  dc11:description "The number of minutes per week that a student with disabilities is served in a special education setting separate from his or her non-disabled peers." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid533 ) .

ceds:P001234
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001234"^^xsd:token ;
  rdfs:label "Individualized Program Inclusion Minutes Per Week" ;
  schema:domainIncludes ceds:C200157 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "IndividualizedProgramInclusionMinutesPerWeek" ;
  dc11:description "The number of minutes per week that a student with disabilities is served in a regular classroom with his or her non-disabled peers." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid535 ) .

