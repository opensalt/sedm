ceds:NI001517164472
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Tutoring Practicum courses provide students with the opportunity to offer
			tutorial assistance to their peers or to younger students. After an initial training
			period during which students learn how to work with other students and how to make use
			of the available resources (e.g., staff, written material, audiovisual aids, and so on),
			students engage in tutoring and assisting others who need or request help.""" ;
