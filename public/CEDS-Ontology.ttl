ceds:NI001671127600
  a owl:NamedIndividual, ceds:C001671, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Cash equivalents are short term, highly liquid investments that are (1)
			readily converted to known amounts of cash, and (2) so near their maturity that they
			present insignificant risk of changes in value because of changes in interest rates.
			Examples are U.S. Treasury bills, certificates of deposit, bankers acceptances,
			repurchase agreements, and commercial paper. Includes amounts for currency on hand and
			deposits held by financial institutions that can be added to or withdrawn without
			limitation, such as demand deposits. (FARM para. 402)""" ;
  dc11:identifier "NI001671127600"^^xsd:token ;
  rdfs:label "Assets: Cash, cash equivalents, and temporary investments" ;
  skos:definition """Cash equivalents are short term, highly liquid investments that are (1)
			readily converted to known amounts of cash, and (2) so near their maturity that they
			present insignificant risk of changes in value because of changes in interest rates.
			Examples are U.S. Treasury bills, certificates of deposit, bankers acceptances,
			repurchase agreements, and commercial paper. Includes amounts for currency on hand and
			deposits held by financial institutions that can be added to or withdrawn without
			limitation, such as demand deposits. (FARM para. 402)""" ;
  skos:inScheme ceds:C001671 ;
  skos:notation "AssetsCashcashequivalentstemporaryinvestments" ;
  skos:prefLabel "Assets: Cash, cash equivalents, and temporary investments" .

ceds:NI001671127601
  a owl:NamedIndividual, ceds:C001671, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Includes amounts receivable for all purposes, including billings for
			educational and general programs and auxiliary enterprise activities; student loans
			receivable; government appropriations receivable; amounts receivable on grants and
			contracts; accrued dividends and interest receivable; claims against vendors; advances
			to employees; and reimbursements receivable from affiliated organizations. All amounts
			receivable should be reported net of an allowance for uncollectible accounts. (FARM
			para. 403)""" ;
  dc11:identifier "NI001671127601"^^xsd:token ;
  rdfs:label "Assets: Receivables (net of allowance for uncollectible amounts)" ;
  skos:definition """Includes amounts receivable for all purposes, including billings for
			educational and general programs and auxiliary enterprise activities; student loans
			receivable; government appropriations receivable; amounts receivable on grants and
			contracts; accrued dividends and interest receivable; claims against vendors; advances
			to employees; and reimbursements receivable from affiliated organizations. All amounts
			receivable should be reported net of an allowance for uncollectible accounts. (FARM
			para. 403)""" ;
  skos:inScheme ceds:C001671 ;
  skos:notation "AssetsReceivablesnetofallowancefor" ;
  skos:prefLabel "Assets: Receivables (net of allowance for uncollectible amounts)" .

ceds:NI001671127602
  a owl:NamedIndividual, ceds:C001671, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Inventories, prepaid expenses, and deferred charges – For inventories,
			include amounts for merchandise inventory held for resale, for example, items held for
			sale by a bookstore or a dining service. Include supplies and other inventoried items
			for internal use if recognized as an asset in the GPFS. For prepaid expenses and
			deferred charges, include amounts paid in advance of services received and expenses
			deferred because benefits relate to future rather than to current period activities.
			Examples include prepaid rent, prepaid insurance, bond issue costs, pension costs or
			other outflows applicable to future periods. (FARM para. 407)""" ;
  dc11:identifier "NI001671127602"^^xsd:token ;
  rdfs:label "Assets: Inventories, prepaid expenses, and deferred charges" ;
  skos:definition """Inventories, prepaid expenses, and deferred charges – For inventories,
			include amounts for merchandise inventory held for resale, for example, items held for
			sale by a bookstore or a dining service. Include supplies and other inventoried items
			for internal use if recognized as an asset in the GPFS. For prepaid expenses and
			deferred charges, include amounts paid in advance of services received and expenses
			deferred because benefits relate to future rather than to current period activities.
			Examples include prepaid rent, prepaid insurance, bond issue costs, pension costs or
			other outflows applicable to future periods. (FARM para. 407)""" ;
  skos:inScheme ceds:C001671 ;
  skos:notation "AssetsInventoriesprepaidexpensesdeferredcharges" ;
  skos:prefLabel "Assets: Inventories, prepaid expenses, and deferred charges" .

