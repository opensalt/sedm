ceds:NI001517162972
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Designed by the College Board to parallel fourth semester college-level courses in Mandarin Chinese language, AP Chinese Languages: Language and Culture courses build upon prior knowledge and develop students' ability to express ideas, exchange opinions, and present information in Chinese languages, both orally and in writing. These courses also help students understand and interpret written and spoken Chinese languages. In addition, students explore the culture of Chinese language-speaking people in historical and contemporary contexts. These courses may be used for any Chinese language, including Mandarin and Cantonese." ;
  dc11:identifier "NI001517162972"^^xsd:token ;
  rdfs:label "AP Chinese Languages: Language and Culture" ;
  skos:definition "Designed by the College Board to parallel fourth semester college-level courses in Mandarin Chinese language, AP Chinese Languages: Language and Culture courses build upon prior knowledge and develop students' ability to express ideas, exchange opinions, and present information in Chinese languages, both orally and in writing. These courses also help students understand and interpret written and spoken Chinese languages. In addition, students explore the culture of Chinese language-speaking people in historical and contemporary contexts. These courses may be used for any Chinese language, including Mandarin and Cantonese." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24414" ;
  skos:prefLabel "AP Chinese Languages: Language and Culture" .

