ceds:NI001670127585
  a owl:NamedIndividual, ceds:C001670, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting the component of net assets represented by the total of
			all capital assets, reduced by accumulated depreciation, and reduced by the amount of
			outstanding bonds, mortgages, notes, or other borrowings that are attributable to the
			acquisition, construction, or improvement of those assets (see indebtedness on capital
			assets). Some outstanding debt may be reported in both current and noncurrent
			liabilities.""" ;
  dc11:identifier "NI001670127585"^^xsd:token ;
  rdfs:label "Net assets invested in capital assets, net of related debt" ;
  skos:definition """Used for reporting the component of net assets represented by the total of
			all capital assets, reduced by accumulated depreciation, and reduced by the amount of
			outstanding bonds, mortgages, notes, or other borrowings that are attributable to the
			acquisition, construction, or improvement of those assets (see indebtedness on capital
			assets). Some outstanding debt may be reported in both current and noncurrent
			liabilities.""" ;
  skos:inScheme ceds:C001670 ;
  skos:notation "Netassetsinvestedincapitalassetsnetofrelateddebt" ;
  skos:prefLabel "Net assets invested in capital assets, net of related debt" .

ceds:NI001670127586
  a owl:NamedIndividual, ceds:C001670, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting restricted net assets that are expendable. Net assets
			should be reported as restricted when constraints placed on use are either (a)
			externally imposed by creditors, grantors, contributors, or laws and regulations of
			other governments or (b) imposed by law through constitutional provisions or enabling
			legislation. Expendable net assets are all those not required to be retained in
			perpetuity.""" ;
  dc11:identifier "NI001670127586"^^xsd:token ;
  rdfs:label "Restricted expendable net assets" ;
  skos:definition """Used for reporting restricted net assets that are expendable. Net assets
			should be reported as restricted when constraints placed on use are either (a)
			externally imposed by creditors, grantors, contributors, or laws and regulations of
			other governments or (b) imposed by law through constitutional provisions or enabling
			legislation. Expendable net assets are all those not required to be retained in
			perpetuity.""" ;
  skos:inScheme ceds:C001670 ;
  skos:notation "Restrictedexpendablenetassets" ;
  skos:prefLabel "Restricted expendable net assets" .

ceds:NI001670127587
  a owl:NamedIndividual, ceds:C001670, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting net assets that are restricted and nonexpendable. Net
			assets should be reported as restricted when constraints placed on use are either (a)
			externally imposed by creditors, grantors, contributors, or laws and regulations of
			other governments or (b) imposed by law through constitutional provisions or enabling
			legislation. Nonexpendable net assets are those that are required to be retained in
			perpetuity.""" ;
  dc11:identifier "NI001670127587"^^xsd:token ;
  rdfs:label "Restricted non-expendable net assets" ;
  skos:definition """Used for reporting net assets that are restricted and nonexpendable. Net
			assets should be reported as restricted when constraints placed on use are either (a)
			externally imposed by creditors, grantors, contributors, or laws and regulations of
			other governments or (b) imposed by law through constitutional provisions or enabling
			legislation. Nonexpendable net assets are those that are required to be retained in
			perpetuity.""" ;
  skos:inScheme ceds:C001670 ;
  skos:notation "Restrictednonexpendablenetassets" ;
  skos:prefLabel "Restricted non-expendable net assets" .

