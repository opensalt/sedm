ceds:NI001517164004
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Retail Marketing courses cover marketing principles and concepts related to
			the provision of goods or services directly to the consumer, emphasizing store
			operation, advertisement and display of goods, store security, human relations, and
			business management and ownership.""" ;
  dc11:identifier "NI001517164004"^^xsd:token ;
  rdfs:label "Retail Marketing" ;
  skos:definition """Retail Marketing courses cover marketing principles and concepts related to
			the provision of goods or services directly to the consumer, emphasizing store
