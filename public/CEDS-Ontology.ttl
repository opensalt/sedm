  ceds:textFormat "HH:MM:SS" .

ceds:P000977
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000977"^^xsd:token ;
  rdfs:label "Assessment Administration Name" ;
  schema:domainIncludes ceds:C200013 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentAdministrationName" ;
  dc11:description "The name given to an assessment event." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001531
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001531"^^xsd:token ;
  rdfs:label "Assessment Administration Period Description" ;
  schema:domainIncludes ceds:C200013 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentAdministrationPeriodDescription" ;
