ceds:NI001517162817
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Academic Competition courses prepare students to compete individually or in
			teams in organized contests that test their academic knowledge and skills. Specific
			content depends upon the competition (examples include Academic Decathlon or Pentathlon,
			Model UN, subject-specific Olympiads, and Odyssey of the Mind); however, these courses
			typically foster research, public speaking, critical thinking, and teamwork skills.
			(Courses that focus on Forensics/Debate competitions should be coded with one of the
			Forensic Speech course codes.)""" ;
  dc11:identifier "NI001517162817"^^xsd:token ;
  rdfs:label "Academic Competition" ;
  skos:definition """Academic Competition courses prepare students to compete individually or in
			teams in organized contests that test their academic knowledge and skills. Specific
			content depends upon the competition (examples include Academic Decathlon or Pentathlon,
			Model UN, subject-specific Olympiads, and Odyssey of the Mind); however, these courses
			typically foster research, public speaking, critical thinking, and teamwork skills.
			(Courses that focus on Forensics/Debate competitions should be coded with one of the
			Forensic Speech course codes.)""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "22115" ;
  skos:prefLabel "Academic Competition" .

ceds:NI001517162818
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "IB Personal and Professional Skills (PPS) courses are a required component of the International Baccalaureate's Career-related program. Intended to develop attitudes, skills, and strategies applicable to both personal and professional situations, these courses emphasize personal growth and development, interpersonal skills, intercultural understanding, and the use of ethics. IB Personal and Professional Skills courses are linked to students' career-related studies and may include work-based experiences." ;
  dc11:identifier "NI001517162818"^^xsd:token ;
  rdfs:label "IB Personal and Professional Skills" ;
  skos:definition "IB Personal and Professional Skills (PPS) courses are a required component of the International Baccalaureate's Career-related program. Intended to develop attitudes, skills, and strategies applicable to both personal and professional situations, these courses emphasize personal growth and development, interpersonal skills, intercultural understanding, and the use of ethics. IB Personal and Professional Skills courses are linked to students' career-related studies and may include work-based experiences." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "22113" ;
  skos:prefLabel "IB Personal and Professional Skills" .

ceds:NI001517162819
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """World Language—General courses involve content that is not grade
			differentiated and may apply to a range of consecutive grades (e.g., "by third grade,
			students should know and be able to do…"). These courses include content that may be
			applicable to states or localities that do not employ grade-level content standards.
			[These courses provide broad content that is not organized as described elsewhere (i.e.,
			World Language, early childhood education through grade 8).]""" ;
  dc11:identifier "NI001517162819"^^xsd:token ;
