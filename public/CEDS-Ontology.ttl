ceds:NI000076116995
  a owl:NamedIndividual, ceds:C000076, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Is absent at the time a given schedule when attendance begins but is present
			before the close of that time period.""" ;
