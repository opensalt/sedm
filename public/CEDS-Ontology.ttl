  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001942"^^xsd:token ;
  rdfs:label "Has WIOA Training Services" ;
  schema:domainIncludes ceds:C200326 ;
  schema:rangeIncludes ceds:C001942 ;
  skos:notation "hasWIOATrainingServices" ;
  dc11:description "An indication of whether or not the individual has received services as defined by the Workforce Innovation and Opportunity Act (WIOA), one or more courses or classes, or a structured regimen that provides the services in 20 CFR part 680.200 and leads to: (a) An industry-recognized certificate or certification, a certificate of completion of a registered apprenticeship, a license recognized by the State involved or the Federal Government, an associate or baccalaureate degree, or community college certificate of completion; (b) Consistent with § 680.350, a secondary school diploma or its equivalent; (c) Employment; or (d) Measurable skill gains toward a credential described in paragraph (a) or (b) of this section or employment." ;
  ceds:editHistory ( _:genid2203 ) .

ceds:P000856
