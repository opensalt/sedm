  skos:prefLabel "Change Cash" .

ceds:NI001353117336
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Deposits with fiscal agents, such as commercial banks, for paying matured
			bonds and interest.""" ;
  dc11:identifier "NI001353117336"^^xsd:token ;
  rdfs:label "Cash With Fiscal Agents" ;
  skos:definition """Deposits with fiscal agents, such as commercial banks, for paying matured
			bonds and interest.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "105" ;
  skos:prefLabel "Cash With Fiscal Agents" .

ceds:NI001353117337
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Securities and real estate held for producing income in the form of
			interest, dividends, rentals, or lease payments. Investments should be presented at fair
			value as of the reporting date. Gains from changes in the fair value of investments are
			recorded using revenue account 1530. Losses from changes in the fair value of
			investments are recorded using expenditure object code 930. Alternatively, gains and
			losses may be netted and recorded in revenue account 1530. The account does not include
			capital assets used in school district operations. Separate accounts may be maintained
			for each category of investments.""" ;
  dc11:identifier "NI001353117337"^^xsd:token ;
  rdfs:label "Investments" ;
  skos:definition """Securities and real estate held for producing income in the form of
			interest, dividends, rentals, or lease payments. Investments should be presented at fair
			value as of the reporting date. Gains from changes in the fair value of investments are
			recorded using revenue account 1530. Losses from changes in the fair value of
			investments are recorded using expenditure object code 930. Alternatively, gains and
			losses may be netted and recorded in revenue account 1530. The account does not include
			capital assets used in school district operations. Separate accounts may be maintained
			for each category of investments.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "111" ;
  skos:prefLabel "Investments" .

ceds:NI001353117338
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The excess of the amount paid for securities over the face value that has
			not yet been amortized. Use of this account is restricted to short- term money market
			investments.""" ;
  dc11:identifier "NI001353117338"^^xsd:token ;
  rdfs:label "Unamortized Premiums on Investments" ;
  skos:definition """The excess of the amount paid for securities over the face value that has
			not yet been amortized. Use of this account is restricted to short- term money market
			investments.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "112" ;
  skos:prefLabel "Unamortized Premiums on Investments" .

ceds:NI001353117339
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The excess of the face value of securities over the amount paid for them
			that has not yet been written off. Use of this account is restricted to short-term
			investments.""" ;
  dc11:identifier "NI001353117339"^^xsd:token ;
  rdfs:label "Unamortized Discounts on Investments (Credit)" ;
  skos:definition """The excess of the face value of securities over the amount paid for them
			that has not yet been written off. Use of this account is restricted to short-term
			investments.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "113" ;
  skos:prefLabel "Unamortized Discounts on Investments (Credit)" .

ceds:NI001353117340
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The amount of interest receivable on investments, excluding interest
			purchased. Interest purchased should be shown in a separate account.""" ;
  dc11:identifier "NI001353117340"^^xsd:token ;
  rdfs:label "Interest Receivable on Investments" ;
  skos:definition """The amount of interest receivable on investments, excluding interest
			purchased. Interest purchased should be shown in a separate account.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "114" ;
  skos:prefLabel "Interest Receivable on Investments" .

ceds:NI001353117341
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Interest accrued on investments between the last interest payment date and
			the date of purchase. The account is carried as an asset until the first interest
			payment date after the date of purchase.""" ;
  dc11:identifier "NI001353117341"^^xsd:token ;
  rdfs:label "Accrued Interest on Investments Purchased" ;
  skos:definition """Interest accrued on investments between the last interest payment date and
			the date of purchase. The account is carried as an asset until the first interest
			payment date after the date of purchase.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "115" ;
  skos:prefLabel "Accrued Interest on Investments Purchased" .

ceds:NI001353117342
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The uncollected portion of taxes that a school district or government unit
			has levied and that has become due, including any interest or penalties that may be
			accrued. Separate accounts may be maintained on the basis of tax roll year, current and
			delinquent taxes, or both.""" ;
  dc11:identifier "NI001353117342"^^xsd:token ;
  rdfs:label "Taxes Receivable" ;
  skos:definition """The uncollected portion of taxes that a school district or government unit
			has levied and that has become due, including any interest or penalties that may be
			accrued. Separate accounts may be maintained on the basis of tax roll year, current and
			delinquent taxes, or both.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "121" ;
  skos:prefLabel "Taxes Receivable" .

ceds:NI001353117343
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The portion of taxes receivable estimated not to be collected. The account
			is shown on the balance sheet as a deduction from the taxes receivable account to arrive
			at the net taxes receivable. Separate accounts may be maintained on the basis of tax
			roll year, delinquent taxes, or both.""" ;
  dc11:identifier "NI001353117343"^^xsd:token ;
  rdfs:label "Allowance for Uncollectible Taxes (Credit)" ;
  skos:definition """The portion of taxes receivable estimated not to be collected. The account
			is shown on the balance sheet as a deduction from the taxes receivable account to arrive
			at the net taxes receivable. Separate accounts may be maintained on the basis of tax
			roll year, delinquent taxes, or both.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "122" ;
  skos:prefLabel "Allowance for Uncollectible Taxes (Credit)" .

ceds:NI001353117344
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """An asset account used to record a loan by one fund to another fund in the
			same governmental unit. It is recommended that separate accounts be maintained for each
			interfund receivable loan.""" ;
  dc11:identifier "NI001353117344"^^xsd:token ;
  rdfs:label "Interfund Loans Receivable" ;
  skos:definition """An asset account used to record a loan by one fund to another fund in the
			same governmental unit. It is recommended that separate accounts be maintained for each
			interfund receivable loan.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "131" ;
  skos:prefLabel "Interfund Loans Receivable" .

ceds:NI001353117345
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """An asset account used to indicate amounts owed to a particular fund by
			another fund in the same school district for goods sold or services rendered. It is
			recommended that separate accounts be maintained for each interfund receivable.""" ;
  dc11:identifier "NI001353117345"^^xsd:token ;
  rdfs:label "Interfund Accounts Receivable" ;
  skos:definition """An asset account used to indicate amounts owed to a particular fund by
			another fund in the same school district for goods sold or services rendered. It is
			recommended that separate accounts be maintained for each interfund receivable.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "132" ;
  skos:prefLabel "Interfund Accounts Receivable" .

ceds:NI001353117346
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Amounts due to the reporting governmental unit from another governmental
			unit. These amounts may represent grants-in-aid, shared taxes, taxes collected for the
			reporting unit by another unit, loans, and charges for services rendered by the
			reporting unit for another government. It is recommended that separate accounts be
			maintained for each interagency receivable.""" ;
  dc11:identifier "NI001353117346"^^xsd:token ;
  rdfs:label "Intergovernmental Accounts Receivable" ;
  skos:definition """Amounts due to the reporting governmental unit from another governmental
			unit. These amounts may represent grants-in-aid, shared taxes, taxes collected for the
			reporting unit by another unit, loans, and charges for services rendered by the
			reporting unit for another government. It is recommended that separate accounts be
			maintained for each interagency receivable.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "141" ;
  skos:prefLabel "Intergovernmental Accounts Receivable" .

ceds:NI001353117347
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Amounts that have been loaned to persons or organizations, including notes
			taken as security for such loans, where permitted by statutory authority.""" ;
  dc11:identifier "NI001353117347"^^xsd:token ;
  rdfs:label "Loans Receivable" ;
  skos:definition """Amounts that have been loaned to persons or organizations, including notes
			taken as security for such loans, where permitted by statutory authority.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "151" ;
  skos:prefLabel "Loans Receivable" .

ceds:NI001353117348
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The portion of loans receivable estimated not to be collected. The account
			is shown on the balance sheet as a deduction from the other loans receivable account.""" ;
  dc11:identifier "NI001353117348"^^xsd:token ;
  rdfs:label "Allowance for Uncollectible Loans (Credit)" ;
  skos:definition """The portion of loans receivable estimated not to be collected. The account
			is shown on the balance sheet as a deduction from the other loans receivable account.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "152" ;
  skos:prefLabel "Allowance for Uncollectible Loans (Credit)" .

ceds:NI001353117349
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Amounts due on open account from private persons, firms, or corporations for
			goods and services furnished by a school district (but not including amounts due from
			other funds or from other governmental units).""" ;
  dc11:identifier "NI001353117349"^^xsd:token ;
  rdfs:label "Other Accounts Receivable" ;
  skos:definition """Amounts due on open account from private persons, firms, or corporations
			for goods and services furnished by a school district (but not including amounts due
			from other funds or from other governmental units).""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "153" ;
  skos:prefLabel "Other Accounts Receivable" .

ceds:NI001353117350
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A provision for that portion of accounts receivable that is estimated will
			not be collected. The account is shown on the balance sheet as a deduction from the
			other accounts receivable account.""" ;
  dc11:identifier "NI001353117350"^^xsd:token ;
  rdfs:label "Allowance for Uncollectible Accounts Receivable (Credit)" ;
  skos:definition """A provision for that portion of accounts receivable that is estimated will
			not be collected. The account is shown on the balance sheet as a deduction from the
			other accounts receivable account.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "154" ;
  skos:prefLabel "Allowance for Uncollectible Accounts Receivable (Credit)" .

ceds:NI001353117351
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The cost of supplies and equipment on hand not yet distributed to
			requisitioning units.""" ;
  dc11:identifier "NI001353117351"^^xsd:token ;
  rdfs:label "Inventories for Consumption" ;
  skos:definition """The cost of supplies and equipment on hand not yet distributed to
			requisitioning units.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "171" ;
  skos:prefLabel "Inventories for Consumption" .

ceds:NI001353117352
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The value of goods purchased and held by a school district for resale rather
			than for use in its own operations. Such goods could include unique manufactured
			inventories, such as student-built homes or equipment.""" ;
  dc11:identifier "NI001353117352"^^xsd:token ;
  rdfs:label "Inventories for Resale" ;
  skos:definition """The value of goods purchased and held by a school district for resale
			rather than for use in its own operations. Such goods could include unique manufactured
			inventories, such as student-built homes or equipment.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "172" ;
  skos:prefLabel "Inventories for Resale" .

ceds:NI001353117353
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Expenditures/expenses paid for benefits not yet received. Prepaid expenses
			differ from deferred charges in that they are spread over a shorter period of time and
			are regularly recurring costs of operation. Examples of prepaid expenses are prepaid
			rent, prepaid interest, and unexpired insurance premiums.""" ;
  dc11:identifier "NI001353117353"^^xsd:token ;
  rdfs:label "Prepaid Items" ;
  skos:definition """Expenditures/expenses paid for benefits not yet received. Prepaid expenses
			differ from deferred charges in that they are spread over a shorter period of time and
			are regularly recurring costs of operation. Examples of prepaid expenses are prepaid
			rent, prepaid interest, and unexpired insurance premiums.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "181" ;
  skos:prefLabel "Prepaid Items" .

ceds:NI001353117354
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Funds deposited by the school district as a prerequisite to receiving
			services, goods, or both.""" ;
  dc11:identifier "NI001353117354"^^xsd:token ;
  rdfs:label "Deposits" ;
  skos:definition """Funds deposited by the school district as a prerequisite to receiving
			services, goods, or both.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "191" ;
  skos:prefLabel "Deposits" .

ceds:NI001353117355
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Bond insurance costs that are a form of prepayment to be amortized." ;
  dc11:identifier "NI001353117355"^^xsd:token ;
  rdfs:label "Bond Insurance Costs" ;
  skos:definition "Bond insurance costs that are a form of prepayment to be amortized." ;
  skos:inScheme ceds:C001353 ;
  skos:notation "193" ;
  skos:prefLabel "Bond Insurance Costs" .

ceds:NI001353117356
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Represents amounts to be amortized as debt premium/discount in connection
			with the issuance of bonds.""" ;
  dc11:identifier "NI001353117356"^^xsd:token ;
  rdfs:label "Premium and Discount on Issuance of Bonds" ;
  skos:definition """Represents amounts to be amortized as debt premium/discount in connection
			with the issuance of bonds.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "194" ;
  skos:prefLabel "Premium and Discount on Issuance of Bonds" .

ceds:NI001353117357
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Current assets not provided for elsewhere." ;
  dc11:identifier "NI001353117357"^^xsd:token ;
