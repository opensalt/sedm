ceds:NI001517162970
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Language A: Literature—Chinese Languages courses prepare students to take
			the International Baccalaureate Language A: Literature exams. Course content includes
			in-depth study of a range of literary texts in a number of literary forms and from
			different times and places, written analyses and critiques of this literature, and other
			oral and written assignments. The course is designed for students highly competent in
			using Chinese languages in an academic context and is intended for students with native
			or near-native fluency in the languages. These courses may be used for any Chinese
			language, including Mandarin and Cantonese.""" ;
  dc11:identifier "NI001517162970"^^xsd:token ;
  rdfs:label "IB Language A: Literature—Chinese Languages" ;
  skos:definition """IB Language A: Literature—Chinese Languages courses prepare students to
			take the International Baccalaureate Language A: Literature exams. Course content
			includes in-depth study of a range of literary texts in a number of literary forms and
			from different times and places, written analyses and critiques of this literature, and
			other oral and written assignments. The course is designed for students highly competent
			in using Chinese languages in an academic context and is intended for students with
			native or near-native fluency in the languages. These courses may be used for any
			Chinese language, including Mandarin and Cantonese.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24412" ;
  skos:prefLabel "IB Language A: Literature—Chinese Languages" .

ceds:NI001517162971
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "IB Language B—Chinese Languages courses prepare students to take the International Baccalaureate Language B exams. These courses focus on improving students' accuracy and fluency in oral and written communication (usually in the students' \"second\" language). These courses may be used for any Chinese language, including Mandarin and Cantonese." ;
