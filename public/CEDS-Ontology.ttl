ceds:P000514
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000514"^^xsd:token ;
  rdfs:label "Has Shortened Expulsion" ;
  schema:domainIncludes ceds:C200215 ;
  schema:rangeIncludes ceds:C000514 ;
  skos:notation "hasShortenedExpulsion" ;
  dc11:description "An expulsion with or without services that is shortened to a term of less than one year by the superintendent or chief administrator of a school district." .

ceds:P000610
