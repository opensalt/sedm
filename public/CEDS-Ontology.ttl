ceds:NI002089181587
  a owl:NamedIndividual, ceds:C002089, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Audio description is the verbal explanation of essential visual elements in
			a video or other multimedia resource, providing access to the visual content when the
			audio component alone is insufficient for perceiving on-screen actions. (Note: While
			video is not covered by Section 121/Chafee Amendment of the Copyright Act, it is a
			material that can be enhanced for accessibility for use by students with disabilities.)""" ;
  dc11:identifier "NI002089181587"^^xsd:token ;
  rdfs:label "Audio Described Video" ;
  skos:definition """Audio description is the verbal explanation of essential visual elements in
			a video or other multimedia resource, providing access to the visual content when the
			audio component alone is insufficient for perceiving on-screen actions. (Note: While
			video is not covered by Section 121/Chafee Amendment of the Copyright Act, it is a
			material that can be enhanced for accessibility for use by students with disabilities.)""" ;
  skos:inScheme ceds:C002089 ;
  skos:notation "1001" ;
  skos:prefLabel "Audio Described Video" .

ceds:NI002089181588
  a owl:NamedIndividual, ceds:C002089, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Braille code is a tactile system of raised dots that enables students who are blind or have low vision to read through touch. Braille consists of patterns of raised dots arranged in cells of up to six dots in a 3×2 configuration. Each cell represents letters of the alphabet, punctuation, numbers, and whole words. (iii) In the case of a child who is blind or visually impaired, provide for instruction in Braille and the use of Braille unless the IEP Team determines, after an evaluation of the child's reading and writing skills, needs, and appropriate reading and writing media (including an evaluation of the child's future needs for instruction in Braille or the use of Braille), that instruction in Braille or the use of Braille is not appropriate for the child; Sec. 300.324 (a) (2) (iii)" ;
  dc11:identifier "NI002089181588"^^xsd:token ;
  rdfs:label "Braille" ;
  skos:definition "Braille code is a tactile system of raised dots that enables students who are blind or have low vision to read through touch. Braille consists of patterns of raised dots arranged in cells of up to six dots in a 3×2 configuration. Each cell represents letters of the alphabet, punctuation, numbers, and whole words. (iii) In the case of a child who is blind or visually impaired, provide for instruction in Braille and the use of Braille unless the IEP Team determines, after an evaluation of the child's reading and writing skills, needs, and appropriate reading and writing media (including an evaluation of the child's future needs for instruction in Braille or the use of Braille), that instruction in Braille or the use of Braille is not appropriate for the child; Sec. 300.324 (a) (2) (iii)" ;
  skos:inScheme ceds:C002089 ;
  skos:notation "1002" ;
  skos:prefLabel "Braille" .

ceds:NI002089181589
  a owl:NamedIndividual, ceds:C002089, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Captions are the text representation of the audio content in a video or
			other multimedia production. Captions are synced with the video and include the words
			spoken, as well as other important information in the audio track. (Note: While video is
			not covered by Section 121/Chafee Amendment of the Copyright Act, it is a material that
			can be enhanced for accessibility for use by students with disabilities.)""" ;
  dc11:identifier "NI002089181589"^^xsd:token ;
  rdfs:label "Captioned Video" ;
  skos:definition """Captions are the text representation of the audio content in a video or
			other multimedia production. Captions are synced with the video and include the words
			spoken, as well as other important information in the audio track. (Note: While video is
			not covered by Section 121/Chafee Amendment of the Copyright Act, it is a material that
			can be enhanced for accessibility for use by students with disabilities.)""" ;
  skos:inScheme ceds:C002089 ;
  skos:notation "1003" ;
  skos:prefLabel "Captioned Video" .

ceds:NI002089181590
  a owl:NamedIndividual, ceds:C002089, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Digital text format refers to accessible file formats that contain both text
			and images. An accessible digital text file must be usable by the student requiring this
			format. Examples of file types include accessible EPUB, HTML, MathML, and tagged PDF.""" ;
  dc11:identifier "NI002089181590"^^xsd:token ;
  rdfs:label "Digital Text" ;
  skos:definition """Digital text format refers to accessible file formats that contain both
			text and images. An accessible digital text file must be usable by the student requiring
			this format. Examples of file types include accessible EPUB, HTML, MathML, and tagged
			PDF.""" ;
  skos:inScheme ceds:C002089 ;
  skos:notation "1004" ;
  skos:prefLabel "Digital Text" .

ceds:NI002089181591
  a owl:NamedIndividual, ceds:C002089, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Large print format is provided in a hard copy document containing a font
			size of 18 points or larger. Additional formatting considerations pertain to styles used
			for font face and punctuation; format options; use of color; paper selection; and
			document size.""" ;
  dc11:identifier "NI002089181591"^^xsd:token ;
  rdfs:label "Large Print" ;
  skos:definition """Large print format is provided in a hard copy document containing a font
			size of 18 points or larger. Additional formatting considerations pertain to styles used
			for font face and punctuation; format options; use of color; paper selection; and
			document size.""" ;
  skos:inScheme ceds:C002089 ;
  skos:notation "1005" ;
  skos:prefLabel "Large Print" .

ceds:NI002089181592
  a owl:NamedIndividual, ceds:C002089, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Tactile graphics convey non-textual information to people who are blind or
			have low vision. These may include tactile representations of pictures, maps, graphs,
			diagrams and other images. Students who are blind or have low vision can feel these
			raised lines and surfaces to access the same information as students who are sighted.
			(Note: While graphics are not covered by Section 121/Chafee Amendment of the Copyright
			Act, it is a material that can be enhanced for accessibility for use by students with
			disabilities.)""" ;
  dc11:identifier "NI002089181592"^^xsd:token ;
  rdfs:label "Tactile Graphics" ;
  skos:definition """Tactile graphics convey non-textual information to people who are blind or
			have low vision. These may include tactile representations of pictures, maps, graphs,
			diagrams and other images. Students who are blind or have low vision can feel these
			raised lines and surfaces to access the same information as students who are sighted.
			(Note: While graphics are not covered by Section 121/Chafee Amendment of the Copyright
			Act, it is a material that can be enhanced for accessibility for use by students with
			disabilities.)""" ;
  skos:inScheme ceds:C002089 ;
  skos:notation "1006" ;
  skos:prefLabel "Tactile Graphics" .

ceds:NI002089181593
  a owl:NamedIndividual, ceds:C002089, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Transcripts are a text version of the speech and non-speech audio
			information needed to understand the content in an audio-only file. (Note: While audio
			is not covered by Section 121/Chafee Amendment of the Copyright Act, it is a material
			that can be enhanced for accessibility for use by students with disabilities.)""" ;
  dc11:identifier "NI002089181593"^^xsd:token ;
  rdfs:label "Text Transcripts of Audio" ;
  skos:definition """Transcripts are a text version of the speech and non-speech audio
			information needed to understand the content in an audio-only file. (Note: While audio
			is not covered by Section 121/Chafee Amendment of the Copyright Act, it is a material
			that can be enhanced for accessibility for use by students with disabilities.)""" ;
  skos:inScheme ceds:C002089 ;
  skos:notation "1007" ;
  skos:prefLabel "Text Transcripts of Audio" .

ceds:NI002089181594
  a owl:NamedIndividual, ceds:C002089, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Synchronized ASL is pre-produced sign language interpretation of audio
			content in a video or other multimedia resource. ASL is synchronized with and displayed
			alongside media, integrated into the media (picture-in-picture), displayed in a separate
			window, or displayed on a second screen. (Note: While audio is not covered by Section
			121/Chafee Amendment of the Copyright Act, it is a material that can be enhanced for
			accessibility for use by students with disabilities.)""" ;
  dc11:identifier "NI002089181594"^^xsd:token ;
  rdfs:label "Video with Synchronized American Sign Language (ASL)" ;
  skos:definition """Synchronized ASL is pre-produced sign language interpretation of audio
			content in a video or other multimedia resource. ASL is synchronized with and displayed
			alongside media, integrated into the media (picture-in-picture), displayed in a separate
			window, or displayed on a second screen. (Note: While audio is not covered by Section
			121/Chafee Amendment of the Copyright Act, it is a material that can be enhanced for
			accessibility for use by students with disabilities.)""" ;
  skos:inScheme ceds:C002089 ;
  skos:notation "1008" ;
  skos:prefLabel "Video with Synchronized American Sign Language (ASL)" .

