  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """An assessment item that presents visual or written stimulus with incomplete
			or incorrect information and asks examinees to correct or complete the information.""" ;
  dc11:identifier "NI000390101930"^^xsd:token ;
  rdfs:label "Substitution" ;
  skos:definition """An assessment item that presents visual or written stimulus with incomplete
			or incorrect information and asks examinees to correct or complete the information.""" ;
  skos:inScheme ceds:C000390 ;
  skos:notation "Substitution" ;
  skos:prefLabel "Substitution" .

