  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Physical Science (prior-to-secondary) courses cover basic principles of
			physical science, such as matter, energy, force, and motion. Topics may include
			conservation of energy and matter, the atomic model, the periodic table, electricity, or
			other topics consistent with state academic standards for physical science.""" ;
