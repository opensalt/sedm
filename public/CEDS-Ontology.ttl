			and chemical interactions.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "03159" ;
  skos:prefLabel "Physical Science" .

ceds:NI001517163391
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Conceptual Physics courses introduce students to the use of chemicals,
			characteristic properties of materials, and simple mechanics to better describe the
			world and nonliving matter. The courses emphasize precise measurements and descriptive
			analysis of experimental results. Topics covered may include energy and motion,
			electricity, magnetism, heat, the structure of matter, and how matter reacts to
			materials and forces.""" ;
  dc11:identifier "NI001517163391"^^xsd:token ;
  rdfs:label "Conceptual Physics" ;
  skos:definition """Conceptual Physics courses introduce students to the use of chemicals,
			characteristic properties of materials, and simple mechanics to better describe the
			world and nonliving matter. The courses emphasize precise measurements and descriptive
			analysis of experimental results. Topics covered may include energy and motion,
			electricity, magnetism, heat, the structure of matter, and how matter reacts to
			materials and forces.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "03161" ;
  skos:prefLabel "Conceptual Physics" .

