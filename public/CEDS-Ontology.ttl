ceds:NI001158104283
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The end attempt interaction is a special type of interaction which allows
			item authors to provide the candidate with control over the way in which the candidate
			terminates an attempt. The candidate can use the interaction to terminate the attempt
			(triggering response processing) immediately, typically to request a hint. It must be
			bound to a response variable with base-type boolean and single cardinality.""" ;
  dc11:identifier "NI001158104283"^^xsd:token ;
  rdfs:label "End Attempt Interaction" ;
  skos:definition """The end attempt interaction is a special type of interaction which allows
			item authors to provide the candidate with control over the way in which the candidate
			terminates an attempt. The candidate can use the interaction to terminate the attempt
			(triggering response processing) immediately, typically to request a hint. It must be
			bound to a response variable with base-type boolean and single cardinality.""" ;
  skos:inScheme ceds:C001158 ;
  skos:notation "EndAttemptInteraction" ;
  skos:prefLabel "End Attempt Interaction" .

