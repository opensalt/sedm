  skos:inScheme ceds:C001876 ;
  skos:notation "02838" ;
  skos:prefLabel "Preventive" .

ceds:NI001876129116
  a owl:NamedIndividual, ceds:C001876, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A work-order based approach to maintenance that addresses lists of broken
			items, deteriorated finishes or equipment/parts nearing the end of their life cycle,
			maintenance required as a result of normal wear and tear, equipment/parts that should be
