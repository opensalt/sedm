ceds:NI001517163558
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Dance Improvisation courses help students develop an ability to respond
			kinesthetically in the moment, understand the elements of dance, relate to each other
			through movement, experiment with choreographic principles, and expand the boundaries of
			the definition of dance. These courses may emphasize the process of exploration,
			individual investigation, and group work.""" ;
  dc11:identifier "NI001517163558"^^xsd:token ;
  rdfs:label "Dance Improvisation" ;
  skos:definition """Dance Improvisation courses help students develop an ability to respond
			kinesthetically in the moment, understand the elements of dance, relate to each other
			through movement, experiment with choreographic principles, and expand the boundaries of
			the definition of dance. These courses may emphasize the process of exploration,
			individual investigation, and group work.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05007" ;
  skos:prefLabel "Dance Improvisation" .

ceds:NI001517163559
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "World/Cultural Dance courses help students develop an understanding of authentic dances from other nations in the context of the people's history, culture, and customs. These courses may involve creating, performing, and responding to dances of other cultures and/or time periods." ;
  dc11:identifier "NI001517163559"^^xsd:token ;
  rdfs:label "World/Cultural Dance" ;
  skos:definition "World/Cultural Dance courses help students develop an understanding of authentic dances from other nations in the context of the people's history, culture, and customs. These courses may involve creating, performing, and responding to dances of other cultures and/or time periods." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05008" ;
  skos:prefLabel "World/Cultural Dance" .

ceds:NI001517163560
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Technical Theater for Dance courses teach students the basics of lighting,
			sound, makeup, costuming, stage management, and other aspects of dance concert
			production. These courses may also include the practical application of skills.""" ;
  dc11:identifier "NI001517163560"^^xsd:token ;
  rdfs:label "Technical Theater for Dance" ;
  skos:definition """Technical Theater for Dance courses teach students the basics of lighting,
			sound, makeup, costuming, stage management, and other aspects of dance concert
			production. These courses may also include the practical application of skills.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05009" ;
  skos:prefLabel "Technical Theater for Dance" .

ceds:NI001517163561
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Social Dance courses teach students the steps, spatial formations and
			patterns, appropriate partner etiquette, and the relationship of the dance(s) to
			specific music or musical forms as well as historical or cultural contexts. These
			courses emphasize the distinct forms of partner or group dances and may include a
			variety of options (e.g., ballroom, square, folk, barn, contra, circle, and line
			dances).""" ;
  dc11:identifier "NI001517163561"^^xsd:token ;
  rdfs:label "Social Dance" ;
  skos:definition """Social Dance courses teach students the steps, spatial formations and
			patterns, appropriate partner etiquette, and the relationship of the dance(s) to
			specific music or musical forms as well as historical or cultural contexts. These
			courses emphasize the distinct forms of partner or group dances and may include a
			variety of options (e.g., ballroom, square, folk, barn, contra, circle, and line
			dances).""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05010" ;
  skos:prefLabel "Social Dance" .

ceds:NI001517163562
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Dance Composition/Composition Seminar courses help students gain an
			understanding of specific choreographic principles and apply those principles to
			individual movement studies. These courses may emphasize the process of building dance
			compositions and discovering methods for connecting different dances.""" ;
  dc11:identifier "NI001517163562"^^xsd:token ;
  rdfs:label "Dance Composition/Composition Seminar" ;
  skos:definition """Dance Composition/Composition Seminar courses help students gain an
			understanding of specific choreographic principles and apply those principles to
			individual movement studies. These courses may emphasize the process of building dance
			compositions and discovering methods for connecting different dances.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05011" ;
  skos:prefLabel "Dance Composition/Composition Seminar" .

ceds:NI001517163563
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Dance courses prepare students to take the International Baccalaureate
			(IB) Dance assessments. IB Dance courses help students develop skills in the
			composition, performance, and analysis of dance. These courses also help students form
			an historical and global awareness of dance forms and styles.""" ;
  dc11:identifier "NI001517163563"^^xsd:token ;
  rdfs:label "IB Dance" ;
  skos:definition """IB Dance courses prepare students to take the International Baccalaureate
			(IB) Dance assessments. IB Dance courses help students develop skills in the
			composition, performance, and analysis of dance. These courses also help students form
			an historical and global awareness of dance forms and styles.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05012" ;
  skos:prefLabel "IB Dance" .

