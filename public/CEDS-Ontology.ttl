  dc11:creator "Common Education Data Standards" ;
  dc11:description "Individualized or small group instruction for students who need assistance in learning one or more components of a prescribed curriculum. Tutoring usually supplements a regular school program, and may be provided by peer students, teachers, or other personnel at school, in an individual's home, or at a community agency site." ;
  dc11:identifier "NI000273172825"^^xsd:token ;
