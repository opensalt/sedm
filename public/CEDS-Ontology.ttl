ceds:NI001517163236
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """English Language and Literature—Independent study courses, often conducted
			with instructors as mentors, allow students to explore particular topics within the
			field of language arts. Independent Study courses may serve as an opportunity for
			students to expand their expertise in a particular application, to explore a topic in
			greater detail, or to develop more advanced skills.""" ;
