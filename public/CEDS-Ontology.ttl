ceds:NI001517163421
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Science (kindergarten) courses encourage students to observe and describe
			properties of organisms, systems, and the environment. Students may raise questions,
			identify patterns, and record observations. Specific content depends upon state
			standards for kindergarten.""" ;
  dc11:identifier "NI001517163421"^^xsd:token ;
