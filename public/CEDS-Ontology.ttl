  rdfs:label "Vapor intrusion" ;
  skos:definition """Vapor intrusion is defined as vapor phase migration of volatile organic
			and/or inorganic compounds into occupied buildings from underlying contaminated ground
			water and/or soil.""" ;
  skos:inScheme ceds:C001874 ;
