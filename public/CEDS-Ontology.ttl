  schema:domainIncludes ceds:C200215 ;
  schema:rangeIncludes ceds:C001322 ;
  skos:notation "hasDisciplinaryActionIEPPlacementMeetingIndicator" ;
  dc11:description "An indication as to whether an offense and/or disciplinary action resulted in a meeting of a student’s Individualized Education Program (IEP) team to determine appropriate placement." .

ceds:P000578
