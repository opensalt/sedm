ceds:NI002068181473
  a owl:NamedIndividual, ceds:C002068, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """This status is assigned when the student is not enrolled, and their
			whereabouts cannot be determined, indicating a potential dropout. The designated
			reporting deadline, as defined by local, state, or federal authorities for identifying
			dropout status, has not yet been reached.""" ;
  dc11:identifier "NI002068181473"^^xsd:token ;
  rdfs:label "Potential Dropout" ;
  skos:definition """This status is assigned when the student is not enrolled, and their
			whereabouts cannot be determined, indicating a potential dropout. The designated
			reporting deadline, as defined by local, state, or federal authorities for identifying
			dropout status, has not yet been reached.""" ;
  skos:inScheme ceds:C002068 ;
  skos:notation "Potential" ;
  skos:prefLabel "Potential Dropout" .

ceds:NI002068181474
  a owl:NamedIndividual, ceds:C002068, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """This status is assigned when the student is not enrolled, and their
			whereabouts cannot be determined. The designated reporting deadline, as defined by
			local, state, or federal authorities for identifying dropout status, has been reached.
			This student is reported as a dropout.""" ;
  dc11:identifier "NI002068181474"^^xsd:token ;
  rdfs:label "Reported Dropout" ;
  skos:definition """This status is assigned when the student is not enrolled, and their
			whereabouts cannot be determined. The designated reporting deadline, as defined by
			local, state, or federal authorities for identifying dropout status, has been reached.
			This student is reported as a dropout.""" ;
  skos:inScheme ceds:C002068 ;
  skos:notation "Reported" ;
  skos:prefLabel "Reported Dropout" .

