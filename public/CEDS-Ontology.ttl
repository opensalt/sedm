  schema:domainIncludes ceds:C200287 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "NumberOfHouseholdCollegeStudents" ;
  dc11:description "Number of people, including the student, who will attend at least half-time in the current academic year, a program that leads to a college degree or certificate" ;
  rdfs:comment "This information is collected on the FAFSA" ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid915 ) .

