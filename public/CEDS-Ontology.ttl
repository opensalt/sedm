ceds:NI001517163966
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Commercial Graphic Design courses teach students to use artistic techniques
			to effectively communicate ideas and information to business and customer audiences via
			illustration and other forms of digital or printed media. Topics covered may include
			concept design, layout, paste-up and techniques such as engraving, etching, silkscreen,
			lithography, offset, drawing and cartooning, painting, collage and computer graphics.""" ;
  dc11:identifier "NI001517163966"^^xsd:token ;
