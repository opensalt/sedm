			within the classroom.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05117" ;
  skos:prefLabel "Music History" .

ceds:NI001517163622
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Music Appreciation courses provide students with an understanding of music
			and its importance in their lives. Course content focuses on how various styles of music
			apply musical elements to create an expressive or aesthetic impact. Students also have
			the ability for informal music performance and creation within the classroom.""" ;
