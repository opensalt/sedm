  rdfs:label "Has Adjusted Capacity Reason Type" ;
  schema:domainIncludes ceds:C200249 ;
  schema:rangeIncludes ceds:C002000 ;
  skos:notation "hasAdjustedCapacityReasonType" ;
  dc11:description "Identifies the reason for adjusted capacity in a program. " ;
