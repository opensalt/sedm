  rdfs:comment "Used to represent a point-in-time transaction or snapshot of an account/fund balance. Use “Financial Accounting Period Budgeted Value”, “Financial Accounting Period Actual Value”, and “Financial Accounting Period Encumbered Value” for values representing a period (with begin and end dates)." ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:editHistory ( _:genid795 ) .

