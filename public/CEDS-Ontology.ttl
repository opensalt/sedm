ceds:P000147
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000147"^^xsd:token ;
  rdfs:label "Has Homeless Serviced Indicator" ;
  schema:domainIncludes ceds:C200407 ;
  schema:rangeIncludes ceds:C000147 ;
  skos:notation "hasHomelessServicedIndicator" ;
  dc11:description "An indication of whether homeless children and youth were served by a McKinney-Vento program  in the state." .

ceds:P000148
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000148"^^xsd:token ;
  rdfs:label "Has Homeless Unaccompanied Youth Status" ;
  schema:domainIncludes ceds:C200309 ;
  schema:rangeIncludes ceds:C000148 ;
  skos:notation "hasHomelessUnaccompaniedYouthStatus" ;
  dc11:description "A homeless unaccompanied youth is a youth who is not in the physical custody of a parent or guardian and who fits the McKinney-Vento definition of homeless.  Students must be both unaccompanied and homeless to be included as unaccompanied homeless youth. There is no age range specified for an unaccompanied youth in the law. The upper age range is determined by what a state defines as school age, unless the child is in special education. The upper age range for students in special education may extend to 22 years of age. There is no lower age range. Therefore, as an example, a young child not in the physical custody of a parent or guardian, though living with a caregiver, and is living in a situation that is not fixed, regular, and adequate, would be identified as a homeless unaccompanied youth." ;
  rdfs:comment "Homelessness Status and Primary Nighttime Residence should be known in order to collect this additional information." ;
  ceds:editHistory ( _:genid1769 ) .

ceds:P001733
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001733"^^xsd:token ;
  rdfs:label "Has IDEA Disability Type" ;
  schema:domainIncludes ceds:C200285 ;
  schema:rangeIncludes ceds:C001733 ;
  skos:notation "hasIDEADisabilityType" ;
  dc11:description "A category of disability that describes a person’s impairment defined by the Individuals with Disabilities Education Act." ;
  rdfs:comment "Option set based on IDEA disability categories. Multiple disability condition could be selected. Refer to Primary Disability Type for a single disability condition based on EDFacts." ;
  ceds:editHistory ( _:genid1771 ) .

ceds:P000556
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
