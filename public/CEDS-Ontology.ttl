  skos:prefLabel "Principles of Marketing" .

ceds:NI001517164008
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Marketing —Commodities courses investigate the meaning and methods of
			marketing as related to agricultural commodities, products and services, and
			agricultural goods in domestic and international markets. Topics typically include
			appropriate market research; benefit/cost analysis of marketing; and methods of targeted
			agricultural marketing in domestic and international markets.""" ;
  dc11:identifier "NI001517164008"^^xsd:token ;
  rdfs:label "Marketing —Commodities" ;
  skos:definition """Marketing —Commodities courses investigate the meaning and methods of
