ceds:NI001517163225
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Writing (grade 4) courses focus on writing skills and may emphasize
			independent writing in a variety of assignments and require students to respond to
			different materials in different ways. Grammar and usage of the English language may
			also be emphasized. Specific content depends upon state standards for grade 4.""" ;
  dc11:identifier "NI001517163225"^^xsd:token ;
