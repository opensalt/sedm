  dc11:creator "Common Education Data Standards" ;
  dc11:description """Programs that offer family planning services including pregnancy counseling,
			birth control, and pregnancy testing which are especially designed to meet the needs and
			concerns of teenage students who are pregnant or are concerned about becoming pregnant
			or impregnating.""" ;
  dc11:identifier "NI000273172821"^^xsd:token ;
  rdfs:label "Teen/adolescent family planning" ;
