ceds:NI001517163019
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Language A: Language and Literature—Korean courses prepare students to
			take the International Baccalaureate Language A: Language and Literature exams. Course
			content includes in-depth study of various text types and literary forms, composition
			for purpose and audience, and the context and elements of literature. The course
			includes oral and written assignments and is designed for students highly competent in
			using Korean in an academic context.""" ;
  dc11:identifier "NI001517163019"^^xsd:token ;
  rdfs:label "IB Language A: Language and Literature—Korean" ;
  skos:definition """IB Language A: Language and Literature—Korean courses prepare students to
			take the International Baccalaureate Language A: Language and Literature exams. Course
			content includes in-depth study of various text types and literary forms, composition
			for purpose and audience, and the context and elements of literature. The course
			includes oral and written assignments and is designed for students highly competent in
			using Korean in an academic context.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24517" ;
  skos:prefLabel "IB Language A: Language and Literature—Korean" .

