ceds:P001975
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001975"^^xsd:token ;
  rdfs:label "Internet Upload Speed" ;
  schema:domainIncludes ceds:C200284 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "InternetUploadSpeed" ;
  dc11:description "The speed that data or information can be sent from one's device to another device or server on the internet in megabits per second." ;
  rdfs:comment "This information is collected via an internet speed test. In 2021, the FCC minimum broadband threshold is 3 Mbps. Display Example: 3.0" ;
  ceds:textFormat "Numeric" ;
  ceds:editHistory ( _:genid903 ) .

ceds:P001976
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001976"^^xsd:token ;
  rdfs:label "Internet Download Speed" ;
  schema:domainIncludes ceds:C200284 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "InternetDownloadSpeed" ;
  dc11:description "The speed that data or information can be downloaded from a server on the internet to one's device in megabits per second." ;
  rdfs:comment "This information is collected via an internet speed test. In 2021, the FCC minimum broadband threshold is 25 Mbps. Display Example: 25.0" ;
  ceds:textFormat "Numeric" ;
  ceds:editHistory ( _:genid905 ) .

ceds:P001977
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001977"^^xsd:token ;
  rdfs:label "Internet Speed Test Date Time" ;
  schema:domainIncludes ceds:C200284 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "InternetSpeedTestDateTime" ;
  dc11:description "The date and, optionally, time that the information was gathered." ;
  rdfs:comment "This information is collected and stored as part of each speed test. Display Example: 2021-09-20T10:30:00" ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" ;
  ceds:editHistory ( _:genid907 ) .

ceds:P000330
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000330"^^xsd:token ;
  rdfs:label "Number of People in Family" ;
  schema:domainIncludes ceds:C200287 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "NumberOfPeopleInFamily" ;
  dc11:description """Total number of persons in immediate family. Family means for the purposes of the regulations in this part all persons: (i) Living in the same household who are: (A) Supported by the income of the parent(s) or guardian(s) of the child enrolling or participating in the program; or (B) Related to the child by blood, marriage, or adoption; or 
(ii) Related to the child enrolling or participating in the program as parents or siblings, by blood, marriage, or adoption.""" ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000331
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000331"^^xsd:token ;
  rdfs:label "Number of People in Household" ;
  schema:domainIncludes ceds:C200287 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "NumberOfPeopleInHousehold" ;
  dc11:description "Total number of persons residing in the same household." ;
  rdfs:comment "For FAFSA, this includes the number of family members that are in the household, including the student, their spouse, children, and any other persons living in the household to whom they will provide more than half of their support" ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid909 ) .

ceds:P000332
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000332"^^xsd:token ;
  rdfs:label "Family Income" ;
  schema:domainIncludes ceds:C200287 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "FamilyIncome" ;
  dc11:description "Total income of family from all sources. Income includes money, wages or salary before deductions; net income from non-farm self-employment; net income from farm self-employment; regular payments from Social Security or railroad retirement; payments from unemployment compensation, strike benefits from union funds, workers’ compensation, veterans benefits (with the exception noted below), public assistance (including Temporary Assistance for Needy Families, Supplemental Security Income, Emergency Assistance money payments, and non-Federally funded General Assistance or General Relief money payments); training stipends; alimony, child support, and military family allotments or other regular support from an absent family member or someone not living in the household; private pensions, government employee pensions (including military retirement pay), and regular insurance or annuity payments; college or university scholarships, grants, fellowships, and assistantships; and dividends, interest, net rental income, net royalties, and periodic receipts from estates or trusts; and net gambling or lottery winnings." ;
  rdfs:comment "Family Income is calculated based on the method specified by “Income Calculation Method.”" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid911 ) .

ceds:P000787
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000787"^^xsd:token ;
  rdfs:label "Family Identifier" ;
  schema:domainIncludes ceds:C200287 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FamilyIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to a family by a school, school system, a state, or other agency or entity." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid913 ) .

ceds:P001982
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001982"^^xsd:token ;
