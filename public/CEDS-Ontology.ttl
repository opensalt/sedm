ceds:NI001517164049
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Appliance Repair courses provide students with the knowledge and experience
			to repair, install, service, and inspect appliances such as stoves, refrigerators,
			washers, dryers, air conditioners, water heaters, and so on. Students gain an
			understanding of the mechanics and working systems of these appliances, the skills to
			read blueprints and specifications, and proficiency in using related tools and products.""" ;
