ceds:NI001517162878
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Language A: Language and Literature—Italian courses prepare students to
			take the International Baccalaureate Language A: Language and Literature exams. Course
			content includes in-depth study of various text types and literary forms, composition
			for purpose and audience, and the context and elements of literature. The course
			includes oral and written assignments and is designed for students highly competent in
			using Italian in an academic context.""" ;
  dc11:identifier "NI001517162878"^^xsd:token ;
  rdfs:label "IB Language A: Language and Literature—Italian" ;
  skos:definition """IB Language A: Language and Literature—Italian courses prepare students to
			take the International Baccalaureate Language A: Language and Literature exams. Course
			content includes in-depth study of various text types and literary forms, composition
			for purpose and audience, and the context and elements of literature. The course
			includes oral and written assignments and is designed for students highly competent in
			using Italian in an academic context.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24167" ;
  skos:prefLabel "IB Language A: Language and Literature—Italian" .

ceds:NI001517162879
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Language Ab Initio—Italian courses prepare students to take the
			International Baccalaureate exam. These courses focus on developing the linguistic
			abilities of students with little or no experience with the language of study. Course
			content includes the study of individuals and society, leisure and work, and urban and
			rural environments. These courses also provide students with the opportunity to practice
			and explore this language.""" ;
  dc11:identifier "NI001517162879"^^xsd:token ;
  rdfs:label "IB Language Ab Initio—Italian" ;
  skos:definition """IB Language Ab Initio—Italian courses prepare students to take the
			International Baccalaureate exam. These courses focus on developing the linguistic
			abilities of students with little or no experience with the language of study. Course
			content includes the study of individuals and society, leisure and work, and urban and
			rural environments. These courses also provide students with the opportunity to practice
			and explore this language.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24168" ;
  skos:prefLabel "IB Language Ab Initio—Italian" .

