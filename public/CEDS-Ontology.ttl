ceds:NI001555164558
  a owl:NamedIndividual, ceds:C001555, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A school organization composed of at least three grades, usually beginning
			with grade 4 through grade 6 or the equivalent and usually ending with grade 8 or grade
			9. Most middle school organizations presume that students finishing middle school will
			go on to secondary school.""" ;
  dc11:identifier "NI001555164558"^^xsd:token ;
  rdfs:label "Middle" ;
  skos:definition """A school organization composed of at least three grades, usually beginning
