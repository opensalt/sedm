  skos:prefLabel "Hair Styling" .

ceds:NI001517164336
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Cosmetology—Non-licensing courses provide students with the knowledge and skills applicable to the care of hair, skin, and nails, but do not necessarily prepare students for the state's Board of Cosmetology examinations. Students gain experience in hair care, facials, and manicures; course topics usually include human anatomy, sanitation and sterilization, and related chemistry and bacteriology. Shop management and state regulations may also be included." ;
  dc11:identifier "NI001517164336"^^xsd:token ;
  rdfs:label "Cosmetology—Non-licensing" ;
  skos:definition "Cosmetology—Non-licensing courses provide students with the knowledge and skills applicable to the care of hair, skin, and nails, but do not necessarily prepare students for the state's Board of Cosmetology examinations. Students gain experience in hair care, facials, and manicures; course topics usually include human anatomy, sanitation and sterilization, and related chemistry and bacteriology. Shop management and state regulations may also be included." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "19104" ;
  skos:prefLabel "Cosmetology—Non-licensing" .

