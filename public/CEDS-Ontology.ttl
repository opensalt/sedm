  ceds:maxLength "128" ;
  ceds:textFormat "Alphanumeric - between 7 and 128 characters" .

ceds:P001567
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001567"^^xsd:token ;
  rdfs:label "Learning Resource Publisher Email" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourcePublisherEmail" ;
  dc11:description "An email address for the publisher of the learning resource." ;
  ceds:minLength "7" ;
  ceds:maxLength "128" ;
  ceds:textFormat "Alphanumeric - between 7 and 128 characters" .

ceds:P001568
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001568"^^xsd:token ;
  rdfs:label "Learning Resource Publisher URL" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
