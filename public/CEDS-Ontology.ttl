ceds:NI001517163034
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Russian for Young Learners (prior-to-secondary) courses provide instruction
			at multiple grade levels in Russian and may apply to a range of consecutive grades.
			These courses prepare students to communicate authentically in Russian by interpreting
			(reading, listening, viewing), exchanging (speaking and listening; reading and writing),
