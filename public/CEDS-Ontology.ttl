ceds:NI000273172826
  a owl:NamedIndividual, ceds:C000273, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Services that include: 1) evaluation and assessment of visual functioning,
			including the diagnosis and appraisal of specific visual disorders, delays, and
			disabilities; 2) referrals for medical or other professional services necessary for the
			habilitation or rehabilitation of visual functioning disorders; and 3) training for
			communication, communication, orientation and mobility, visual, and independent living
			skills, and any additional training necessary to activate visual motor abilities.""" ;
