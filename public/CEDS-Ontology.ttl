ceds:P000128
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000128"^^xsd:token ;
  rdfs:label "Grade Point Average Cumulative" ;
  schema:domainIncludes ceds:C200210, ceds:C200336, ceds:C200338 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "GPACumulative" ;
  dc11:description "A measure of average performance in all courses taken by a person during his or her school career as determined for record-keeping purposes. This is obtained by dividing the total grade points received by the total number of credits attempted. This usually includes grade points received and credits attempted in his or her current school as well as those transferred from schools in which the person was previously enrolled." ;
  rdfs:comment "Related Connection; linked to Grade Point Average Weighted Indicator, High School Percentile, High School Rank, and Size of High School Graduating Class" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 4 digits after decimal place" ;
  ceds:decimalPlaces "4" ;
  ceds:editHistory ( _:genid583 ) .

ceds:P000130
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000130"^^xsd:token ;
  rdfs:label "Grade Points Earned Cumulative" ;
  schema:domainIncludes ceds:C200210 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "GradePointsEarnedCumulative" ;
  dc11:description "The cumulative number of grade points a person earns by successfully completing courses or examinations during his or her enrollment in the current school as well as those transferred from schools in which the person had been previously enrolled." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid585 ) .

ceds:P000226
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
