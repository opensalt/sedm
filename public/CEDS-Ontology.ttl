  a owl:NamedIndividual, ceds:C001122, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Examining text content and structure requires critically evaluating,
			comparing and contrasting, and understanding the effect of features such as irony,
			humor, and organization. Readers are required to stand apart from the text, consider it
