ceds:NI001676127679
  a owl:NamedIndividual, ceds:C001676, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Amounts paid as compensation for services to all employees - faculty, staff,
			part-time, full-time, regular employees, and student employees. This includes regular or
			periodic payment to a person for the regular or periodic performance of work or a
			service and payment to a person for more sporadic performance of work or a service
			(overtime, extra compensation, summer compensation, bonuses, sick or annual leave,
			etc.).""" ;
  dc11:identifier "NI001676127679"^^xsd:token ;
