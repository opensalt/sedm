ceds:NI001517163478
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Comparative Government courses study the basic tenets of government,
			searching for the differences and similarities among several forms of government. These
			courses take a comparative approach to the study of government and politics, focusing on
			how the United States compares with other nations.""" ;
  dc11:identifier "NI001517163478"^^xsd:token ;
