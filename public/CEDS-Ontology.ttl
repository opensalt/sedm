ceds:NI001673127649
  a owl:NamedIndividual, ceds:C001673, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting all amounts received from the federal government through
			a direct appropriation of Congress, except grants and contracts. An example of a federal
			appropriation is a federal land-grant appropriation. Does not include Pell Grants or any
			ARRA revenues.""" ;
  dc11:identifier "NI001673127649"^^xsd:token ;
  rdfs:label "Federal appropriations" ;
  skos:definition """Used for reporting all amounts received from the federal government through
			a direct appropriation of Congress, except grants and contracts. An example of a federal
			appropriation is a federal land-grant appropriation. Does not include Pell Grants or any
			ARRA revenues.""" ;
  skos:inScheme ceds:C001673 ;
  skos:notation "Federalappropriations" ;
  skos:prefLabel "Federal appropriations" .

ceds:NI001673127650
  a owl:NamedIndividual, ceds:C001673, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting all amounts received from a state government through a
			direct appropriation of its legislative body, except for state grants and contracts. An
			example of a state appropriation is an annual state appropriation for operating expenses
			of the institution. (FARM para. 463) Does not include any ARRA revenues.""" ;
  dc11:identifier "NI001673127650"^^xsd:token ;
  rdfs:label "State appropriations" ;
  skos:definition """Used for reporting all amounts received from a state government through a
			direct appropriation of its legislative body, except for state grants and contracts. An
			example of a state appropriation is an annual state appropriation for operating expenses
			of the institution. (FARM para. 463) Does not include any ARRA revenues.""" ;
  skos:inScheme ceds:C001673 ;
  skos:notation "Stateappropriations" ;
  skos:prefLabel "State appropriations" .

ceds:NI001673127651
  a owl:NamedIndividual, ceds:C001673, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting all amounts received from a local government (i.e., city
			and/or county) through a direct appropriation of its legislative body, except for local
			grants and contracts. An example of a local appropriation is an annual local
			appropriation for operating expenses of the institution.""" ;
  dc11:identifier "NI001673127651"^^xsd:token ;
  rdfs:label "Local appropriations" ;
  skos:definition """Used for reporting all amounts received from a local government (i.e., city
			and/or county) through a direct appropriation of its legislative body, except for local
			grants and contracts. An example of a local appropriation is an annual local
			appropriation for operating expenses of the institution.""" ;
  skos:inScheme ceds:C001673 ;
  skos:notation "Localappropriations" ;
  skos:prefLabel "Local appropriations" .

ceds:NI001673127652
  a owl:NamedIndividual, ceds:C001673, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting all revenues from federal agencies that are for specific
			undertakings such as research projects, training projects, and similar activities,
			including contributions from federal agencies. If federal Pell and similar student aid
			grants are treated as agency transactions in your GPFS, they are excluded from this
			amount. If federal Pell and similar student aid grants are treated as student aid
			expenses or as allowances when awarded, they are included from this amount. Does not
			include any ARRA revenues.""" ;
  dc11:identifier "NI001673127652"^^xsd:token ;
  rdfs:label "Federal grants and contracts" ;
  skos:definition """Used for reporting all revenues from federal agencies that are for specific
			undertakings such as research projects, training projects, and similar activities,
			including contributions from federal agencies. If federal Pell and similar student aid
			grants are treated as agency transactions in your GPFS, they are excluded from this
			amount. If federal Pell and similar student aid grants are treated as student aid
			expenses or as allowances when awarded, they are included from this amount. Does not
			include any ARRA revenues.""" ;
  skos:inScheme ceds:C001673 ;
  skos:notation "Federalgrantscontracts" ;
  skos:prefLabel "Federal grants and contracts" .

ceds:NI001673127653
  a owl:NamedIndividual, ceds:C001673, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting all revenues from state government agencies that are for
			specific undertakings such as research projects, training projects, and similar
			activities, including contributions from state agencies. If state grants for student aid
			are treated as agency transactions in your GPFS, they are excluded from this amount. If
			state grants for student aid are treated in your GPFS as student aid expenses or as
			allowances when awarded, include the grant revenue on this line and in Part C. Does not
			include any ARRA revenues.""" ;
  dc11:identifier "NI001673127653"^^xsd:token ;
  rdfs:label "State grants and contracts" ;
  skos:definition """Used for reporting all revenues from state government agencies that are for
			specific undertakings such as research projects, training projects, and similar
			activities, including contributions from state agencies. If state grants for student aid
			are treated as agency transactions in your GPFS, they are excluded from this amount. If
			state grants for student aid are treated in your GPFS as student aid expenses or as
			allowances when awarded, include the grant revenue on this line and in Part C. Does not
			include any ARRA revenues.""" ;
  skos:inScheme ceds:C001673 ;
  skos:notation "Stategrantscontracts" ;
  skos:prefLabel "State grants and contracts" .

