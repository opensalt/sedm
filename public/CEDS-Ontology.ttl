  dc11:description "An indication that the course is approved for determining NCAA eligibility." .

ceds:P000586
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000586"^^xsd:token ;
  rdfs:label "Has Postsecondary Enrollment Action" ;
  schema:domainIncludes ceds:C200210 ;
  schema:rangeIncludes ceds:C000586 ;
  skos:notation "hasPostsecondaryEnrollmentAction" ;
  dc11:description "The action taken with respect to postsecondary enrollment by the student who graduated from the school, LEA or state in the past two years." ;
  ceds:editHistory ( _:genid2101 ) .

ceds:P000096
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000096"^^xsd:token ;
  rdfs:label "Has Postsecondary Enrollment Status" ;
  schema:domainIncludes ceds:C200343, ceds:C200352 ;
  schema:rangeIncludes ceds:C000096 ;
  skos:notation "hasPostsecondaryEnrollmentStatus" ;
  dc11:description "An indication of the student's enrollment status for a particular term as defined by the institution" ;
  rdfs:comment "Either use option 02 or one of the options, 04 or 05, for less than full-time but at least half-time." ;
  ceds:editHistory ( _:genid2103 ) .

ceds:P000095
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000095"^^xsd:token ;
  rdfs:label "Has Postsecondary Enrollment Type" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C000095 ;
  skos:notation "hasPostsecondaryEnrollmentType" ;
  dc11:description "An indicator of the enrollment type associated with the enrollment award level of a person at the beginning of a term." .

ceds:P001617
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001617"^^xsd:token ;
  rdfs:label "Has Postsecondary Exit or Withdrawal Type" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C001617 ;
  skos:notation "hasPostsecondaryExitOrWithdrawalType" ;
  dc11:description " The circumstances under which the student exited from enrollment in a postsecondary institution." .

ceds:P000748
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000748"^^xsd:token ;
  rdfs:label "Has Institutionally Controlled Housing Status" ;
  schema:domainIncludes ceds:C200329 ;
  schema:rangeIncludes ceds:C000748 ;
  skos:notation "hasInstitutionallyControlledHousingStatus" ;
  dc11:description "An indication of whether an institution has any residence hall or housing facility located on- or off-campus that is owned or controlled by an institution and used by the institution in direct support of or in a manner related to, the institution's educational purposes." ;
  rdfs:comment "As defined in IPEDS" .

ceds:P600265
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P600265"^^xsd:token ;
  rdfs:label "Has Postsecondary Price Of Attendance" ;
  schema:domainIncludes ceds:C200329 ;
  schema:rangeIncludes ceds:C200330 ;
  skos:notation "hasPostsecondaryPriceOfAttendance" .

ceds:P001616
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001616"^^xsd:token ;
  rdfs:label "Has Postsecondary Program Level" ;
  schema:domainIncludes ceds:C200331 ;
  schema:rangeIncludes ceds:C001616 ;
  skos:notation "hasPostsecondaryProgramLevel" ;
  dc11:description "The level describing the concentration of study for a postsecondary program." .

ceds:P600108
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P600108"^^xsd:token ;
  rdfs:label "Has Postsecondary Section Location" ;
  schema:domainIncludes ceds:C200332 ;
  schema:rangeIncludes ceds:C200333 ;
  skos:notation "hasPostsecondarySectionLocation" .

ceds:P000734
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000734"^^xsd:token ;
  rdfs:label "Has Faculty Status" ;
  schema:domainIncludes ceds:C200334 ;
  schema:rangeIncludes ceds:C000734 ;
  skos:notation "hasFacultyStatus" ;
  dc11:description "Persons identified by the institution as such and typically those whose initial assignments are made for the purpose of conducting instruction, research or public service as a principal activity (or activities). They may hold academic rank titles of professor, associate professor, assistant professor, instructor, lecturer or the equivalent of any of those academic ranks. Faculty may also include the chancellor/president, provost, vice provosts, deans, directors or the equivalent, as well as associate deans, assistant deans and executive officers of academic departments (chairpersons, heads or the equivalent) if their principal activity is instruction combined with research and/or public service. The designation as \"faculty\" is separate from the activities to which they may be currently assigned. For example, a newly appointed president of an institution may also be appointed as a faculty member. Graduate, instruction, and research assistants are not included in this category." ;
  rdfs:comment "As defined in IPEDS." .

ceds:P000742
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000742"^^xsd:token ;
  rdfs:label "Has Graduate Assistant Status" ;
  schema:domainIncludes ceds:C200334 ;
  schema:rangeIncludes ceds:C000742 ;
  skos:notation "hasGraduateAssistantStatus" ;
  dc11:description "Graduate-level students employed on a part-time basis, not limited to, but often employed for the primary purpose of assisting in classroom or laboratory instruction or in the conduct of research.  Graduate students having titles such as graduate assistant, teaching assistant, teaching associate, teaching fellow, or research assistant typically hold these positions." ;
  rdfs:comment "As defined in IPEDS" .

ceds:P000732
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000732"^^xsd:token ;
  rdfs:label "Has Instructional Staff Status" ;
  schema:domainIncludes ceds:C200334 ;
  schema:rangeIncludes ceds:C000732 ;
  skos:notation "hasInstructionalStaffStatus" ;
  dc11:description "Staff whose primary function/occupational activity is primarily instruction or instruction combined with research and/or public service.  Does not include medical school staff." ;
  rdfs:comment "As defined in IPEDS." .

ceds:P000733
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000733"^^xsd:token ;
  rdfs:label "Has Medical School Staff Status" ;
  schema:domainIncludes ceds:C200334 ;
  schema:rangeIncludes ceds:C000733 ;
  skos:notation "hasMedicalSchoolStaffStatus" ;
  dc11:description "Staff employed by or employees working in the medical school component of a postsecondary institution or in a free standing medical school.  Does not include staff employed by or employees working strictly in a hospital associated with a medical school or those who work in health or allied health schools or departments such as dentistry, veterinary medicine, nursing or dental hygiene." ;
  rdfs:comment "As defined in IPEDS." .

ceds:P000755
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000755"^^xsd:token ;
  rdfs:label "Has Postsecondary Applicant" ;
  schema:domainIncludes ceds:C200338 ;
  schema:rangeIncludes ceds:C000755 ;
  skos:notation "hasPostsecondaryApplicant" ;
  dc11:description "An individual who has fulfilled the institution’s requirements to be considered for admission (including payment or waiving of the application fee, if any) and who has been notified of one of the following actions: admission, nonadmission, placement on waiting list, or application withdrawn (by applicant or institution). Include early decision, early action, and students who began studies during summer in this cohort." ;
  rdfs:comment "CDS definition/instructions; first part matches IPEDS" .

ceds:P000757
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000757"^^xsd:token ;
  rdfs:label "Has Wait Listed Student" ;
  schema:domainIncludes ceds:C200338 ;
  schema:rangeIncludes ceds:C000757 ;
  skos:notation "hasWaitListedStudent" ;
  dc11:description "A person who meets the admission requirements but will only be offered a place in the class if space becomes available." ;
  rdfs:comment "Common Data Set definition" .

ceds:P001984
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001984"^^xsd:token ;
  rdfs:label "Has Children of Fallen Heroes Indicator" ;
  schema:domainIncludes ceds:C200341 ;
  schema:rangeIncludes ceds:C001984 ;
  skos:notation "hasChildrenOfFallenHeroesIndicator" ;
  dc11:description "Pell-eligible students whose parent or guardian was a member of the U.S. armed forces and died as a result of military service performed in Iraq or Afghanistan after the events of 9/11 or a public safety officer and died as a result of active service in the line of duty. At the time of the parent's or guardian's death, the student must be less than 24 years of age or enrolled in college or career school at least part-time." ;
  rdfs:comment "The Children of Fallen heroes Indicator should follow the current legislation definitions and be updated as definitions change" ;
  ceds:editHistory ( _:genid2105 ) .

ceds:P001981
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001981"^^xsd:token ;
  rdfs:label "Has Emancipated Minor" ;
  schema:domainIncludes ceds:C200341 ;
  schema:rangeIncludes ceds:C001981 ;
  skos:notation "hasEmancipatedMinor" ;
  dc11:description "A minor student under the age of 18 who has been granted by legal action to have the power and capacity of an adult." ;
  ceds:editHistory ( _:genid2107 ) .

ceds:P001947
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001947"^^xsd:token ;
  rdfs:label "Has First Generation College Student" ;
  schema:domainIncludes ceds:C200341 ;
  schema:rangeIncludes ceds:C001947 ;
  skos:notation "hasFirstGenerationCollegeStudent" ;
  dc11:description "The term First Generation College Student means an individual both of whose parents did not complete a baccalaureate degree or in the case of any individual who regularly resided with and received support from only one parent, an individual whose only such parent did not complete a baccalaureate degree." ;
  ceds:editHistory ( _:genid2109 ) .

ceds:P000078
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000078"^^xsd:token ;
  rdfs:label "Has Degree or Certificate Seeking Student" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C000078 ;
  skos:notation "hasDegreeOrCertificateSeekingStudent" ;
  dc11:description "Person is enrolled in courses for credit and recognized by the institution as seeking a degree, certificate, or other formal award. High school students also enrolled in postsecondary courses for credit are not considered degree/certificate-seeking." ;
  ceds:editHistory ( _:genid2111 ) .

ceds:P001323
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001323"^^xsd:token ;
  rdfs:label "Has Distance Education Program Enrollment Indicator" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C001323 ;
  skos:notation "hasDistanceEducationProgramEnrollmentIndicator" ;
  dc11:description "An individual's enrollment in a program for which all the required coursework for program completion is able to be completed via distance education courses. Distance education is education that uses one or more technologies to deliver instruction to individuals who are separated from the instructor and to support regular and substantive interaction between the individuals and the instructor synchronously or asynchronously." ;
  rdfs:comment "Element defined in IPEDS" .

ceds:P001324
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001324"^^xsd:token ;
  rdfs:label "Has Doctoral Candidacy Admit Indicator" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C001324 ;
  skos:notation "hasDoctoralCandidacyAdmitIndicator" ;
  dc11:description "The individual's status in being admitted as a doctoral candidate." .

ceds:P000117
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000117"^^xsd:token ;
  rdfs:label "Has First Time Postsecondary Student" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C000117 ;
  skos:notation "hasFirstTimePostsecondaryStudent" ;
  dc11:description "A person who has no prior postsecondary experience  attending any institution for the first time at the undergraduate level since completing high school (or its equivalent). This includes persons enrolled in academic or occupational programs. It also includes persons enrolled in the fall term who attended college for the first time in the prior summer term, and persons who entered with advanced standing (college credits earned before graduation from high school)." .

ceds:P000761
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000761"^^xsd:token ;
  rdfs:label "Has Fraternity Participation Status" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C000761 ;
  skos:notation "hasFraternityParticipationStatus" ;
  dc11:description "Student is in membership of a chiefly social organization of men students at a college or university, usually designated by Greek letters." .

ceds:P001416
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001416"^^xsd:token ;
  rdfs:label "Has Oral Defense Completed Indicator" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C001416 ;
  skos:notation "hasOralDefenseCompletedIndicator" ;
  dc11:description "An indication of the individual's completion of an oral defense. The requirement to conduct an oral defense by doctoral individuals may vary across institutions, programs, or fields of study." .

ceds:P001426
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001426"^^xsd:token ;
  rdfs:label "Has Postsecondary Entering Student Indicator" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C001426 ;
  skos:notation "hasPostsecondaryEnteringStudentIndicator" ;
  dc11:description "The initial enrollment of an individual in credit bearing courses or developmental/remedial courses at an institution after completing high school or a high school equivalency program (e.g. GED, Adult High School Diploma)." ;
  rdfs:comment "An individual can only be an entering student once at an institution at the undergraduate level." .

ceds:P000760
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000760"^^xsd:token ;
  rdfs:label "Has Postsecondary Student Housing On-Campus" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C000760 ;
  skos:notation "hasPostsecondaryStudentHousingOnCampus" ;
  dc11:description "The student resides in a residence hall or housing facility owned or controlled by an institution within the same reasonably contiguous geographic area and used by the institution in direct support of or in a manner related to, the institution's educational purposes." ;
  rdfs:comment "IPEDS Definition" .

ceds:P000762
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000762"^^xsd:token ;
  rdfs:label "Has Sorority Participation Status" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes ceds:C000762 ;
  skos:notation "hasSororityParticipationStatus" ;
  dc11:description "Student is in membership in a chiefly social organization of women students at a college or university, usually designated by Greek letters." ;
  ceds:editHistory ( _:genid2113 ) .

ceds:P000763
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000763"^^xsd:token ;
  rdfs:label "Has Financial Aid Applicant" ;
  schema:domainIncludes ceds:C200344 ;
  schema:rangeIncludes ceds:C000763 ;
  skos:notation "hasFinancialAidApplicant" ;
  dc11:description "Any applicant who submits any one of the institutionally required financial aid applications/forms, such as the  Free Application for Federal Student Aid (FAFSA)." ;
  rdfs:comment "Common Data Set definition.<br/>Element should be used in combination with Financial Aid Applicant Type." .

ceds:P000292
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000292"^^xsd:token ;
  rdfs:label "Has Title IV Participant and Recipient" ;
  schema:domainIncludes ceds:C200344 ;
  schema:rangeIncludes ceds:C000292 ;
  skos:notation "hasTitleIVParticipantAndRecipient" ;
  dc11:description "A person who receives Title IV aid.  Title IV aid includes grant aid, work study aid, and loan aid such as: Federal Pell Grant, Federal Supplemental Educational Opportunity Grant (FSEOG), Teacher Education Assistance for College and Higher Education (TEACH) Grant, Federal Work-Study, Federal Perkins Loan, Subsidized Direct or FFEL Stafford Loan, and Unsubsidized Direct or FFEL Stafford Loan.  Title IV aid specifications are defined by the instructions for the IPEDS Student Financial Aid survey." .

ceds:P000077
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000077"^^xsd:token ;
  rdfs:label "Has Degree Applicability" ;
  schema:domainIncludes ceds:C200346 ;
  schema:rangeIncludes ceds:C000077 ;
  skos:notation "hasDegreeApplicability" ;
  dc11:description "An indication that the course is a part of a degree program. " .

ceds:P600277
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P600277"^^xsd:token ;
  rdfs:label "Has Postsecondary Student Course Section Mark" ;
  schema:domainIncludes ceds:C200346 ;
  schema:rangeIncludes ceds:C200340 ;
  skos:notation "hasPostsecondaryStudentCourseSectionMark" .

ceds:P000571
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000571"^^xsd:token ;
  rdfs:label "Has Pre and Post Test Indicator" ;
  schema:domainIncludes ceds:C200210, ceds:C200213 ;
  schema:rangeIncludes ceds:C000571 ;
  skos:notation "hasPreAndPostTestIndicator" ;
  dc11:description "An indication of whether students took both a pre-test and a post-test to measure academic improvement." .

ceds:P000729
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000729"^^xsd:token ;
  rdfs:label "Has Predominant Calendar System" ;
  schema:domainIncludes ceds:C200110, ceds:C200329 ;
  schema:rangeIncludes ceds:C000729 ;
  skos:notation "hasPredominantCalendarSystem" ;
  dc11:description "The method by which an institution structures most of its courses for the academic year." ;
  rdfs:comment "Definition and code set in IPEDS" ;
  ceds:editHistory ( _:genid2115 ) .

ceds:P000490
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000490"^^xsd:token ;
  rdfs:label "Has Prekindergarten Daily Length" ;
  schema:domainIncludes ceds:C200198 ;
  schema:rangeIncludes ceds:C000490 ;
  skos:notation "hasPrekindergartenDailyLength" ;
  dc11:description "The portion of a day that a pre-kindergarten program is provided to the students it serves." .

ceds:P000216
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000216"^^xsd:token ;
  rdfs:label "Has Prekindergarten Eligibility" ;
  schema:domainIncludes ceds:C200192 ;
  schema:rangeIncludes ceds:C000216 ;
  skos:notation "hasPrekindergartenEligibility" ;
  dc11:description "The groups of students for whom pre-kindergarten programs are available." .

ceds:P000217
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000217"^^xsd:token ;
  rdfs:label "Has Prekindergarten Eligible Ages for Non-IDEA Students" ;
  schema:domainIncludes ceds:C200193 ;
  schema:rangeIncludes ceds:C000217 ;
  skos:notation "hasPrekindergartenEligibleAgesForNonIDEAStudents" ;
  dc11:description "The ages of children not served under IDEA to whom the LEA's pre-kindergarten services are available.  " .

ceds:P000600
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000600"^^xsd:token ;
  rdfs:label "Has Present Attendance Category" ;
  schema:domainIncludes ceds:C200351 ;
  schema:rangeIncludes ceds:C000600 ;
  skos:notation "hasPresentAttendanceCategory" ;
  dc11:description "The category that describes how the student spends his or her time when attending an instructional program approved by the state and/or school." ;
  ceds:editHistory ( _:genid2117 ) .

ceds:P000218
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000218"^^xsd:token ;
  rdfs:label "Has Primary Disability Type" ;
  schema:domainIncludes ceds:C200285 ;
  schema:rangeIncludes ceds:C000218 ;
  skos:notation "hasPrimaryDisabilityType" ;
  dc11:description "The major or overriding disability condition that best describes a person's impairment." ;
  rdfs:comment "Option set based on EDFacts. Only one disability condition would be selected. Refer to IDEA Disability Type for selecting multiple disability category options and any additional IDEA disability categories." ;
  ceds:editHistory (
   _:genid2119
   _:genid2121
 ) .

ceds:P001932
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001932"^^xsd:token ;
  rdfs:label "Has Primary Learning Device Access" ;
  schema:domainIncludes ceds:C200294 ;
  schema:rangeIncludes ceds:C001932 ;
  skos:notation "hasPrimaryLearningDeviceAccess" ;
  dc11:description "An indication of whether the primary learning device is shared or not shared with another individual" ;
  rdfs:comment "When asking for this information on a parent or student survey, the question could be phrased like this: \"Is the student's primary learning device shared with anyone else?\"" ;
  ceds:editHistory ( _:genid2123 ) .

ceds:P001931
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001931"^^xsd:token ;
  rdfs:label "Has Primary Learning Device Away From School" ;
  schema:domainIncludes ceds:C200294 ;
  schema:rangeIncludes ceds:C001931 ;
  skos:notation "hasPrimaryLearningDeviceAwayFromSchool" ;
  dc11:description "The type of device the student uses most often to complete learning activities away from school." ;
  rdfs:comment "When asking for this information on a parent or student survey, the question could be phrased like this: \"What device does the student most often use to complete learning activities away from school?\"" ;
  ceds:editHistory ( _:genid2125 ) .

ceds:P001933
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001933"^^xsd:token ;
  rdfs:label "Has Primary Learning Device Provider" ;
  schema:domainIncludes ceds:C200294 ;
  schema:rangeIncludes ceds:C001933 ;
  skos:notation "hasPrimaryLearningDeviceProvider" ;
  dc11:description "The provider of the primary learning device." ;
  rdfs:comment "When asking for this information on a parent or student survey, the question could be phrased like this: \"Who provided the primary learning device to the student?\"" ;
  ceds:editHistory ( _:genid2127 ) .

ceds:P000807
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000807"^^xsd:token ;
  rdfs:label "Has Professional Association Membership Status" ;
  schema:domainIncludes ceds:C200309 ;
  schema:rangeIncludes ceds:C000807 ;
  skos:notation "hasProfessionalAssociationMembershipStatus" ;
  dc11:description "An indication of whether the person is a member of a professional organization or association." ;
  ceds:editHistory ( _:genid2129 ) .

ceds:P001619
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001619"^^xsd:token ;
  rdfs:label "Has Professional Development Activity State Approved Status" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes ceds:C001619 ;
  skos:notation "hasProfessionalDevelopmentActivityStateApprovedStatus" ;
  dc11:description "An indication of whether a training activity has been approved through a state process." ;
  ceds:editHistory ( _:genid2131 ) .

ceds:P001445
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001445"^^xsd:token ;
  rdfs:label "Has Professional Development Publish Activity Indicator" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes ceds:C001445 ;
  skos:notation "hasProfessionalDevelopmentPublishActivityIndicator" ;
  dc11:description "An indicator of whether the professional development activity should be published." .

ceds:P000811
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000811"^^xsd:token ;
  rdfs:label "Has Professional Development Scholarship Status" ;
  schema:domainIncludes ceds:C200311, ceds:C200369 ;
  schema:rangeIncludes ceds:C000811 ;
  skos:notation "hasProfessionalDevelopmentScholarshipStatus" ;
  dc11:description "An indication of whether a scholarship was received for the person to participate in the professional development." .

ceds:P600118
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P600118"^^xsd:token ;
  rdfs:label "Has Professional Development Session" ;
  schema:domainIncludes ceds:C200311, ceds:C200369 ;
  schema:rangeIncludes ceds:C200313 ;
  skos:notation "hasProfessionalDevelopmentSession" .

ceds:P001433
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001433"^^xsd:token ;
  rdfs:label "Has Professional Development Activity Approved Purpose" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes ceds:C001433 ;
  skos:notation "hasProfessionalDevelopmentActivityApprovedPurpose" ;
  dc11:description "The purposes for which an activity is approved." ;
  ceds:editHistory (
   _:genid2133
   _:genid2135
 ) .

ceds:P001436
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001436"^^xsd:token ;
  rdfs:label "Has Professional Development Activity Credit Type" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes ceds:C001436 ;
  skos:notation "hasProfessionalDevelopmentActivityCreditType" ;
  dc11:description "The type of credit awarded." ;
  ceds:editHistory ( _:genid2137 ) .

ceds:P001439
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001439"^^xsd:token ;
  rdfs:label "Has Professional Development Activity Level" ;
