ceds:NI001517163290
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Analytic Geometry courses include the study of the nature and intersection
			of lines and planes in space, including vectors, the polar coordinate system, equations
			and graphs of conic sections, rotations and transformations, and parametric equations.""" ;
