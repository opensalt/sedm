  ceds:maxInclusive "1" ;
  ceds:textFormat "Numeric - between 0 and 1, up to 2 digits" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory (
   _:genid421
   _:genid423
   _:genid425
 ) .

ceds:P000649
