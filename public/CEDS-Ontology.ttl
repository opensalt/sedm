  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001195
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001195"^^xsd:token ;
  rdfs:label "Assessment Asset Version" ;
  schema:domainIncludes ceds:C200015 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentAssetVersion" ;
  dc11:description "A version number or label defined by the publisher." ;
  rdfs:comment "In some use cases a date, such as Learning Resource Date Created may be used as an alternative to a version number.  Each use case may adopt different rules depending on the application requirements for maintenance of current version only or the multiple objects/records representing the complete version history." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001197
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001197"^^xsd:token ;
  rdfs:label "Assessment Asset Published Date" ;
  schema:domainIncludes ceds:C200015 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AssessmentAssetPublishedDate" ;
