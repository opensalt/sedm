ceds:NI001517163378
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Chemistry courses involve studying the composition, properties, and
			reactions of substances. These courses typically explore such concepts as the behaviors
			of solids, liquids, and gases; acid/base and oxidation/reduction reactions; and atomic
			structure. Chemical formulas and equations and nuclear reactions are also studied.""" ;
  dc11:identifier "NI001517163378"^^xsd:token ;
  rdfs:label "Chemistry" ;
  skos:definition """Chemistry courses involve studying the composition, properties, and
			reactions of substances. These courses typically explore such concepts as the behaviors
			of solids, liquids, and gases; acid/base and oxidation/reduction reactions; and atomic
			structure. Chemical formulas and equations and nuclear reactions are also studied.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "03101" ;
  skos:prefLabel "Chemistry" .

ceds:NI001517163379
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Usually taken after a comprehensive initial study of chemistry,
			Chemistry—Advanced Studies courses cover chemical properties and interactions in more
			detail. Advanced chemistry topics include organic chemistry, thermodynamics,
			electrochemistry, macromolecules, kinetic theory, and nuclear chemistry.""" ;
  dc11:identifier "NI001517163379"^^xsd:token ;
