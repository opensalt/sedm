ceds:NI001517163828
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Database Management and Data Warehousing courses provide students with the
			skills necessary to design databases to meet user needs. Courses typically address how
			to enter, retrieve, and manipulate data into useful information. More advanced topics
			may cover implementing interactive applications for common transactions and the utility
			of mining data.""" ;
  dc11:identifier "NI001517163828"^^xsd:token ;
  rdfs:label "Database Management and Data Warehousing" ;
  skos:definition """Database Management and Data Warehousing courses provide students with the
			skills necessary to design databases to meet user needs. Courses typically address how
			to enter, retrieve, and manipulate data into useful information. More advanced topics
			may cover implementing interactive applications for common transactions and the utility
			of mining data.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "10052" ;
  skos:prefLabel "Database Management and Data Warehousing" .

ceds:NI001517163829
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Database Application courses provide students with an understanding of
			database development, modeling, design, and normalization. These courses typically cover
			such topics as SELECT statements, data definition, manipulation, control languages,
			records, and tables. In these courses, students may use Oracle WebDB, SQL, PL/SQL, SPSS,
			and SAS and may prepare for certification.""" ;
  dc11:identifier "NI001517163829"^^xsd:token ;
  rdfs:label "Database Applications" ;
  skos:definition """Database Application courses provide students with an understanding of
			database development, modeling, design, and normalization. These courses typically cover
			such topics as SELECT statements, data definition, manipulation, control languages,
			records, and tables. In these courses, students may use Oracle WebDB, SQL, PL/SQL, SPSS,
			and SAS and may prepare for certification.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "10053" ;
  skos:prefLabel "Database Applications" .

ceds:NI001517163830
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Data Systems/Processing courses introduce students to the uses and operation
			of computer hardware and software and to the programming languages used in business
			applications. Students typically use BASIC, COBOL, and/or RPL languages as they write
			flowcharts or computer programs and may also learn data-processing skills.""" ;
  dc11:identifier "NI001517163830"^^xsd:token ;
  rdfs:label "Data Systems/Processing" ;
  skos:definition """Data Systems/Processing courses introduce students to the uses and
			operation of computer hardware and software and to the programming languages used in
			business applications. Students typically use BASIC, COBOL, and/or RPL languages as they
			write flowcharts or computer programs and may also learn data-processing skills.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "10054" ;
  skos:prefLabel "Data Systems/Processing" .

