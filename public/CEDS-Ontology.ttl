ceds:NI001517163490
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Anthropology courses introduce students to the study of human evolution with
			regard to the origin, distribution, physical attributes, environment, and culture of
			human beings. These courses provide an overview of anthropology, including but not
			limited to both physical and cultural anthropology.""" ;
  dc11:identifier "NI001517163490"^^xsd:token ;
  rdfs:label "Anthropology" ;
  skos:definition """Anthropology courses introduce students to the study of human evolution
			with regard to the origin, distribution, physical attributes, environment, and culture
			of human beings. These courses provide an overview of anthropology, including but not
			limited to both physical and cultural anthropology.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "04251" ;
  skos:prefLabel "Anthropology" .

ceds:NI001517163491
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """These courses examine a particular topic in anthropology, such as physical
