ceds:P000775
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000775"^^xsd:token ;
  rdfs:label "Has Low-income Status" ;
  schema:domainIncludes ceds:C200309 ;
  schema:rangeIncludes ceds:C000775 ;
  skos:notation "hasLowIncomeStatus" ;
  dc11:description "A person who receives or is a member of a family who receives a total family income in the 6 months prior to enrollment of 70 percent of the income standard for a family of that size or that does not exceed the poverty line, or the person is receiving or is a member of a family who is receiving cash assistance payments from Federal, State, or local agencies or food stamps, or the person can be designated as homeless under the McKinney Act." ;
  ceds:editHistory ( _:genid1971 ) .

ceds:P000181
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000181"^^xsd:token ;
  rdfs:label "Has Magnet or Special Program Emphasis School" ;
  schema:domainIncludes ceds:C200203 ;
  schema:rangeIncludes ceds:C000181 ;
  skos:notation "hasMagnetOrSpecialProgramEmphasisSchool" ;
  dc11:description "A school that has been designed: 1) to attract students of different racial/ethnic backgrounds for the purpose of reducing, preventing, or eliminating racial isolation; and/or 2)to provide an academic or social focus on a particular theme (e.g., science/math, performing arts, gifted/talented, career academy or foreign language)." ;
  ceds:editHistory ( _:genid1973 ) .

