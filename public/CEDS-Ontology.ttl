ceds:NI001517163871
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Computer Technology courses introduce students to the features, functions,
			and design of computer hardware and provide instruction in the maintenance and repair of
			computer components and peripheral devices.""" ;
  dc11:identifier "NI001517163871"^^xsd:token ;
  rdfs:label "Computer Technology" ;
  skos:definition """Computer Technology courses introduce students to the features, functions,
			and design of computer hardware and provide instruction in the maintenance and repair of
			computer components and peripheral devices.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "10251" ;
  skos:prefLabel "Computer Technology" .

ceds:NI001517163872
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Computer Maintenance courses prepare students to apply basic electronic
			theory and principles in diagnosing and repairing personal computers and input/output
			devices. Topics may include operating, installing, maintaining, and repairing computers,
			network systems, digital control instruments, programmable controllers, and processors.""" ;
  dc11:identifier "NI001517163872"^^xsd:token ;
  rdfs:label "Computer Maintenance" ;
  skos:definition """Computer Maintenance courses prepare students to apply basic electronic
			theory and principles in diagnosing and repairing personal computers and input/output
			devices. Topics may include operating, installing, maintaining, and repairing computers,
			network systems, digital control instruments, programmable controllers, and processors.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "10252" ;
  skos:prefLabel "Computer Maintenance" .

ceds:NI001517163873
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """C++ Programming courses provide an opportunity for students to gain
			expertise in computer programs using the C++ language. As with more general computer
			programming courses, the emphasis is on how to write logically structured programs,
			include appropriate documentation, and use problem-solving techniques. More advanced
			topics may include multi-dimensional arrays, functions, sorting, loops, and records.""" ;
  dc11:identifier "NI001517163873"^^xsd:token ;
  rdfs:label "C++ Programming" ;
  skos:definition """C++ Programming courses provide an opportunity for students to gain
			expertise in computer programs using the C++ language. As with more general computer
			programming courses, the emphasis is on how to write logically structured programs,
			include appropriate documentation, and use problem-solving techniques. More advanced
			topics may include multi-dimensional arrays, functions, sorting, loops, and records.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "10154" ;
