ceds:NI000390104761
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "An assessment item type that asks examinees to prepare and deliver an organized, cohesive response to an item prompt. The essay item is one type of extended constructed response. Others include the development and sequencing of mathematical proofs, extended analytical papers, and research papers." ;
  dc11:identifier "NI000390104761"^^xsd:token ;
  rdfs:label "Extended Response (Essay)" ;
  skos:definition "An assessment item type that asks examinees to prepare and deliver an organized, cohesive response to an item prompt. The essay item is one type of extended constructed response. Others include the development and sequencing of mathematical proofs, extended analytical papers, and research papers." ;
  skos:inScheme ceds:C000390 ;
  skos:notation "ExtendedResponse" ;
  skos:prefLabel "Extended Response (Essay)" .

ceds:NI000390104762
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "An interactive assessment item delivered in an online or computerized testing environment such that the manipulation of the stem, options, or other facet of the item by the examinees becomes part of the item prompt or part of the item response. Scalise and Gifford (2006**) present a taxonomy of 28 innovative item types that include: Drag and Drop, Reordering, and other experiential items." ;
  dc11:identifier "NI000390104762"^^xsd:token ;
  rdfs:label "Technology Enhanced / Interactive" ;
  skos:definition "An interactive assessment item delivered in an online or computerized testing environment such that the manipulation of the stem, options, or other facet of the item by the examinees becomes part of the item prompt or part of the item response. Scalise and Gifford (2006**) present a taxonomy of 28 innovative item types that include: Drag and Drop, Reordering, and other experiential items." ;
  skos:inScheme ceds:C000390 ;
  skos:notation "TechnologyEnhancedInteractive" ;
  skos:prefLabel "Technology Enhanced / Interactive" .

