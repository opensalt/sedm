  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid67 ) .

ceds:P000961
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000961"^^xsd:token ;
