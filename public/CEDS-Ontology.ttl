ceds:NI001517163333
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Energy and the Environment courses expose students to the scientific principles associated with energy transformation, collection, extraction, transmission and storage. Course content may emphasize energy's significance in society and the effects of its use on the environment. Topics may include the distribution, availability, patterns of use, and environmental impacts of energy resources." ;
