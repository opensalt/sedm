ceds:NI000390101924
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "An assessment item that asks examinees to show preparatory work for the creation of a product, performance, or extended text. The item may be treated as one component of a task leading to a final product or may be stand-alone, as evidence of preliminary thinking and problem-solving." ;
  dc11:identifier "NI000390101924"^^xsd:token ;
  rdfs:label "Show your work" ;
  skos:definition "An assessment item that asks examinees to show preparatory work for the creation of a product, performance, or extended text. The item may be treated as one component of a task leading to a final product or may be stand-alone, as evidence of preliminary thinking and problem-solving." ;
  skos:inScheme ceds:C000390 ;
  skos:notation "ShowYourWork" ;
  skos:prefLabel "Show your work" .

ceds:NI000390101925
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Any assessment item that asks the examinee to develop answers without
			suggested answer choices and that does not fit the definition of the other assessment
			item types.""" ;
  dc11:identifier "NI000390101925"^^xsd:token ;
  rdfs:label "Other constructed response" ;
  skos:definition """Any assessment item that asks the examinee to develop answers without
			suggested answer choices and that does not fit the definition of the other assessment
			item types.""" ;
  skos:inScheme ceds:C000390 ;
  skos:notation "OtherConstructedResponse" ;
  skos:prefLabel "Other constructed response" .

ceds:NI000390101926
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "An item or set of items that directs examinees to demonstrate what they know and can do via a performance, given a set of conditions and expectations for the task(s). The range of possible performances is long, and may include oral, written, procedural, artistic, and/or psychomotor performances such as conducting science experiments, developing informational materials, or participating in a recital, to name a few. An extended constructed response or essay item is a specific instance of a performance task." ;
  dc11:identifier "NI000390101926"^^xsd:token ;
  rdfs:label "Performance task" ;
  skos:definition "An item or set of items that directs examinees to demonstrate what they know and can do via a performance, given a set of conditions and expectations for the task(s). The range of possible performances is long, and may include oral, written, procedural, artistic, and/or psychomotor performances such as conducting science experiments, developing informational materials, or participating in a recital, to name a few. An extended constructed response or essay item is a specific instance of a performance task." ;
  skos:inScheme ceds:C000390 ;
  skos:notation "PerformanceTask" ;
  skos:prefLabel "Performance task" .

ceds:NI000390101929
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """An assessment item that asks examinees to reorder items, such as pictures of
			events within a chronological sequence, items forming a pattern, or text within a
			passage.""" ;
  dc11:identifier "NI000390101929"^^xsd:token ;
  rdfs:label "Reordering" ;
  skos:definition """An assessment item that asks examinees to reorder items, such as pictures
			of events within a chronological sequence, items forming a pattern, or text within a
			passage.""" ;
  skos:inScheme ceds:C000390 ;
  skos:notation "Reordering" ;
  skos:prefLabel "Reordering" .

