ceds:NI001517164111
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Public Safety Telecommunications courses provide students with the skills
			and knowledge necessary to obtain national certification in Public Safety
			Telecommunications and/or employment as a 911 telecommunicator. Course content may
			include, but is not limited to, understanding standard federal, state, and local
			telecommunication operating procedures; functions, terminology, and types of
			telecommunication equipment; malfunctions and maintenance agreements; proper and correct
			telephone and dispatching procedures and techniques; emergency situations and operating
			procedures; and emergency medical dispatch procedures.""" ;
  dc11:identifier "NI001517164111"^^xsd:token ;
  rdfs:label "Public Safety Telecommunications" ;
  skos:definition """Public Safety Telecommunications courses provide students with the skills
			and knowledge necessary to obtain national certification in Public Safety
			Telecommunications and/or employment as a 911 telecommunicator. Course content may
			include, but is not limited to, understanding standard federal, state, and local
			telecommunication operating procedures; functions, terminology, and types of
			telecommunication equipment; malfunctions and maintenance agreements; proper and correct
