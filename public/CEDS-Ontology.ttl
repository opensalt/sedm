ceds:NI001517163037
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Russian Literature courses prepare students to communicate authentically in
			Russian by interpreting (reading, listening, viewing), exchanging (speaking and
