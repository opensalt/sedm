ceds:NI001492116481
  a owl:NamedIndividual, ceds:C001492, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Paraprofessionals are employees who provide instructional support, including
			those who: (1) provide one-on-one tutoring if such tutoring is scheduled at a time when
			a student would not otherwise receive instruction from a teacher, (2) assist with
			classroom management, such as organizing instructional and other materials, (3) provide
			instructional assistance in a computer laboratory, (4) conduct parental involvement
			activities, (5) provide support in a library or media center, (6) act as a translator,
			or (7) provide instructional support services under the direct supervision of a teacher.""" ;
  dc11:identifier "NI001492116481"^^xsd:token ;
  rdfs:label "Paraprofessionals" ;
  skos:definition """Paraprofessionals are employees who provide instructional support,
			including those who: (1) provide one-on-one tutoring if such tutoring is scheduled at a
			time when a student would not otherwise receive instruction from a teacher, (2) assist
			with classroom management, such as organizing instructional and other materials, (3)
			provide instructional assistance in a computer laboratory, (4) conduct parental
			involvement activities, (5) provide support in a library or media center, (6) act as a
			translator, or (7) provide instructional support services under the direct supervision
			of a teacher.""" ;
  skos:inScheme ceds:C001492 ;
  skos:notation "Paraprofessionals" ;
  skos:prefLabel "Paraprofessionals" .

