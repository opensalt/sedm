  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes ceds:C000954 ;
  skos:notation "hasAssessmentItemResponseScaffoldingItemFlag" ;
  dc11:description "Indicates that the response is to a scaffolding problem rather than the main/assigned problem.  A scaffolding item is a follow-up formative assessment item used to assess prerequisite or component skills, presented immediately after a learner gives an incorrect answer on the previous item." .

ceds:P600131
