  ceds:textFormat "Integer" .

ceds:P001788
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001788"^^xsd:token ;
  rdfs:label "Building Year Built" ;
  schema:domainIncludes ceds:C200123 ;
  schema:rangeIncludes xsd:gYear ;
  skos:notation "BuildingYearBuilt" ;
  dc11:description "The year a building was constructed, as indicated by cornerstone or official government records." ;
  ceds:textFormat "YYYY" .

ceds:P001789
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001789"^^xsd:token ;
