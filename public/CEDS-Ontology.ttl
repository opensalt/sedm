  dc11:creator "Common Education Data Standards" ;
  dc11:description """Portuguese Conversation and Culture courses provide students with an
			introduction to the Portuguese language and the culture(s) of Portuguese-speaking
			people, placing greater emphasis on speaking and listening skills while deemphasizing
			writing and reading the language.""" ;
  dc11:identifier "NI001517162891"^^xsd:token ;
  rdfs:label "Portuguese Conversation and Culture" ;
  skos:definition """Portuguese Conversation and Culture courses provide students with an
			introduction to the Portuguese language and the culture(s) of Portuguese-speaking
			people, placing greater emphasis on speaking and listening skills while deemphasizing
			writing and reading the language.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24209" ;
  skos:prefLabel "Portuguese Conversation and Culture" .

ceds:NI001517162892
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Portuguese Literature courses prepare students to communicate authentically
			in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and
			listening; reading and writing), and presenting (speaking, writing) information,
			opinions, and ideas drawn from literature written in Portuguese. Emphasis is typically
			placed on critical and analytical reading and writing, understanding the integration of
			Portuguese cultures into literature, and exploring interdisciplinary connections.""" ;
  dc11:identifier "NI001517162892"^^xsd:token ;
  rdfs:label "Portuguese Literature" ;
  skos:definition """Portuguese Literature courses prepare students to communicate authentically
			in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and
			listening; reading and writing), and presenting (speaking, writing) information,
			opinions, and ideas drawn from literature written in Portuguese. Emphasis is typically
			placed on critical and analytical reading and writing, understanding the integration of
			Portuguese cultures into literature, and exploring interdisciplinary connections.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24210" ;
  skos:prefLabel "Portuguese Literature" .

