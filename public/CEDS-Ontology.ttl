ceds:NI000273172847
  a owl:NamedIndividual, ceds:C000273, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Services that involve making home visits to evaluate a child's living conditions and patterns of parent-child interaction; preparing a social or emotional developmental assessment of the child within the family context; providing individual and family-group counseling with parents and other family members, and appropriate social skill-building activities with the child and parents; working with those problems in a child's and family's living situation (home, community, and any center where early intervention services are provided) that affect the child's maximum utilization of early intervention services; and identifying, mobilizing, and coordinating community resources and services to enable the child and family to receive maximum benefit from early intervention services." ;
  dc11:identifier "NI000273172847"^^xsd:token ;
  rdfs:label "Social work services" ;
  skos:definition "Services that involve making home visits to evaluate a child's living conditions and patterns of parent-child interaction; preparing a social or emotional developmental assessment of the child within the family context; providing individual and family-group counseling with parents and other family members, and appropriate social skill-building activities with the child and parents; working with those problems in a child's and family's living situation (home, community, and any center where early intervention services are provided) that affect the child's maximum utilization of early intervention services; and identifying, mobilizing, and coordinating community resources and services to enable the child and family to receive maximum benefit from early intervention services." ;
  skos:inScheme ceds:C000273 ;
  skos:notation "00337" ;
  skos:prefLabel "Social work services" .

ceds:NI000273172848
  a owl:NamedIndividual, ceds:C000273, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Programs that investigate reports of child abuse, neglect, and abandonment,
			and provide for the temporary placement of a child who, for his or her own protection,
			has been removed from custody of his or her parent/guardians. Program staff works with
			families that are experiencing the problem of child abuse with the objective of
			facilitating continued family unification or reunification. These programs also provide
			ongoing support services for children in permanent placement.""" ;
  dc11:identifier "NI000273172848"^^xsd:token ;
  rdfs:label "Children's protective services" ;
  skos:definition "Programs that investigate reports of child abuse, neglect, and abandonment, and provide for the temporary placement of a child who, for his or her own protection, has been removed from custody of his or her parent/guardians. Program staff works with families that are experiencing the problem of child abuse with the objective of facilitating continued family unification or reunification. These programs also provide ongoing support services for children in permanent placement." ;
  skos:inScheme ceds:C000273 ;
  skos:notation "00295" ;
  skos:prefLabel "Children's protective services" .

