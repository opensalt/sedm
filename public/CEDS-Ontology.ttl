  skos:notation "GoalMeasurementCriterionSuccessCount" ;
  dc11:description "The number of correct results that will be considered to represent successful achievement of a goal." ;
  ceds:textFormat "Integer" ;
  ceds:editHistory ( _:genid499 ) .

ceds:P001690
