ceds:NI001877129136
  a owl:NamedIndividual, ceds:C001877, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Naturally occurring asbestos (NOA) includes fibrous minerals found in
			certain types of rock formations. NOA can take the form of long, thin, separable fibers.
			Natural weathering or human disturbance can break NOA down to microscopic fibers, easily
			suspended in air. There is no health threat if NOA remains undisturbed and does not
			become airborne.""" ;
  dc11:identifier "NI001877129136"^^xsd:token ;
  rdfs:label "Naturally Occurring Asbestos (NOA)" ;
  skos:definition """Naturally occurring asbestos (NOA) includes fibrous minerals found in
			certain types of rock formations. NOA can take the form of long, thin, separable fibers.
			Natural weathering or human disturbance can break NOA down to microscopic fibers, easily
			suspended in air. There is no health threat if NOA remains undisturbed and does not
			become airborne.""" ;
  skos:inScheme ceds:C001877 ;
  skos:notation "13682" ;
  skos:prefLabel "Naturally Occurring Asbestos (NOA)" .

