ceds:NI001517164438
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Aerospace Technology courses introduce students to the technology systems
			used in the aerospace industry and their interrelationships. Examples of such systems
			include satellite communications systems, composite materials in airframe manufacturing,
			space station constructions techniques, space shuttle propulsion systems, aerostatics,
			and aerodynamics.""" ;
  dc11:identifier "NI001517164438"^^xsd:token ;
  rdfs:label "Aerospace Technology" ;
  skos:definition """Aerospace Technology courses introduce students to the technology systems
			used in the aerospace industry and their interrelationships. Examples of such systems
			include satellite communications systems, composite materials in airframe manufacturing,
			space station constructions techniques, space shuttle propulsion systems, aerostatics,
			and aerodynamics.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "21055" ;
  skos:prefLabel "Aerospace Technology" .

