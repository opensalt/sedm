ceds:NI001555164563
  a owl:NamedIndividual, ceds:C001555, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "An institution of higher education that usually offers the first 2 years of college instruction and frequently grants an associate's degree, but does not grant a bachelor's degree. It is an independently organized institution (public or nonpublic), an institution that is part of a school district, or an independently organized system of junior colleges. Junior colleges offer college transfer courses and programs; vocational, technical, and semiprofessional occupational programs; or general education programs." ;
  dc11:identifier "NI001555164563"^^xsd:token ;
  rdfs:label "Community/Junior College" ;
