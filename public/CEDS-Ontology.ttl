ceds:NI001617106062
  a owl:NamedIndividual, ceds:C001617, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A student enrolled in a postsecondary institution who has withdrawn, dropped
			out, failed to re-enroll or been terminated, expelled or dismissed by the institution is
			considered withdrawn.""" ;
  dc11:identifier "NI001617106062"^^xsd:token ;
  rdfs:label "Withdrawn" ;
  skos:definition """A student enrolled in a postsecondary institution who has withdrawn,
			dropped out, failed to re-enroll or been terminated, expelled or dismissed by the
			institution is considered withdrawn.""" ;
  skos:inScheme ceds:C001617 ;
  skos:notation "Withdrawn" ;
  skos:prefLabel "Withdrawn" .

ceds:NI001617106063
  a owl:NamedIndividual, ceds:C001617, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A student who was enrolled in an eligible postsecondary institution and
			completed the requirements for graduation or the program of study in which he/she was
			enrolled is considered graduated.""" ;
  dc11:identifier "NI001617106063"^^xsd:token ;
  rdfs:label "Graduated" ;
  skos:definition """A student who was enrolled in an eligible postsecondary institution and
			completed the requirements for graduation or the program of study in which he/she was
			enrolled is considered graduated.""" ;
  skos:inScheme ceds:C001617 ;
  skos:notation "Graduated" ;
  skos:prefLabel "Graduated" .

ceds:NI001617106064
  a owl:NamedIndividual, ceds:C001617, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A student who is enrolled in an eligible postsecondary institution and has
			met the requirements for an approved student loan leave of absence and, therefore, is
			not required to attend classes for a specified period of time. For purposes of Title IV,
			HEA program loan borrower, an institution does not have to treat a leave of absence as a
			withdrawal if it is an approved leave of absence. An approved student loan leave of
			absence must not exceed 180 days in any 12-month-period. The number of days in a leave
			of absence is counted beginning with the first day of the student’s initial leave of
			absence in a 12-month period. If a student does not resume attendance at the institution
			at or before the end of a leave of absence, the institution must treat the student as a
			withdrawal in accordance with CFR 668.22(d).""" ;
  dc11:identifier "NI001617106064"^^xsd:token ;
  rdfs:label "Approved Leave of Absence" ;
  skos:definition """A student who is enrolled in an eligible postsecondary institution and has
			met the requirements for an approved student loan leave of absence and, therefore, is
			not required to attend classes for a specified period of time. For purposes of Title IV,
			HEA program loan borrower, an institution does not have to treat a leave of absence as a
			withdrawal if it is an approved leave of absence. An approved student loan leave of
			absence must not exceed 180 days in any 12-month-period. The number of days in a leave
			of absence is counted beginning with the first day of the student’s initial leave of
			absence in a 12-month period. If a student does not resume attendance at the institution
			at or before the end of a leave of absence, the institution must treat the student as a
			withdrawal in accordance with CFR 668.22(d).""" ;
  skos:inScheme ceds:C001617 ;
  skos:notation "ApprovedLeaveOfAbsence" ;
  skos:prefLabel "Approved Leave of Absence" .

