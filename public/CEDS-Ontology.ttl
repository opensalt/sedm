ceds:NI000599127826
  a owl:NamedIndividual, ceds:C000599, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The student is out of school and involved in a noninstructional activity
			recognized by the school, district, and/or state. Examples include such civic activities
			as involvement with the National Guard, service as a legislative page, jury duty, or
			participation on an election board. Note that "recognized activities" are not
			necessarily considered "excused" absences.""" ;
  dc11:identifier "NI000599127826"^^xsd:token ;
  rdfs:label "Absent - Noninstructional activity recognized by state, district, or school" ;
  skos:definition """The student is out of school and involved in a noninstructional activity
