ceds:P001412
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001412"^^xsd:token ;
  rdfs:label "Has Military Enlistment After Exit" ;
  schema:domainIncludes ceds:C200373 ;
  schema:rangeIncludes ceds:C001412 ;
  skos:notation "hasMilitaryEnlistmentAfterExit" ;
  dc11:description "An individual who is a member of the uniformed armed forces of the United States as reported through FEDES after exiting secondary, postsecondary, or adult education or workforce programs." ;
  rdfs:comment "Information on military enlistment is collected as a part of the FEDES program which facilitates periodic matches with the Department of Defense Manpower Information Center.  While the unemployment insurance data cannot be used to indicate that an individual is not employed, the DOD Enlistment data can suggest \"not enlisted when there is no match.\"  These data are included in FEDES matches and may need to be \"unduplicated\" from employment counts." .

ceds:P000997
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000997"^^xsd:token ;
  rdfs:label "Has Workforce Program Type" ;
  schema:domainIncludes ceds:C200375 ;
  schema:rangeIncludes ceds:C000997 ;
  skos:notation "hasWorkforceProgramType" ;
  dc11:description "The type of workforce and employment development program that an individual is participating in." ;
  rdfs:comment "A reference period for identifying program participation during or after enrollment in secondary education, postsecondary education, or adult education will have to be defined by the agency in collaboration with other agency partners.  At this point this element is intended only to indicate program participation and does not delve into programmatic details, persistence, or completion." ;
  ceds:editHistory (
   _:genid2403
   _:genid2405
 ) .

