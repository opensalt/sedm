ceds:NI001517163542
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Social Studies (grade 4) courses continue to develop skills in history,
			geography, civics and government, and economics. Although the four disciplines are
			typically integrated, these courses may take a more discipline-specific approach, such
			as concentrating on U.S. history, state-specific history, or civic engagement for
			periods of time. Specific content depends upon state standards for grade 4.""" ;
  dc11:identifier "NI001517163542"^^xsd:token ;
  rdfs:label "Social Studies (grade 4)" ;
  skos:definition """Social Studies (grade 4) courses continue to develop skills in history,
			geography, civics and government, and economics. Although the four disciplines are
			typically integrated, these courses may take a more discipline-specific approach, such
			as concentrating on U.S. history, state-specific history, or civic engagement for
			periods of time. Specific content depends upon state standards for grade 4.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "04434" ;
  skos:prefLabel "Social Studies (grade 4)" .

