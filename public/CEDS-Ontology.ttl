ceds:NI001517163178
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Language Arts (grade 1) courses include the four aspects of language use:
			reading, writing, speaking, and listening. These courses may emphasize recognition of
