			also be emphasized. Specific content depends upon state standards for grade 4.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "01134" ;
  skos:prefLabel "Writing (grade 4)" .

ceds:NI001517163226
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Writing (grade 5) courses focus on writing skills and may extend students' skills in writing for particular purposes or audiences, distinguishing meaning and literary functions in texts, and fluency in writing. Specific content depends upon state standards for grade 5." ;
