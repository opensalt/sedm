ceds:NI001876129113
  a owl:NamedIndividual, ceds:C001876, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A plan that addresses the maintenance in which a critical system, component,
			equipment, or furnishing breaks down and must be repaired to secure the safety of
			students, staff, or visitors and/or for operation of the program or service to continue.
			Unexpected events beyond normal wear and tear may mandate overtime, as situations may
			have to be dealt with immediately.""" ;
  dc11:identifier "NI001876129113"^^xsd:token ;
  rdfs:label "Emergency maintenance repair" ;
