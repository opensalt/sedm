  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Integrated Pest Management courses help students develop an understanding of
			the life cycles of and damage caused by pests, diseases, and weeds. Course topics may
			include the application of pesticides and/or herbicides to manage pest populations and
			assessing the effectiveness of pest management plans.""" ;
