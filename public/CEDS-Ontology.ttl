ceds:NI001517163007
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Miscellaneous—Aide courses offer students the opportunity to assist
			instructors in preparing, organizing, or delivering course curricula or to assist other
			staff members in fulfilling their duties. Students may provide tutorial or instructional
			assistance to other students. Note: if the particular subject area is known, use the
