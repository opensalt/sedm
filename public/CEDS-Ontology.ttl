ceds:NI001517163781
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Physical Education (grade 1) courses typically emphasize knowledge and
			skills that lead to health, enjoyment, and social development through physical activity.
			Course content may include activities that strengthen gross and fine motor skills, body
			awareness, safety, and the relationship between physical activity and health. Specific
			content depends upon state standards for grade 1.""" ;
