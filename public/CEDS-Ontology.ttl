  skos:prefLabel "School Orientation" .

ceds:NI001517164475
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """School Governance courses convene students as an entire student body to
			discuss common concerns, organize groups for action, make decisions, and solve
