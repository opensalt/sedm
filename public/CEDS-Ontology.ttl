  schema:domainIncludes ceds:C200144, ceds:C200145 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FinancialAidYearDesignator" ;
  dc11:description "The school year for which the student's financial aid application and award data apply.  Generally, this is the 12-month period from July 1 to June 30." ;
  ceds:minLength "9" ;
  ceds:maxLength "9" ;
  ceds:textFormat "YYYY-YYYY" .

ceds:P000112
