ceds:NI001088104244
  a owl:NamedIndividual, ceds:C001088, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """This category relies heavily on the recall and recognition of previously
			learned concepts and principles. Items typically specify what the student is to do,
			which is often to carry out some procedure that can be performed mechanically. It is not
			left to the student to come up with an original method or solution.""" ;
  dc11:identifier "NI001088104244"^^xsd:token ;
  rdfs:label "Low complexity" ;
  skos:definition """This category relies heavily on the recall and recognition of previously
			learned concepts and principles. Items typically specify what the student is to do,
			which is often to carry out some procedure that can be performed mechanically. It is not
			left to the student to come up with an original method or solution.""" ;
  skos:inScheme ceds:C001088 ;
  skos:notation "LowComplexity" ;
  skos:prefLabel "Low complexity" .

ceds:NI001088104245
  a owl:NamedIndividual, ceds:C001088, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Items in the moderate-complexity category involve more flexibility of
			thinking and choice among alternatives than do those in the low-complexity category.
			They require a response that goes beyond the habitual, is not specified, and ordinarily
			has more than a single step. The student is expected to decide what to do, using
			informal methods of reasoning and problem-solving strategies, and to bring together
			skill and knowledge from various domains.""" ;
  dc11:identifier "NI001088104245"^^xsd:token ;
  rdfs:label "Moderate complexity" ;
  skos:definition """Items in the moderate-complexity category involve more flexibility of
			thinking and choice among alternatives than do those in the low-complexity category.
			They require a response that goes beyond the habitual, is not specified, and ordinarily
			has more than a single step. The student is expected to decide what to do, using
			informal methods of reasoning and problem-solving strategies, and to bring together
			skill and knowledge from various domains.""" ;
  skos:inScheme ceds:C001088 ;
  skos:notation "ModerateComplexity" ;
  skos:prefLabel "Moderate complexity" .

ceds:NI001088104246
  a owl:NamedIndividual, ceds:C001088, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """High-complexity items make heavy demands on students, who must engage in
			more abstract reasoning, planning, analysis, judgment, and creative thought. A
			satisfactory response to the item requires that the student think in an abstract and
			sophisticated way.""" ;
  dc11:identifier "NI001088104246"^^xsd:token ;
  rdfs:label "High complexity" ;
  skos:definition """High-complexity items make heavy demands on students, who must engage in
			more abstract reasoning, planning, analysis, judgment, and creative thought. A
			satisfactory response to the item requires that the student think in an abstract and
			sophisticated way.""" ;
  skos:inScheme ceds:C001088 ;
  skos:notation "HighComplexity" ;
  skos:prefLabel "High complexity" .

