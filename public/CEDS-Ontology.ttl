  a owl:NamedIndividual, ceds:C001122, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """To make reader/text connections, the reader must link information in the
			text with knowledge and experience. This might include applying ideas in the text to the
			real world, and responses must be text based.""" ;
  dc11:identifier "NI001122104351"^^xsd:token ;
  rdfs:label "Making reader/text connections" ;
