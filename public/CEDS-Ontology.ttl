  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002053"^^xsd:token ;
  rdfs:label "Military Deployment Order Description" ;
  schema:domainIncludes ceds:C200298 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MilitaryDeploymentOrderDescription" ;
  dc11:description "A textual description of the person's military deployment order." ;
  rdfs:comment "This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements. " ;
  ceds:textFormat "Alphanumeric - 200 characters maximum" ;
  ceds:editHistory ( _:genid967 ) .

ceds:P002054
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002054"^^xsd:token ;
  rdfs:label "Military Deployment Requested By" ;
  schema:domainIncludes ceds:C200298 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MilitaryDeploymentRequestedBy" ;
  dc11:description "A textual description of an entity that requested the person's military deployment." ;
  rdfs:comment "This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements. " ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" ;
  ceds:editHistory ( _:genid969 ) .

ceds:P002055
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002055"^^xsd:token ;
  rdfs:label "Military Deployment Activity Code" ;
  schema:domainIncludes ceds:C200298 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MilitaryDeploymentActivityCode" ;
  dc11:description "The codes of any activities performed by the person while deployed in the military." ;
  rdfs:comment "This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements. " ;
  ceds:textFormat "Alphanumeric - 200 characters maximum" ;
  ceds:editHistory ( _:genid971 ) .

ceds:P002056
  a rdf:Property ;
