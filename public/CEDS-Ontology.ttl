  rdfs:label "Has ISO 639-2 Language Code" ;
  schema:domainIncludes ceds:C200010, ceds:C200025, ceds:C200042, ceds:C200067, ceds:C200072, ceds:C200228, ceds:C200293 ;
  schema:rangeIncludes ceds:C000317 ;
  skos:notation "hasISO6392LanguageCode" ;
  dc11:description "The code for the specific language or dialect that a person uses to communicate." ;
  rdfs:comment "The CEDS ISO 639-2 Language Code option set comes from the <a href=\"http://www.loc.gov/standards/iso639-2/langhome.html\">ISO 639-2 standard</a>, the character encoding in ISO 8859-1 download.  Discontinued codes from the ISO standard are not included in the CEDS list." ;
  ceds:editHistory (
   _:genid1239
   _:genid1241
 ) .

ceds:P001637
