ceds:NI001517162930
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Language A: Literature—Greek courses prepare students to take the
			International Baccalaureate Language A: Literature exams. Course content includes
			in-depth study of a range of literary texts in a number of literary forms and from
			different times and places, written analyses and critiques of this literature, and other
			oral and written assignments. The course is designed for students highly competent in
			using Greek in an academic context and is intended for students with native or
			near-native fluency in the language.""" ;
  dc11:identifier "NI001517162930"^^xsd:token ;
  rdfs:label "IB Language A: Literature—Greek" ;
  skos:definition """IB Language A: Literature—Greek courses prepare students to take the
			International Baccalaureate Language A: Literature exams. Course content includes
			in-depth study of a range of literary texts in a number of literary forms and from
			different times and places, written analyses and critiques of this literature, and other
			oral and written assignments. The course is designed for students highly competent in
			using Greek in an academic context and is intended for students with native or
			near-native fluency in the language.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24312" ;
  skos:prefLabel "IB Language A: Literature—Greek" .

ceds:NI001517162931
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
