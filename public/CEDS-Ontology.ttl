  schema:rangeIncludes xsd:decimal ;
  skos:notation "NumberOfCreditsEarned" ;
  dc11:description "The number of credits an individual earns by the successful completion of a course." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory (
   _:genid599
   _:genid601
 ) .

ceds:P000616
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000616"^^xsd:token ;
  rdfs:label "Grade Value Qualifier" ;
  schema:domainIncludes ceds:C200213, ceds:C200214 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "GradeValueQualifier" ;
  dc11:description "The scale of equivalents, if applicable, for grades awarded as indicators of performance in schoolwork. For example, numerical equivalents for letter grades used in determining a student's Grade Point Average (A=4, B=3, C=2, D=1 in a four-point system) or letter equivalents for percentage grades (90-100%=A, 80-90%=B, etc.)" ;
  rdfs:comment "A list of \"Academic Grade Qualifiers\" is available from the Association of American Medical Colleges, 2450 N St., N.W., Washington, DC 20037" ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" .

ceds:P000651
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000651"^^xsd:token ;
  rdfs:label "Course Section Exit Withdrawal Date" ;
  schema:domainIncludes ceds:C200213 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CourseSectionExitWithdrawalDate" ;
  dc11:description "The year, month and day of the first day after the date of a person's last enrollment in a course section." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid603
   _:genid605
 ) .

ceds:P000182
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000182"^^xsd:token ;
  rdfs:label "Marking Period Name" ;
  schema:domainIncludes ceds:C200214 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MarkingPeriodName" ;
  dc11:description "The name or description of the marking period (e.g., fall, first marking period)." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid607 ) .

ceds:P000183
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000183"^^xsd:token ;
  rdfs:label "Mid Term Mark" ;
  schema:domainIncludes ceds:C200214 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MidTermMark" ;
  dc11:description "Indicator of student performance at the mid-point of the marking period." ;
  ceds:maxLength "15" ;
  ceds:textFormat "Alphanumeric - 15 characters maximum" .

ceds:P001573
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001573"^^xsd:token ;
  rdfs:label "Student Course Section Grade Narrative" ;
  schema:domainIncludes ceds:C200214, ceds:C200340 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "StudentCourseSectionGradeNarrative" ;
  dc11:description "The narrative of the student performance in a course section as submitted by the instructor." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P000082
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000082"^^xsd:token ;
  rdfs:label "Disciplinary Action End Date" ;
  schema:domainIncludes ceds:C200215 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "DisciplinaryActionEndDate" ;
  dc11:description "The year, month and day on which a discipline action ends." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid609 ) .

ceds:P000083
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000083"^^xsd:token ;
  rdfs:label "Disciplinary Action Start Date" ;
  schema:domainIncludes ceds:C200215 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "DisciplinaryActionStartDate" ;
  dc11:description "The year, month and day on which a discipline action begins." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000511
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000511"^^xsd:token ;
  rdfs:label "Duration of Disciplinary Action" ;
  schema:domainIncludes ceds:C200215 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "DurationOfDisciplinaryAction" ;
  dc11:description "The length, in school days, of the disciplinary action." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000529
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000529"^^xsd:token ;
  rdfs:label "First Entry Date into a US School" ;
  schema:domainIncludes ceds:C200219 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "FirstEntryDateIntoUSSchool" ;
  dc11:description "The year, month and day of a person's initial enrollment into a United States school." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001574
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001574"^^xsd:token ;
  rdfs:label "Credits Required" ;
  schema:domainIncludes ceds:C200220, ceds:C200315 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CreditsRequired" ;
  dc11:description "The total number of credits required for a student to graduate from the school of enrollment or complete a program." ;
  rdfs:comment "May be compared to the sum of Number of Credits Earned for courses associated with the program of study to determine the remaining credits that the student needs to complete the program." ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001989
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001989"^^xsd:token ;
  rdfs:label "Home Language Survey Administration Date" ;
  schema:domainIncludes ceds:C200221 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "HomeLanguageSurveyAdministrationDate" ;
  dc11:description "The year, month, and day on which the Home Language Survey is known to have been administered to the parent or guardian of this student." ;
  rdfs:comment "The actual date of the administration is not what this element is capturing but rather when the result of the home language survey have been received by the school. The survey may have been completed in the school office upon registration of the student or could have been completed at home as part of a set of documents parents or guardians complete when enrolling students. When the completed home language survey has been provided to the school, the date received or the date the information is entered into a student information system as having been completed is sufficient to meet the intent of this element." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid611 ) .

ceds:P000129
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000129"^^xsd:token ;
  rdfs:label "Grade Point Average Given Session" ;
  schema:domainIncludes ceds:C200223 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "GPAGivenSession" ;
  dc11:description "A measure of average performance in all courses taken by a person during a given session. This is obtained by dividing the total grade points received by the number of credits attempted for the same session." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 4 digits after decimal place" ;
  ceds:decimalPlaces "4" ;
  ceds:editHistory ( _:genid613 ) .

ceds:P000935
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000935"^^xsd:token ;
  rdfs:label "Learner Action Value" ;
  schema:domainIncludes ceds:C200225 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActionValue" ;
  dc11:description "The value representing input by the learner using an online system, such as a value entered in response to an assessment question, or the URL of a learning resource link clicked." ;
  ceds:textFormat "Alphanumeric" .

ceds:P000937
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000937"^^xsd:token ;
  rdfs:label "Learner Action Date Time" ;
  schema:domainIncludes ceds:C200225 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "LearnerActionDateTime" ;
  dc11:description "The date and time at which the action was taken." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" ;
  ceds:editHistory ( _:genid615 ) .

ceds:P001557
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001557"^^xsd:token ;
  rdfs:label "Learner Action Actor Identifier" ;
  schema:domainIncludes ceds:C200225 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActionActorIdentifier" ;
  dc11:description " A unique identifier for the person performing the learner action.  The identifier should be encrypted when integrating learning experience data across systems to secure the privacy of the learner." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" .

ceds:P001558
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001558"^^xsd:token ;
  rdfs:label "Learner Action Object Description" ;
  schema:domainIncludes ceds:C200225 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActionObjectDescription" ;
  dc11:description "A description of the object upon which the person has performed the Learner Action." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001559
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001559"^^xsd:token ;
  rdfs:label "Learner Action Object Identifier" ;
  schema:domainIncludes ceds:C200225 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActionObjectIdentifier" ;
  dc11:description "A globally unique identifier for the object upon which the learning has performed the Learner Action which may be a URL with information about a learning resource or to launch the resource." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" .

ceds:P001560
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001560"^^xsd:token ;
  rdfs:label "Learner Action Object Type" ;
  schema:domainIncludes ceds:C200225 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActionObjectType" ;
  dc11:description "The type of object upon which a person has performed the Learner Action." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000939
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000939"^^xsd:token ;
  rdfs:label "Learner Activity Title" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActivityTitle" ;
  dc11:description "The title for work assigned to the learner, which can comprise of learning resources, activities, and assessments." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000940
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000940"^^xsd:token ;
  rdfs:label "Learner Activity Description" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActivityDescription" ;
  dc11:description "The description and context for the assignment  described in a way that the learner can understand." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P000941
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000941"^^xsd:token ;
  rdfs:label "Learner Activity Prerequisite" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActivityPrerequisite" ;
  dc11:description "The description of the skills or competencies the student must have to engage in assignment." ;
  rdfs:comment "Note: Prerequisites may also be referenced via an associated Learning Goal and Competency Set (prerequisites for individual competencies).  For some applications enumeration of the detailed prerequisites will have greater utility than a single descriptive field." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P000943
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000943"^^xsd:token ;
  rdfs:label "Learner Activity Creation Date" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "LearnerActivityCreationDate" ;
  dc11:description "The creation date of the assignment." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000944
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000944"^^xsd:token ;
  rdfs:label "Learner Activity Maximum Time Allowed" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "LearnerActivityMaximumTimeAllowed" ;
  dc11:description "The time required to complete the assignment." ;
  rdfs:comment "Time allowed is assumed to be unlimited if zero or omitted." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000946
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000946"^^xsd:token ;
  rdfs:label "Learner Activity Due Date" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "LearnerActivityDueDate" ;
  dc11:description "The date assignment is due." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000947
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000947"^^xsd:token ;
  rdfs:label "Learner Activity Due Time" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "LearnerActivityDueTime" ;
  dc11:description "The time the assignment is due." ;
  ceds:textFormat "HH:MM:SS" .

ceds:P000948
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000948"^^xsd:token ;
  rdfs:label "Learner Activity Maximum Attempts Allowed" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "LearnerActivityMaximumAttemptsAllowed" ;
  dc11:description "The number attempts a student may make on this assignment. Assumed to be unlimited if zero or omitted." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000950
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000950"^^xsd:token ;
  rdfs:label "Learner Activity Release Date" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "LearnerActivityReleaseDate" ;
  dc11:description "The date the student was informed about an assignment or that an automated system displays the assignment." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000951
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000951"^^xsd:token ;
  rdfs:label "Learner Activity Weight" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "LearnerActivityWeight" ;
  dc11:description "The percentage weight of the assignment during the particular course or term." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "100" ;
  ceds:textFormat "Numeric - up to 3 digits before and 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000952
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000952"^^xsd:token ;
  rdfs:label "Learner Activity Possible Points" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "LearnerActivityPossiblePoints" ;
  dc11:description "The number of possible points for an assignment." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000953
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000953"^^xsd:token ;
  rdfs:label "Learner Activity Rubric URL" ;
  schema:domainIncludes ceds:C200226 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearnerActivityRubricURL" ;
  dc11:description "The Uniform Resource Locator pointing to a rubric that may be used to evaluate learner performance on the assignment." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid617 ) .

ceds:P000911
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000911"^^xsd:token ;
  rdfs:label "Learning Resource URL" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceURL" ;
  dc11:description "The Uniform Resource Locator where the resource may be accessed, or a proxy for the resource, such as an information page for a commercially available resource." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid619 ) .

ceds:P000912
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000912"^^xsd:token ;
  rdfs:label "Learning Resource Title" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceTitle" ;
  dc11:description "The title of the resource." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000913
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000913"^^xsd:token ;
  rdfs:label "Learning Resource Subject Name" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceSubjectName" ;
  dc11:description "The descriptive name for the subject of the content for the learning resource." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000914
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000914"^^xsd:token ;
  rdfs:label "Learning Resource Subject Code" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceSubjectCode" ;
  dc11:description "The code used to identify the organization of subject matter and related learning experiences addressed by the learning resource." ;
  rdfs:comment "A promising practice is to use a URL as the Learning Resource Subject Code, that resolves to a web page describing a term in a subject taxonomy.  For example, for \"Mathematics\", the URL http://id.loc.gov/authorities/classification/BH301.M35.html points to the Library of Congress classification for \"Mathematics\".  For K12 curriculum \"SCED\" - School Courses for the Exchange of Data (SCED) may be used, e.g. https://ceds.ed.gov/ScedCourseCodes.aspx#02031 is \"Mathematics (grade 1)\"" ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid621 ) .

ceds:P000915
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000915"^^xsd:token ;
  rdfs:label "Learning Resource Subject Code System" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceSubjectCodeSystem" ;
  dc11:description "The system that is used to identify the organization of subject matter and related learning experiences addressed by the learning resource." ;
  rdfs:comment "This may be a URL to a web page describing the subject code system or a name or abbreviation for the system if no authoritative web page exists.  When the associated learning resource Subject Code is a URL, that URL usually provides enough context so that the \"Subject Code System\" need not be specified.  However, this may be the URL to a page describing the classification system and/or the entry point to the web hosted classification system.  E.g. for the Library of Congress Classification System use: http://id.loc.gov/authorities/classification.html" ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid623 ) .

ceds:P000916
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000916"^^xsd:token ;
  rdfs:label "Learning Resource Date Created" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "LearningResourceDateCreated" ;
  dc11:description "The date on which the resource was created." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000917
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000917"^^xsd:token ;
  rdfs:label "Learning Resource Creator" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceCreator" ;
  dc11:description "The name of a person or organization credited with the creation of the resource." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid625 ) .

ceds:P000918
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000918"^^xsd:token ;
  rdfs:label "Learning Resource Publisher Name" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourcePublisherName" ;
  dc11:description "The name of the organization credited with publishing the resource." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000921
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000921"^^xsd:token ;
  rdfs:label "Learning Resource License URL" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceLicenseURL" ;
  dc11:description "The URL where the owner specifies permissions for using the resource." ;
  rdfs:comment "Ex: “http://creativecommons.org/licenses/by/3.0/“" ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid627 ) .

ceds:P000922
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000922"^^xsd:token ;
  rdfs:label "Learning Resource Based on URL" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceBasedOnURL" ;
  dc11:description "A resource that was used in the creation of this resource. This term can be repeated for multiple sources." ;
  rdfs:comment "Ex: “http://example.com/great-multiplication-intro.html“" ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" .

ceds:P000924
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000924"^^xsd:token ;
  rdfs:label "Learning Resource Time Required" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "LearningResourceTimeRequired" ;
  dc11:description "The approximate or typical time it takes to work with or through this learning resource for the typical intended target audience." ;
  ceds:textFormat "HH:MM" ;
  ceds:editHistory ( _:genid629 ) .

ceds:P000925
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000925"^^xsd:token ;
  rdfs:label "Learning Resource Typical Age Range Minimum" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:byte ;
  skos:notation "LearningResourceTypicalAgeRangeMinimum" ;
  dc11:description "The minimum for the typical range of ages of the content’s intended end user." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000926
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000926"^^xsd:token ;
  rdfs:label "Learning Resource Typical Age Range Maximum" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:byte ;
  skos:notation "LearningResourceTypicalAgeRangeMaximum" ;
  dc11:description "The maximum for the typical range of ages of the content’s intended end user." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000929
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000929"^^xsd:token ;
  rdfs:label "Learning Resource Text Complexity Value" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceTextComplexityValue" ;
  dc11:description "The complexity of the text using the scaling system defined by Text Complexity System, e.g. Lexile(tm)." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000930
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000930"^^xsd:token ;
  rdfs:label "Learning Resource Text Complexity System" ;
  schema:domainIncludes ceds:C200228 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceTextComplexitySystem" ;
  dc11:description "The scaling system used to specify the text complexity of an Learning Resource" ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001143
