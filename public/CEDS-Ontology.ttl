ceds:NI001517163941
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Office Services courses introduce students to and help them refine their
			clerical and office assistant skills. Course content typically covers filing, telephone,
			and keyboarding skills; reprographic machinery and procedures; communications skills;
			and so on.""" ;
