ceds:NI001517163942
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Keyboarding courses provide students with an introduction to the keyboard
			(letters, numbers, and symbols), basic machine operation, and proper keystroke
			technique. As students progress, they improve their speed and accuracy and produce
			increasingly complex documents. Such courses help students develop keyboard proficiency,
			document production skills, and problem-solving skills.""" ;
  dc11:identifier "NI001517163942"^^xsd:token ;
  rdfs:label "Keyboarding" ;
  skos:definition """Keyboarding courses provide students with an introduction to the keyboard
