  skos:prefLabel "Tutorial" .

ceds:NI001517164467
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Study Hall courses provide students with the opportunity and time to
			complete classroom assignments or school projects. Students typically work on their own,
			without the help of a tutor; however, they are supervised and usually remain in the
			classroom.""" ;
  dc11:identifier "NI001517164467"^^xsd:token ;
  rdfs:label "Study Hall" ;
  skos:definition """Study Hall courses provide students with the opportunity and time to
			complete classroom assignments or school projects. Students typically work on their own,
