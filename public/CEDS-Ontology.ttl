ceds:NI001517163606
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """General Band courses help students develop techniques for playing brass,
			woodwind, and percussion instruments and their ability to perform a variety of concert
			band literature styles. These courses may emphasize rehearsal and performance
			experiences in a range of styles (e.g., concert, marching, orchestral, and modern) and
			also include experiences in creating and responding to music.""" ;
  dc11:identifier "NI001517163606"^^xsd:token ;
  rdfs:label "General Band" ;
  skos:definition """General Band courses help students develop techniques for playing brass,
			woodwind, and percussion instruments and their ability to perform a variety of concert
			band literature styles. These courses may emphasize rehearsal and performance
			experiences in a range of styles (e.g., concert, marching, orchestral, and modern) and
			also include experiences in creating and responding to music.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05101" ;
  skos:prefLabel "General Band" .

ceds:NI001517163607
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Courses in Concert Band are designed to promote students' technique for playing brass, woodwind, and percussion instruments and cover a variety of band literature styles, primarily for concert performances and also include experiences in creating and responding to music." ;
  dc11:identifier "NI001517163607"^^xsd:token ;
  rdfs:label "Concert Band" ;
  skos:definition "Courses in Concert Band are designed to promote students' technique for playing brass, woodwind, and percussion instruments and cover a variety of band literature styles, primarily for concert performances and also include experiences in creating and responding to music." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05102" ;
  skos:prefLabel "Concert Band" .

ceds:NI001517163608
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Courses in Marching Band are intended to develop students' technique for playing brass, woodwind, and percussion instruments and cover appropriate band literature styles, primarily for marching performances." ;
  dc11:identifier "NI001517163608"^^xsd:token ;
  rdfs:label "Marching Band" ;
  skos:definition "Courses in Marching Band are intended to develop students' technique for playing brass, woodwind, and percussion instruments and cover appropriate band literature styles, primarily for marching performances." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05103" ;
  skos:prefLabel "Marching Band" .

ceds:NI001517163609
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Guitar courses provide students an introduction to, and refine the
			fundamentals of, music and guitar literature and techniques, such as strumming and
			chords and may offer instruction in more advanced techniques. These courses may include
			bass, ukelele and other plucked string instruments. Formal and informal performances are
			typically included as well as experiences in creating and responding to music.""" ;
  dc11:identifier "NI001517163609"^^xsd:token ;
  rdfs:label "Guitar" ;
  skos:definition """Guitar courses provide students an introduction to, and refine the
			fundamentals of, music and guitar literature and techniques, such as strumming and
			chords and may offer instruction in more advanced techniques. These courses may include
			bass, ukelele and other plucked string instruments. Formal and informal performances are
			typically included as well as experiences in creating and responding to music.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05108" ;
  skos:prefLabel "Guitar" .

ceds:NI001517163610
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Recording and Production courses provide students with an opportunity to
			learn and apply skills in music recording techniques, music editing, mixing, and
			creating finished musical recordings for distribution as sound files in order to
			enhance, convey, and capture the expressive intent of music.""" ;
  dc11:identifier "NI001517163610"^^xsd:token ;
  rdfs:label "Recording and Production" ;
  skos:definition """Recording and Production courses provide students with an opportunity to
			learn and apply skills in music recording techniques, music editing, mixing, and
			creating finished musical recordings for distribution as sound files in order to
			enhance, convey, and capture the expressive intent of music.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05123" ;
  skos:prefLabel "Recording and Production" .

