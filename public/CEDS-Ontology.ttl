  rdfs:label "Composition—Independent Study" ;
  skos:definition """Composition—Independent study, often conducted with instructors as mentors,
			allow students to explore particular topics within the field of language arts
			(emphasizing composition). Independent Study courses may serve as an opportunity for
			students to expand their expertise in a particular application, to explore a topic in
			greater detail, or to develop more advanced skills.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "01147" ;
  skos:prefLabel "Composition—Independent Study" .

ceds:NI001517163218
