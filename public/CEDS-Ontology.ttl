ceds:NI000390101916
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A forced-choice assessment item featuring a stem (which is a prompt) and two
			or more choices, one of which is the correct answer, and the remainder are distractors.""" ;
