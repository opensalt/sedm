  ceds:editHistory ( _:genid641 ) .

ceds:P001148
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001148"^^xsd:token ;
  rdfs:label "Learning Resource Peer Rating Value" ;
  schema:domainIncludes ceds:C200234 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "LearningResourcePeerRatingValue" ;
  dc11:description "An individual score, rating or level assigned to a Learning Resource by a person within the boundaries set by a Peer Rating System that may be aggregated to derive an overall score for the learning resource." ;
  ceds:textFormat "Numeric - up to 4 digits after decimal place" ;
  ceds:decimalPlaces "4" .

ceds:P001167
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001167"^^xsd:token ;
