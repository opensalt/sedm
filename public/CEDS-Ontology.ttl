  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Geometry courses, emphasizing an abstract, formal approach to the study of
			geometry, typically include topics such as properties of plane and solid figures;
