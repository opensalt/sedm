			advanced skills.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "21147" ;
  skos:prefLabel "Drafting—Independent Study" .

ceds:NI001517164456
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Drafting—Workplace Experience courses provide work experience in a field
			related to drafting. Goals are typically set cooperatively by the student, teacher, and
			employer (although students are not necessarily paid). These courses may include
			classroom activities as well, involving further study of the field or discussion
			regarding experiences that students encounter in the workplace.""" ;
  dc11:identifier "NI001517164456"^^xsd:token ;
  rdfs:label "Drafting—Workplace Experience" ;
  skos:definition """Drafting—Workplace Experience courses provide work experience in a field
