  skos:inScheme ceds:C001517 ;
  skos:notation "01135" ;
  skos:prefLabel "Writing (grade 5)" .

ceds:NI001517163227
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Literature—Workplace Experience courses provide work experience in a field
			related to English literature. Goals are typically set cooperatively by the student,
			teacher, and employer (although students are not necessarily paid). These courses may
			include classroom activities as well, involving further study of the field or discussion
			regarding experiences that students encounter in the workplace.""" ;
  dc11:identifier "NI001517163227"^^xsd:token ;
