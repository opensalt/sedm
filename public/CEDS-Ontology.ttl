ceds:NI001517163370
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Physics courses involve the study of the forces and laws of nature affecting
			matter, such as equilibrium, motion, momentum, and the relationships between matter and
			energy. The study of physics includes examination of sound, light, and magnetic and
			electric phenomena.""" ;
