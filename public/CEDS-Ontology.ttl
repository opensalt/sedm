  ceds:textFormat "YYYY-MM-DD" .

ceds:P001198
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001198"^^xsd:token ;
  rdfs:label "Assessment Asset Identifier" ;
  schema:domainIncludes ceds:C200015 ;
  schema:rangeIncludes xsd:string ;
