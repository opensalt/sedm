ceds:NI001680127705
  a owl:NamedIndividual, ceds:C001680, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "A pass-through transaction is essentially a payment on the student's account where the institution is purely processing the Pell Grant and those monies are not counted by the institution until they come in as a tuition payment from the student. The latter option is sometimes referred to as an agency transaction. With this option Pell grants are not counted as federal revenues and are not considered to be a discount/allowance to tuition and fees or auxiliary enterprises." ;
  dc11:identifier "NI001680127705"^^xsd:token ;
  rdfs:label "Pass through" ;
  skos:definition "A pass-through transaction is essentially a payment on the student's account where the institution is purely processing the Pell Grant and those monies are not counted by the institution until they come in as a tuition payment from the student. The latter option is sometimes referred to as an agency transaction. With this option Pell grants are not counted as federal revenues and are not considered to be a discount/allowance to tuition and fees or auxiliary enterprises." ;
  skos:inScheme ceds:C001680 ;
  skos:notation "Passthrough" ;
  skos:prefLabel "Pass through" .

ceds:NI001680127706
  a owl:NamedIndividual, ceds:C001680, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Pell grants are counted as federal revenue and allowance to tuition and fees and/or auxiliary enterprises (for room and board, books, meals, etc.). There should be an offsetting discount/allowance to tuition and fees revenue and/or auxiliary enterprise revenue so that the Pell grants are not being double counted in the institution's revenues." ;
  dc11:identifier "NI001680127706"^^xsd:token ;
  rdfs:label "Federal grant revenue" ;
  skos:definition "Pell grants are counted as federal revenue and allowance to tuition and fees and/or auxiliary enterprises (for room and board, books, meals, etc.). There should be an offsetting discount/allowance to tuition and fees revenue and/or auxiliary enterprise revenue so that the Pell grants are not being double counted in the institution's revenues." ;
  skos:inScheme ceds:C001680 ;
  skos:notation "Federalgrantrevenue" ;
  skos:prefLabel "Federal grant revenue" .

