ceds:NI001517164286
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Water Treatment courses provide instruction regarding the environmental
			hazards associated with identifying and accepting waste water disposal. Course topics
			typically include waste water, the steps in waste water treatment, compliance with
			applicable regulations, and the use of water-testing instruments and water-treatment
			equipment to treat wastewater.""" ;
  dc11:identifier "NI001517164286"^^xsd:token ;
  rdfs:label "Water Treatment" ;
  skos:definition """Water Treatment courses provide instruction regarding the environmental
			hazards associated with identifying and accepting waste water disposal. Course topics
			typically include waste water, the steps in waste water treatment, compliance with
			applicable regulations, and the use of water-testing instruments and water-treatment
			equipment to treat wastewater.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "18406" ;
  skos:prefLabel "Water Treatment" .

