ceds:NI001517163986
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Formerly known as Investing, Securities and Investments courses emphasize
			the formulation of business and individual investment decisions by comparing and
			contrasting the investment qualities of cash, stock, bonds, and mutual funds. Students
			typically review annual reports, predict growth rates, and analyze trends. Stock market
			simulations are often incorporated into these courses.""" ;
  dc11:identifier "NI001517163986"^^xsd:token ;
  rdfs:label "Securities and Investments" ;
  skos:definition """Formerly known as Investing, Securities and Investments courses emphasize
			the formulation of business and individual investment decisions by comparing and
