ceds:NI001517164429
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Technological Literacy courses expose students to the communication,
			transportation, energy, production, biotechnology, and integrated technology systems and
			processes that affect their lives. The study of these processes enables students to
			better understand technological systems and their applications and uses.""" ;
