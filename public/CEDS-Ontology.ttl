  skos:prefLabel "IB Language B—Spanish" .

ceds:NI001517162821
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Designed by the College Board to parallel third-year college-level courses in Spanish language, AP Spanish Language and Culture courses build upon prior knowledge and develop students' ability to express ideas, exchange opinions, and present information in Spanish, both orally and in writing. These courses also help students understand and interpret written and spoken Spanish. In addition, students explore the culture of Spanish-speaking people in historical and contemporary contexts." ;
  dc11:identifier "NI001517162821"^^xsd:token ;
  rdfs:label "AP Spanish Language and Culture" ;
  skos:definition "Designed by the College Board to parallel third-year college-level courses in Spanish language, AP Spanish Language and Culture courses build upon prior knowledge and develop students' ability to express ideas, exchange opinions, and present information in Spanish, both orally and in writing. These courses also help students understand and interpret written and spoken Spanish. In addition, students explore the culture of Spanish-speaking people in historical and contemporary contexts." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24064" ;
  skos:prefLabel "AP Spanish Language and Culture" .

ceds:NI001517162822
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Designed to introduce students to two or more languages in a single course
			of study, Exploration of Multiple World Languages courses provide students with general
			information about the spoken and written languages and introduce the relationships among
			the products, practices, and perspectives of the associated cultures.""" ;
  dc11:identifier "NI001517162822"^^xsd:token ;
  rdfs:label "Exploration of Multiple World Languages" ;
  skos:definition """Designed to introduce students to two or more languages in a single course
			of study, Exploration of Multiple World Languages courses provide students with general
			information about the spoken and written languages and introduce the relationships among
			the products, practices, and perspectives of the associated cultures.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24040" ;
  skos:prefLabel "Exploration of Multiple World Languages" .

ceds:NI001517162823
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Spanish for Young Learners (prior-to-secondary) courses provide instruction
			at multiple grade levels in Spanish and may apply to a range of consecutive grades.
			These courses prepare students to communicate authentically in Spanish by interpreting
			(reading, listening, viewing), exchanging (speaking and listening; reading and writing),
			and presenting (speaking, writing) information on concrete topics. These courses
			introduce the relationships among the products, practices, and perspectives of
			Spanish-speaking cultures.""" ;
  dc11:identifier "NI001517162823"^^xsd:token ;
  rdfs:label "Spanish for Young Learners (prior-to-secondary)" ;
  skos:definition """Spanish for Young Learners (prior-to-secondary) courses provide instruction
			at multiple grade levels in Spanish and may apply to a range of consecutive grades.
			These courses prepare students to communicate authentically in Spanish by interpreting
			(reading, listening, viewing), exchanging (speaking and listening; reading and writing),
			and presenting (speaking, writing) information on concrete topics. These courses
			introduce the relationships among the products, practices, and perspectives of
			Spanish-speaking cultures.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24050" ;
  skos:prefLabel "Spanish for Young Learners (prior-to-secondary)" .

ceds:NI001517162824
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Spanish Immersion (prior-to-secondary) courses engage students in
			developmentally appropriate activities to acquire literacy in Spanish and grade-specific
			content using Spanish as the language of instruction. Spanish Immersion courses prepare
			students to communicate authentically in Spanish by interpreting (reading, listening,
			viewing), exchanging (speaking and listening; reading and writing), and presenting
			(speaking, writing) information about standards-based academic content and incorporate
			the relationships among the products, practices, and perspectives of Spanish-speaking
			cultures.""" ;
  dc11:identifier "NI001517162824"^^xsd:token ;
  rdfs:label "Spanish Immersion (prior-to-secondary)" ;
  skos:definition """Spanish Immersion (prior-to-secondary) courses engage students in
			developmentally appropriate activities to acquire literacy in Spanish and grade-specific
			content using Spanish as the language of instruction. Spanish Immersion courses prepare
			students to communicate authentically in Spanish by interpreting (reading, listening,
			viewing), exchanging (speaking and listening; reading and writing), and presenting
			(speaking, writing) information about standards-based academic content and incorporate
			the relationships among the products, practices, and perspectives of Spanish-speaking
			cultures.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24051" ;
  skos:prefLabel "Spanish Immersion (prior-to-secondary)" .

