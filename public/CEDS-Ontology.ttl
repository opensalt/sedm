ceds:NI001517163641
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Reading (grade 5) courses focus on reading skills and may extend students' skills in distinguishing meaning and literary functions in texts, and fluency in reading. Specific content depends upon state standards for grade 5." ;
  dc11:identifier "NI001517163641"^^xsd:token ;
  rdfs:label "Reading (grade 5)" ;
