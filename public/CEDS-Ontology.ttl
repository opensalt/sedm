ceds:NI001517163876
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Following the College Board's suggested curriculum designed to mirror college-level computer science courses, AP Computer Science A courses emphasize object-oriented programming methodology with a focus on problem solving and algorithm development. These courses cover such topics as object-oriented program design; program implementation; program analysis; standard data structures; standard algorithms; and the ethical and social implications of computing systems." ;
  dc11:identifier "NI001517163876"^^xsd:token ;
  rdfs:label "AP Computer Science A" ;
  skos:definition "Following the College Board's suggested curriculum designed to mirror college-level computer science courses, AP Computer Science A courses emphasize object-oriented programming methodology with a focus on problem solving and algorithm development. These courses cover such topics as object-oriented program design; program implementation; program analysis; standard data structures; standard algorithms; and the ethical and social implications of computing systems." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "10157" ;
  skos:prefLabel "AP Computer Science A" .

ceds:NI001517163877
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Computer Science courses prepare students to take the International
			Baccalaureate Computer Science exams. The courses emphasize system fundamentals,
			computer organization, and networks, as well as the fundamental concepts of
			computational thinking, the development of practical computational solutions, and
			programming. IB Computer Science courses also cover the applications and effects of the
			computer on modern society as well as the limitations of computer technology.""" ;
  dc11:identifier "NI001517163877"^^xsd:token ;
