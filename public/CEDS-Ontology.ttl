ceds:NI001517164081
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Dental Laboratory Technology courses expose students to the principals,
			tools, terminology, and procedures necessary for a career in a dental laboratory. These
			courses typically cover many of the same topics as Dental Science, but emphasize making
			mouth guards, taking impressions, creating various types of dental molds and models, and
			fabricating prostheses and dental appliances.""" ;
  dc11:identifier "NI001517164081"^^xsd:token ;
  rdfs:label "Dental Laboratory Technology" ;
  skos:definition """Dental Laboratory Technology courses expose students to the principals,
			tools, terminology, and procedures necessary for a career in a dental laboratory. These
			courses typically cover many of the same topics as Dental Science, but emphasize making
			mouth guards, taking impressions, creating various types of dental molds and models, and
			fabricating prostheses and dental appliances.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "14101" ;
  skos:prefLabel "Dental Laboratory Technology" .

ceds:NI001517164082
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Medical Lab Technology courses provide students with the knowledge and
			skills necessary for employment in health care-related laboratories. Topics include
			basic principles of anatomy and physiology, relevant concepts in microbiology and
			chemistry, and laboratory techniques (including preparation and analysis of various
			cultures and specimens). The courses may also cover such components as venipuncture,
			EKG, and CPR procedures.""" ;
  dc11:identifier "NI001517164082"^^xsd:token ;
  rdfs:label "Medical Lab Technology" ;
  skos:definition """Medical Lab Technology courses provide students with the knowledge and
			skills necessary for employment in health care-related laboratories. Topics include
			basic principles of anatomy and physiology, relevant concepts in microbiology and
			chemistry, and laboratory techniques (including preparation and analysis of various
			cultures and specimens). The courses may also cover such components as venipuncture,
			EKG, and CPR procedures.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "14102" ;
  skos:prefLabel "Medical Lab Technology" .

