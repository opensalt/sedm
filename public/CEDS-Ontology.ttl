  skos:prefLabel "Business Principles and Management" .

ceds:NI001517163960
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """International Business and Marketing courses examine business management and
			administration in a global economy. Topics covered in this course typically include the
			principles and processes of export sales, trade controls, foreign operations and related
			problems, monetary issues, international business and policy, and applications of doing
			business in specific countries and markets.""" ;
