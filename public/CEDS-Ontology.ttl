ceds:NI001877129132
  a owl:NamedIndividual, ceds:C001877, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Arsenic is a semi-metal element in the periodic table. It is odorless and
			tasteless. It enters drinking water supplies from natural deposits in the earth or from
			agricultural and industrial practices. Non-cancer effects can include thickening and
			discoloration of the skin, stomach pain, nausea, vomiting; diarrhea; numbness in hands
			and feet; partial paralysis; and blindness. Arsenic has been linked to cancer of the
			bladder, lungs, skin, kidney, nasal passages, liver, and prostate.""" ;
  dc11:identifier "NI001877129132"^^xsd:token ;
  rdfs:label "Arsenic" ;
  skos:definition """Arsenic is a semi-metal element in the periodic table. It is odorless and
			tasteless. It enters drinking water supplies from natural deposits in the earth or from
			agricultural and industrial practices. Non-cancer effects can include thickening and
			discoloration of the skin, stomach pain, nausea, vomiting; diarrhea; numbness in hands
			and feet; partial paralysis; and blindness. Arsenic has been linked to cancer of the
			bladder, lungs, skin, kidney, nasal passages, liver, and prostate.""" ;
  skos:inScheme ceds:C001877 ;
  skos:notation "13678" ;
  skos:prefLabel "Arsenic" .

