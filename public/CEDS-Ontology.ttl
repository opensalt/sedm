ceds:NI001517163889
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Microsoft Certified Professional courses provide students with the knowledge
			and skills necessary to be employed as a network administrator in the latest Windows
			server-networking environment. Topics include installing, configuring, and
			trouble-shooting the Windows server. These courses prepare students to set up network
			connections; manage security issues and shares; and develop policies. Students are
			typically encouraged to take the MCP exam.""" ;
  dc11:identifier "NI001517163889"^^xsd:token ;
  rdfs:label "Microsoft Certified Professional (MCP)" ;
  skos:definition """Microsoft Certified Professional courses provide students with the
			knowledge and skills necessary to be employed as a network administrator in the latest
			Windows server-networking environment. Topics include installing, configuring, and
			trouble-shooting the Windows server. These courses prepare students to set up network
			connections; manage security issues and shares; and develop policies. Students are
			typically encouraged to take the MCP exam.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "10110" ;
  skos:prefLabel "Microsoft Certified Professional (MCP)" .

