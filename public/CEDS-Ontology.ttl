  skos:inScheme ceds:C001517 ;
  skos:notation "04101" ;
  skos:prefLabel "U.S. History—Comprehensive" .

ceds:NI001517163465
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Early U.S. History courses examine the history of the United States from the
			colonial period to the Civil War or Reconstruction era (some courses end after this
			period). Some courses include North American history before European settlement, while
			others may begin at the formation of the new nation. These courses typically include a
			historical overview of political, military, scientific, and social developments.""" ;
  dc11:identifier "NI001517163465"^^xsd:token ;
