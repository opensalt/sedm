ceds:NI001517164003
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Marketing—Merchandising courses address marketing in a retail/e-tail
			environment focusing on the buying and merchandising of products. Content includes, but
			is not limited to, marketing information management (including marketing research),
			market planning, channel management, sales, promotion, product/service management, and
			pricing.""" ;
