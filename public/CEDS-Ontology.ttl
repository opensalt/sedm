ceds:NI001517163422
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Science (grade 1) courses allow students to identify interactions and
			patterns in objects and events and to record observations in written or visual form.
			Typically, students investigate systems of living organisms and the environment.
			Specific content depends upon state standards for grade 1.""" ;
  dc11:identifier "NI001517163422"^^xsd:token ;
