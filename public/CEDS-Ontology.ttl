ceds:NI002086181571
  a owl:NamedIndividual, ceds:C002086, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A person who was enrolled on a full-time or part-time basis for at least one
			complete term at any time in the year since leaving high school in an education or
			training program such as Job Corps, adult education, workforce development program, or
			vocational technical school which is less than a two-year program and does not meet the
			definition of option "Higher education within one year.\"""" ;
  dc11:identifier "NI002086181571"^^xsd:token ;
  rdfs:label "Other postsecondary education or training within one year" ;
  skos:definition """A person who was enrolled on a full-time or part-time basis for at least
			one complete term at any time in the year since leaving high school in an education or
			training program such as Job Corps, adult education, workforce development program, or
			vocational technical school which is less than a two-year program and does not meet the
			definition of option "Higher education within one year.\"""" ;
  skos:inScheme ceds:C002086 ;
  skos:notation "1003" ;
  skos:prefLabel "Other postsecondary education or training within one year" .

