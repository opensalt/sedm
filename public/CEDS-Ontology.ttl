ceds:NI001517163640
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Reading (grade 4) courses focus on reading skills and may emphasize
			independent reading in a variety of assignments and require students to respond to
			different material in different ways. Specific content depends upon state standards for
			grade 4.""" ;
  dc11:identifier "NI001517163640"^^xsd:token ;
