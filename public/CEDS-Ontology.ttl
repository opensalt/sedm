ceds:NI001517163256
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Pre-Algebra courses increase students' foundational mathematics skills and prepare them for Algebra I by covering a variety of topics, such as properties of rational numbers (i.e., number theory), ratio, proportion, estimation, exponents and radicals, the rectangular coordinate system, sets and logic, formulas, and solving first-degree equations and inequalities." ;
  dc11:identifier "NI001517163256"^^xsd:token ;
  rdfs:label "Pre-Algebra" ;
  skos:definition "Pre-Algebra courses increase students' foundational mathematics skills and prepare them for Algebra I by covering a variety of topics, such as properties of rational numbers (i.e., number theory), ratio, proportion, estimation, exponents and radicals, the rectangular coordinate system, sets and logic, formulas, and solving first-degree equations and inequalities." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "02051" ;
  skos:prefLabel "Pre-Algebra" .

ceds:NI001517163257
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Algebra I courses include the study of properties and operations of the real
			number system; evaluating rational algebraic expressions; solving and graphing
			first-degree equations and inequalities; translating word problems into equations;
			operations with and factoring of polynomials; solving quadratic equations; and modeling
			linear data. Specific content depends upon state standards.""" ;
  dc11:identifier "NI001517163257"^^xsd:token ;
  rdfs:label "Algebra I" ;
  skos:definition """Algebra I courses include the study of properties and operations of the
			real number system; evaluating rational algebraic expressions; solving and graphing
			first-degree equations and inequalities; translating word problems into equations;
			operations with and factoring of polynomials; solving quadratic equations; and modeling
			linear data. Specific content depends upon state standards.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "02052" ;
  skos:prefLabel "Algebra I" .

ceds:NI001517163258
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The first part in a multipart sequence of Algebra I. This course generally
			covers the same topics as the first semester of Algebra I, including the study of
			properties of rational numbers (i.e., number theory), ratio, proportion, and estimation,
			exponents and radicals, the rectangular coordinate system, sets and logic, formulas, and
			solving first-degree equations and inequalities. Specific content depends upon state
			standards.""" ;
  dc11:identifier "NI001517163258"^^xsd:token ;
  rdfs:label "Algebra I—Part 1" ;
  skos:definition """The first part in a multipart sequence of Algebra I. This course generally
