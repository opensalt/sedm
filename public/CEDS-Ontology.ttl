  schema:domainIncludes ceds:C200140 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "FacilitySiteArea" ;
  dc11:description "The total number of acres in a continuous piece of land, to the nearest tenth, including undeveloped areas as well as areas occupied by buildings, walks, drives, parking facilities, and other improvements." ;
  ceds:textFormat "Numeric - up to 1 digit after decimal place" ;
  ceds:decimalPlaces "1" .

ceds:P001786
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001786"^^xsd:token ;
