ceds:NI001517164323
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Educational Methodology courses prepare students to teach and guide others.
			These courses typically provide opportunities for students to develop their own teaching
			objectives, to design lesson plans, and to experience teaching in a controlled
			environment. Students examine and practice teaching strategies, learning styles, time
			management and planning strategies, presentation and questioning skills, classroom
			management, and evaluation techniques.""" ;
  dc11:identifier "NI001517164323"^^xsd:token ;
  rdfs:label "Educational Methodology" ;
  skos:definition """Educational Methodology courses prepare students to teach and guide others.
