ceds:NI001517163155
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """World Language and Literature—Independent Study courses, often conducted
			with instructors as mentors, enable students to explore (non-English) world
			language-related topics of interest. Independent Study courses may serve as an
			opportunity for students to expand their expertise in a particular language, to explore
			a topic in greater detail, or to develop more advanced skills.""" ;
  dc11:identifier "NI001517163155"^^xsd:token ;
  rdfs:label "World Language and Literature—Independent Study" ;
  skos:definition """World Language and Literature—Independent Study courses, often conducted
			with instructors as mentors, enable students to explore (non-English) world
			language-related topics of interest. Independent Study courses may serve as an
			opportunity for students to expand their expertise in a particular language, to explore
			a topic in greater detail, or to develop more advanced skills.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24997" ;
  skos:prefLabel "World Language and Literature—Independent Study" .

ceds:NI001517163156
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """World Language and Literature—Workplace Experience courses provide students
			with work experience in a field related to a (non-English) world language or literature.
			Goals are typically set cooperatively by the student, teacher, and employer (although
			students are not necessarily paid). These courses may include classroom activities as
			well, involving further study of the field or discussion regarding experiences that
			students encounter in the workplace.""" ;
  dc11:identifier "NI001517163156"^^xsd:token ;
  rdfs:label "World Language and Literature—Workplace Experience" ;
  skos:definition """World Language and Literature—Workplace Experience courses provide students
			with work experience in a field related to a (non-English) world language or literature.
			Goals are typically set cooperatively by the student, teacher, and employer (although
			students are not necessarily paid). These courses may include classroom activities as
			well, involving further study of the field or discussion regarding experiences that
			students encounter in the workplace.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24998" ;
  skos:prefLabel "World Language and Literature—Workplace Experience" .

