ceds:NI001517163005
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Miscellaneous—Workplace Experience courses provide students with work
			experience in a field related to their interests. Goals are typically set cooperatively
			by the student, teacher, and employer (although students are not necessarily paid).
			These courses may include classroom activities as well, involving further study of the
			field or discussion regarding experiences that students encounter in the workplace.
			Note: if the particular subject area is known, use the code associated with the
			Workplace Experience course within that subject area.""" ;
  dc11:identifier "NI001517163005"^^xsd:token ;
  rdfs:label "Miscellaneous—Workplace Experience" ;
