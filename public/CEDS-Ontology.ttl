  ceds:textFormat "Integer" .

ceds:P001785
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001785"^^xsd:token ;
  rdfs:label "Building Number of Stories" ;
  schema:domainIncludes ceds:C200123 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "BuildingNumberOfStories" ;
