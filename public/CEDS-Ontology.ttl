			upon state standards for grade 3.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "03233" ;
  skos:prefLabel "Science (grade 3)" .

ceds:NI001517163425
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Science (grade 4) courses typically explore complex systems, such as plant
			and animal adaptation, forces and motion, and physical and chemical changes in matter,
			or content consistent with state academic standards. Students may identify causes and
			effects of change, make predictions, and gather data from multiple sources. Specific
			content depends upon state standards for grade 4.""" ;
  dc11:identifier "NI001517163425"^^xsd:token ;
  rdfs:label "Science (grade 4)" ;
