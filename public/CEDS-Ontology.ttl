  skos:prefLabel "World Language—General" .

ceds:NI001517162820
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "IB Language B—Spanish courses prepare students to take the International Baccalaureate Language B exams. These courses focus on improving students' accuracy and fluency in oral and written communication (usually in the students' \"second\" language)." ;
