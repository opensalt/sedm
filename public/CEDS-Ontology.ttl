ceds:P002095
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002095"^^xsd:token ;
  rdfs:label "Learning Resource Ordered Date" ;
  schema:domainIncludes ceds:C200233 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "LearningResourceOrderedDate" ;
