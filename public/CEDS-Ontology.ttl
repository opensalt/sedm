  schema:rangeIncludes ceds:C000563 ;
  skos:notation "hasMEPContinuationOfServicesStatus" ;
  dc11:description "An indication that migrant children are receiving instructional or support services under the continuation of services authority ESEA Title III Section 1304(e)(2)-(3)." ;
