  schema:rangeIncludes ceds:C001327 ;
  skos:notation "hasDoctoralExamsRequiredType" ;
  dc11:description "A qualifier identifying the types of exams required of doctoral level individuals." .

ceds:P001641
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001641"^^xsd:token ;
  rdfs:label "Has DQP Categories of Learning" ;
  schema:domainIncludes ceds:C200331 ;
  schema:rangeIncludes ceds:C001641 ;
  skos:notation "hasDQPCategoriesOfLearning" ;
  dc11:description "The Lumina Foundation's Degree Qualifications Profile offers reference points for what students should know and be able to do upon completion of associate, bachelor's and master's degrees – in any field of study. The DQP Categories of Learning provide a profile of what degrees mean within which specific proficiencies may be defined." ;
  rdfs:comment "Based on the <a href=\"http://degreeprofile.org\">Degree Qualifications Profile</a>." .

