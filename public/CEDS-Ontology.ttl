  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Organic Chemistry courses involve the study of organic molecules and
			functional groups. Topics covered may include nomenclature, bonding molecular structure
			and reactivity, reaction mechanisms, and current spectroscopic techniques.""" ;
