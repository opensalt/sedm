ceds:P000106
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000106"^^xsd:token ;
  rdfs:label "Has Cohort Exclusion" ;
  schema:domainIncludes ceds:C200341 ;
  schema:rangeIncludes ceds:C000106 ;
  skos:notation "hasCohortExclusion" ;
  dc11:description "Those persons who may be removed (deleted) from a cohort (or subcohort). For the Graduation Rates and Fall Enrollment retention rate reporting, persons may be removed from a cohort if they left the institution for one of the following reasons: death or total and permanent disability; service in the armed forces (including those called to active duty); service with a foreign aid service of the federal government, such as the Peace Corps; or service on official church missions." .

