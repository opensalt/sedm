ceds:NI001517164291
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Elder Care courses emphasize the care of human beings as they grow older.
			These courses involve the study of the biological, physiological, social, and
			psychological needs and concerns of the elderly, and deal with economic and legal
			issues, the aging process, death, and dying in a realistic manner. Elder Care courses
			may cover work and personal habits appropriate to the field, and may also offer the
			opportunity to explore various careers.""" ;
  dc11:identifier "NI001517164291"^^xsd:token ;
