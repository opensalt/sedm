  dc11:description "The name of the ownership rights holder or publisher of the asset." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001202
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001202"^^xsd:token ;
  rdfs:label "Assessment Asset Content XML" ;
  schema:domainIncludes ceds:C200015 ;
  schema:rangeIncludes xsd:string ;
