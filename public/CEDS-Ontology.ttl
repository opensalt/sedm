  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200272"^^xsd:token ;
  rdfs:comment "A telephone number for a person or an organization." ;
  rdfs:label "Telephone" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Telephone" .

ceds:C200373
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200373"^^xsd:token ;
  rdfs:comment """Person-level employment and earnings information from quarterly employment and
			earnings-related data from sources such as State UI Wage Records, the Wage Record
			Interchange System, or the Federal Employment Data Exchange System (FEDES).""" ;
  rdfs:label "Workforce Employment Quarterly Data" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "WorkforceEmploymentQuarterlyData" .

ceds:C200374
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200374"^^xsd:token ;
  rdfs:comment "Information about a specific cohort of workforce program participants." ;
  rdfs:label "Workforce Program Participant Cohort" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "WorkforceProgramParticipantCohort" .

ceds:C200412
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200412"^^xsd:token ;
  rdfs:comment "An individual within an organization who serves as a point of communication for specific roles or responsibilities." ;
  rdfs:label "Contact" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Contact" .

ceds:C200413
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200413"^^xsd:token ;
  rdfs:comment "The essential information required to reach an individual within an organization, specific to their role or responsibility." ;
  rdfs:label "Contact Details" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "ContactDetails" .

ceds:P002116
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002116"^^xsd:token ;
  rdfs:comment "The date associated with the commencement/entry/start of a role for a person at an organization." ;
  rdfs:label "Membership Entry Date" ;
  schema:domainIncludes ceds:C200257 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "MembershipEntryDate" .

ceds:P002117
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002117"^^xsd:token ;
  rdfs:comment "The date associated with the termination/exit/end of a role for a person at an organization." ;
  rdfs:label "Membership Exit Date" ;
  schema:domainIncludes ceds:C200257 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "MembershipExitDate" .

ceds:P001572
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001572"^^xsd:token ;
  rdfs:comment """A unique number or alphanumeric code assigned to a person by a school, school
			system, a state, or other agency or entity.""" ;
  rdfs:label "Person Identifier" ;
  schema:domainIncludes ceds:C200291 ;
  schema:rangeIncludes xsd:token ;
  skos:notation "PersonIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to a person by a school, school system, a state, or other agency or entity." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid49 ) .

ceds:P000826
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000826"^^xsd:token ;
  rdfs:comment """A unique number or alphanumeric code assigned to an organization by a school,
			school system, a state, or other agency or entity.""" ;
  rdfs:label "Organization Identifier" ;
  schema:domainIncludes ceds:C200252 ;
  schema:rangeIncludes xsd:token ;
  skos:notation "OrganizationIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to an organization by a school, school system, a state, or other agency or entity." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory (
   _:genid51
   _:genid53
 ) .

ceds:P001530
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001530"^^xsd:token ;
  rdfs:label "Activity Description" ;
  schema:domainIncludes ceds:C200001 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ActivityDescription" ;
  dc11:description "A description of the events and procedures that take place under the purview of an organized activity, such as a co-curricular or extra-curricular activity that is offered at an education institution." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P000788
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000788"^^xsd:token ;
  rdfs:label "Years of Prior Adult Education Teaching Experience" ;
  schema:domainIncludes ceds:C200005, ceds:C200368 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "YearsofPriorAETeachingExperience" ;
  dc11:description "The total number of years that a person has previously held a teaching position in one or more adult education programs." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid55 ) .

ceds:P000081
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000081"^^xsd:token ;
  rdfs:label "Diploma or Credential Award Date" ;
  schema:domainIncludes ceds:C200006, ceds:C200091, ceds:C200210, ceds:C200281, ceds:C200336, ceds:C200364, ceds:C200375 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "DiplomaOrCredentialAwardDate" ;
  dc11:description "The month and year on which the diploma/credential is awarded to a student in recognition of his/her completion of the curricular requirements." ;
  ceds:textFormat "YYYY-MM" ;
  ceds:editHistory ( _:genid57 ) .

ceds:P001102
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001102"^^xsd:token ;
  rdfs:label "Assessment Item Body Custom Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyCustomInteractionXML" ;
  dc11:description "The custom interaction provides an opportunity for extensibility of this specification to include support for interactions not currently documented.  The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001103
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001103"^^xsd:token ;
  rdfs:label "Assessment Item Body Drawing Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyDrawingInteractionXML" ;
  dc11:description "The drawing interaction allows the candidate to use a common set of drawing tools to modify a given graphical image (the canvas). It must be bound to a response variable with base-type file and single cardinality. The result is a file in the same format as the original image. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001104
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001104"^^xsd:token ;
  rdfs:label "Assessment Item Body Gap Match Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyGapMatchInteractionXML" ;
  dc11:description "A gap match interaction contains a number gaps that the candidate can fill from an associated set of choices. The candidate must be able to review the content with the gaps filled in context, as indicated by their choices. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001105
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001105"^^xsd:token ;
  rdfs:label "Assessment Item Body Match Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyMatchInteractionXML" ;
  dc11:description "A match interaction presents candidates with two sets of choices and allows them to create associates between pairs of choices in the two sets, but not between pairs of choices in the same set. Further restrictions can still be placed on the allowable associations using the matchMax attribute of the choices. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001106
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001106"^^xsd:token ;
  rdfs:label "Assessment Item Body Graphic Gap Match Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyGraphicGapMatchInteractionXML" ;
  dc11:description "A graphic gap-match interaction is a graphical interaction with a set of gaps that are defined as areas (hotspots) of the graphic image and an additional set of gap choices that are defined outside the image. The candidate must associate the gap choices with the gaps in the image and be able to review the image with the gaps filled in context, as indicated by their choices. Care should be taken when designing these interactions to ensure that the gaps in the image are a suitable size to receive the required gap choices. It must be clear to the candidate which hotspot each choice has been associated with. When associated, choices must appear wholly inside the gaps if at all possible and, where overlaps are required, should not hide each other completely. If the candidate indicates the association by positioning the choice over the gap (e.g., drag and drop) the system should 'snap' it to the nearest position that satisfies these requirements. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001107
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001107"^^xsd:token ;
  rdfs:label "Assessment Item Body Hot Spot Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyHotSpotInteractionXML" ;
  dc11:description "A hotspot interaction is a graphical interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to select one or more of the areas (hotspots). The hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, choiceInteraction should be used instead with separate material for each option. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001108
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001108"^^xsd:token ;
  rdfs:label "Assessment Item Body Graphic Order Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyGraphicOrderInteractionXML" ;
  dc11:description "A graphic order interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to impose an ordering on the areas (hotspots). The order hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, orderInteraction should be used instead with separate material for each option. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001109
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001109"^^xsd:token ;
  rdfs:label "Assessment Item Body Select Point Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodySelectPointInteractionXML" ;
  dc11:description "Like hotspotInteraction, a select point interaction is a graphic interaction. The candidate's task is to select one or more points. The associated response may have an areaMapping that scores the response on the basis of comparing it against predefined areas but the delivery engine must not indicate these areas of the image. Only the actual point(s) selected by the candidate shall be indicated. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001110
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001110"^^xsd:token ;
  rdfs:label "Assessment Item Body Select Point Interaction" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodySelectPointInteraction" ;
  dc11:description "A graphic associate interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to associate the areas (hotspots) with each other. The graphic associate interaction should only be used when the graphical relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, associateInteraction should be used instead with separate Material for each option. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001111
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001111"^^xsd:token ;
  rdfs:label "Assessment Item Body Slider Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodySliderInteractionXML" ;
  dc11:description "The slider interaction presents the candidate with a control for selecting a numerical value between a lower and upper bound. It must be bound to a response variable with single cardinality with a base-type of either integer or float. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001112
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001112"^^xsd:token ;
  rdfs:label "Assessment Item Body Choice Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyChoiceInteractionXML" ;
  dc11:description "The choice interaction presents a set of choices to the candidate. The candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is always initialized with no choices selected. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001114
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001114"^^xsd:token ;
  rdfs:label "Assessment Item Body Inline Choice Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyInlineChoiceInteractionXML" ;
  dc11:description "A inline choice is an inline interaction that presents the user with a set of choices, each of which is a simple piece of text. The candidate's task is to select one of the choices. Unlike the Choice Interaction, the delivery engine must allow the candidate to review their choice within the context of the surrounding text." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001115
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001115"^^xsd:token ;
  rdfs:label "Assessment Item Body Media Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyMediaInteractionXML" ;
  dc11:description "The media interaction allows more control over the way the candidate interacts with a time-based media object and allows the number of times the media object was experienced to be reported in the value of the associated response variable, which must be of base-type integer and single cardinality. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001116
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001116"^^xsd:token ;
  rdfs:label "Assessment Item Body Hottext Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyHottextInteractionXML" ;
  dc11:description "The hottext interaction presents a set of choices to the candidate represented as selectable runs of text embedded within a surrounding context, such as a simple passage of text. Like choiceInteraction, the candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is initialized from the defaultValue of the associated response variable, a NULL value indicating that no choices are selected (the usual case). The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001117
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001117"^^xsd:token ;
  rdfs:label "Assessment Item Body Order Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyOrderInteractionXML" ;
  dc11:description "In an order interaction the candidate's task is to reorder the choices, the order in which the choices are displayed initially is significant. By default the candidate's task is to order all of the choices but a subset of the choices can be requested using the maxChoices and minChoices attributes. When specified the candidate must select a subset of the choices and impose an ordering on them. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001118
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001118"^^xsd:token ;
  rdfs:label "Assessment Item Body Position Object Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyPositionObjectInteractionXML" ;
  dc11:description "The position object interaction consists of a single image which must be positioned on another graphic image (the stage) by the candidate. Like selectPointInteraction, the associated response may have an areaMapping that scores the response on the basis of comparing it against predefined areas but the delivery engine must not indicate these areas of the stage. Only the actual position(s) selected by the candidate shall be indicated. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001119
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001119"^^xsd:token ;
  rdfs:label "Assessment Item Body Text Entry Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyTextEntryInteractionXML" ;
  dc11:description "A textEntry interaction obtains a simple piece of text from the candidate. Like inlineChoiceInteraction, the delivery engine must allow the candidate to review their choice within the context of the surrounding text. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001120
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001120"^^xsd:token ;
  rdfs:label "Assessment Item Body Extended Text Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyExtendedTextInteractionXML" ;
  dc11:description "An extended text interaction allows the candidate to enter an extended amount of text. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001121
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001121"^^xsd:token ;
  rdfs:label "Assessment Item Body End Attempt Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyEndAttemptInteractionXML" ;
  dc11:description "The end attempt interaction is a special type of interaction which allows item authors to provide the candidate with control over the way in which the candidate terminates an attempt. The candidate can use the interaction to terminate the attempt (triggering response processing) immediately, typically to request a hint. It must be bound to a response variable with base-type boolean and single cardinality. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001123
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001123"^^xsd:token ;
  rdfs:label "Assessment Item Body Associate Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyAssociateInteractionXML" ;
  dc11:description "An associate interaction presents candidates with a number of choices and allows them to create associations between them. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001222
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001222"^^xsd:token ;
  rdfs:label "Assessment Item Body Upload Interaction XML" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyUploadInteractionXML" ;
  dc11:description "The upload interaction allows the candidate to upload a pre-prepared file representing their response. It must be bound to a response variable with base-type file and single cardinality. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001529
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001529"^^xsd:token ;
  rdfs:label "APIP Interaction Sequence Number" ;
  schema:domainIncludes ceds:C200008 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "APIPInteractionSequenceNumber" ;
  dc11:description "The position of this APIP Interaction in a sequence of interactions." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric" .

ceds:P001173
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001173"^^xsd:token ;
  rdfs:label "Authorization Application Name" ;
  schema:domainIncludes ceds:C200009 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AuthorizationApplicationName" ;
  dc11:description "The name of a data system or application which an authenticated person may access." ;
  ceds:maxLength "120" ;
  ceds:textFormat "Alphanumeric - 120 characters maximum" .

ceds:P001174
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001174"^^xsd:token ;
  rdfs:label "Authorization Application URI" ;
  schema:domainIncludes ceds:C200009 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AuthorizationApplicationURI" ;
  dc11:description "The Uniform Resource Identifier (URI) of a data system or application which an authenticated person may access." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" .

ceds:P000028
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000028"^^xsd:token ;
  rdfs:label "Assessment Title" ;
  schema:domainIncludes ceds:C200010 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentTitle" ;
  dc11:description "The title or name of the assessment." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000382
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000382"^^xsd:token ;
  rdfs:label "Assessment Objective" ;
  schema:domainIncludes ceds:C200010 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentObjective" ;
  dc11:description "This is the objective that the assessment is measuring." ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" .

ceds:P000931
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000931"^^xsd:token ;
  rdfs:label "Assessment Short Name" ;
  schema:domainIncludes ceds:C200010 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentShortName" ;
  dc11:description "An abbreviated title for an assessment." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000932
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000932"^^xsd:token ;
  rdfs:label "Assessment Family Title" ;
  schema:domainIncludes ceds:C200010 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFamilyTitle" ;
  dc11:description "The full title of the Assessment Family. An Assessment Family is a set of assessments with a common name, jurisdiction, or focus, such as Graduate Record Exam or National Assessment of Educational Progress." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000933
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000933"^^xsd:token ;
  rdfs:label "Assessment Family Short Name" ;
  schema:domainIncludes ceds:C200010 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFamilyShortName" ;
  dc11:description "The abbreviated title of the Assessment Family. An Assessment Family is a set of assessments with a common name, jurisdiction, or focus." ;
  rdfs:comment "Examples: SAT, GRE, NAEP" ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000967
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000967"^^xsd:token ;
  rdfs:label "Assessment Administration Assessment Family" ;
  schema:domainIncludes ceds:C200010, ceds:C200246 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentAdministrationAssessmentFamily" ;
  dc11:description "The title of the assessment family to be administered." ;
  rdfs:comment "A typical scenario for an assessment administration is a state-wide administration of an accountability test.  For example, in Florida \"Florida Comprehensive Assessment Test\"." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001006
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001006"^^xsd:token ;
  rdfs:label "Assessment Provider" ;
  schema:domainIncludes ceds:C200010 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentProvider" ;
  dc11:description "Identifies the provider or publisher of the assessment." ;
  rdfs:comment "AIF property" ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001067
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001067"^^xsd:token ;
  rdfs:label "Assessment Identifier" ;
  schema:domainIncludes ceds:C200010 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to an assessment by a school, school system, a state, or other agency or entity.  This may be the publisher identifier." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" ;
  ceds:editHistory (
   _:genid59
   _:genid61
   _:genid63
   _:genid65
 ) .

ceds:P001544
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001544"^^xsd:token ;
