ceds:NI001287141404
  a owl:NamedIndividual, ceds:C001287, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A model in which within a given course or subject, students rotate between
			learning modalities, at least one of which is online learning. Other modalities might
			include activities such as small-group or full-class instruction, group projects,
			individual tutoring, and pencil-and-paper assignments.""" ;
  dc11:identifier "NI001287141404"^^xsd:token ;
  rdfs:label "Rotation model" ;
  skos:definition """A model in which within a given course or subject, students rotate between
			learning modalities, at least one of which is online learning. Other modalities might
			include activities such as small-group or full-class instruction, group projects,
			individual tutoring, and pencil-and-paper assignments.""" ;
  skos:inScheme ceds:C001287 ;
  skos:notation "Rotation" ;
  skos:prefLabel "Rotation model" .

ceds:NI001287141405
  a owl:NamedIndividual, ceds:C001287, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A model in which online learning is the backbone of student learning, even
			if it directs students to offline activities at times. Students move on an individually
			customized, fluid schedule among learning modalities, and the teacher of record is
			on-site. The teacher-of-record or other adults provide face-to-face support on a
			flexible and adaptive as-needed basis through activities such as small-group
			instruction, group projects, and individual tutoring.""" ;
  dc11:identifier "NI001287141405"^^xsd:token ;
  rdfs:label "Flex model" ;
  skos:definition """A model in which online learning is the backbone of student learning, even
			if it directs students to offline activities at times. Students move on an individually
			customized, fluid schedule among learning modalities, and the teacher of record is
			on-site. The teacher-of-record or other adults provide face-to-face support on a
			flexible and adaptive as-needed basis through activities such as small-group
			instruction, group projects, and individual tutoring.""" ;
  skos:inScheme ceds:C001287 ;
  skos:notation "FlexModel" ;
  skos:prefLabel "Flex model" .

ceds:NI001287141406
  a owl:NamedIndividual, ceds:C001287, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A model in which students take one or more courses entirely online with an
			online teacher of record and at the same time continue to have brick-and-mortar
			educational experiences. Students may take the online courses either on the
			brick-and-mortar campus or off-site. This differs from full-time online learning and the
			Enriched Virtual model because it is not a whole-school experience.""" ;
  dc11:identifier "NI001287141406"^^xsd:token ;
  rdfs:label "A La Carte model" ;
  skos:definition """A model in which students take one or more courses entirely online with an
			online teacher of record and at the same time continue to have brick-and-mortar
			educational experiences. Students may take the online courses either on the
			brick-and-mortar campus or off-site. This differs from full-time online learning and the
			Enriched Virtual model because it is not a whole-school experience.""" ;
  skos:inScheme ceds:C001287 ;
  skos:notation "ALaCarte" ;
  skos:prefLabel "A La Carte model" .

ceds:NI001287141407
  a owl:NamedIndividual, ceds:C001287, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A whole-school experience in which within each course, students divide their
			time between attending a brick-and-mortar campus and learning remotely, off-site, using
			online delivery of content and instruction.""" ;
  dc11:identifier "NI001287141407"^^xsd:token ;
  rdfs:label "Enriched Virtual model" ;
  skos:definition """A whole-school experience in which within each course, students divide
			their time between attending a brick-and-mortar campus and learning remotely, off-site,
			using online delivery of content and instruction.""" ;
  skos:inScheme ceds:C001287 ;
  skos:notation "EnrichedVirtual" ;
  skos:prefLabel "Enriched Virtual model" .

ceds:NI001287141408
  a owl:NamedIndividual, ceds:C001287, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A model for implementing blended learning that does not fit the definition
			of the other blended learning model types""" ;
  dc11:identifier "NI001287141408"^^xsd:token ;
  rdfs:label "Other" ;
  skos:definition """A model for implementing blended learning that does not fit the definition
			of the other blended learning model types""" ;
  skos:inScheme ceds:C001287 ;
  skos:notation "Other" ;
  skos:prefLabel "Other" .

