ceds:NI001517163166
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Literature and Performance courses prepare students to take the
			International Baccalaureate Literature and Performance exam. Course content focuses on
