  schema:domainIncludes ceds:C200302 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MilitaryOccupationalSpecialties" .

ceds:P002038
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002038"^^xsd:token ;
