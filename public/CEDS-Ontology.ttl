  a owl:NamedIndividual, ceds:C000273, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Programs that provide assistance for students with disabilities who need
			help in reading or writing responses to test items. Examples of such assistance include
			the administration of untimed tests and the presence of test facilitators for children
