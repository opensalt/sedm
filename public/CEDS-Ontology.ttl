ceds:NI001517162907
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Greek for Native Speakers courses prepare native and heritage speakers to communicate in Greek in all modes. These courses reinforce and expand students' skills to interpret (read, listen, view) and present (speak, write) information at the same level as they exchange (speak and listen; read and write) information, concepts, and ideas on a variety of topics. Greek for Native Speakers courses advance students' understanding of the relationships among the products, practices, and perspectives of the cultures included in the Greek-speaking world." ;
  dc11:identifier "NI001517162907"^^xsd:token ;
  rdfs:label "Greek for Native Speakers" ;
  skos:definition "Greek for Native Speakers courses prepare native and heritage speakers to communicate in Greek in all modes. These courses reinforce and expand students' skills to interpret (read, listen, view) and present (speak, write) information at the same level as they exchange (speak and listen; read and write) information, concepts, and ideas on a variety of topics. Greek for Native Speakers courses advance students' understanding of the relationships among the products, practices, and perspectives of the cultures included in the Greek-speaking world." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24307" ;
  skos:prefLabel "Greek for Native Speakers" .

ceds:NI001517162908
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """German Literature courses prepare students to communicate authentically in
			German by interpreting (reading, listening, viewing), exchanging (speaking and
			listening; reading and writing), and presenting (speaking, writing) information,
			opinions, and ideas drawn from literature written in German. Emphasis is typically
			placed on critical and analytical reading and writing, understanding the integration of
			German cultures into literature, and exploring interdisciplinary connections.""" ;
  dc11:identifier "NI001517162908"^^xsd:token ;
  rdfs:label "German Literature" ;
  skos:definition """German Literature courses prepare students to communicate authentically in
			German by interpreting (reading, listening, viewing), exchanging (speaking and
			listening; reading and writing), and presenting (speaking, writing) information,
			opinions, and ideas drawn from literature written in German. Emphasis is typically
			placed on critical and analytical reading and writing, understanding the integration of
			German cultures into literature, and exploring interdisciplinary connections.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24260" ;
  skos:prefLabel "German Literature" .

