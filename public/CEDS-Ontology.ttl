ceds:NI001676127680
  a owl:NamedIndividual, ceds:C001676, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Cash contributions in the form of supplementary or deferred compensation other than salary. Excludes the employee's contribution. Employee fringe benefits include retirement plans, social security taxes, medical/dental plans, guaranteed disability income protection plans, tuition plans, housing plans, unemployment compensation plans, group life insurance plans, worker's compensation plans, and other benefits in-kind with cash options." ;
  dc11:identifier "NI001676127680"^^xsd:token ;
  rdfs:label "Benefits" ;
  skos:definition "Cash contributions in the form of supplementary or deferred compensation other than salary. Excludes the employee's contribution. Employee fringe benefits include retirement plans, social security taxes, medical/dental plans, guaranteed disability income protection plans, tuition plans, housing plans, unemployment compensation plans, group life insurance plans, worker's compensation plans, and other benefits in-kind with cash options." ;
  skos:inScheme ceds:C001676 ;
  skos:notation "Benefits" ;
  skos:prefLabel "Benefits" .

ceds:NI001676127681
  a owl:NamedIndividual, ceds:C001676, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """An expense category that includes expenses for operations established to
			provide service and maintenance related to campus grounds and facilities used for
			educational and general purposes. Specific expenses include utilities, fire protection,
			property insurance, and similar items. This expense does include amounts charged to
			auxiliary enterprises, hospitals, and independent operations. Also includes information
			technology expenses related to operation and maintenance of plant activities if the
			institution separately budgets and expenses information technology resources (otherwise
			these expenses are included in institutional support).""" ;
  dc11:identifier "NI001676127681"^^xsd:token ;
  rdfs:label "Operation and maintenance of plant" ;
  skos:definition """An expense category that includes expenses for operations established to
			provide service and maintenance related to campus grounds and facilities used for
			educational and general purposes. Specific expenses include utilities, fire protection,
			property insurance, and similar items. This expense does include amounts charged to
			auxiliary enterprises, hospitals, and independent operations. Also includes information
			technology expenses related to operation and maintenance of plant activities if the
			institution separately budgets and expenses information technology resources (otherwise
			these expenses are included in institutional support).""" ;
  skos:inScheme ceds:C001676 ;
  skos:notation "Operationmaintenanceofplant" ;
  skos:prefLabel "Operation and maintenance of plant" .

ceds:NI001676127682
  a owl:NamedIndividual, ceds:C001676, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The allocation or distribution of the cost of capital assets, less any
			salvage value, to expenses over the estimated useful life of the asset in a systematic
			and rational manner. Depreciation for the year is the amount of the allocation or
			distribution for the year involved.""" ;
  dc11:identifier "NI001676127682"^^xsd:token ;
  rdfs:label "Depreciation" ;
  skos:definition """The allocation or distribution of the cost of capital assets, less any
			salvage value, to expenses over the estimated useful life of the asset in a systematic
			and rational manner. Depreciation for the year is the amount of the allocation or
			distribution for the year involved.""" ;
  skos:inScheme ceds:C001676 ;
  skos:notation "Depreciation" ;
  skos:prefLabel "Depreciation" .

