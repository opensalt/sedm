_:genid227
  a ceds:editHistoryEntry ;
  ceds:changeNotes "This is one of two new elements that split the existing Competency Item Typical Age Range from a single element into separate elements for minimum and maximum values. The intent is to make the values machine readable without parsing." ;
  ceds:version "8" .

