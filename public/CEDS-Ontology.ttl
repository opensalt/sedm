ceds:NI001517163723
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Prayer and Spirituality courses vary widely, but seek to enable students to
			experience deeper communion with the divine through public and private worship. Course
			content may include an examination or exploration of traditional and contemporary
			practices.""" ;
  dc11:identifier "NI001517163723"^^xsd:token ;
