ceds:NI001517163344
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Mathematics—Workplace Experience courses provide students with work
			experience in a field related to mathematics. Goals are typically set cooperatively by
