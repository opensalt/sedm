ceds:NI001517164087
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Medical/Clerical Assisting courses enable students to develop knowledge and
			skills that combine the medical and clerical fields. Students typically develop skills
			such as patient exam preparation, assessment of vital signs, routine lab procedures,
			medical transcription, financial accounting, patient and insurance company billing, and
			record-keeping.""" ;
