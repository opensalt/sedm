ceds:NI001517163301
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Abstract Algebra courses include a study of the properties of the number
			system from an abstract perspective, including such topics as number fields (i.e.,
			rational, real, and complex numbers), integral domains, rings, groups, polynomials, and
			the fundamental theorem of algebra. Abstract Algebra is typically geared towards
			students who have attained pre-calculus objectives.""" ;
