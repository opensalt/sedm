ceds:P000202
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000202"^^xsd:token ;
  rdfs:label "Number of Days in Attendance" ;
  schema:domainIncludes ceds:C200106, ceds:C200350 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "NumberOfDaysInAttendance" ;
  dc11:description "The number of days a person is present when school is in session during a given reporting period." ;
  rdfs:comment "Note: This applies to an enrollment period record.  Separate records using this element definition could capture attendance for regular enrollment, an out-of-school program or other program requiring attendance records.  CEDS now supports the detailed attendance events to capture attendance status on any given day, class period, or session.  CEDS generally doesn't include elements for counts when it has the unit level elements to calculate the count.  However, this element has been retained to support the intended use cases, recognizing that the rules for attendance vary based on location." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid413 ) .

