  schema:domainIncludes ceds:C200219, ceds:C200343 ;
  schema:rangeIncludes ceds:C000610 ;
  skos:notation "hasDisplacedStudentStatus" ;
  dc11:description "A student who was enrolled, or eligible for enrollment, but has enrolled in another place because of a crisis." ;
  ceds:editHistory ( _:genid1895 ) .

ceds:P001654
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001654"^^xsd:token ;
  rdfs:label "Has National School Lunch Program Direct Certification Indicator" ;
  schema:domainIncludes ceds:C200219 ;
  schema:rangeIncludes ceds:C001654 ;
  skos:notation "hasNationalSchoolLunchProgramDirectCertificationIndicator" ;
  dc11:description "Indicates that the student's National School Lunch Program (NSLP) eligibility has been determined through direct certification." ;
  rdfs:comment "This element was introduced in version 6 of CEDS with plans for further development of elements needed to fully support direct certification use cases." .

ceds:P001988
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001988"^^xsd:token ;
  rdfs:label "Has Home Language Survey Administration Indicator" ;
  schema:domainIncludes ceds:C200221 ;
  schema:rangeIncludes ceds:C001988 ;
  skos:notation "hasHomeLanguageSurveyAdministrationIndicator" ;
  dc11:description "An indication that the parent or guardian of this student was administered the Home Language Survey - a questionnaire given to parents or guardians that helps schools and local education agencies identify which students are potential English Learners and who will require assessment of their English language proficiency to determine whether they are eligible for language assistance services." ;
  rdfs:comment "The term \"administration\" would indicate that the results of the home language survey for this student have been provided to the school. The intent of this element is not to determine whether or not the school provided a home language survey to the parents/guardians of the student but instead to determine if the school received the results of that home language survey back from the parents/guardians of the student." ;
  ceds:editHistory ( _:genid1897 ) .

ceds:P000467
