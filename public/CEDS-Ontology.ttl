ceds:NI001517163472
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Simulated Political Process courses provide students with the opportunity to
			confront and resolve national and international issues by mirroring local, national, or
			international governmental bodies. These courses focus on government and international
			relations, conflict resolution, and policies and procedures of government. Course topics
			may include simulations of jury trials and national or international governmental
			organizations.""" ;
  dc11:identifier "NI001517163472"^^xsd:token ;
  rdfs:label "Simulated Political Process" ;
  skos:definition """Simulated Political Process courses provide students with the opportunity
			to confront and resolve national and international issues by mirroring local, national,
			or international governmental bodies. These courses focus on government and
			international relations, conflict resolution, and policies and procedures of government.
			Course topics may include simulations of jury trials and national or international
			governmental organizations.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "04167" ;
  skos:prefLabel "Simulated Political Process" .

