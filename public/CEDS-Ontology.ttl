  schema:domainIncludes ceds:C200303 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MilitaryServiceLocations" ;
  dc11:description "A description of the duty stations (locations) encompassed within a period of military service." ;
  rdfs:comment "This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements. " ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid977 ) .

ceds:P000115
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000115"^^xsd:token ;
  rdfs:label "First Name" ;
  schema:domainIncludes ceds:C200377 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FirstName" ;
  dc11:description "The full legal first name given to a person at birth, baptism, or through legal change." ;
  rdfs:comment "Workforce Note: To collect data on workforce program participation, a data match will have to be negotiated between state agencies.  The data match makes use of name, social security number, gender and ethnicity data." ;
  ceds:maxLength "35" ;
  ceds:textFormat "Alphanumeric - 75 characters maximum" ;
  ceds:editHistory (
   _:genid979
   _:genid981
 ) .

ceds:P000121
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000121"^^xsd:token ;
  rdfs:label "Generation Code or Suffix" ;
  schema:domainIncludes ceds:C200377 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "GenerationCodeOrSuffix" ;
  dc11:description "An appendage, if any, used to denote a person's generation in his family (e.g., Jr., Sr., III)." ;
  rdfs:comment "Workforce <BR/>Note: To collect data on workforce program participation, a data match will have to be negotiated between state agencies.  The data match makes use of name, social security number, gender and ethnicity data." ;
  ceds:maxLength "10" ;
  ceds:textFormat "Alphanumeric - 10 characters maximum" ;
  ceds:editHistory ( _:genid983 ) .

ceds:P000172
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000172"^^xsd:token ;
  rdfs:label "Last or Surname" ;
  schema:domainIncludes ceds:C200377 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "LastOrSurname" ;
  dc11:description "The full legal last name borne in common by members of a family." ;
  rdfs:comment "Workforce <BR/>Note: To collect data on workforce program participation, a data match will have to be negotiated between state agencies.  The data match makes use of name, social security number, gender and ethnicity data." ;
  ceds:maxLength "35" ;
  ceds:textFormat "Alphanumeric - 75 characters maximum" ;
  ceds:editHistory (
   _:genid985
   _:genid987
 ) .

ceds:P000184
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000184"^^xsd:token ;
  rdfs:label "Middle Name" ;
  schema:domainIncludes ceds:C200377 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MiddleName" ;
  dc11:description "A full legal middle name given to a person at birth, baptism, or through legal change." ;
  rdfs:comment "Workforce <BR/>Note: To collect data on workforce program participation, a data match will have to be negotiated between state agencies.  The data match makes use of name, social security number, gender and ethnicity data." ;
  ceds:maxLength "35" ;
  ceds:textFormat "Alphanumeric - 75 characters maximum" ;
  ceds:editHistory (
   _:genid989
   _:genid991
 ) .

ceds:P000212
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000212"^^xsd:token ;
  rdfs:label "Personal Title or Prefix" ;
  schema:domainIncludes ceds:C200377 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "PersonalTitleOrPrefix" ;
  dc11:description "An appellation, if any, used to denote rank, placement, or status (e.g., Mr., Ms., Reverend, Sister, Dr., Colonel)." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid993 ) .

ceds:P000206
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000206"^^xsd:token ;
  rdfs:label "Other Name" ;
  schema:domainIncludes ceds:C200304 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "OtherName" ;
  dc11:description "Previous, alternate or other names or aliases associated with the person." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" .

ceds:P001513
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001513"^^xsd:token ;
  rdfs:label "Other Last Name" ;
  schema:domainIncludes ceds:C200304 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "OtherLastName" ;
  dc11:description "A last name given to a person." ;
  rdfs:comment "Other Last Name may be repeatable and used with Other Name Type." ;
  ceds:maxLength "35" ;
  ceds:textFormat "Alphanumeric - 35 characters maximum" .

ceds:P001514
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001514"^^xsd:token ;
  rdfs:label "Other First Name" ;
  schema:domainIncludes ceds:C200304 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "OtherFirstName" ;
  dc11:description "A first name given to a person." ;
  rdfs:comment "Other First Name may be repeatable and used with Other Name Type." ;
  ceds:maxLength "35" ;
  ceds:textFormat "Alphanumeric - 35 characters maximum" .

ceds:P001515
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001515"^^xsd:token ;
  rdfs:label "Other Middle Name" ;
  schema:domainIncludes ceds:C200304 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "OtherMiddleName" ;
  dc11:description "A middle name given to a person." ;
  rdfs:comment "Other Middle Name may be repeatable and used with Other Name Type." ;
  ceds:maxLength "35" ;
  ceds:textFormat "Alphanumeric - 35 characters maximum" .

ceds:P001481
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001481"^^xsd:token ;
  rdfs:label "Referral Date" ;
  schema:domainIncludes ceds:C200307 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "ReferralDate" ;
  dc11:description "The date of referral." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001483
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001483"^^xsd:token ;
  rdfs:label "Referral Reason" ;
  schema:domainIncludes ceds:C200307 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ReferralReason" ;
  dc11:description "The reason for the referral." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001484
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001484"^^xsd:token ;
  rdfs:label "Referral Source" ;
  schema:domainIncludes ceds:C200307 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ReferralSource" ;
  dc11:description "The person, program, or organization making the initial referral." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid995 ) .

ceds:P001485
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001485"^^xsd:token ;
  rdfs:label "Referral Type Received" ;
  schema:domainIncludes ceds:C200307 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ReferralTypeReceived" ;
  dc11:description "A type of service that a child or family has received a referral for." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid997 ) .

ceds:P001486
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001486"^^xsd:token ;
  rdfs:label "Referred To" ;
  schema:domainIncludes ceds:C200307 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ReferredTo" ;
  dc11:description "The program or organization to which the child/family was referred." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001423
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001423"^^xsd:token ;
  rdfs:label "Person Relationship to Learner Contact Priority Number" ;
  schema:domainIncludes ceds:C200308 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "PersonRelationshipToLearnerContactPriorityNumber" ;
  dc11:description "The numeric order in the preferred sequence and priority for contacting a person related to the learner." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P001424
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001424"^^xsd:token ;
  rdfs:label "Person Relationship to Learner Contact Restrictions Description" ;
  schema:domainIncludes ceds:C200308 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "PersonRelationshipToLearnerContactRestrictionsDescription" ;
  dc11:description "Restrictions for student and/or teacher contact with the individual (e.g., the student may not be picked up by the individual)" ;
  ceds:textFormat "Alphanumeric" .

ceds:P001314
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001314"^^xsd:token ;
  rdfs:label "Course Number" ;
  schema:domainIncludes ceds:C200328 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseNumber" ;
  dc11:description "The official reference number portion of a course identifier.  This number normally designates the level of the course as well as the level of the individual expected to enroll in the course." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001420
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001420"^^xsd:token ;
  rdfs:label "Original Course Identifier" ;
  schema:domainIncludes ceds:C200328 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "OriginalCourseIdentifier" ;
  dc11:description "The course identifier as it was listed when the credit was earned (e.g. before a system conversion) to show consistency between present transcripts and older ones." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid999 ) .

ceds:P001422
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001422"^^xsd:token ;
  rdfs:label "Override School Course Number" ;
  schema:domainIncludes ceds:C200328 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "OverrideSchoolCourseNumber" ;
  dc11:description "An indication of the way an academic course was identified at an educational institution." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000745
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000745"^^xsd:token ;
  rdfs:label "Tuition - Published" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "TuitionPublished" ;
  dc11:description "The published tuition for first time, full-time undergraduate students (lower of in-district or in-state for public institutions).  Tuition may be charged per term, per course, per credit or per program." ;
  rdfs:comment "The tuition rate used in the calculation of the institutional \"net price\" of attendance." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000747
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000747"^^xsd:token ;
  rdfs:label "Required Student Fees" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "RequiredStudentFees" ;
  dc11:description "Fixed sum charged to persons for items not covered by tuition and required of such a large proportion of all students that the student who does not pay the charge is the exception." ;
  rdfs:comment "As defined in IPEDS" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000749
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000749"^^xsd:token ;
  rdfs:label "Room Charges" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "RoomCharges" ;
  dc11:description "The charges for an academic year for rooming accommodations for a typical student sharing a room with one other student." ;
  rdfs:comment "As defined in IPEDS" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000750
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000750"^^xsd:token ;
  rdfs:label "Board Charges" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "BoardCharges" ;
  dc11:description "The charges assessed students for an academic year for the maximum meal plan available." ;
  rdfs:comment "As defined in IPEDS" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000751
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000751"^^xsd:token ;
  rdfs:label "Books and Supplies Costs" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "BooksAndSuppliesCosts" ;
  dc11:description "The average cost for books and supplies for a typical student for an entire academic year (or program). Does not include unusual costs for special groups of students (e.g., engineering or art majors) unless they constitute the majority of students at an institution." ;
  rdfs:comment "As defined in IPEDS" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000752
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000752"^^xsd:token ;
  rdfs:label "Other Student Expenses" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "OtherStudentExpenses" ;
  dc11:description "The amount of money (estimated by the financial aid office) needed by a person to cover expenses such as laundry, transportation, and entertainment." ;
  rdfs:comment "As defined in IPEDS" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000753
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000753"^^xsd:token ;
  rdfs:label "Price of Attendance" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "PriceOfAttendance" ;
  dc11:description "The total amount institutions estimate that undergraduate-level full-time, first-time degree-seeking students will pay to attend before financial aid is considered. This price includes tuition and fees, books and supplies, room and board, and certain other designated expenses such as transportation. These estimates are the average amounts used by the financial aid office to determine a student’s financial aid." ;
  rdfs:comment "As defined in IPEDS" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000754
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000754"^^xsd:token ;
  rdfs:label "Comprehensive Fee" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "ComprehensiveFee" ;
  dc11:description "A single fixed amount of money charged by an institution that covers tuition, required fees, room, and board. For some institutions, this amount may also cover books and supplies." ;
  rdfs:comment "As defined in IPEDS" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001613
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001613"^^xsd:token ;
  rdfs:label "IPEDS Collection Year Designator" ;
  schema:domainIncludes ceds:C200330 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IPEDSCollectionYearDesignator" ;
  dc11:description "The academic year, generally extending from September to June, in which IPEDS data is collected.  Most Institutional Characteristics, Salaries, Fall Staff, Fall Enrollment, and Employees by Assigned Position data are collected for the current year; Completions, 12-Month Enrollment, Student Financial Aid, and Finance data collections cover the prior year." ;
  ceds:minLength "9" ;
  ceds:maxLength "9" ;
  ceds:textFormat "YYYY-YYYY" .

ceds:P000197
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000197"^^xsd:token ;
  rdfs:label "Normal Length of Time for Completion" ;
  schema:domainIncludes ceds:C200331 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "NormalLengthOfTimeForCompletion" ;
  dc11:description "The amount of time necessary for a person to complete all requirements for a degree or certificate according to the institution's catalog. This is typically 4 years (8 semesters or trimesters, or 12 quarters, excluding summer terms) for a bachelor's degree in a standard term-based institution; 2 years (4 semesters or trimesters, or 6 quarters, excluding summer terms) for an associate's degree in a standard term-based institution; and the various scheduled times for certificate programs." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000223
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000223"^^xsd:token ;
  rdfs:label "Program Length Hours" ;
  schema:domainIncludes ceds:C200331 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "ProgramLengthHours" ;
  dc11:description "The normal length in credit/contact hours of a person's program as published in the institution's catalogue, website, or other official documents." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001298
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001298"^^xsd:token ;
  rdfs:label "Course Academic Grade Scale Code" ;
  schema:domainIncludes ceds:C200332, ceds:C200328 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseAcademicGradeScaleCode" ;
  dc11:description "The grading scale used by an academic educational institution for an academic course." ;
  rdfs:comment "Based on the American Medical Colleges Admissions Services (AMCAS) grade scale, values 01 through 99. See Appendix E of the PESC XML High School Transcript Implementation Guide for a complete list of code values. 3-digit values (500 and above) established in earlier versions of the standard for miscellaneous grades are deprecated." ;
  ceds:minLength "2" ;
  ceds:maxLength "2" ;
  ceds:textFormat "Integer - 2 digits with leading zeros" .

ceds:P001309
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001309"^^xsd:token ;
  rdfs:label "Course Instruction Site Name" ;
  schema:domainIncludes ceds:C200333 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseInstructionSiteName" ;
  dc11:description "The name of the location at which the course is taught." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000001
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000001"^^xsd:token ;
  rdfs:label "Academic Award Date" ;
  schema:domainIncludes ceds:C200335 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AcademicAwardDate" ;
  dc11:description "The year, month and day or year and month on which the academic award was conferred." ;
  ceds:textFormat "YYYY-MM-DD or YYYY-MM" ;
  ceds:editHistory ( _:genid1001 ) .

ceds:P000003
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000003"^^xsd:token ;
  rdfs:label "Academic Award Title" ;
  schema:domainIncludes ceds:C200335 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AcademicAwardTitle" ;
  dc11:description "The descriptive title for the academic award." ;
  ceds:maxLength "80" ;
  ceds:textFormat "Alphanumeric - 80 characters maximum" .

ceds:P001665
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001665"^^xsd:token ;
  rdfs:label "Academic Award Requirements URL" ;
  schema:domainIncludes ceds:C200335 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AcademicAwardRequirementsURL" ;
  dc11:description "A URL to a page that describes the requirements for the credential." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid1003 ) .

ceds:P000018
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000018"^^xsd:token ;
  rdfs:label "Advanced Placement Credits Awarded" ;
  schema:domainIncludes ceds:C200336 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "APCreditsAwarded" ;
  dc11:description "The number of credits awarded a student by the postsecondary institution based on successful completion of advanced placement courses and/or advanced placement tests. " ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid1005 ) .

ceds:P000085
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000085"^^xsd:token ;
  rdfs:label "Dual Credit Dual Enrollment Credits Awarded" ;
  schema:domainIncludes ceds:C200336 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "DualCreditDualEnrollmentCreditsAwarded" ;
  dc11:description "The number of credits awarded a student by the postsecondary institution based on successful completion of dual credit/dual enrollment courses. " ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid1007 ) .

ceds:P000127
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000127"^^xsd:token ;
  rdfs:label "Grade Point Average" ;
  schema:domainIncludes ceds:C200336 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "GradePointAverage" ;
  dc11:description "The value of the total quality points divided by the Credit Hours for Grade Point Average. " ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 4 digits after decimal place" ;
  ceds:decimalPlaces "4" .

ceds:P000726
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000726"^^xsd:token ;
  rdfs:label "Academic Year Designator" ;
  schema:domainIncludes ceds:C200336 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AcademicYearDesignator" ;
  dc11:description "The academic year for which the data apply." ;
  ceds:minLength "9" ;
  ceds:maxLength "9" ;
  ceds:textFormat "YYYY-YYYY" ;
  ceds:editHistory (
   _:genid1009
   _:genid1011
 ) .

ceds:P001316
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001316"^^xsd:token ;
  rdfs:label "Course Total" ;
  schema:domainIncludes ceds:C200336 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "CourseTotal" ;
  dc11:description "The total number of courses listed on a transcript. Used as a check digit for integrity purposes." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P001427
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001427"^^xsd:token ;
  rdfs:label "Postsecondary Student Entering Term" ;
  schema:domainIncludes ceds:C200336 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "PostsecondaryStudentEnteringTerm" ;
  dc11:description "The term and year of the initial enrollment of an individual in credit bearing courses or developmental/remedial courses at an institution after completing high school or a high school equivalency program (e.g., GED, Adult High School Diploma)." ;
  rdfs:comment "An individual can only be an entering student once at an institution at the undergraduate level." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000265
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000265"^^xsd:token ;
  rdfs:label "Standardized Admission Test Score" ;
  schema:domainIncludes ceds:C200337 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "StandardizedAdmissionTestScore" ;
  dc11:description "The quantitative score on a standardized admission test reported to a postsecondary institution." ;
  ceds:textFormat "Numeric" .

ceds:P000759
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000759"^^xsd:token ;
  rdfs:label "High School Percentile" ;
  schema:domainIncludes ceds:C200338 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "HighSchoolPercentile" ;
  dc11:description "The High School Rank divided by the Size of High School Graduating Class expressed as a percentage." ;
  rdfs:comment "Related Connection; linked to High School Grade Point Average Cumulative, Grade Point Average Weighted Indicator, High School Rank, and Size of High School Graduating Class<BR/>0% to 99% (where 99% corresponds to the valedictorian, 0% to the bottom rank in the class)" ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "100" ;
  ceds:textFormat "Numeric - up to 3 digits before and 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001313
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001313"^^xsd:token ;
  rdfs:label "Course Narrative Explanation Grade" ;
  schema:domainIncludes ceds:C200340 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseNarrativeExplanationGrade" ;
  dc11:description "The narrative of the grade awarded to an individual in an academic course in those cases where a course does not receive a letter or numeric grade included in the grading scale of the Course Academic Grade Qualifier." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001415
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001415"^^xsd:token ;
  rdfs:label "Number of Dependents" ;
  schema:domainIncludes ceds:C200341 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "NumberOfDependents" ;
  dc11:description "The number of dependents who live with the student and receive more than half their support from them." ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid1013 ) .

ceds:P000098
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000098"^^xsd:token ;
  rdfs:label "Entry Date into Postsecondary" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "EntryDateIntoPostsecondary" ;
  dc11:description "The year, month and day on which a person entered and began to receive instructional services at a postsecondary institution for the first time after completing high school (or its equivalent). " ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000165
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000165"^^xsd:token ;
  rdfs:label "Initial Enrollment Term" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "InitialEnrollmentTerm" ;
  dc11:description "The first registration term of a person enrolling in credit-granting courses at a postsecondary institution after completing high school (or its equivalent).  " ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000168
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000168"^^xsd:token ;
  rdfs:label "Instructional Activity Hours Attempted" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "InstructionalActivityHoursAttempted" ;
  dc11:description "The number of credit hours and/or contact hours attempted by a person during a term." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000362
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000362"^^xsd:token ;
  rdfs:label "Instructional Activity Hours Completed" ;
  schema:domainIncludes ceds:C200343, ceds:C200316 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "InstructionalActivityHoursCompleted" ;
  dc11:description "The number of credit hours and/or contact hours successfully completed by a person during a term." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001325
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001325"^^xsd:token ;
  rdfs:label "Doctoral Candidacy Date" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "DoctoralCandidacyDate" ;
  dc11:description "The date on which the individual was admitted to doctoral candidate status." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001326
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001326"^^xsd:token ;
  rdfs:label "Doctoral Exam Taken Date" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "DoctoralExamTakenDate" ;
  dc11:description "The date on which the individual took an exam for advancement in, continuation or completion of a doctoral program." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001417
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001417"^^xsd:token ;
  rdfs:label "Oral Defense Date" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "OralDefenseDate" ;
  dc11:description "The date on which the individual gave an oral defense." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001496
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001496"^^xsd:token ;
  rdfs:label "Thesis or Dissertation Title" ;
  schema:domainIncludes ceds:C200343 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ThesisOrDissertationTitle" ;
  dc11:description "The title of the thesis or dissertation." ;
  ceds:textFormat "Alphanumeric" .

ceds:P000765
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000765"^^xsd:token ;
  rdfs:label "Financial Need" ;
  schema:domainIncludes ceds:C200344 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "FinancialNeed" ;
  dc11:description "The amount of financial need as determined by an institution using the federal methodology and/or your institution's own standards." ;
  rdfs:comment "Common Data Set definition" ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001352
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001352"^^xsd:token ;
  rdfs:label "Financial Aid Income Level" ;
  schema:domainIncludes ceds:C200344 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "FinancialAidIncomeLevel" ;
  dc11:description "The income level of an individual that is used by an institution's financial aid office to determine an individual's Expected Family Contribution (EFC).  For dependent students this will include the parents' adjusted gross income and the student's adjusted gross income.  For independent students this will include the student's adjusted gross income." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000053
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000053"^^xsd:token ;
  rdfs:label "Course Academic Grade" ;
  schema:domainIncludes ceds:C200346 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseAcademicGrade" ;
  dc11:description "The final grade awarded for participation in the course. " ;
  ceds:maxLength "15" ;
  ceds:textFormat "Alphanumeric - 15 characters maximum" .

ceds:P000063
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000063"^^xsd:token ;
  rdfs:label "Course Override School" ;
  schema:domainIncludes ceds:C200346 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseOverrideSchool" ;
  dc11:description "The school where the credit was earned if different from the institution reporting. " ;
  ceds:maxLength "80" ;
  ceds:textFormat "Alphanumeric - 80 characters maximum" .

ceds:P000064
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000064"^^xsd:token ;
  rdfs:label "Course Quality Points Earned" ;
  schema:domainIncludes ceds:C200346 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CourseQualityPointsEarned" ;
  dc11:description "The numerical value assigned to a letter grade to provide a basis of quantitative determination of an average. " ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000809
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000809"^^xsd:token ;
  rdfs:label "Professional Development Activity Identifier" ;
  schema:domainIncludes ceds:C200311, ceds:C200369 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentActivityIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to the Professional Development Activity as assigned by the organization offering the training." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory (
   _:genid1015
   _:genid1017
 ) .

ceds:P000810
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000810"^^xsd:token ;
  rdfs:label "Professional Development Activity Title" ;
  schema:domainIncludes ceds:C200311, ceds:C200369 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentActivityTitle" ;
  dc11:description "The title of an activity designed for the purpose of developing someone professionally." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid1019 ) .

ceds:P001432
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001432"^^xsd:token ;
  rdfs:label "Professional Development Activity Approval Code" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentActivityApprovalCode" ;
  dc11:description "A code given to an activity by an approval organization to designate it as an approved activity." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid1021 ) .

ceds:P001434
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001434"^^xsd:token ;
  rdfs:label "Professional Development Activity Code" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentActivityCode" ;
  dc11:description "A code assigned to an professional development activity by the organization offering the activity that is unique to the non-variable activity details." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001435
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001435"^^xsd:token ;
  rdfs:label "Professional Development Activity Cost" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "ProfessionalDevelopmentActivityCost" ;
  dc11:description "The cost for an attendee to participate in a professional development activity." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001437
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001437"^^xsd:token ;
  rdfs:label "Professional Development Activity Credits" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "ProfessionalDevelopmentActivityCredits" ;
  dc11:description "The number of credits a professional development activity provides." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001438
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001438"^^xsd:token ;
  rdfs:label "Professional Development Activity Description" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentActivityDescription" ;
  dc11:description "A description of the content covered in the professional development activity." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001440
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001440"^^xsd:token ;
  rdfs:label "Professional Development Activity Objective" ;
  schema:domainIncludes ceds:C200311 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentActivityObjective" ;
  dc11:description "The expected outcomes of a participant in an activity." ;
  ceds:textFormat "Alphanumeric" .

ceds:P000804
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000804"^^xsd:token ;
  rdfs:label "Required Training Clock Hours" ;
  schema:domainIncludes ceds:C200312 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "RequiredTrainingClockHours" ;
  dc11:description "Number of clock hours of training required for providers to meet requirements of the state." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001443
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001443"^^xsd:token ;
  rdfs:label "Professional Development Funding Source" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentFundingSource" ;
  dc11:description "The primary source of funding for a professional development session." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001446
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001446"^^xsd:token ;
  rdfs:label "Professional Development Session Capacity" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "ProfessionalDevelopmentSessionCapacity" ;
  dc11:description "The total number of participants that can be accommodated by a professional development session." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P001447
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001447"^^xsd:token ;
  rdfs:label "Professional Development Session End Date" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "ProfessionalDevelopmentSessionEndDate" ;
  dc11:description "The year, month and day a professional development session ends." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid1023 ) .

ceds:P001448
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001448"^^xsd:token ;
  rdfs:label "Professional Development Session End Time" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentSessionEndTime" ;
  dc11:description "The time at which a professional development session ends." ;
  ceds:textFormat "HH:MM" .

ceds:P001449
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001449"^^xsd:token ;
  rdfs:label "Professional Development Session Evaluation Method" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentSessionEvaluationMethod" ;
  dc11:description "The method used to evaluate a professional development session." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001450
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001450"^^xsd:token ;
  rdfs:label "Professional Development Session Evaluation Score" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentSessionEvaluationScore" ;
  dc11:description "The score or rating used to determine if a professional development session was successful." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001451
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001451"^^xsd:token ;
  rdfs:label "Professional Development Activity Expiration Date" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "ProfessionalDevelopmentActivityExpirationDate" ;
  dc11:description "The year, month, and day on which any certificate awarded as part of a professional development activity expires." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001452
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001452"^^xsd:token ;
  rdfs:label "Professional Development Session Identifier" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentSessionIdentifier" ;
  dc11:description "The unique, non-duplicated,  identification number assigned by the registry data system for a session of a particular professional development activity." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid1025 ) .

ceds:P001454
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001454"^^xsd:token ;
  rdfs:label "Professional Development Session Location Name" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentSessionLocationName" ;
  dc11:description "The name of a location where a professional development session will be held." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001455
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001455"^^xsd:token ;
  rdfs:label "Professional Development Session Start Date" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "ProfessionalDevelopmentSessionStartDate" ;
  dc11:description "The year, month, and day a professional development session begins." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001456
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001456"^^xsd:token ;
  rdfs:label "Professional Development Session Start Time" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ProfessionalDevelopmentSessionStartTime" ;
  dc11:description "The time at which a professional development session begins." ;
  ceds:textFormat "HH:MM" .

ceds:P001489
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001489"^^xsd:token ;
  rdfs:label "Sponsoring Agency Name" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "SponsoringAgencyName" ;
  dc11:description "The name of the sponsoring agency." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001628
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001628"^^xsd:token ;
  rdfs:label "Training and Technical Assistance Level" ;
  schema:domainIncludes ceds:C200313 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "TrainingAndTechnicalAssistanceLevel" ;
  dc11:description "The level of expertise an individual training and technical assistance specialist has based on a set of established criteria." ;
  rdfs:comment "Technical assistance may be for organizations or staff depending on context. See the document <a href=\"https://ceds.ed.gov/pdf/ceds-addresses-professional-development-data-elements.pdf\">https://ceds.ed.gov/pdf/ceds-addresses-professional-development-data-elements.pdf</a>." ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" ;
  ceds:editHistory ( _:genid1027 ) .

ceds:P000790
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000790"^^xsd:token ;
  rdfs:label "Proxy Contact Hours" ;
  schema:domainIncludes ceds:C200316 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "ProxyContactHours" ;
  dc11:description "The number of instructional hours completed by an adult enrolled in a distance learning program." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 1 digit after decimal place" ;
  ceds:decimalPlaces "1" .

ceds:P001081
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001081"^^xsd:token ;
  rdfs:label "Adult Education Postsecondary Transition Date" ;
  schema:domainIncludes ceds:C200316 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AdultEducationPostsecondaryTransitionDate" ;
  dc11:description "The year, month and day on which a person previously enrolled in adult education entered and began to receive instructional services or training at a postsecondary institution." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001583
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001583"^^xsd:token ;
  rdfs:label "Career Pathways Program Participation Exit Date" ;
  schema:domainIncludes ceds:C200318 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CareerPathwaysProgramParticipationExitDate" ;
  dc11:description "The year, month and day on which the person ceased to participate in a program." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid1029 ) .

ceds:P001584
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001584"^^xsd:token ;
  rdfs:label "Career Pathways Program Participation Start Date" ;
  schema:domainIncludes ceds:C200318 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CareerPathwaysProgramParticipationStartDate" ;
  dc11:description "The year, month and day on which the person began to participate in a career pathway program." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000171
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000171"^^xsd:token ;
  rdfs:label "Last Qualifying Move Date" ;
  schema:domainIncludes ceds:C200320 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "LastQualifyingMoveDate" ;
  dc11:description "The year, month and day of the last qualifying move of a migrant student." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000430
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000430"^^xsd:token ;
  rdfs:label "Migrant Education Program Eligibility Expiration Date" ;
  schema:domainIncludes ceds:C200320 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "MigrantEducationProgramEligibilityExpirationDate" ;
  dc11:description "The year, month, and day on which the child is no longer eligible for the Migrant Education Program. This date should initially be a date equal to 36 months from the Qualifying Arrival Date to indicate the end of MEP eligibility or the student reaches 22 years of age, whichever comes first." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000432
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000432"^^xsd:token ;
  rdfs:label "Migrant Student Qualifying Arrival Date" ;
  schema:domainIncludes ceds:C200320 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "MigrantStudentQualifyingArrivalDate" ;
  dc11:description "The qualifying arrival date (QAD) is the month, date, and year that the child completed a move with his or her parent to enable the parent to find qualifying employment. In some cases, the child and worker may not always move together, in which case the QAD would be the date that the child joins the worker who has  already moved, or the date the worker joins the child who has already moved. The QAD is the date the child's eligibility for the Migrant Education Program begins." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000433
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000433"^^xsd:token ;
  rdfs:label "Qualifying Move From City" ;
  schema:domainIncludes ceds:C200320 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "QualifyingMoveFromCity" ;
  dc11:description "The name of the city in which the child resided prior to the qualifying move." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000436
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000436"^^xsd:token ;
  rdfs:label "Designated Graduation School Identifier" ;
  schema:domainIncludes ceds:C200320 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "DesignatedGraduationSchoolIdentifier" ;
  dc11:description "The NCES school identification number that identifies the school or facility from which a student expects to graduate." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid1031 ) .

ceds:P000263
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000263"^^xsd:token ;
  rdfs:label "Special Education Services Exit Date" ;
  schema:domainIncludes ceds:C200322 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "SpecialEducationServicesExitDate" ;
  dc11:description "The year, month and day a child with disabilities (IDEA) ages 14 through 21 exited special education." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid1033 ) .

ceds:P001242
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001242"^^xsd:token ;
  rdfs:label "Special Education Full Time Equivalency" ;
  schema:domainIncludes ceds:C200322, ceds:C200360 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "SpecialEducationFTE" ;
  dc11:description "Calculated ratio of time the student is in a special education setting. Values range from 0.00 to 1.00. If the student is in a special education setting 25% of the time, the value is .25; if 100% of the time, the value is 1.00." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "1" ;
  ceds:textFormat "Numeric - between 0 and 1, up to 2 digits" ;
  ceds:decimalPlaces "2" .

ceds:P001704
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001704"^^xsd:token ;
  rdfs:label "IDEA Placement Rationale" ;
  schema:domainIncludes ceds:C200322 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IDEAPlacementRationale" ;
  dc11:description "The rationale for the placement decision and if applicable, an explanation of the extent, if any, to which the child will not participate with nondisabled children in the regular class and in the activities described in paragraph (a)(4) of CFR. §300.320." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid1035 ) .

ceds:P000772
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000772"^^xsd:token ;
  rdfs:label "Supervised Clinical Experience Clock Hours" ;
  schema:domainIncludes ceds:C200323 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "SupervisedClinicalExperienceClockHours" ;
  dc11:description "An indication of  the number of clock hours (minimum) a student is required to complete associated with a supervised clinical experience." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000989
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000989"^^xsd:token ;
  rdfs:label "Quarterly Earnings" ;
  schema:domainIncludes ceds:C200347 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "QuarterlyEarnings" ;
  dc11:description "The quarterly amount paid to individuals found employed during the reference period." ;
  rdfs:comment "Workforce Notes: Quarterly earnings are the sum of all the reported earnings for each individual for all jobs held during the reference quarter. \"Reference\" quarter is the period of employment defined by the agency for its purposes either for students who are enrolled or after they exit. The amount is expressed as a numeric dollar amount. Note that it may be desirable to collect these data over time, in a longitudinal sense, to measure things related to persistence and growth in employment." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid1037 ) .

ceds:P000992
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000992"^^xsd:token ;
  rdfs:label "Employment Record Reference Period Start Date" ;
  schema:domainIncludes ceds:C200347 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "EmploymentRecordReferencePeriodStartDate" ;
  dc11:description "The year, month, and day of the first day of the employment record reference period." ;
  rdfs:comment "The reference quarter is the 13-week period around which employment and earnings data are collected. For unemployment insurance purposes, quarters are defined by 13-week periods. In most state cases, a reference quarter is defined to coincide with an enrollment period (e.g., a term or semester) or as a certain number of quarters after exiting a program, such as \"3d quarter after exit.\" In some cases, states have defined the reference quarter to represent a period where employment and earnings data are collected for all of a previous year's exits and graduates. This is often the October- December quarter. Ultimately, the most value to be gained from the use of employment and earnings data is when data are collected continuously, both in a longitudinal sense for defined cohorts of students, as well as for an \"annual set\" of students." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid1039 ) .

ceds:P000993
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000993"^^xsd:token ;
  rdfs:label "Employment Record Reference Period End Date" ;
  schema:domainIncludes ceds:C200347 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "EmploymentRecordReferencePeriodEndDate" ;
  dc11:description "The year, month, and day of the last day of the employment record reference period." ;
  rdfs:comment "The reference quarter is the 13-week period around which employment and earnings data are collected. For unemployment insurance purposes, quarters are defined by 13-week periods. In most state cases, a reference quarter is defined to coincide with an enrollment period (e.g., a term or semester) or as a certain number of quarters after exiting a program, such as \"3d quarter after exit.\" In some cases, states have defined the reference quarter to represent a period where employment and earnings data are collected for all of a previous year's exits and graduates. This is often the October - December quarter. Ultimately, the most value to be gained from the use of employment and earnings data is when data are collected continuously, both in a longitudinal sense for defined cohorts of students, as well as for an \"annual set\" of students." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid1041
   _:genid1043
 ) .

ceds:P000201
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000201"^^xsd:token ;
  rdfs:label "Number of Days Absent" ;
  schema:domainIncludes ceds:C200350 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "NumberOfDaysAbsent" ;
  dc11:description "The number of days a person is absent when school is in session during a given reporting period." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory (
   _:genid1045
   _:genid1047
 ) .

ceds:P000271
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000271"^^xsd:token ;
  rdfs:label "Student Attendance Rate" ;
  schema:domainIncludes ceds:C200350 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "StudentAttendanceRate" ;
  dc11:description "The number of school days during the regular school year (plus summer, if applicable, if part of implementing the restart, transformation, or turnaround model) the student attended school divided by the maximum number of days the student could have attended school during the regular school year." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "1" ;
  ceds:textFormat "Numeric - between 0 and 1" ;
  ceds:decimalPlaces "6" .

ceds:P001957
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001957"^^xsd:token ;
  rdfs:label "Number of Days Tardy" ;
  schema:domainIncludes ceds:C200350 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "NumberofDaysTardy" ;
  dc11:description "The number of days a person is tardy when school is in session during a given reporting period." ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:editHistory ( _:genid1049 ) .

ceds:P001649
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001649"^^xsd:token ;
  rdfs:label "Attendance Event Date" ;
  schema:domainIncludes ceds:C200351 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AttendanceEventDate" ;
  dc11:description "The date on which an attendance event takes place." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid1051 ) .

ceds:P002014
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002014"^^xsd:token ;
  rdfs:label "Attendance Event Duration Minutes" ;
  schema:domainIncludes ceds:C200351 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AttendanceEventDurationMinutes" ;
  dc11:description "The duration of the attendance event in minutes." ;
  ceds:textFormat "Numeric - up to 2 decimal places" ;
  ceds:editHistory ( _:genid1053 ) .

ceds:P002015
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002015"^^xsd:token ;
  rdfs:label "Attendance Event Duration Hours" ;
  schema:domainIncludes ceds:C200351 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AttendanceEventDurationHours" ;
  dc11:description "The duration of the attendance event in hours." ;
  ceds:textFormat "Numeric - up to 2 decimal places" ;
  ceds:editHistory ( _:genid1055 ) .

ceds:P002098
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002098"^^xsd:token ;
  rdfs:label "Attendance Event Duration Day" ;
  schema:domainIncludes ceds:C200351 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AttendanceEventDurationDay" ;
  dc11:description "The duration of the attendance event captured as one whole day or a portion of a day." ;
  rdfs:comment "When used to capture daily attendance, 1.0 would represent a whole day. Other examples would include 0.5 as a half-day and 0.33 as one-third of a day. For capturing course section attendance, the recommendation would be to use the element \"Attendance Event Duration Minutes\"." ;
  ceds:textFormat "Numeric - up to 2 decimal places" ;
  ceds:editHistory ( _:genid1057 ) .

ceds:P000975
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000975"^^xsd:token ;
  rdfs:label "Course Section Enrollment Status End Date" ;
  schema:domainIncludes ceds:C200213 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "CourseSectionEnrollmentStatusEndDate" ;
  dc11:description "The date on which the enrollment status ended related to a student enrolled in an instance of a course." ;
  rdfs:comment "Enrollment statuses may overlap, for example at one point in time a student may be both pre-registered and wait-listed for enrollment in a course, the start dates may be different and the end dates may be the same as the start date for \"enrolled\" status when the student moves off the wait list. All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid1059
   _:genid1061
   _:genid1063
 ) .

ceds:P000421
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000421"^^xsd:token ;
  rdfs:label "Rubric Title" ;
  schema:domainIncludes ceds:C200353 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentRubricTitle" ;
  dc11:description "The title of the rubric." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid1065 ) .

ceds:P000422
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000422"^^xsd:token ;
  rdfs:label "Rubric Identifier" ;
  schema:domainIncludes ceds:C200353 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentRubricIdentifier" ;
  dc11:description "An identifier assigned to a rubric." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory (
   _:genid1067
   _:genid1069
 ) .

ceds:P000423
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000423"^^xsd:token ;
  rdfs:label "Rubric URL Reference" ;
  schema:domainIncludes ceds:C200353 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentRubricURLReference" ;
  dc11:description "The URL location where the rubric may be found." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory (
   _:genid1071
   _:genid1073
 ) .

ceds:P001479
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001479"^^xsd:token ;
  rdfs:label "Rubric Description" ;
  schema:domainIncludes ceds:C200353 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "RubricDescription" ;
  dc11:description "Text describing the intended use of the rubric." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001469
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001469"^^xsd:token ;
  rdfs:label "Rubric Criterion Category" ;
  schema:domainIncludes ceds:C200354 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "RubricCriterionCategory" ;
  dc11:description "A textual label for category by which Rubric Criterion may be grouped." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001470
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001470"^^xsd:token ;
  rdfs:label "Rubric Criterion Description" ;
  schema:domainIncludes ceds:C200354 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "RubricCriterionDescription" ;
  dc11:description "Text describing a criterion that must be met to demonstrate quality for a product, process, or performance task." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001476
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001476"^^xsd:token ;
  rdfs:label "Rubric Criterion Position" ;
  schema:domainIncludes ceds:C200354 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "RubricCriterionPosition" ;
  dc11:description "A numeric value representing this criterion's position in the criteria list for this rubric." ;
  ceds:textFormat "Numeric" .

ceds:P001477
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001477"^^xsd:token ;
  rdfs:label "Rubric Criterion Title" ;
  schema:domainIncludes ceds:C200354 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "RubricCriterionTitle" ;
  dc11:description "The title of the rubric criterion." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001478
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001478"^^xsd:token ;
  rdfs:label "Rubric Criterion Weight" ;
  schema:domainIncludes ceds:C200354 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "RubricCriterionWeight" ;
  dc11:description "A numeric weight assigned to this Rubric Criterion, used for scored rubrics." ;
  ceds:textFormat "Numeric" .

ceds:P001471
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001471"^^xsd:token ;
  rdfs:label "Rubric Criterion Level Description" ;
  schema:domainIncludes ceds:C200355 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "RubricCriterionLevelDescription" ;
  dc11:description "Text describing  one or more benchmarks that must be met to achieve a degree of achievement on a product, process, or performance task." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001472
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001472"^^xsd:token ;
  rdfs:label "Rubric Criterion Level Feedback" ;
  schema:domainIncludes ceds:C200355 ;
