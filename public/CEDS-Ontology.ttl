ceds:NI001517163008
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "International Baccalaureate (IB) Personal Project, Middle Years Program courses occur during the final year of the program and should result in a significant piece of work that is the product of the student's own initiative and creativity. Students choose their projects, which may take many forms, and complete them under the supervision of a teacher. Projects involve planning, research, and a high degree of personal reflection." ;
  dc11:identifier "NI001517163008"^^xsd:token ;
  rdfs:label "IB Personal Project, Middle Years Program" ;
  skos:definition "International Baccalaureate (IB) Personal Project, Middle Years Program courses occur during the final year of the program and should result in a significant piece of work that is the product of the student's own initiative and creativity. Students choose their projects, which may take many forms, and complete them under the supervision of a teacher. Projects involve planning, research, and a high degree of personal reflection." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "22260" ;
  skos:prefLabel "IB Personal Project, Middle Years Program" .

ceds:NI001517163009
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Developmental Support courses are customized according to each student's condition and needs, emphasizing an increase in skill or control of body and mind function. Examples of support may include refinement of gross and fine motor skills, development of visual perception, and improvement in eye-hand coordination." ;
  dc11:identifier "NI001517163009"^^xsd:token ;
  rdfs:label "Developmental Support" ;
  skos:definition "Developmental Support courses are customized according to each student's condition and needs, emphasizing an increase in skill or control of body and mind function. Examples of support may include refinement of gross and fine motor skills, development of visual perception, and improvement in eye-hand coordination." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "22254" ;
  skos:prefLabel "Developmental Support" .

ceds:NI001517163010
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Social Development Instruction courses teach students the social skills
			needed for independent functioning with the community. Topics may include self-control,
			self-expression, obeying rules, decision-making, appropriate situational behavior,
			interacting with others, and maintaining relationships. Students may develop
			independence, self-confidence, and self-reliance.""" ;
  dc11:identifier "NI001517163010"^^xsd:token ;
  rdfs:label "Social Development Instruction" ;
  skos:definition """Social Development Instruction courses teach students the social skills
			needed for independent functioning with the community. Topics may include self-control,
			self-expression, obeying rules, decision-making, appropriate situational behavior,
			interacting with others, and maintaining relationships. Students may develop
			independence, self-confidence, and self-reliance.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "22253" ;
  skos:prefLabel "Social Development Instruction" .

ceds:NI001517163011
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Communication Instruction courses are typically indiviualized according to each student's condition and needs. Increasing the student's communication skills—oral expression, listening comprehension, reading, and writing—is emphasized; communication techniques in several areas (Educational, social, and vocational) are often explored." ;
  dc11:identifier "NI001517163011"^^xsd:token ;
  rdfs:label "Communication Instruction" ;
  skos:definition "Communication Instruction courses are typically indiviualized according to each student's condition and needs. Increasing the student's communication skills—oral expression, listening comprehension, reading, and writing—is emphasized; communication techniques in several areas (Educational, social, and vocational) are often explored." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "22252" ;
  skos:prefLabel "Communication Instruction" .

ceds:NI001517163012
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Korean IV courses prepare students to communicate authentically in Korean by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information, concepts, and ideas on a variety of topics, including connections to other subject areas. Korean IV courses promote students' understanding of the relationships among the products, practices, and perspectives of Korean-speaking countries and cultures." ;
  dc11:identifier "NI001517163012"^^xsd:token ;
  rdfs:label "Korean IV" ;
  skos:definition "Korean IV courses prepare students to communicate authentically in Korean by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information, concepts, and ideas on a variety of topics, including connections to other subject areas. Korean IV courses promote students' understanding of the relationships among the products, practices, and perspectives of Korean-speaking countries and cultures." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24505" ;
  skos:prefLabel "Korean IV" .

ceds:NI001517163013
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
