ceds:NI001517164476
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Community Service courses provide students with the opportunity to volunteer
			their time, energy, and talents to serve a community project or organization. These
			courses are usually (but not always) conducted with a seminar component, so that
			students can use their volunteer experiences to learn how to solve problems, make
			decisions, and communicate effectively.""" ;
  dc11:identifier "NI001517164476"^^xsd:token ;
