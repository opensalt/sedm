  skos:prefLabel "Particular Topics in Networking Systems" .

ceds:NI001517163891
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Local Area Networking courses introduce students to local area networking
			(LAN) administration skills, operating systems, basic user skills, defining network
			objects, building a simple LAN topology applying principles of cabling, LAN switching,
			designing file systems, managing user access, securing file systems, working with
			directory service software security, implementing network printing, implementing login
			scripts, and managing user environments.""" ;
  dc11:identifier "NI001517163891"^^xsd:token ;
  rdfs:label "Local Area Networking" ;
  skos:definition """Local Area Networking courses introduce students to local area networking
			(LAN) administration skills, operating systems, basic user skills, defining network
			objects, building a simple LAN topology applying principles of cabling, LAN switching,
			designing file systems, managing user access, securing file systems, working with
			directory service software security, implementing network printing, implementing login
			scripts, and managing user environments.""" ;
  skos:inScheme ceds:C001517 ;
