ceds:NI001517163298
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Pre-Calculus courses combine the study of Trigonometry, Elementary
			Functions, Analytic Geometry, and Mathematic Analysis topics as preparation for
			calculus. Topics typically include the study of complex numbers; polynomial,
			logarithmic, exponential, rational, trigonometric, and circular functions, and their
			relations, inverses and graphs; trigonometric identities and equations; solutions of
			right and oblique triangles; vectors; the polar coordinate system; conic sections;
			Boolean algebra and symbolic logic; mathematical induction; matrix algebra; sequences
			and series; modeling linear, quadratic, exponential, and trigonometric data; and limits
			and continuity.""" ;
