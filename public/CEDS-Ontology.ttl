ceds:P002034
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002034"^^xsd:token ;
  rdfs:label "Has Military Country" ;
  dc11:description "The unique two character International Organization for Standardization (ISO) code for the country in whose military a person serves or served." ;
  skos:definition "The unique two character International Organization for Standardization (ISO) code for the country in whose military a person serves or served." ;
  schema:domainIncludes ceds:C200296 ;
  schema:rangeIncludes ceds:C000050 ;
  skos:notation "hasMilitaryCountry" ;
  rdfs:comment "This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements. The CEDS Country Code option set comes from the ISO 3166 standard, the short name for Officially assigned codes. Discontinued codes from the ISO standard are not included in the CEDS list. This element is intended to show when a person is serving or has served in another country's military, not the country in which they serve as part of the US Military." ;
  ceds:textFormat "Option Set" ;
  ceds:editHistory ( _:genid2409 ) .

