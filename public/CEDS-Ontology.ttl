  dc11:identifier "P001652"^^xsd:token ;
  rdfs:label "Charter School Contract Approval Date" ;
  schema:domainIncludes ceds:C200199 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CharterSchoolContractApprovalDate" ;
  dc11:description "The effective date of the contract (or charter) that an approved charter school authorizer authorized the charter school to operate in the state under the state's charter school legislation." ;
  ceds:textFormat "YYYY-MM-DD" .

