  ceds:textFormat "Alphanumeric" .

ceds:P001204
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001204"^^xsd:token ;
  rdfs:label "Assessment Asset Content URL" ;
  schema:domainIncludes ceds:C200015 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentAssetContentURL" ;
  dc11:description "The Uniform Resource Locator (URL) location of the external Assessment Asset content." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid71 ) .

ceds:P000024
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000024"^^xsd:token ;
