  schema:rangeIncludes xsd:string ;
  skos:notation "LearningResourceAuthorURL" ;
  dc11:description "A Uniform Resource Locator (URL) attributed to the author of a learning resource." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" .

ceds:P001564
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001564"^^xsd:token ;
