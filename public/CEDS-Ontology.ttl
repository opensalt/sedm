ceds:NI001517164437
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Technology Innovation and Assessment courses use engineering design
			activities to help students understand how criteria, constraints, and processes affect
			design solutions and provide students with the skills to systematically assess
			technological developments or solutions. Course topics may include brainstorming,
			visualizing, modeling, simulating, constructing, testing, and refining designs.""" ;
  dc11:identifier "NI001517164437"^^xsd:token ;
  rdfs:label "Technology Innovation and Assessment" ;
  skos:definition """Technology Innovation and Assessment courses use engineering design
