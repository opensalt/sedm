  a owl:NamedIndividual, ceds:C001555, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A program for adults and out-of-school youth (typically 16 years of age and
			older who are not regularly enrolled in school) who have completed, interrupted, or not
			begun their formal education and are pursuing skills or knowledge in other than
