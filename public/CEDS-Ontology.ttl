  skos:prefLabel "Permanently restricted net assets" .

ceds:NI001671127618
  a owl:NamedIndividual, ceds:C001671, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting net assets that are subject to a donor’s or grantor’s
			restriction are restricted net assets. Include long-term but temporarily restricted net
			assets, such as term endowments, and net assets held subject to trust agreements if
			those agreements permit expenditure of the resources at a future date. (FARM para.
			450.3)""" ;
  dc11:identifier "NI001671127618"^^xsd:token ;
  rdfs:label "Temporarily restricted net assets" ;
  skos:definition """Used for reporting net assets that are subject to a donor’s or grantor’s
			restriction are restricted net assets. Include long-term but temporarily restricted net
			assets, such as term endowments, and net assets held subject to trust agreements if
			those agreements permit expenditure of the resources at a future date. (FARM para.
			450.3)""" ;
  skos:inScheme ceds:C001671 ;
  skos:notation "Temporarilyrestrictednetassets" ;
  skos:prefLabel "Temporarily restricted net assets" .

