ceds:NI001517164444
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Standardized Test Preparation courses help prepare students for national
			standardized tests such as the PSAT, SAT, and ACT. In particular, these courses assist
			students in developing and/or expanding their vocabulary, test-taking, and reasoning
			skills through study, lecture, and practice drills. Course topics may include vocabulary
			review; root words, prefixes, and suffixes; mathematical concepts, logic, and rules; and
			general problem-solving and test-taking strategies.""" ;
  dc11:identifier "NI001517164444"^^xsd:token ;
  rdfs:label "Standardized Test Preparation" ;
