ceds:NI001670127577
  a owl:NamedIndividual, ceds:C001670, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting all capital assets reduced by the total accumulated
			depreciation, including improvements to land, easements, buildings, building
			improvements, vehicles, machinery, equipment, infrastructure, and all other tangible or
			intangible depreciable assets that are used in operations and that have initial useful
			lives extending beyond a single reporting period. Includes the net amount of all
			depreciable capital assets after reducing the gross amount for accumulated depreciation.""" ;
  dc11:identifier "NI001670127577"^^xsd:token ;
  rdfs:label "Depreciable capital assets, net of depreciation" ;
  skos:definition """Used for reporting all capital assets reduced by the total accumulated
			depreciation, including improvements to land, easements, buildings, building
			improvements, vehicles, machinery, equipment, infrastructure, and all other tangible or
			intangible depreciable assets that are used in operations and that have initial useful
			lives extending beyond a single reporting period. Includes the net amount of all
			depreciable capital assets after reducing the gross amount for accumulated depreciation.""" ;
  skos:inScheme ceds:C001670 ;
  skos:notation "Depreciablecapitalassetsnetofdepreciation" ;
  skos:prefLabel "Depreciable capital assets, net of depreciation" .

