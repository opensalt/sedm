ceds:NI001158104266
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The custom interaction provides an opportunity for extensibility of this
			specification to include support for interactions not currently documented.""" ;
  dc11:identifier "NI001158104266"^^xsd:token ;
  rdfs:label "Custom Interaction" ;
  skos:definition """The custom interaction provides an opportunity for extensibility of this
			specification to include support for interactions not currently documented.""" ;
  skos:inScheme ceds:C001158 ;
  skos:notation "CustomInteraction" ;
  skos:prefLabel "Custom Interaction" .

ceds:NI001158104267
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The drawing interaction allows the candidate to use a common set of drawing
			tools to modify a given graphical image (the canvas). It must be bound to a response
			variable with base-type file and single cardinality. The result is a file in the same
			format as the original image.""" ;
  dc11:identifier "NI001158104267"^^xsd:token ;
  rdfs:label "Drawing Interaction" ;
  skos:definition """The drawing interaction allows the candidate to use a common set of drawing
			tools to modify a given graphical image (the canvas). It must be bound to a response
			variable with base-type file and single cardinality. The result is a file in the same
			format as the original image.""" ;
  skos:inScheme ceds:C001158 ;
  skos:notation "DrawingInteraction" ;
  skos:prefLabel "Drawing Interaction" .

ceds:NI001158104268
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A gap match interaction contains a number gaps that the candidate can fill
			from an associated set of choices. The candidate must be able to review the content with
			the gaps filled in context, as indicated by their choices.""" ;
  dc11:identifier "NI001158104268"^^xsd:token ;
  rdfs:label "Gap Match Interaction" ;
  skos:definition """A gap match interaction contains a number gaps that the candidate can fill
			from an associated set of choices. The candidate must be able to review the content with
			the gaps filled in context, as indicated by their choices.""" ;
  skos:inScheme ceds:C001158 ;
  skos:notation "GapMatchInteraction" ;
  skos:prefLabel "Gap Match Interaction" .

ceds:NI001158104269
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A match interaction presents candidates with two sets of choices and allows
			them to create associates between pairs of choices in the two sets, but not between
			pairs of choices in the same set. Further restrictions can still be placed on the
			allowable associations using the matchMax attribute of the choices.""" ;
  dc11:identifier "NI001158104269"^^xsd:token ;
  rdfs:label "Match Interaction" ;
  skos:definition """A match interaction presents candidates with two sets of choices and allows
			them to create associates between pairs of choices in the two sets, but not between
			pairs of choices in the same set. Further restrictions can still be placed on the
			allowable associations using the matchMax attribute of the choices.""" ;
  skos:inScheme ceds:C001158 ;
  skos:notation "MatchInteraction" ;
  skos:prefLabel "Match Interaction" .

ceds:NI001158104270
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "A graphic gap-match interaction is a graphical interaction with a set of gaps that are defined as areas (hotspots) of the graphic image and an additional set of gap choices that are defined outside the image. The candidate must associate the gap choices with the gaps in the image and be able to review the image with the gaps filled in context, as indicated by their choices. Care should be taken when designing these interactions to ensure that the gaps in the image are a suitable size to receive the required gap choices. It must be clear to the candidate which hotspot each choice has been associated with. When associated, choices must appear wholly inside the gaps if at all possible and, where overlaps are required, should not hide each other completely. If the candidate indicates the association by positioning the choice over the gap (e.g., drag and drop) the system should 'snap' it to the nearest position that satisfies these requirements." ;
  dc11:identifier "NI001158104270"^^xsd:token ;
  rdfs:label "Graphic Gap Match Interaction" ;
  skos:definition "A graphic gap-match interaction is a graphical interaction with a set of gaps that are defined as areas (hotspots) of the graphic image and an additional set of gap choices that are defined outside the image. The candidate must associate the gap choices with the gaps in the image and be able to review the image with the gaps filled in context, as indicated by their choices. Care should be taken when designing these interactions to ensure that the gaps in the image are a suitable size to receive the required gap choices. It must be clear to the candidate which hotspot each choice has been associated with. When associated, choices must appear wholly inside the gaps if at all possible and, where overlaps are required, should not hide each other completely. If the candidate indicates the association by positioning the choice over the gap (e.g., drag and drop) the system should 'snap' it to the nearest position that satisfies these requirements." ;
  skos:inScheme ceds:C001158 ;
  skos:notation "GraphicGapMatchInteraction" ;
  skos:prefLabel "Graphic Gap Match Interaction" .

ceds:NI001158104271
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "A hotspot interaction is a graphical interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to select one or more of the areas (hotspots). The hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, choiceInteraction should be used instead with separate material for each option." ;
  dc11:identifier "NI001158104271"^^xsd:token ;
  rdfs:label "Hotspot Interaction" ;
  skos:definition "A hotspot interaction is a graphical interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to select one or more of the areas (hotspots). The hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, choiceInteraction should be used instead with separate material for each option." ;
  skos:inScheme ceds:C001158 ;
  skos:notation "HotspotInteraction" ;
  skos:prefLabel "Hotspot Interaction" .

ceds:NI001158104272
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "A graphic order interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to impose an ordering on the areas (hotspots). The order hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, orderInteraction should be used instead with separate material for each option." ;
  dc11:identifier "NI001158104272"^^xsd:token ;
  rdfs:label "Graphic Order Interaction" ;
  skos:definition "A graphic order interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to impose an ordering on the areas (hotspots). The order hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, orderInteraction should be used instead with separate material for each option." ;
  skos:inScheme ceds:C001158 ;
  skos:notation "GraphicOrderInteraction" ;
  skos:prefLabel "Graphic Order Interaction" .

ceds:NI001158104279
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "In an order interaction the candidate's task is to reorder the choices, the order in which the choices are displayed initially is significant. By default the candidate's task is to order all of the choices but a subset of the choices can be requested using the maxChoices and minChoices attributes. When specified the candidate must select a subset of the choices and impose an ordering on them." ;
  dc11:identifier "NI001158104279"^^xsd:token ;
  rdfs:label "Order Interaction" ;
  skos:definition "In an order interaction the candidate's task is to reorder the choices, the order in which the choices are displayed initially is significant. By default the candidate's task is to order all of the choices but a subset of the choices can be requested using the maxChoices and minChoices attributes. When specified the candidate must select a subset of the choices and impose an ordering on them." ;
  skos:inScheme ceds:C001158 ;
  skos:notation "OrderInteraction" ;
  skos:prefLabel "Order Interaction" .

ceds:NI001158104274
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "A graphic associate interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to associate the areas (hotspots) with each other. The graphic associate interaction should only be used when the graphical relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, associateInteraction should be used instead with separate Material for each option. SliderInteraction -- The slider interaction presents the candidate with a control for selecting a numerical value between a lower and upper bound. It must be bound to a response variable with single cardinality with a base-type of either integer or float." ;
  dc11:identifier "NI001158104274"^^xsd:token ;
  rdfs:label "Graphic Associate Interaction" ;
  skos:definition "A graphic associate interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to associate the areas (hotspots) with each other. The graphic associate interaction should only be used when the graphical relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, associateInteraction should be used instead with separate Material for each option. SliderInteraction -- The slider interaction presents the candidate with a control for selecting a numerical value between a lower and upper bound. It must be bound to a response variable with single cardinality with a base-type of either integer or float." ;
  skos:inScheme ceds:C001158 ;
  skos:notation "GraphicAssociateInteraction" ;
  skos:prefLabel "Graphic Associate Interaction" .

ceds:NI001158104275
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "The choice interaction presents a set of choices to the candidate. The candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is always initialized with no choices selected." ;
  dc11:identifier "NI001158104275"^^xsd:token ;
  rdfs:label "Choice Interaction" ;
  skos:definition "The choice interaction presents a set of choices to the candidate. The candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is always initialized with no choices selected." ;
  skos:inScheme ceds:C001158 ;
  skos:notation "ChoiceInteraction" ;
  skos:prefLabel "Choice Interaction" .

ceds:NI001158104276
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "A inline choice is an inlineInteraction that presents the user with a set of choices, each of which is a simple piece of text. The candidate's task is to select one of the choices. Unlike the choiceInteraction, the delivery engine must allow the candidate to review their choice within the context of the surrounding text." ;
  dc11:identifier "NI001158104276"^^xsd:token ;
  rdfs:label "Inline Choice Interaction" ;
  skos:definition "A inline choice is an inlineInteraction that presents the user with a set of choices, each of which is a simple piece of text. The candidate's task is to select one of the choices. Unlike the choiceInteraction, the delivery engine must allow the candidate to review their choice within the context of the surrounding text." ;
  skos:inScheme ceds:C001158 ;
  skos:notation "InlineChoiceInteraction" ;
  skos:prefLabel "Inline Choice Interaction" .

ceds:NI001158104277
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The media interaction allows more control over the way the candidate
			interacts with a time-based media object and allows the number of times the media object
			was experienced to be reported in the value of the associated response variable, which
			must be of base-type integer and single cardinality.""" ;
  dc11:identifier "NI001158104277"^^xsd:token ;
  rdfs:label "Media Interaction" ;
  skos:definition """The media interaction allows more control over the way the candidate
			interacts with a time-based media object and allows the number of times the media object
			was experienced to be reported in the value of the associated response variable, which
			must be of base-type integer and single cardinality.""" ;
  skos:inScheme ceds:C001158 ;
  skos:notation "MediaInteraction" ;
  skos:prefLabel "Media Interaction" .

ceds:NI001158104278
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "The hottext interaction presents a set of choices to the candidate represented as selectable runs of text embedded within a surrounding context, such as a simple passage of text. Like choiceInteraction, the candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is initialized from the defaultValue of the associated response variable, a NULL value indicating that no choices are selected (the usual case)." ;
  dc11:identifier "NI001158104278"^^xsd:token ;
  rdfs:label "Hottext Interaction" ;
  skos:definition "The hottext interaction presents a set of choices to the candidate represented as selectable runs of text embedded within a surrounding context, such as a simple passage of text. Like choiceInteraction, the candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is initialized from the defaultValue of the associated response variable, a NULL value indicating that no choices are selected (the usual case)." ;
  skos:inScheme ceds:C001158 ;
  skos:notation "HottextInteraction" ;
  skos:prefLabel "Hottext Interaction" .

ceds:NI001158104280
  a owl:NamedIndividual, ceds:C001158, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The position object interaction consists of a single image which must be
			positioned on another graphic image (the stage) by the candidate. Like
			selectPointInteraction, the associated response may have an areaMapping that scores the
			response on the basis of comparing it against predefined areas but the delivery engine
			must not indicate these areas of the stage. Only the actual position(s) selected by the
			candidate shall be indicated.""" ;
  dc11:identifier "NI001158104280"^^xsd:token ;
  rdfs:label "Position Object Interaction" ;
  skos:definition """The position object interaction consists of a single image which must be
			positioned on another graphic image (the stage) by the candidate. Like
			selectPointInteraction, the associated response may have an areaMapping that scores the
			response on the basis of comparing it against predefined areas but the delivery engine
			must not indicate these areas of the stage. Only the actual position(s) selected by the
			candidate shall be indicated.""" ;
  skos:inScheme ceds:C001158 ;
  skos:notation "PositionObjectInteraction" ;
  skos:prefLabel "Position Object Interaction" .

