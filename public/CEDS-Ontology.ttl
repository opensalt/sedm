  rdfs:label "Hire Date" ;
  schema:domainIncludes ceds:C200365 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "HireDate" ;
  dc11:description "The year, month and day on which a person was hired for a position, or consecutive positions within the same organization and job classification." ;
  rdfs:comment "This is the Hire Date beginning consecutive employment with the current employer in the same Professional-Educational Job Classification. A person may change positions within the same organization and job classification without triggering a new hire date. For example a teacher originally hire to teach 3rd grade may be reassigned to 4th grade.  However, a change of job classifications, e.g. from teacher to principal, would trigger a new Hire Date." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid1111 ) .

