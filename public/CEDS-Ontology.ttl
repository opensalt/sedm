ceds:NI000273172808
  a owl:NamedIndividual, ceds:C000273, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Programs that help participants develop or refine their communication
			skills, usually by focusing on communication in a particular context (e.g., helping a
			parent/guardian communicate with a child or helping professionals communicate with their
			clients). Training may emphasize active listening skills, problem-solving skills,
			conflict resolution techniques, body language, empathy, sensitivity to the values and/or
			cultural background of other, genuineness and other facets of the communication process.""" ;
  dc11:identifier "NI000273172808"^^xsd:token ;
  rdfs:label "Communication services" ;
  skos:definition """Programs that help participants develop or refine their communication
			skills, usually by focusing on communication in a particular context (e.g., helping a
