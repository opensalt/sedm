ceds:NI001517164459
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """State Test Preparation courses prepare students for particular state tests
			required for graduation. These courses may cover specific content areas (such as
			citizenship, mathematics, language arts, and so on) according to individual student
			needs, or they may provide a more general course of study, similar to the Standardized
			Test Preparation course described above.""" ;
  dc11:identifier "NI001517164459"^^xsd:token ;
  rdfs:label "State Test Preparation" ;
