ceds:NI000273172813
  a owl:NamedIndividual, ceds:C000273, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Programs that use music and music-related activities to help the student
			maintain mental functioning, to facilitate social and emotional growth, to promote
			communication, to develop constructive use of leisure time and to improve or maintain
			motor and perceptual skills. Music can be used as a passive agent as in the case of
			listening to music to aid in reminiscence, reality orientation or relaxation; or as an
			active creative process in which the client participates in musical production.""" ;
  dc11:identifier "NI000273172813"^^xsd:token ;
  rdfs:label "Music therapy" ;
  skos:definition """Programs that use music and music-related activities to help the student
			maintain mental functioning, to facilitate social and emotional growth, to promote
			communication, to develop constructive use of leisure time and to improve or maintain
			motor and perceptual skills. Music can be used as a passive agent as in the case of
			listening to music to aid in reminiscence, reality orientation or relaxation; or as an
			active creative process in which the client participates in musical production.""" ;
  skos:inScheme ceds:C000273 ;
  skos:notation "00306" ;
  skos:prefLabel "Music therapy" .

