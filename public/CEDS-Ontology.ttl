ceds:P001196
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001196"^^xsd:token ;
  rdfs:label "Has Assessment Asset Type" ;
  schema:domainIncludes ceds:C200015 ;
  schema:rangeIncludes ceds:C001196 ;
  skos:notation "hasAssessmentAssetType" ;
  dc11:description "Specifies a predominant type of assessment asset represented by the Learning Resource.  Assessment assets represent any content used to compose an assessment item, is referenced by an item but not part of the item content itself, or is content that is included as part of a section within an assessment form. Assets can be static content such as art work or dynamic assets such as calculators." ;
  rdfs:comment "The standard option set may be extended based on local and implementation-specific requirements.  Commonly used options may be submitted for inclusion in future versions of CEDS." .

ceds:P000605
