ceds:NI001517163193
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Reading (early childhood education) courses develop students' readiness for language arts, particularly focusing on reading skills. Courses may include activities related to phonics, phonemic awareness, and vocabulary. Content is age-appropriate and conforms to any existing state standards for early childhood education." ;
