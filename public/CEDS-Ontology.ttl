  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Drama (grade 2) courses enable students to express themselves through
			dramatic play and storytelling. Course content typically includes the use of movement,
			language, character, plot, and spectacle to portray imaginary or real experiences.
			Specific course content conforms to any existing state standards for grade 2.""" ;
  dc11:identifier "NI001517163595"^^xsd:token ;
  rdfs:label "Drama (grade 2)" ;
  skos:definition """Drama (grade 2) courses enable students to express themselves through
			dramatic play and storytelling. Course content typically includes the use of movement,
