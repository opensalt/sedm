ceds:NI001156173065
  a owl:NamedIndividual, ceds:C001156, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """An organization that supplements the regular school program or serves as
			early childhood education and care for children prior to reaching school-attendance age.
			These programs and services are often, but not solely, available through federal, state,
			or local agencies, non-profit organizations and/or other community-based organizations
			(or assistance provided by these entities). Services may be instructional or
			non-instructional in nature, may be direct or in-direct, and may be provided within or
			outside of a school building.""" ;
