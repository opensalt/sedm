ceds:NI001517163223
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Writing (grade 2) courses focus on writing skills and may build students' skills in independent writing by increasing writing fluency, vocabulary, and recognition of word and language patterns. They may also introduce or reinforce the rules of grammar and spelling. Specific content depends upon state standards for grade 2." ;
  dc11:identifier "NI001517163223"^^xsd:token ;
  rdfs:label "Writing (grade 2)" ;
  skos:definition "Writing (grade 2) courses focus on writing skills and may build students' skills in independent writing by increasing writing fluency, vocabulary, and recognition of word and language patterns. They may also introduce or reinforce the rules of grammar and spelling. Specific content depends upon state standards for grade 2." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "01132" ;
  skos:prefLabel "Writing (grade 2)" .

