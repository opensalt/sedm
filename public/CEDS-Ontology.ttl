ceds:NI001517164290
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Child Development courses provide students with knowledge about the
			physical, mental, emotional, social, and moral growth and development of children from
			conception to pre-school age, emphasizing the application of this knowledge in child
			care settings and/or home environments. Brain development and current developmental
			research are addressed. These courses typically include related topics such as the
			appropriate care of infants, toddlers, and young children.""" ;
  dc11:identifier "NI001517164290"^^xsd:token ;
