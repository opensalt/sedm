ceds:NI001874129101
  a owl:NamedIndividual, ceds:C001874, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Vapor intrusion is defined as vapor phase migration of volatile organic
			and/or inorganic compounds into occupied buildings from underlying contaminated ground
			water and/or soil.""" ;
