ceds:NI000599127829
  a owl:NamedIndividual, ceds:C000599, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The student is out of school for unexpected family reasons. Examples include
			lack of child care for a student with child(ren), care for a sick relative, and
			bereavement for a family member.""" ;
  dc11:identifier "NI000599127829"^^xsd:token ;
  rdfs:label "Absent - Family emergency or bereavement" ;
  skos:definition """The student is out of school for unexpected family reasons. Examples
			include lack of child care for a student with child(ren), care for a sick relative, and
			bereavement for a family member.""" ;
  skos:inScheme ceds:C000599 ;
  skos:notation "13296" ;
  skos:prefLabel "Absent - Family emergency or bereavement" .

ceds:NI000599127830
  a owl:NamedIndividual, ceds:C000599, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The student has been removed from the regular instructional setting for
			disciplinary reasons and is not receiving instruction. This may include either in-school
			or out-of-school suspension if instructional services are not provided. It does not
			include expulsion since expelled students are not enrolled in school.""" ;
  dc11:identifier "NI000599127830"^^xsd:token ;
  rdfs:label "Absent - Disciplinary action, not receiving instruction" ;
  skos:definition """The student has been removed from the regular instructional setting for
			disciplinary reasons and is not receiving instruction. This may include either in-school
			or out-of-school suspension if instructional services are not provided. It does not
			include expulsion since expelled students are not enrolled in school.""" ;
  skos:inScheme ceds:C000599 ;
  skos:notation "13297" ;
  skos:prefLabel "Absent - Disciplinary action, not receiving instruction" .

ceds:NI000599127831
  a owl:NamedIndividual, ceds:C000599, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The student is out of school due to a legal obligation to attend judicial
			proceedings, required appointments, or trial or hearing dates. Or, the student is
			serving time in jail or is in the custody of the court and is not receiving instruction.""" ;
  dc11:identifier "NI000599127831"^^xsd:token ;
  rdfs:label "Absent - Legal or judicial requirement" ;
  skos:definition """The student is out of school due to a legal obligation to attend judicial
			proceedings, required appointments, or trial or hearing dates. Or, the student is
			serving time in jail or is in the custody of the court and is not receiving instruction.""" ;
  skos:inScheme ceds:C000599 ;
  skos:notation "13298" ;
  skos:prefLabel "Absent - Legal or judicial requirement" .

