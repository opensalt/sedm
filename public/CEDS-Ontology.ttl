  schema:domainIncludes ceds:C200027 ;
  schema:rangeIncludes ceds:C001217 ;
  skos:notation "hasAssessmentItemPossibleResponseCorrectIndicator" ;
  dc11:description "Indicates that the possible response is the correct response." .

ceds:P000956
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000956"^^xsd:token ;
  rdfs:label "Has Assessment Item Response Hint Included Answer" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes ceds:C000956 ;
  skos:notation "hasAssessmentItemResponseHintIncludedAnswer" ;
  dc11:description "Indicates that one of the hints presented included the correct answer." ;
  rdfs:comment "A typical scenario for an online tutoring application may present a series of hints for a formative assessment item with the last hint being the correct answer.  The learner must enter the correct answer before continuing.  This data element is a flag that the learner was presented with the \"bottom hint\", which is the correct answer." .

ceds:P000954
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
