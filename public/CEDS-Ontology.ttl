  schema:rangeIncludes ceds:C001041 ;
  skos:notation "hasAssessmentNeedAlternativeRepresentationType" ;
  dc11:description "Defines as part of an Assessment Personal Needs Profile the default presentation mode of the associated Alternative Representations accessibility." .

ceds:P001045
