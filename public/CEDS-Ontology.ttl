  skos:notation "K12StudentEnrollment" .

ceds:C200220
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200220"^^xsd:token ;
  rdfs:comment "The plan of courses a K-12 student will take to graduate from high school." ;
  rdfs:label "K12 Student Graduation Plan" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "K12StudentGraduationPlan" .

ceds:C200221
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200221"^^xsd:token ;
  rdfs:comment "Information captured on an English learner home language survey." ;
  rdfs:label "K12 Student Home Language Survey" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "K12StudentHomeLanguageSurvey" .

ceds:C200222
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200222"^^xsd:token ;
  rdfs:comment "Information about literacy assessment given to a K12 student." ;
  rdfs:label "K12 Student Literacy Assessment" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "K12StudentLiteracyAssessment" .

ceds:C200223
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200223"^^xsd:token ;
  rdfs:comment "Information specific to a K12 student and session." ;
  rdfs:label "K12 Student Session" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "K12StudentSession" .

ceds:C200224
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200224"^^xsd:token ;
  rdfs:comment "The collection of Title III language instructional programs offered by an LEA." ;
  rdfs:label "K12 Title III Language Instruction" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "K12TitleIIILanguageInstruction" .

ceds:C200225
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200225"^^xsd:token ;
  rdfs:comment """LearnerAction is designed to handle clickstream data for online assessments
			and other experiences such as is used by intelligent tutoring systems. The model is
			compatible with the structure of data found in Experience API (xAPI) specification.""" ;
  rdfs:label "Learner Action" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearnerAction" .

ceds:C200226
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200226"^^xsd:token ;
  rdfs:comment """An entity with information about a learning activity that may be assigned to a
			learner, for example a homework assignment.""" ;
  rdfs:label "Learner Activity" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearnerActivity" .

ceds:C200228
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200228"^^xsd:token ;
  rdfs:comment """A persistent resource that has one or more physical or digital
			representations, and that explicitly involves, specifies or entails a learning activity
			or learning experience.""" ;
  rdfs:label "Learning Resource" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResource" .

ceds:C200229
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200229"^^xsd:token ;
  rdfs:comment """Links a learning resource record to one or more available aptations based on
			this resource.""" ;
  rdfs:label "Learning Resource Adaptation" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResourceAdaptation" .

ceds:C200230
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200230"^^xsd:token ;
  rdfs:comment """A unique number or alphanumeric code assigned to a learning resource by an
			organization.""" ;
  rdfs:label "Learning Resource Identifier" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResourceIdentifier" .

ceds:C200231
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200231"^^xsd:token ;
  rdfs:comment """Information related to issuing a learning resource to a person for a period of
			time.""" ;
  rdfs:label "Learning Resource Issued" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResourceIssued" .

ceds:C200232
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200232"^^xsd:token ;
  rdfs:comment "Links a learning resource record to one or more media features." ;
  rdfs:label "Learning Resource Media Feature" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResourceMediaFeature" .

ceds:C200233
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200233"^^xsd:token ;
  rdfs:comment """Information related to an organization ordering or purchasing a learning
			resource.""" ;
  rdfs:label "Learning Resource Order" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResourceOrder" .

ceds:C200234
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200234"^^xsd:token ;
  rdfs:comment "Information about a rating given to a learning resource. (LearningResourceAggregatePeerRating is a CEDS Connection to also support aggregate ratings.)" ;
  rdfs:label "Learning Resource Peer Rating" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResourcePeerRating" .

ceds:C200235
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200235"^^xsd:token ;
  rdfs:comment """Information about physical media on which the Learning Resource is delivered
			or available.""" ;
  rdfs:label "Learning Resource Physical Media" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResourcePhysicalMedia" .

ceds:C200236
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200236"^^xsd:token ;
  rdfs:comment "The current status of a learning resource owned or leased by an organization." ;
  rdfs:label "Learning Resource Status" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LearningResourceStatus" .

ceds:C200188
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200188"^^xsd:token ;
  rdfs:comment "An administrative unit within K-12 education at the local level which exists primarily to operate schools or to contract for educational services. These units may or may not be co-extensive with county, city, or town boundaries." ;
  rdfs:label "Local Education Agency" ;
  rdfs:subClassOf ceds:C200239 ;
  skos:notation "LocalEducationAgency" .

ceds:C200189
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200189"^^xsd:token ;
  rdfs:comment """Information on the federal funds received and distributed by the LEA under
			various programs.""" ;
  rdfs:label "Local Education Agency Federal Funds" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocalEducationAgencyFederalFunds" .

ceds:C200190
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200190"^^xsd:token ;
  rdfs:comment "Federal reporting status values and counts for an LEA." ;
  rdfs:label "Local Education Agency Federal Reporting" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocalEducationAgencyFederalReporting" .

ceds:C200191
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200191"^^xsd:token ;
  rdfs:comment "Information related to policies within a K12 location education agency." ;
  rdfs:label "Local Education Agency Policy" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocalEducationAgencyPolicy" .

ceds:C200192
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200192"^^xsd:token ;
  rdfs:comment "The groups of students for whom pre-kindergarten is available." ;
  rdfs:label "Local Education Agency PreK Eligibility" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocalEducationAgencyPreKEligibility" .

ceds:C200193
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200193"^^xsd:token ;
  rdfs:comment """The ages of children not served under IDEA to whom the LEA's pre-kindergarten
			services are available.""" ;
  rdfs:label "Local Education Agency PreK Eligible Ages IDEA" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocalEducationAgencyPreKEligibleAgesIDEA" .

ceds:C200194
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200194"^^xsd:token ;
  rdfs:comment """Information about the LEA's performance under the Safe and Drug-Free Schools
			and Communities act.""" ;
  rdfs:label "Local Education Agency Safe Drug Free" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocalEducationAgencySafeDrugFree" .

ceds:C200195
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200195"^^xsd:token ;
  rdfs:comment "The type of Title III professional development utilized by an LEA." ;
  rdfs:label "Local Education Agency Title III Professional Development" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocalEducationAgencyTitleIIIProfessionalDevelopment" .

ceds:C200196
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200196"^^xsd:token ;
  rdfs:comment "The type of support services provided to students in Title I programs by an LEA." ;
  rdfs:label "Local Education Agency Title I Support Service" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocalEducationAgencyTitleISupportService" .

ceds:C200237
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200237"^^xsd:token ;
  rdfs:comment "A location such as a physical address or mailing address." ;
  rdfs:label "Location" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Location" .

ceds:C200238
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200238"^^xsd:token ;
  rdfs:comment "Location that contains a address, city, state, zip." ;
  rdfs:label "Location Address" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "LocationAddress" .

ceds:C200257
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200257"^^xsd:token ;
  rdfs:comment """The association that represents a Person’s Role within an Organization for a
			period of time.""" ;
  rdfs:label "Membership" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Membership" .

ceds:C200402
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200257, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000097
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000107
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200402"^^xsd:token ;
  rdfs:comment "A specific type of Membership that represents a student's association with an educational organization, characterized by properties related to their enrollment status, participation, and educational engagement over a defined period of time." ;
  rdfs:label "Enrollment" ;
  skos:notation "Enrollment" .

ceds:C200403
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200257, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000007
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000008
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200403"^^xsd:token ;
  rdfs:comment "A specific type of Membership that represents a person's association with an organized activity within an educational organization, characterized by properties related to their participation, involvement, and engagement over a defined period of time." ;
  rdfs:label "Activity Membership" ;
  skos:notation "ActivityMembership" .

ceds:C200404
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200257, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000326
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000327
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200404"^^xsd:token ;
  rdfs:comment "A specific type of Membership that represents a student's association with a service provided by an organization, characterized by properties related to their access, participation, and engagement with the service over a defined period of time." ;
  rdfs:label "Service Membership" ;
  skos:notation "ServiceMembership" .

ceds:C200405
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200257, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000346
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000795
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200405"^^xsd:token ;
  rdfs:comment "A specific type of Membership that represents a staff person's association with an organization, characterized by properties related to their employment over a defined period of time. This includes linking a person in the role of a staff person with the organization, capturing elements such as the start and end dates of the employment period, the specific role or position held, job responsibilities, employment status, and associated benefits." ;
  rdfs:label "Employment" ;
  skos:notation "Employment" .

ceds:C200406
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200257, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000526
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000527
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200406"^^xsd:token ;
  rdfs:comment "A specific type of Membership that represents a staff person's assignment within an educational institution, characterized by properties related to their specific duties and responsibilities. This includes linking a staff person to particular assignments such as course sections, administrative roles, or other institutional tasks over a defined period of time. The concept captures elements such as the start and end dates of the assignment, the specific role or position held, and the nature of the duties performed." ;
  rdfs:label "Assignment" ;
  skos:notation "Assignment" .

ceds:C200407
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200257, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000590
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000591
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200407"^^xsd:token ;
  rdfs:comment "A specific type of Membership that represents a student's involvement in a federally funded program offered by an educational institution. This includes linking a student to particular programs such as Title I, Title III, and other similar initiatives, capturing elements such as the start and end dates of the involvement, the specific program details, and the nature of the services or support provided. The concept encompasses various aspects of the student's participation, such as eligibility criteria, progress, and outcomes related to the program." ;
  rdfs:label "Program Participation" ;
  skos:notation "ProgramParticipation" .

ceds:C200408
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200257, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000793
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000794
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200408"^^xsd:token ;
  rdfs:comment "A specific type of Membership that represents a student's involvement in a federally funded program offered by an educational institution. This includes linking a student to particular programs such as Title I, Title III, and other similar initiatives, capturing elements such as the start and end dates of the involvement, the specific program details, and the nature of the services or support provided. The concept encompasses various aspects of the student's participation, such as eligibility criteria, progress, and outcomes related to the program." ;
  rdfs:label "Staff Education Enrollment" ;
  skos:notation "StaffEducationEnrollment" .

ceds:C200213
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200257, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000974
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000794
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200213"^^xsd:token ;
  rdfs:comment "A specific type of Membership that represents a student's involvement in a federally funded program offered by an educational institution. This includes linking a student to particular programs such as Title I, Title III, and other similar initiatives, capturing elements such as the start and end dates of the involvement, the specific program details, and the nature of the services or support provided. The concept encompasses various aspects of the student's participation, such as eligibility criteria, progress, and outcomes related to the program." ;
  rdfs:label "Student Course Section Enrollment" ;
  skos:notation "StudentCourseSectionEnrollment" .

ceds:C200375
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200407, [
    a owl:Restriction ;
    owl:onProperty ceds:P002116 ;
    owl:allValuesFrom ceds:P000974
  ], [
    a owl:Restriction ;
    owl:onProperty ceds:P002117 ;
    owl:allValuesFrom ceds:P000794
  ] ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200375"^^xsd:token ;
  rdfs:comment "Information about instruction and/or services provided to a person through a workforce and/or an employment development program." ;
  rdfs:label "Workforce Program Participation" ;
  skos:notation "WorkforceProgramParticipation" .

ceds:C200409
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200407 ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200409"^^xsd:token ;
  rdfs:comment "Information about instruction and/or services provided to a person through a workforce and/or an employment development program." ;
  rdfs:label "Workforce Program Participation" ;
  skos:notation "WorkforceProgramParticipation" .

ceds:C200258
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200258"^^xsd:token ;
  rdfs:comment """Information related to a person applying for a specifing role in an
			organization (e.g., applying for college, applying to be enrolled in a program).""" ;
  rdfs:label "Membership Application" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "MembershipApplication" .

ceds:C200259
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200259"^^xsd:token ;
  rdfs:comment """Information about the percentage of full-time equivalent work that a person
			contributes in a specific role for an organization.""" ;
  rdfs:label "Membership Full Time Equivalency" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "MembershipFullTimeEquivalency" .

ceds:C001756
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C001756"^^xsd:token ;
  rdfs:comment "The O*NET-SOC taxonomy defines the set of occupations across the world of work based on the Standard Occupational Classification." ;
  rdfs:label "O*NET-SOC Occupation Type" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "O*NET-SOCOccupationType" .

ceds:C200239
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200239"^^xsd:token ;
  rdfs:comment "An entity that represents any type of organization. It includes information common to all types of organizations. CEDS also defines specific types of organizations such as Early Learning Organization, K12 School and Post Secondary Institution." ;
  rdfs:label "Organization" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Organization" .

ceds:C200240
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200240"^^xsd:token ;
  rdfs:comment "The accreditation status of an organization and accreditation agency." ;
  rdfs:label "Organization Accreditation" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationAccreditation" .

ceds:C200241
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200241"^^xsd:token ;
  rdfs:comment """OrganizationCalendar represents a calendar owned by an Organization. The
			details of the calendar are defined by OrganizationCalendarEvent,
			OrganizationCalendarDay, OrganizationCalendarSession, and OrganizationCalendarCrisis.""" ;
  rdfs:label "Organization Calendar" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationCalendar" .

ceds:C200242
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200242"^^xsd:token ;
  rdfs:comment "OrganizationCalendarCrisis provides the unschehduled exceptions to the calendar such as a natural disaster, that causes closing of a school or the displacement of students from a school or institution over multiple days, weeks or months." ;
  rdfs:label "Organization Calendar Crisis" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationCalendarCrisis" .

ceds:C200243
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200243"^^xsd:token ;
  rdfs:comment "OrganzationCalendarDay is for naming days within the regular schedule." ;
  rdfs:label "Organization Calendar Day" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationCalendarDay" .

ceds:C200244
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200244"^^xsd:token ;
  rdfs:comment """OrganizationCalendarEvent handles scheduled or unscheduled events such as
			holidays or closings that may interrupt the course section schedule on a specified date.
			See CEDS element definition and option set for Calendar Event Type.""" ;
  rdfs:label "Organization Calendar Event" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationCalendarEvent" .

ceds:C200245
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200245"^^xsd:token ;
  rdfs:comment """OrganizationCalendarSession provides the beginning and end date of the period
			of time, such as a term or semester. It has multiple uses. For example, it may be
			flagged as an "attendance term" with a value for DaysInSession, or the specific days
			applicable for attendance may be derived using OrganizationCalendarEvent. Early learning
			use cases use this entity to specify instructional session start and end times within
			the context of a day.""" ;
  rdfs:label "Organization Calendar Session" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationCalendarSession" .

ceds:C200247
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200247"^^xsd:token ;
  rdfs:comment "An email address for an organization." ;
  rdfs:label "Organization Email" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationEmail" .

ceds:C200248
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200248"^^xsd:token ;
  rdfs:comment "Information about employee benefits linked to an organization." ;
  rdfs:label "Organization Employee Benefit" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationEmployeeBenefit" .

ceds:C200249
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200249"^^xsd:token ;
  rdfs:comment """Information about the capacity for an enrollment in an organization such as
			school, program, or course.""" ;
  rdfs:label "Organization Enrollment Capacity" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationEnrollmentCapacity" .

ceds:C200250
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200250"^^xsd:token ;
  rdfs:comment """Information on the status of the organization on various federal
			accountability measures.""" ;
  rdfs:label "Organization Federal Accountability" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationFederalAccountability" .

ceds:C200251
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200251"^^xsd:token ;
  rdfs:comment """The intersection of FinancialAccount and OrganizationCalendarSession
			(representing an AccountingPeriod) and containing the values for that accounting period.""" ;
  rdfs:label "Organization Financial" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationFinancial" .

ceds:C200252
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200252"^^xsd:token ;
  rdfs:comment """A unique number or alphanumeric code assigned to an organization by a school,
			school system, a state, or other agency or entity.""" ;
  rdfs:label "Organization Identification" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "OrganizationIdentification" .

ceds:C200253
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200253"^^xsd:token ;
  rdfs:comment "An photo linked to an organization." ;
  rdfs:label "Organization Image" ;
