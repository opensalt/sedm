ceds:P000611
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000611"^^xsd:token ;
  rdfs:label "Crisis Code" ;
  schema:domainIncludes ceds:C200242 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CrisisCode" ;
  dc11:description "A unique number or alphanumeric code used to identify a crisis. This code should be able to accommodate numerous crises within a single school year. It is associated with the displaced student identifier in order to link a crisis to a student who was displaced or otherwise affected by the event. If the same code values are to be used over multiple years, it is important to have enough crisis-specific items (e.g., school year, date/time) to keep the events unique over time." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000612
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000612"^^xsd:token ;
  rdfs:label "Crisis Name" ;
  schema:domainIncludes ceds:C200242 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CrisisName" ;
  dc11:description "The name of the crisis that caused the displacement of students." ;
  ceds:maxLength "45" ;
  ceds:textFormat "Alphanumeric - 45 characters maximum" .

ceds:P000613
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000613"^^xsd:token ;
  rdfs:label "Crisis Type" ;
  schema:domainIncludes ceds:C200242 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CrisisType" ;
  dc11:description "The type or category of crisis (ex., chemical, earthquake, flood, wildfire, etc.)." ;
  ceds:maxLength "45" ;
  ceds:textFormat "Alphanumeric - 45 characters maximum" .

ceds:P000614
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000614"^^xsd:token ;
  rdfs:label "Crisis Start Date" ;
  schema:domainIncludes ceds:C200242 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CrisisStartDate" ;
  dc11:description "The year, month and day on which the crisis affected the agency. This date may not be the same as the date the crisis occurred if evacuation orders are implemented in anticipation of a crisis." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001550
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001550"^^xsd:token ;
