ceds:NI001517163350
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Regional Biology courses are designed to provide information regarding the
			fundamental concepts of life and life processes as related to the local environment.
			Course topics may include nature appreciation, local flora and fauna, biology, and
			zoology.""" ;
  dc11:identifier "NI001517163350"^^xsd:token ;
  rdfs:label "Regional Biology" ;
