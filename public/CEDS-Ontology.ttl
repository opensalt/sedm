ceds:NI001517163988
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Income Tax Accounting courses introduce students to and expand their
			knowledge of the fundamental accounting principles and procedures used in businesses
			through integrating and using accounting-related software and information systems. These
			courses focus on federal, state, and local business tax laws; business tax accounting
			methods; and the preparation of business tax forms.""" ;
  dc11:identifier "NI001517163988"^^xsd:token ;
  rdfs:label "Income Tax Accounting" ;
  skos:definition """Income Tax Accounting courses introduce students to and expand their
