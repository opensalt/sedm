ceds:NI001353117332
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """All funds on deposit with a bank or savings and loan institution, normally
			in non-interest-bearing accounts. Interest-bearing accounts, however, that do not meet
			the definition of an investment (e.g., demand deposits that are interest-bearing) should
			be recorded herein as well.""" ;
  dc11:identifier "NI001353117332"^^xsd:token ;
  rdfs:label "Cash in Bank" ;
  skos:definition """All funds on deposit with a bank or savings and loan institution, normally
			in non-interest-bearing accounts. Interest-bearing accounts, however, that do not meet
			the definition of an investment (e.g., demand deposits that are interest-bearing) should
			be recorded herein as well.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "101" ;
  skos:prefLabel "Cash in Bank" .

ceds:NI001353117333
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Currency, coins, checks, postal and express money orders, and bankers' drafts on hand." ;
  dc11:identifier "NI001353117333"^^xsd:token ;
  rdfs:label "Cash on Hand" ;
  skos:definition "Currency, coins, checks, postal and express money orders, and bankers' drafts on hand." ;
  skos:inScheme ceds:C001353 ;
  skos:notation "102" ;
  skos:prefLabel "Cash on Hand" .

ceds:NI001353117334
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A sum of money set aside to pay small obligations for which the issuance of
			a formal voucher and check would be too expensive and time consuming.""" ;
  dc11:identifier "NI001353117334"^^xsd:token ;
  rdfs:label "Petty Cash" ;
  skos:definition """A sum of money set aside to pay small obligations for which the issuance of
			a formal voucher and check would be too expensive and time consuming.""" ;
  skos:inScheme ceds:C001353 ;
  skos:notation "103" ;
  skos:prefLabel "Petty Cash" .

ceds:NI001353117335
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
