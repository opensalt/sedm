  schema:rangeIncludes ceds:C000451 ;
  skos:notation "hasLEAFundsTransferType" ;
  dc11:description "An indication of the type of transfer for an LEAs that transferred funds from an eligible program to another eligible program." .

ceds:P002096
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002096"^^xsd:token ;
  rdfs:label "Has LEA GFSA Assurance of Compliance Indicator" ;
  schema:domainIncludes ceds:C200191 ;
  schema:rangeIncludes ceds:C002096 ;
  skos:notation "hasLEAGFSAAssuranceofComplianceIndicator" ;
  dc11:description "Indicates if a Local Education Agency (LEA) has provided an assurance that it is in compliance with the State law requiring that a student who brings a firearm to school, or possesses a firearm at school, be expelled for one year, except that such State law shall allow the chief administering officer of a local educational agency to modify such expulsion requirement for a student on a case-by-case basis if such modification is in writing." ;
  rdfs:comment "This data is part of the requirement for LEAs to adhere to the Gun Free Schools Act (GFSA)." ;
  ceds:textFormat "Option Set" ;
  ceds:editHistory ( _:genid1905 ) .

ceds:P002097
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002097"^^xsd:token ;
  rdfs:label "Has LEA GFSA Policy Assurance Indicator" ;
  schema:domainIncludes ceds:C200191 ;
  schema:rangeIncludes ceds:C002097 ;
  skos:notation "hasLEAGFSAPolicyAssuranceIndicator" ;
  dc11:description "Indicates if a Local Education Agency has provided an assurance that it is in compliance with the requirement in Section 4141(h) that an LEA receiving ESEA funds have in place a policy requiring referral to the criminal justice or juvenile delinquency system of any student who brings a firearm to a school or possesses a firearm at school. " ;
  rdfs:comment "This data is part of the requirement for LEAs to adhere to the Gun Free Schools Act (GFSA)." ;
  ceds:textFormat "Option Set" ;
  ceds:editHistory ( _:genid1907 ) .

