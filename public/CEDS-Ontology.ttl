ceds:NI001517163576
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Dance—Independent Study courses, often conducted with instructors or
			professional artists as mentors, provide training in a specific area of emphasis
			(ballet, tap, jazz, modern, musical theater, world dance, etc.) or in the areas of
			choreography, production, criticism, etc. Independent Study courses may serve as an
			opportunity for students to expand their expertise in a particular form or style, to
			explore a topic in greater detail, or to develop more advanced skills.""" ;
  dc11:identifier "NI001517163576"^^xsd:token ;
  rdfs:label "Dance—Independent Study" ;
  skos:definition """Dance—Independent Study courses, often conducted with instructors or
			professional artists as mentors, provide training in a specific area of emphasis
			(ballet, tap, jazz, modern, musical theater, world dance, etc.) or in the areas of
			choreography, production, criticism, etc. Independent Study courses may serve as an
			opportunity for students to expand their expertise in a particular form or style, to
			explore a topic in greater detail, or to develop more advanced skills.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05047" ;
  skos:prefLabel "Dance—Independent Study" .

ceds:NI001517163577
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Dance—Workplace Experience courses provide students with work experience in
			a field related to dance. Goals are typically set cooperatively by the student, teacher,
			and employer (although students are not necessarily paid). These courses may include
			classroom activities as well, involving further study of the field or discussion
			regarding experiences that students encounter in the workplace.""" ;
  dc11:identifier "NI001517163577"^^xsd:token ;
  rdfs:label "Dance—Workplace Experience" ;
  skos:definition """Dance—Workplace Experience courses provide students with work experience in
			a field related to dance. Goals are typically set cooperatively by the student, teacher,
			and employer (although students are not necessarily paid). These courses may include
			classroom activities as well, involving further study of the field or discussion
			regarding experiences that students encounter in the workplace.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "05048" ;
  skos:prefLabel "Dance—Workplace Experience" .

