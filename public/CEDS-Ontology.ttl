ceds:P000495
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000495"^^xsd:token ;
  rdfs:label "Calendar Description" ;
  schema:domainIncludes ceds:C200241 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CalendarDescription" ;
