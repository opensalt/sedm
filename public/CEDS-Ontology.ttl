  rdfs:label "Multiple-choice" ;
  skos:definition """A forced-choice assessment item featuring a stem (which is a prompt) and
			two or more choices, one of which is the correct answer, and the remainder are
			distractors.""" ;
  skos:inScheme ceds:C000390 ;
  skos:notation "MultipleChoice" ;
  skos:prefLabel "Multiple-choice" .

ceds:NI000390101917
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A short-answer item in which examinees are presented with a sentence in
			which a word or words is missing, and are asked to provide the missing word(s).""" ;
  dc11:identifier "NI000390101917"^^xsd:token ;
  rdfs:label "Fill-in-the-blank" ;
  skos:definition """A short-answer item in which examinees are presented with a sentence in
			which a word or words is missing, and are asked to provide the missing word(s).""" ;
  skos:inScheme ceds:C000390 ;
  skos:notation "FillInTheBlank" ;
  skos:prefLabel "Fill-in-the-blank" .

ceds:NI000390101918
  a owl:NamedIndividual, ceds:C000390, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "A declarative statement that examinees judge true or false. Variants of the true/false item have examinees identify: fact/opinion, supported by the narrative or not, etc." ;
  dc11:identifier "NI000390101918"^^xsd:token ;
  rdfs:label "True/False" ;
  skos:definition "A declarative statement that examinees judge true or false. Variants of the true/false item have examinees identify: fact/opinion, supported by the narrative or not, etc." ;
  skos:inScheme ceds:C000390 ;
  skos:notation "TrueFalse" ;
  skos:prefLabel "True/False" .

