  schema:domainIncludes ceds:C200157 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IEPTransferofRightsStatement" ;
  dc11:description "Beginning not later than one year before the child reaches the age of majority under State law, the IEP must include a statement that the child has been informed of the child's rights under Part B of the Individuals with Disabilities Education Act, if any, that will transfer to the child on reaching the age of majority under §300.520." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid537 ) .

