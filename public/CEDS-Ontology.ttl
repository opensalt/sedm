ceds:NI000076115614
  a owl:NamedIndividual, ceds:C000076, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Leaves before the official close of the daily session. Reasons may include a special activity for curricular enrichment, doctor's appointment, and family emergency. State, local, and school regulations may distinguish excused and unexcused early departures. When officially approved on a regular basis, early departures immediately prior to the close of the session are considered to be released time." ;
  dc11:identifier "NI000076115614"^^xsd:token ;
  rdfs:label "Early Departure" ;
  skos:definition "Leaves before the official close of the daily session. Reasons may include a special activity for curricular enrichment, doctor's appointment, and family emergency. State, local, and school regulations may distinguish excused and unexcused early departures. When officially approved on a regular basis, early departures immediately prior to the close of the session are considered to be released time." ;
  skos:inScheme ceds:C000076 ;
  skos:notation "EarlyDeparture" ;
  skos:prefLabel "Early Departure" .

ceds:NI000076115673
  a owl:NamedIndividual, ceds:C000076, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Not present but is temporarily excused from attendance because the person
			is: 1) is ill and attendance would endanger his or her health or the health of others;
			2) has an immediate family member who is seriously ill or has died; 3) is observing a
			recognized religious holiday of his or her faith; or 4) is otherwise excused in
			accordance with policies.""" ;
  dc11:identifier "NI000076115673"^^xsd:token ;
  rdfs:label "Excused Absence" ;
  skos:definition """Not present but is temporarily excused from attendance because the person
			is: 1) is ill and attendance would endanger his or her health or the health of others;
			2) has an immediate family member who is seriously ill or has died; 3) is observing a
			recognized religious holiday of his or her faith; or 4) is otherwise excused in
			accordance with policies.""" ;
  skos:inScheme ceds:C000076 ;
  skos:notation "ExcusedAbsence" ;
  skos:prefLabel "Excused Absence" .

