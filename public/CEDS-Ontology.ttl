ceds:NI001517163346
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Earth Science courses offer insight into the environment on earth and the earth's environment in space. While presenting the concepts and principles essential to students' understanding of the dynamics and history of the earth, these courses usually explore oceanography, geology, astronomy, meteorology, and geography." ;
  dc11:identifier "NI001517163346"^^xsd:token ;
  rdfs:label "Earth Science" ;
  skos:definition "Earth Science courses offer insight into the environment on earth and the earth's environment in space. While presenting the concepts and principles essential to students' understanding of the dynamics and history of the earth, these courses usually explore oceanography, geology, astronomy, meteorology, and geography." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "03001" ;
  skos:prefLabel "Earth Science" .

ceds:NI001517163347
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Geology courses provide an in-depth study of the forces that formed and continue to affect the earth's surface. Earthquakes, volcanoes, and erosion are examples of topics that are presented." ;
  dc11:identifier "NI001517163347"^^xsd:token ;
  rdfs:label "Geology" ;
  skos:definition "Geology courses provide an in-depth study of the forces that formed and continue to affect the earth's surface. Earthquakes, volcanoes, and erosion are examples of topics that are presented." ;
  skos:inScheme ceds:C001517 ;
  skos:notation "03002" ;
  skos:prefLabel "Geology" .

ceds:NI001517163348
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Earth Science—Independent Study courses, often conducted with instructors as
			mentors, enable students to explore scientific topics of interest, using advanced
			methods of scientific inquiry and experimentation. These courses may be offered in
			conjunction with other science courses or may serve as an opportunity to explore a topic
			of special interest.""" ;
  dc11:identifier "NI001517163348"^^xsd:token ;
  rdfs:label "Earth Science—Independent Study" ;
