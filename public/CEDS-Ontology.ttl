ceds:NI001517163464
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """U.S. History—Comprehensive courses provide students with an overview of the
			history of the United States, examining time periods from discovery or colonialism
			through World War II or after. These courses typically include a historical overview of
			political, military, scientific, and social developments. Course content may include a
			history of the North American peoples before European settlement.""" ;
  dc11:identifier "NI001517163464"^^xsd:token ;
