ceds:NI001517163355
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Biology courses are designed to provide information regarding the
			fundamental concepts of life and life processes. These courses include (but are not
			restricted to) such topics as cell structure and function, general plant and animal
			physiology, genetics, and taxonomy.""" ;
