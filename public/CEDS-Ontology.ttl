  dc11:identifier "P000039"^^xsd:token ;
  rdfs:label "Has Charter School Indicator" ;
  schema:domainIncludes ceds:C200199, ceds:C200188 ;
  schema:rangeIncludes ceds:C000039 ;
  skos:notation "hasCharterSchoolIndicator" ;
  dc11:description "An indication that a public school provides free public elementary and/or secondary education to eligible students under a specific charter executed, pursuant to a state charter school law, by an authorized chartering agency/authority and that is designated by such authority to be a public charter school." ;
  rdfs:comment "When the element is used for an LEA, it means the LEA is a Charter District meaning any and all schools under the authority of the LEA are charter schools. Don't flag an LEA as a charter district if it has a mix of charter schools and non-charter schools." ;
  ceds:editHistory (
   _:genid1877
   _:genid1879
 ) .

