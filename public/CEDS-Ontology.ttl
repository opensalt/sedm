  schema:domainIncludes ceds:C200317 ;
  schema:rangeIncludes ceds:C001955 ;
  skos:notation "hasAdultEducationCredentialAttainmentEmployedIndicator" ;
  dc11:description "An indication of whether the adult education participant received a secondary school diploma or its recognized equivalent while enrolled in the adult education program or within one year of exiting the adult education program and was employed within one year of exiting the adult education program." ;
  ceds:editHistory ( _:genid2173 ) .

