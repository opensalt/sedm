ceds:NI001517163273
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """The second part in a multipart sequence of Algebra I. This course generally
			covers the same topics as the second semester of Algebra I, including the study of
			properties of the real number system and operations, evaluating rational algebraic
			expressions, solving and graphing first-degree equations and inequalities, translating
			word problems into equations, operations with and factoring of polynomials, and solving
			quadratics. Specific content depends upon state standards.""" ;
  dc11:identifier "NI001517163273"^^xsd:token ;
  rdfs:label "Algebra I—Part 2" ;
  skos:definition """The second part in a multipart sequence of Algebra I. This course generally
			covers the same topics as the second semester of Algebra I, including the study of
			properties of the real number system and operations, evaluating rational algebraic
			expressions, solving and graphing first-degree equations and inequalities, translating
			word problems into equations, operations with and factoring of polynomials, and solving
			quadratics. Specific content depends upon state standards.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "02054" ;
  skos:prefLabel "Algebra I—Part 2" .

