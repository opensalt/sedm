  schema:domainIncludes ceds:C200222 ;
  schema:rangeIncludes ceds:C000467 ;
  skos:notation "hasLiteracyGoalMetStatus" ;
  dc11:description "The participant showed \"significant learning gains\" on measures of reading, the definition of which is determined at the State level." .

ceds:P000468
