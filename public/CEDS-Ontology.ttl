ceds:P000501
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000501"^^xsd:token ;
  rdfs:label "Incident Identifier" ;
  schema:domainIncludes ceds:C200154 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IncidentIdentifier" ;
  dc11:description "A locally assigned unique identifier (within the school or school district) to identify each specific incident or occurrence. The same identifier should be used to document the entire incident even if it included multiple offenses and multiple offenders." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid523 ) .

ceds:P000502
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000502"^^xsd:token ;
  rdfs:label "Incident Date" ;
  schema:domainIncludes ceds:C200154 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "IncidentDate" ;
  dc11:description "The year, month and day on which the incident occurred." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000503
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000503"^^xsd:token ;
  rdfs:label "Incident Time" ;
  schema:domainIncludes ceds:C200154 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "IncidentTime" ;
  dc11:description "An indication of the time of day the incident took place." ;
  ceds:textFormat "HH:MM:SS" .

ceds:P000505
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000505"^^xsd:token ;
  rdfs:label "Incident Cost" ;
  schema:domainIncludes ceds:C200154 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IncidentCost" ;
  dc11:description "The value of any quantifiable monetary loss directly resulting from the incident. Examples include the value of repairs necessitated by vandalism of a school facility, the value of personnel resources used for repairs or consumed by the incident, the value of stolen items, and the value of time consumed by an incident (e.g., instructional time involved in evacuating a school during a false fire alarm).  Cost may be reported by specific monetary amount or range." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000507
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000507"^^xsd:token ;
  rdfs:label "Reporter Identifier" ;
  schema:domainIncludes ceds:C200154 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "ReporterIdentifier" ;
  dc11:description "Identifies the reporter of the incident using  a pre-existing unique student identifier or unique staff identifier, when the reporter is a student or staff member." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid525 ) .

ceds:P000508
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000508"^^xsd:token ;
  rdfs:label "Incident Description" ;
  schema:domainIncludes ceds:C200154 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IncidentDescription" ;
  dc11:description "The description for an incident." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001374
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001374"^^xsd:token ;
  rdfs:label "Incident Regulation Violated Description" ;
  schema:domainIncludes ceds:C200154 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IncidentRegulationViolatedDescription" ;
  dc11:description "A description of the rule‚ regulation‚ or standard that was violated when an incident occurred (e.g.‚ the identification of a relevant law‚ conduct standard‚ or acceptable use policy)." ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" .

ceds:P001370
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001370"^^xsd:token ;
  rdfs:label "Incident Perpetrator Identifier" ;
  schema:domainIncludes ceds:C200156 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IncidentPerpetratorIdentifier" ;
  dc11:description "Identifies the perpetrator of the incident by use of a pre-existing unique identifier assigned to a student or staff member by a school or district." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid527 ) .

ceds:P001377
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001377"^^xsd:token ;
  rdfs:label "Incident Victim Identifier" ;
  schema:domainIncludes ceds:C200156 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IncidentVictimIdentifier" ;
  dc11:description "Identifies the victim of the incident by use of a pre-existing unique identifier assigned to a student or staff member by a school or district." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid529 ) .

ceds:P001379
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001379"^^xsd:token ;
  rdfs:label "Incident Witness Identifier" ;
  schema:domainIncludes ceds:C200156 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "IncidentWitnessIdentifier" ;
  dc11:description "Identifies the witness of the incident by use of a pre-existing unique identifier assigned to a student or staff member by a school or district. Using this data element permits linkage to descriptive information about the individual in the student or staff database." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid531 ) .

