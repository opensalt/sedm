  skos:inScheme ceds:C001517 ;
  skos:notation "01056" ;
  skos:prefLabel "British Literature" .

ceds:NI001517163201
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """British Literature/History courses integrate the study of British literature
			with an overview of the history of England. These courses may also include other aspects
