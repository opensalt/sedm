ceds:NI001517163642
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Reading (grade 6) courses build upon students' prior knowledge and skill in reading and may emphasize the use of language for different effects, in different contexts, and for different purposes. Specific content depends upon state standards for grade 6." ;
  dc11:identifier "NI001517163642"^^xsd:token ;
