ceds:NI001517164482
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """IB Mathematics: Applications and Interpretation courses prepare students to
			take the International Baccalaureate Mathematics: Applications and Interpretation exams.
			Intended to provide students with an understanding of the role of mathematics in an
			increasing technological world, these courses focus on mathematical concepts used as
			applications and in mathematical modeling. Course topics include numbers and algebra,
			functions, geometry and trigonometry, statistics and probability, and calculus.""" ;
  dc11:identifier "NI001517164482"^^xsd:token ;
  rdfs:label "IB Mathematics: Applications and Interpretation" ;
