ceds:NI001891129118
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Interest added to the amount of the loan on the front end, or beginning of
			the loan repayment period. The balance (of principal and interest) is then paid by
			installments. This form of interest is much more expensive than simple interest paid on
			the entire amount for the entire term of the loan.""" ;
  dc11:identifier "NI001891129118"^^xsd:token ;
  rdfs:label "Add-on interest" ;
  skos:definition """Interest added to the amount of the loan on the front end, or beginning of
			the loan repayment period. The balance (of principal and interest) is then paid by
			installments. This form of interest is much more expensive than simple interest paid on
			the entire amount for the entire term of the loan.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13730" ;
  skos:prefLabel "Add-on interest" .

ceds:NI001891129119
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A mortgage in which interest and payment rates vary periodically, based on a
			specific index, such as 30-year Treasury bills or the Cost-of-Funds index.""" ;
  dc11:identifier "NI001891129119"^^xsd:token ;
  rdfs:label "Adjustable-Rate Mortgage (ARM)" ;
  skos:definition """A mortgage in which interest and payment rates vary periodically, based on
			a specific index, such as 30-year Treasury bills or the Cost-of-Funds index.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13731" ;
  skos:prefLabel "Adjustable-Rate Mortgage (ARM)" .

ceds:NI001891129120
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A short-term mortgage, generally at a fixed rate of interest, to be paid
			back in pre-determined, equal monthly payments, with a large, final payment for the
			balance of the loan paid at the end of the term.""" ;
  dc11:identifier "NI001891129120"^^xsd:token ;
  rdfs:label "Balloon Mortgage" ;
  skos:definition """A short-term mortgage, generally at a fixed rate of interest, to be paid
			back in pre-determined, equal monthly payments, with a large, final payment for the
			balance of the loan paid at the end of the term.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13732" ;
  skos:prefLabel "Balloon Mortgage" .

ceds:NI001891129121
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Interest due but unpaid. Mortgages that permit negative amortization (such
			as a graduated-payment mortgage or a floating rate loan without a rate cap) will allow
			deferred interest.""" ;
  dc11:identifier "NI001891129121"^^xsd:token ;
  rdfs:label "Deferred Interest" ;
  skos:definition """Interest due but unpaid. Mortgages that permit negative amortization (such
			as a graduated-payment mortgage or a floating rate loan without a rate cap) will allow
			deferred interest.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13733" ;
  skos:prefLabel "Deferred Interest" .

ceds:NI001891129122
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Periodic payments of principal and interest on a mortgage which remain
			constant over the loan term.""" ;
  dc11:identifier "NI001891129122"^^xsd:token ;
  rdfs:label "Fixed Payment Mortgage" ;
  skos:definition """Periodic payments of principal and interest on a mortgage which remain
			constant over the loan term.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13734" ;
  skos:prefLabel "Fixed Payment Mortgage" .

ceds:NI001891129123
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A mortgage in which the interest rate does not change during the entire term
			of the loan.""" ;
  dc11:identifier "NI001891129123"^^xsd:token ;
  rdfs:label "Fixed-rate Mortgage" ;
  skos:definition """A mortgage in which the interest rate does not change during the entire
			term of the loan.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13735" ;
  skos:prefLabel "Fixed-rate Mortgage" .

ceds:NI001891129124
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """An interest rate on a loan which changes during the life of the loan, often
			monthly, but can change quarterly or annually. These variable rates are based on an
			index rate and can be used for mortgages and other loans such as lines of credit.""" ;
  dc11:identifier "NI001891129124"^^xsd:token ;
  rdfs:label "Floating Rate" ;
  skos:definition """An interest rate on a loan which changes during the life of the loan, often
			monthly, but can change quarterly or annually. These variable rates are based on an
			index rate and can be used for mortgages and other loans such as lines of credit.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13736" ;
  skos:prefLabel "Floating Rate" .

ceds:NI001891129125
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A method of loan amortization in which equal periodic payments completely
			repay the loan during the loan term.""" ;
  dc11:identifier "NI001891129125"^^xsd:token ;
  rdfs:label "Fully Amortizing Mortgage" ;
  skos:definition """A method of loan amortization in which equal periodic payments completely
			repay the loan during the loan term.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13737" ;
  skos:prefLabel "Fully Amortizing Mortgage" .

ceds:NI001891129126
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "A type of stepped-payment loan in which the borrower's payments are initially lower than those on a comparable level-rate mortgage. The payments gradually increase over a predetermined period, and then cap at a final level for the duration of the mortgage." ;
  dc11:identifier "NI001891129126"^^xsd:token ;
  rdfs:label "Graduated-payment Mortgage (GPM)" ;
  skos:definition "A type of stepped-payment loan in which the borrower's payments are initially lower than those on a comparable level-rate mortgage. The payments gradually increase over a predetermined period, and then cap at a final level for the duration of the mortgage." ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13738" ;
  skos:prefLabel "Graduated-payment Mortgage (GPM)" .

ceds:NI001891129127
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A method of loan amortization in which interest is paid periodically over
			the term of the loan and the entire loan amount (principal) is paid at maturity.""" ;
  dc11:identifier "NI001891129127"^^xsd:token ;
  rdfs:label "Interest-only loan" ;
  skos:definition """A method of loan amortization in which interest is paid periodically over
			the term of the loan and the entire loan amount (principal) is paid at maturity.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13739" ;
  skos:prefLabel "Interest-only loan" .

ceds:NI001891129128
  a owl:NamedIndividual, ceds:C001891, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """A mortgage agreement that allows the mortgagor to borrow additional funds
			from the mortgage lender in the future, normally with a borrowing limit. This limit may
			be based on loan-to-value or may simply be the original loan amount.""" ;
  dc11:identifier "NI001891129128"^^xsd:token ;
  rdfs:label "Open-end Mortgage" ;
  skos:definition """A mortgage agreement that allows the mortgagor to borrow additional funds
			from the mortgage lender in the future, normally with a borrowing limit. This limit may
			be based on loan-to-value or may simply be the original loan amount.""" ;
  skos:inScheme ceds:C001891 ;
  skos:notation "13740" ;
  skos:prefLabel "Open-end Mortgage" .

