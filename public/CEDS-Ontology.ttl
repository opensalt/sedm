  a owl:NamedIndividual, ceds:C001675, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description "Expenses associated with operations that are independent of or unrelated to the primary missions of the institution (i.e., instruction, research, public service) although they may contribute indirectly to the enhancement of these programs. This category is generally limited to expenses of a major federally funded research and development center. Also includes information technology expenses, actual or allocated costs for operation and maintenance of plant, interest and depreciation related to the independent operations. Expenses of operations owned and managed as investments of the institution's endowment funds are excluded." ;
  dc11:identifier "NI001675127677"^^xsd:token ;
  rdfs:label "Independent operations" ;
  skos:definition "Expenses associated with operations that are independent of or unrelated to the primary missions of the institution (i.e., instruction, research, public service) although they may contribute indirectly to the enhancement of these programs. This category is generally limited to expenses of a major federally funded research and development center. Also includes information technology expenses, actual or allocated costs for operation and maintenance of plant, interest and depreciation related to the independent operations. Expenses of operations owned and managed as investments of the institution's endowment funds are excluded." ;
  skos:inScheme ceds:C001675 ;
  skos:notation "Independentoperations" ;
  skos:prefLabel "Independent operations" .

