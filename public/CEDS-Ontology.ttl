ceds:NI001517164088
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Pharmacy Assisting courses emphasize the knowledge and skills necessary to
			assist a pharmacist or pharmacy technician. Course topics and experiences enable
			students to understand medical terminology, keep and maintain records, label
			medications, perform computer patient billing, perform stock inventory, and order
			supplies. These courses also emphasize pharmaceutical classification, drug interactions,
			and interpersonal/communication skills.""" ;
