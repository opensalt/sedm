  schema:domainIncludes ceds:C200213 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "CourseSectionEnrollmentStatusStartDate" ;
  dc11:description "The date on which the enrollment status began related to a student enrolled in an instance of a course." ;
  rdfs:comment "Enrollment statuses may overlap, for example at one point in time a student may be both pre-registered and wait listed for enrollment in a course, the start dates may be different and the end dates may be the same as the start date for \"enrolled\" status when the student moves off the wait list." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid719
   _:genid721
 ) .

ceds:P000998
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000998"^^xsd:token ;
  rdfs:label "Workforce Program Participation Start Date" ;
  schema:domainIncludes ceds:C200375 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "WorkforceProgramParticipationStartDate" ;
  dc11:description "The year, month, and day of the first day of the reference period during which data are matched between education and workforce data sources." ;
  rdfs:comment "Agencies define the time period for this collection around an enrollment period or exit date with a to-be defined lag period following an exit event. Enrollment periods are defined in CEDS for K12 and postsecondary students. The term \"exit\" includes leaving education for any reason including dropping out or graduating with or without a credential. Exiting conditions are defined in CEDS for K12 and postsecondary students." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid723 ) .

ceds:P000999
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000999"^^xsd:token ;
