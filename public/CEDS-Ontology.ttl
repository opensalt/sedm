  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormName" ;
  dc11:description "The name of a given assessment form." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid73 ) .

ceds:P000366
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000366"^^xsd:token ;
  rdfs:label "Assessment Form Number" ;
  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormNumber" ;
  dc11:description "The number of a given assessment form." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001181
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001181"^^xsd:token ;
  rdfs:label "Assessment Item Bank Identifier" ;
  schema:domainIncludes ceds:C200017, ceds:C200020, ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBankIdentifier" ;
  dc11:description "If the assessment is provided with an item bank, then this identifies the item bank: a unique code or number used by the item banking system." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid75 ) .

ceds:P001182
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001182"^^xsd:token ;
  rdfs:label "Assessment Item Bank Name" ;
  schema:domainIncludes ceds:C200017, ceds:C200020, ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBankName" ;
  dc11:description "If the assessment is provided with an item bank, then this is the name of the item bank." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001183
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001183"^^xsd:token ;
  rdfs:label "Assessment Form Version" ;
  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormVersion" ;
  dc11:description "The version number of the Assessment Form." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001184
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001184"^^xsd:token ;
  rdfs:label "Learning Resource Published Date" ;
  schema:domainIncludes ceds:C200017, ceds:C200020, ceds:C200228 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "LearningResourcePublishedDate" ;
  dc11:description "The published date of an educational resource, such as instructional media, an assessment form, or section of an assessment form." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001185
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001185"^^xsd:token ;
  rdfs:label "Assessment Form Accommodation List" ;
  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormAccommodationList" ;
  dc11:description "The human readable list of one or more of the specific accommodations available. If no accommodations are provided, then this list will not be present." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001186
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001186"^^xsd:token ;
  rdfs:label "Intended Administration Start Date" ;
  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "IntendedAdministrationStartDate" ;
  dc11:description "The beginning date of the time period in which the form is intended to be administered." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001187
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001187"^^xsd:token ;
  rdfs:label "Assessment Form Intended Administration End Date" ;
  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AssessmentFormIntendedAdministrationEndDate" ;
  dc11:description "The ending date of the time period in which the assessment form is intended to be administered." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid77
   _:genid79
 ) .

ceds:P001188
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001188"^^xsd:token ;
  rdfs:label "Assessment Form Platforms Supported" ;
  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormPlatformsSupported" ;
  dc11:description "A human readable list of delivery platforms the form will support." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001533
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001533"^^xsd:token ;
  rdfs:label "Assessment Form Algorithm Identifier" ;
  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormAlgorithmIdentifier" ;
  dc11:description "An identifier for algorithm used to generate a custom form for an adaptive test." ;
  rdfs:comment "The algorithm is typically used to generate the entire assessment form, but there may be cases in which it is used to generate only one part (Assessment Form Section).<br/><br/>CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/> An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" .

ceds:P001534
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001534"^^xsd:token ;
  rdfs:label "Assessment Form Algorithm Version" ;
  schema:domainIncludes ceds:C200017 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormAlgorithmVersion" ;
  dc11:description "The version of the algorithm used to generate a custom form for an adaptive test." ;
  rdfs:comment "The algorithm is typically used to generate the entire assessment form, but there may be cases in which it is used to generate only one part (Assessment Form Section)." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" .

ceds:P000979
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000979"^^xsd:token ;
  rdfs:label "Assessment Form Section Sequence Number" ;
  schema:domainIncludes ceds:C200019, ceds:C200022 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentFormSectionSequenceNumber" ;
  dc11:description "The position of the assessment section presented in the sequence of sections within an assessment form." ;
  ceds:textFormat "Numeric" .

ceds:P001189
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001189"^^xsd:token ;
  rdfs:label "Assessment Form Section Version" ;
  schema:domainIncludes ceds:C200020 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormSectionVersion" ;
  dc11:description "The version number of the Assessment Form Section." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001191
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001191"^^xsd:token ;
  rdfs:label "Assessment Form Section Identifier" ;
  schema:domainIncludes ceds:C200020 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentFormSectionIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to the Assessment Form Section using the system specified by Identification System for Assessment Form Section." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid81 ) .

ceds:P001192
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001192"^^xsd:token ;
  rdfs:label "Assessment Form Section Time Limit" ;
  schema:domainIncludes ceds:C200020 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "AssessmentFormSectionTimeLimit" ;
  dc11:description "If this section is timed, then this will identify the maximum amount of time the test taker can spend within this section." ;
  ceds:textFormat "HH:MM:SS" .

ceds:P000391
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000391"^^xsd:token ;
  rdfs:label "Assessment Item Difficulty" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentItemDifficulty" ;
  dc11:description "The percentage of students who answered the item correctly during trial testing of the item." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "100" ;
  ceds:textFormat "Numeric - up to 3 digits before and 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid83 ) .

ceds:P000398
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000398"^^xsd:token ;
  rdfs:label "Assessment Item Distractor Analysis" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemDistractorAnalysis" ;
  dc11:description "The analysis of the distractors provided for a specific assessment." ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" .

ceds:P000400
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000400"^^xsd:token ;
  rdfs:label "Assessment Item Stem" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemStem" ;
  dc11:description "The statement of the question or prompt for an Assessment Item to which the student responds." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid85 ) .

ceds:P000403
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000403"^^xsd:token ;
  rdfs:label "Assessment Item Allotted Time" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "AssessmentItemAllottedTime" ;
  dc11:description "The amount of time allotted for a specific item." ;
  ceds:textFormat "HH:MM:SS" ;
  ceds:editHistory ( _:genid87 ) .

ceds:P000630
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000630"^^xsd:token ;
  rdfs:label "Assessment Item Identifier" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemIdentifier" ;
  dc11:description "The identifier that uniquely identifies an assessment item." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid89 ) .

ceds:P000707
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000707"^^xsd:token ;
  rdfs:label "Assessment Item Maximum Score" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemMaximumScore" ;
  dc11:description "The maximum number of points possible for the assessment item." ;
  ceds:textFormat "Numeric" .

ceds:P000708
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000708"^^xsd:token ;
  rdfs:label "Assessment Item Minimum Score" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemMinimumScore" ;
  dc11:description "The minimum number of points possible for the assessment item." ;
  ceds:textFormat "Numeric" .

ceds:P000906
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000906"^^xsd:token ;
  rdfs:label "Assessment Item Text Complexity Value" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemTextComplexityValue" ;
  dc11:description "The complexity of the text using the scaling system defined by Text Complexity System, e.g. Lexile™ for assessment items with a reading passage." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001267
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001267"^^xsd:token ;
  rdfs:label "Assessment Item Body Text" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemBodyText" ;
  dc11:description "The complete text of an assessment item including all applicable parts such as stimulus, stem, and possible response options presented." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001268
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001268"^^xsd:token ;
  rdfs:label "Assessment Item Stimulus" ;
  schema:domainIncludes ceds:C200023 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemStimulus" ;
  dc11:description " The text, source (e.g., video clip), and/or graphic about which the assessment item is written. The stimulus provides the context of the item/task to which the student must respond." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001131
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001131"^^xsd:token ;
  rdfs:label "Assessment Item APIP Response Processing Template URL" ;
  schema:domainIncludes ceds:C200024 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemAPIPResponseProcessingTemplateURL" ;
  dc11:description "These templates are described using the processing language defined in IMS Global APIP specification and are distributed (in XML form) along with it. Delivery engines that support generalized response processing do not need to implement special mechanisms to support them as a template file can be parsed directly while processing the assessment item that refers to it. This element provides the URL for the template." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid91 ) .

ceds:P001132
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001132"^^xsd:token ;
  rdfs:label "Assessment Item APIP Response Processing XML" ;
  schema:domainIncludes ceds:C200024 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemAPIPResponseProcessingXML" ;
  dc11:description "Response processing is the process by which the Delivery Engine assigns outcomes based on the learner's responses. The outcomes may be used to provide feedback to the learner Feedback is either provided immediately following the end of the learner's attempt or it is provided at some later time, perhaps as part of a summary report on the item session. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001133
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001133"^^xsd:token ;
  rdfs:label "Assessment Item APIP Response Declaration XML" ;
  schema:domainIncludes ceds:C200024 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemAPIPResponseDeclarationXML" ;
  dc11:description "Response declarations state what the response variables include.  The response declaration may assign an optional correct response. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001134
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001134"^^xsd:token ;
  rdfs:label "Assessment Item APIP Outcome Declaration XML" ;
  schema:domainIncludes ceds:C200024 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemAPIPOutcomeDeclarationXML" ;
  dc11:description "Outcome variables are declared by outcome declarations. Their value is set either from a default given in the declaration itself or by a responseRule during response processing.  The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001135
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001135"^^xsd:token ;
  rdfs:label "Assessment Item APIP Template Declaration XML" ;
  schema:domainIncludes ceds:C200024 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemAPIPTemplateDeclarationXML" ;
  dc11:description "Template declarations declare item variables that are to be used specifically for the purposes of cloning items. They can have their value set only during template processing. They are referred to within the item body in order to individualize the clone and possibly also within the response Processing rules if the cloning process affects the way the item is scored.  The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001136
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001136"^^xsd:token ;
  rdfs:label "Assessment Item APIP Template Processing XML" ;
  schema:domainIncludes ceds:C200024 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemAPIPTemplateProcessingXML" ;
  dc11:description "Template processing consists of one or more template rules that are followed by the cloning engine or delivery system in order to assign values to the template variables. Template processing is identical in form to responseProcessing except that the purpose is to assign values to template variables, not outcome variables. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001137
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001137"^^xsd:token ;
  rdfs:label "Assessment Item APIP Modal Feedback XML" ;
  schema:domainIncludes ceds:C200024 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemAPIPModalFeedbackXML" ;
  dc11:description "Modal feedback is shown to the candidate directly following response processing. The value of an outcome variable is used in conjunction with the showHide and identifier attributes to determine whether or not the feedback is shown in a similar way to feedbackElement. The XML from the IMS Global APIP Specification would be included." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001138
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001138"^^xsd:token ;
  rdfs:label "Assessment Item APIP Item Body XML" ;
  schema:domainIncludes ceds:C200024 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemAPIPItemBodyXML" ;
  dc11:description "The item body contains the text, graphics, media objects, and interactions that describe the item's content and information about how it is structured. The body is presented by combining it with stylesheet information, either explicitly or implicitly using the default style rules of the delivery or authoring system. This element contains the appropriate XML from the IMS Global APIP Specification defining the various item body interactions." ;
  ceds:textFormat "Alphanumeric" .

ceds:P000393
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000393"^^xsd:token ;
  rdfs:label "Assessment Item Response Choice Pattern" ;
  schema:domainIncludes ceds:C200026 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemResponseChoicePattern" ;
  dc11:description "The distribution of responses for each choice in the assessment item." ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" .

ceds:P000709
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000709"^^xsd:token ;
  rdfs:label "Assessment Item Characteristic Value" ;
  schema:domainIncludes ceds:C200026 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemCharacteristicValue" ;
  dc11:description "A psychometric measure provided for an assessment item." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000904
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000904"^^xsd:token ;
  rdfs:label "Assessment Item Possible Response Feedback Message" ;
  schema:domainIncludes ceds:C200027 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemPossibleResponseFeedbackMessage" ;
  dc11:description "A message provided to the person being assessed after giving a response that matches the possible response." ;
  rdfs:comment "This may be a message of affirmation for a correct answer or descriptive feedback for an incorrect answer.  For example, if the item asked the question what is 2 times 3 and the learner answered 5, the Feedback Message might be \"Try multiplication instead of addition.\"" ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P000905
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000905"^^xsd:token ;
  rdfs:label "Assessment Item Possible Response Sequence Number" ;
  schema:domainIncludes ceds:C200027 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemPossibleResponseSequenceNumber" ;
  dc11:description "The position of this response in the list of responses displayed, such as for a multiple choice item type." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P001269
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001269"^^xsd:token ;
  rdfs:label "Assessment Item Possible Response Option" ;
  schema:domainIncludes ceds:C200027 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemPossibleResponseOption" ;
  dc11:description "The possible response presented to the participant within a selected-response/multiple-choice assessment item." ;
  ceds:textFormat "Alphanumeric" .

ceds:P000402
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000402"^^xsd:token ;
  rdfs:label "Assessment Item Response Duration" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "AssessmentItemResponseDuration" ;
  dc11:description "The total amount of time in seconds or milliseconds  that a person spent responding to a given assessment item." ;
  ceds:textFormat "HH:MM:SS or HH:MM:SS.sss" ;
  ceds:editHistory ( _:genid93 ) .

ceds:P000406
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000406"^^xsd:token ;
  rdfs:label "Assessment Item Response Aid Set Used" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemResponseAidSetUsed" ;
  dc11:description "A tool or aid set used while viewing the item. This can include things like a calculator, reference tools, etc." ;
  rdfs:comment "This a permissible set of tools suggested for use for successful completion of a test question, not an accommodation." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid95 ) .

ceds:P000724
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000724"^^xsd:token ;
  rdfs:label "Assessment Item Response Score Value" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemResponseScoreValue" ;
  dc11:description "The score given to a person's response to an assessment item." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid97 ) .

ceds:P000891
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000891"^^xsd:token ;
  rdfs:label "Assessment Item Response Descriptive Feedback" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemResponseDescriptiveFeedback" ;
  dc11:description "The formative descriptive feedback that was given to a learner in response to the results from a scored/evaluated assessment item." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P000955
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000955"^^xsd:token ;
  rdfs:label "Assessment Item Response Hint Count" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseHintCount" ;
  dc11:description "The total number of hints presented as the learner responded to a formative assessment item.  This may include hints requested by the learner or hints automatically presented such as in an online tutoring system. Presentation of a scaffolding item is a separate response record and not counted as a hint." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000957
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000957"^^xsd:token ;
  rdfs:label "Assessment Item Response First Attempt Duration" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "AssessmentItemResponseFirstAttemptDuration" ;
  dc11:description "The amount of time in seconds or milliseconds that a person took to give an initial response, a first attempt to answer a formative assessment item." ;
  rdfs:comment "Formative assessments often allow learners to make multiple attempts until a correct or acceptable answer is given.  In such cases it is valuable to know both the time it took for the initial response and the total time spent responding to the problem." ;
  ceds:textFormat "HH:MM:SS or HH:MM:SS.sss" .

ceds:P000958
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000958"^^xsd:token ;
  rdfs:label "Assessment Item Response Start Time" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "AssessmentItemResponseStartTime" ;
  dc11:description "The time of day that the assessment item was presented to the learner." ;
  ceds:textFormat "HH:MM:SS or HH:MM:SS.sss" .

ceds:P000959
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000959"^^xsd:token ;
  rdfs:label "Assessment Item Response Start Date" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AssessmentItemResponseStartDate" ;
  dc11:description "The date on which the assessment item was presented to the learner." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000969
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000969"^^xsd:token ;
  rdfs:label "Assessment Item Response Security Issue" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemResponseSecurityIssue" ;
  dc11:description "The description of security issue, if any, related to a learner's response to an assessment item." ;
  rdfs:comment "For example: Suspected plagiarism ; Computer left test window ; Excessive response time ; Proctor suspected copying ; Student identity not confirmed ; No proctor present ; Student carried wireless mobile device during test ; Student terminated test early and restarted ; Excessive erasures on test form ; Response pattern identical to another student's" ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001063
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001063"^^xsd:token ;
  rdfs:label "Assessment Item Response Value" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemResponseValue" ;
  dc11:description " A specific response to an assessment item by the person being assessed." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001284
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001284"^^xsd:token ;
  rdfs:label "Assessment Item Result XML" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentItemResultXML" ;
  dc11:description "The  assessment item result formatted according to the IMS Global QTI  Specification." ;
  rdfs:comment "See http://www.imsglobal.org/question/qtiv2p1/imsqti_resultv2p1.html#element10818" ;
  ceds:textFormat "Alphanumeric" .

ceds:P001537
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001537"^^xsd:token ;
  rdfs:label "Assessment Item Response Descriptive Feedback Date" ;
  schema:domainIncludes ceds:C200028 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "AssessmentItemResponseDescriptiveFeedbackDate" ;
  dc11:description "The date and time the descriptive feedback was entered in response to the results from a scored/evaluated assessment item." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" .

ceds:P001251
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001251"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter A" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterA" ;
  dc11:description "The Item Response Theory value representing the discrimination of the item. The a parameter is found by taking the slope of the line tangent to the item characteristic curve at the inflection point, B. The parameter is the steepness of the curve at its steepest point." ;
  ceds:textFormat "Numeric" .

ceds:P001252
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001252"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter B" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterB" ;
  dc11:description "The Item Response Theory value representing the difficulty of the item.   It is the Theta value for the location of the inflection point of the item characteristic curve." ;
  ceds:textFormat "Numeric" .

ceds:P001254
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001254"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter C" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterC" ;
  dc11:description "The Item Response Theory value for multiple choice items representing the guessing of the item. The c parameter is a lower asymptote. It is the low point of the curve as it moves to negative infinity on the horizontal axis. You can think of c as the probability that a chicken would get the item right." ;
  ceds:textFormat "Numeric" .

ceds:P001255
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001255"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter D1" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterD1" ;
  dc11:description "For   polytomous assessment items with more than two possible responses, this is the item response theory value representing the threshold between the first and second item characteristic functions." ;
  ceds:textFormat "Numeric" .

ceds:P001256
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001256"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter D2" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterD2" ;
  dc11:description "For   polytomous assessment items with more than two possible responses, this is the item response theory value representing the threshold between the second and third item characteristic functions." ;
  ceds:textFormat "Numeric" .

ceds:P001257
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001257"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter D3" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterD3" ;
  dc11:description "For   polytomous assessment items with more than three possible responses, this is the item response theory value representing the threshold between the third and fourth item characteristic functions." ;
  ceds:textFormat "Numeric" .

ceds:P001258
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001258"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter D4" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterD4" ;
  dc11:description "For   polytomous assessment items with more than four possible responses, this is the item response theory value representing the threshold between the fourth and fifth item characteristic functions." ;
  ceds:textFormat "Numeric" .

ceds:P001259
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001259"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter D5" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterD5" ;
  dc11:description "For   polytomous assessment items with more than five possible responses, this is the item response theory value representing the threshold between the fifth and sixth item characteristic functions." ;
  ceds:textFormat "Numeric" .

ceds:P001260
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001260"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Parameter D6" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryParameterD6" ;
  dc11:description "For   polytomous assessment items with more than six possible responses, this is the item response theory value representing the threshold between the sixth and seventh item characteristic functions." ;
  ceds:textFormat "Numeric" .

ceds:P001262
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001262"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Point Biserial Correlation Value" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryPointBiserialCorrelationValue" ;
  dc11:description "The correlation between correct answers on this item and total correct answers on the test during a previous administration. " ;
  ceds:textFormat "Numeric" .

ceds:P001264
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001264"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory DIF Value" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryDIFValue" ;
  dc11:description "A value representing the Differential Item Functioning, also referred to as  measurement bias, for the assessment item.  The value represents differences in the functioning of the item across groups which are matched on the attribute being measure by the item.  The value is calculated using Mantel-Haenszel approach or a comparable algorithm so that a value of 1.0 represents no bias." ;
  ceds:textFormat "Numeric" .

ceds:P001265
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001265"^^xsd:token ;
  rdfs:label "Assessment Item Response Theory Kappa Value" ;
  schema:domainIncludes ceds:C200029 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentItemResponseTheoryKappaValue" ;
  dc11:description "The measure used to represent the degree of agreement among raters." ;
  ceds:textFormat "Numeric" .

ceds:P001049
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001049"^^xsd:token ;
  rdfs:label "Assessment Need Time Multiplier" ;
  schema:domainIncludes ceds:C200033 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentNeedTimeMultiplier" ;
  dc11:description "Defines the multiplier to be applied to the time limit to determine the total testing time allowed when Additional Testing Time is specified as part of an Assessment Personal Needs Profile.  If the value is ‘unlimited’ then there is no time limit for the test." ;
  ceds:maxLength "9" ;
  ceds:textFormat "Alphanumeric - 9 characters maximum" .

ceds:P001050
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001050"^^xsd:token ;
  rdfs:label "Assessment Need Line Reader Highlight Color" ;
  schema:domainIncludes ceds:C200033 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentNeedLineReaderHighlightColor" ;
  dc11:description "The color defined as part of an Assessment Personal Needs Profile to be used to highlight the point of line reader activity i.e. the line being read." ;
  ceds:minLength "6" ;
  ceds:maxLength "6" ;
  ceds:textFormat "Color hex code (alphanumeric - 6 characters)" .

ceds:P001051
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001051"^^xsd:token ;
  rdfs:label "Assessment Need Overlay Color" ;
  schema:domainIncludes ceds:C200033 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentNeedOverlayColor" ;
  dc11:description "This is the preferred color for the overlay for screen enhancement defined as part of an Assessment Personal Needs Profile." ;
  ceds:minLength "6" ;
  ceds:maxLength "6" ;
  ceds:textFormat "Color hex code (alphanumeric - 6 characters)" .

ceds:P001053
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001053"^^xsd:token ;
  rdfs:label "Assessment Need Background Color" ;
  schema:domainIncludes ceds:C200033 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentNeedBackgroundColor" ;
  dc11:description "This is the preferred Background color for screen enhancement defined as part of an Assessment Personal Needs Profile." ;
  ceds:minLength "6" ;
  ceds:maxLength "6" ;
  ceds:textFormat "Color hex code (alphanumeric - 6 characters)" .

ceds:P001047
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001047"^^xsd:token ;
  rdfs:label "Assessment Need Text Messaging String" ;
  schema:domainIncludes ceds:C200034 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentNeedTextMessagingString" ;
  dc11:description "The text string that is to be displayed to the user as an expression of encouragement when Masking is specified as part of an Assessment Personal Needs Profile.  It is left to the system to determine when to display this string." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001048
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001048"^^xsd:token ;
  rdfs:label "Assessment Need Sound File URL" ;
  schema:domainIncludes ceds:C200034 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentNeedSoundFileURL" ;
  dc11:description "The URI of the sound file that is to be played to the user as an expression of encouragement when Masking is specified as part of an Assessment Personal Needs Profile. It is left to the system to determine when to play this audio file." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid99 ) .

ceds:P001034
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001034"^^xsd:token ;
  rdfs:label "Assessment Need Number of Braille Cells" ;
  schema:domainIncludes ceds:C200035 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentNeedNumberOfBrailleCells" ;
  dc11:description "Defines as part of an Assessment Personal Needs Profile the number of active Braille cells in a Braille display." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P001036
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001036"^^xsd:token ;
  rdfs:label "Assessment Need Braille Dot Pressure" ;
  schema:domainIncludes ceds:C200035 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentNeedBrailleDotPressure" ;
  dc11:description "Defines as part of an Assessment Personal Needs Profile the resistance pressure of Braille display pins." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "999999" ;
  ceds:textFormat "Numeric - up to 4 digits after decimal place" ;
  ceds:decimalPlaces "4" .

ceds:P001031
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001031"^^xsd:token ;
  rdfs:label "Assessment Need Magnification" ;
  schema:domainIncludes ceds:C200036 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentNeedMagnification" ;
  dc11:description "Defines as part of an Assessment Personal Needs Profile the preferred magnification of the screen as a factor of a screen’s original size." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "999999" ;
  ceds:textFormat "Numeric - up to 4 digits after decimal place" ;
  ceds:decimalPlaces "4" .

ceds:P001052
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001052"^^xsd:token ;
  rdfs:label "Assessment Need Foreground Color" ;
  schema:domainIncludes ceds:C200036 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentNeedForegroundColor" ;
  dc11:description "This is the preferred Foreground color for screen enhancement defined as part of an Assessment Personal Needs Profile." ;
  ceds:minLength "6" ;
  ceds:maxLength "6" ;
  ceds:textFormat "Color hex code (alphanumeric - 6 characters)" .

ceds:P000407
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000407"^^xsd:token ;
  rdfs:label "Assessment Participant Session Time Assessed" ;
  schema:domainIncludes ceds:C200037 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentParticipantSessionTimeAssessed" ;
  dc11:description "The overall time a learner actually spent during the  assessment session." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid101 ) .

ceds:P001003
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001003"^^xsd:token ;
  rdfs:label "Assessment Participant Session Delivery Device Details" ;
  schema:domainIncludes ceds:C200037 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentParticipantSessionDeliveryDeviceDetails" ;
  dc11:description "The details about the device or platform by with which the assessment was delivered to the learner." ;
  rdfs:comment "For example web browser version and screen resolution." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001021
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001021"^^xsd:token ;
  rdfs:label "Assessment Session Actual Start Date Time" ;
  schema:domainIncludes ceds:C200037, ceds:C200049 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "AssessmentSessionActualStartDateTime" ;
  dc11:description "Date and time the assessment actually began." ;
  rdfs:comment "When associated to an assessment session this is the actual start date and time.  When associated to an individual taking an assessment, this is the actual date and time when the individual started." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" .

ceds:P001022
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001022"^^xsd:token ;
  rdfs:label "Assessment Session Actual End Date Time" ;
  schema:domainIncludes ceds:C200037, ceds:C200049 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "AssessmentSessionActualEndDateTime" ;
  dc11:description "Date and time the assessment actually ended." ;
  rdfs:comment "When associated to an assessment session this is the actual end date and time.  When associated to an individual taking an assessment, this is the actual date and time when the individual finished." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" ;
  ceds:editHistory ( _:genid103 ) .

ceds:P001093
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001093"^^xsd:token ;
  rdfs:label "Assessment Session Special Event Description" ;
  schema:domainIncludes ceds:C200037, ceds:C200049 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSessionSpecialEventDescription" ;
  dc11:description "Describes special events that occur before during or after the assessment session that may impact use of results according to rules related to the Assessment Registration Testing Indicator." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001130
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001130"^^xsd:token ;
  rdfs:label "Assessment Participant Session Security Issue" ;
  schema:domainIncludes ceds:C200037 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentParticipantSessionSecurityIssue" ;
  dc11:description "Describes an issue related to the security of a testing instrument identified during a specific instance of delivering an assessment to a specific person during a specific time period." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001152
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001152"^^xsd:token ;
  rdfs:label "Assessment Participant Session Platform User Agent" ;
  schema:domainIncludes ceds:C200037 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentParticipantSessionPlatformUserAgent" ;
  dc11:description " A list of product tokens (keywords) with optional comments that identifies the client hardware and software with which the assessment was delivered to the student during the assessment session." ;
  rdfs:comment "Implementation Note: The recommended approach is to store the User-Agent string returned as part of an HTTP header.  For example, an assessment session delivery via iPad might have \"Mozilla/5.0 (iPad; U; CPU OS 3_2_1 like Mac OS X; en-us) AppleWebKit/531.21.10 (KHTML, like Gecko) Mobile/7B405\"" ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" .

ceds:P001539
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001539"^^xsd:token ;
  rdfs:label "Assessment Participant Session Database Name" ;
  schema:domainIncludes ceds:C200037 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentParticipantSessionDatabaseName" ;
  dc11:description "The name of the database that was used to administer the test." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P000417
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000417"^^xsd:token ;
  rdfs:label "Assessment Performance Level Score Metric" ;
  schema:domainIncludes ceds:C200038 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentPerformanceLevelScoreMetric" ;
  dc11:description "The metric or scale used for score reporting." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000418
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000418"^^xsd:token ;
  rdfs:label "Assessment Performance Level Lower Cut Score" ;
  schema:domainIncludes ceds:C200038 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentPerformanceLevelLowerCutScore" ;
  dc11:description "Lowest possible score for the performance level." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid105 ) .

ceds:P000419
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000419"^^xsd:token ;
  rdfs:label "Assessment Performance Level Upper Cut Score" ;
  schema:domainIncludes ceds:C200038 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentPerformanceLevelUpperCutScore" ;
  dc11:description "Highest possible score for the performance level." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid107 ) .

ceds:P000717
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000717"^^xsd:token ;
  rdfs:label "Assessment Performance Level Identifier" ;
  schema:domainIncludes ceds:C200038 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentPerformanceLevelIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to an assessment performance level." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid109 ) .

ceds:P000718
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000718"^^xsd:token ;
  rdfs:label "Assessment Performance Level Label" ;
  schema:domainIncludes ceds:C200038 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentPerformanceLevelLabel" ;
  dc11:description "A label representing the performance level appropriate for use on a report." ;
  ceds:maxLength "20" ;
  ceds:textFormat "Alphanumeric - 20 characters maximum" ;
  ceds:editHistory ( _:genid111 ) .

ceds:P001218
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001218"^^xsd:token ;
  rdfs:label "Assessment Performance Level Descriptive Feedback" ;
  schema:domainIncludes ceds:C200038 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentPerformanceLevelDescriptiveFeedback" ;
  dc11:description "A feedback message designed to be reported with the assessment performance level." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001028
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001028"^^xsd:token ;
  rdfs:label "Assessment Need Speech Rate" ;
  schema:domainIncludes ceds:C200040 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentNeedSpeechRate" ;
  dc11:description "Defines as part of an Assessment Personal Needs Profile the rate of speech of a speech synthesizer." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P001029
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001029"^^xsd:token ;
  rdfs:label "Assessment Need Volume" ;
  schema:domainIncludes ceds:C200040 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentNeedVolume" ;
  dc11:description "Defines as part of an Assessment Personal Needs Profile the volume of a speech synthesizer." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "999999" ;
  ceds:textFormat "Numeric - up to 4 digits after decimal place" ;
  ceds:decimalPlaces "4" .

ceds:P001087
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001087"^^xsd:token ;
  rdfs:label "Assessment Need Pitch" ;
  schema:domainIncludes ceds:C200040 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentNeedPitch" ;
  dc11:description "Defines as part of an Assessment Personal Needs Profile the pitch of a speech synthesizer." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "999999" ;
  ceds:textFormat "Numeric - up to 4 digits after decimal place" ;
  ceds:decimalPlaces "4" .

ceds:P001127
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001127"^^xsd:token ;
  rdfs:label "Assessment Need Type" ;
  schema:domainIncludes ceds:C200041 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentNeedType" ;
  dc11:description "A type of need identified for a learner as part of an assessment need profile." ;
  ceds:textFormat "Alphanumeric" .

ceds:P000889
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000889"^^xsd:token ;
  rdfs:label "Assessment Registration Assignor Identifier" ;
  schema:domainIncludes ceds:C200046 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentRegistrationAssignorIdentifier" ;
  dc11:description "The unique identifier of the person who assigned the assessment to the learner." ;
  rdfs:comment "For example, the unique identifier of a classroom teacher or school principal.<BR/><BR/>CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <BR/><BR/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid113 ) .

ceds:P001015
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001015"^^xsd:token ;
  rdfs:label "Assessment Registration Days of Instruction" ;
  schema:domainIncludes ceds:C200046 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentRegistrationDaysOfInstruction" ;
  dc11:description "The number of days of instruction the student has taken prior to testing." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P001017
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001017"^^xsd:token ;
  rdfs:label "Assessment Registration Creation Date" ;
  schema:domainIncludes ceds:C200046 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "AssessmentRegistrationCreationDate" ;
  dc11:description "Date/time assignment is made." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" .

ceds:P001055
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001055"^^xsd:token ;
  rdfs:label "Assessment Registration Testing Indicator" ;
  schema:domainIncludes ceds:C200046 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentRegistrationTestingIndicator" ;
  dc11:description "Indicates rules about use of results based on Special Events before, during or after the test. The option set values are determined by the testing program." ;
  rdfs:comment "For example, \"do not score\", \"do not report\"." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid115 ) .

ceds:P001056
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001056"^^xsd:token ;
  rdfs:label "Assessment Registration Score Publish Date" ;
  schema:domainIncludes ceds:C200046 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AssessmentRegistrationScorePublishDate" ;
  dc11:description "The date set by the testing program when the test scores are published.  For formative or classroom assessments, this will likely be the date when the scored the individual test.  For summative assessments, this date is likely set for a group of assessments when the processing system releases the scores." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001162
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001162"^^xsd:token ;
  rdfs:label "Assessment Registration Test Attempt Identifier" ;
  schema:domainIncludes ceds:C200046 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentRegistrationTestAttemptIdentifier" ;
  dc11:description "A unique identifier for the test attempt assigned by the delivery system." ;
  rdfs:comment "For paper-based tests this is typically a batch/stack/serial number and for online tests it is likely a unique internal identifier. Used to locate the original attempt.<br/><br/>CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid117 ) .

ceds:P001542
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001542"^^xsd:token ;
  rdfs:label "Assessment Registration Completion Status Date Time" ;
  schema:domainIncludes ceds:C200046 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "AssessmentRegistrationCompletionStatusDateTime" ;
  dc11:description "The date and time the completion and scoring status was changed for an instance of a person taking an assessment." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" .

ceds:P000245
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000245"^^xsd:token ;
  rdfs:label "Assessment Result Score Value" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentResultScoreValue" ;
  dc11:description "A meaningful raw score, derived score, or statistical expression of the performance of a person on an assessment. The type of result is indicated by the Assessment Score Metric Type element. The results can be expressed as a number, percentile, range, level, etc. The score relates to all scored items or a sub test scoring one aspect of performance on the test. This value may or may not correspond to one or more Performance Levels." ;
  rdfs:comment "Information for interpreting the score is defined by elements in the related Assessment Subtest entity.  This includes the minimum, maximum, and optimal values for the measurement. Assessment Subtest defines information for scoring an Assessment Form, which may be for the entire assessment or one aspect of evaluation. The Assessment Subtest may in turn be associated with one or more content standards using the Learning Standard Item Association entity." ;
  ceds:maxLength "35" ;
  ceds:textFormat "Alphanumeric - 35 characters maximum" ;
  ceds:editHistory ( _:genid119 ) .

ceds:P000370
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000370"^^xsd:token ;
  rdfs:label "Instructional Recommendation" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "InstructionalRecommendation" ;
  dc11:description "This provides the next steps for instruction for the student based upon the assessment results and student characteristics." ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" .

ceds:P000890
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000890"^^xsd:token ;
  rdfs:label "Assessment Result Descriptive Feedback" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentResultDescriptiveFeedback" ;
  dc11:description "The formative descriptive feedback that was given to a learner based on a scored/evaluated portion of an assessment as recorded in the result entity." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid121 ) .

ceds:P000970
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000970"^^xsd:token ;
  rdfs:label "Assessment Result Date Updated" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AssessmentResultDateUpdated" ;
  dc11:description "The most recent date that the result was calculated/updated.  The value should be the same as Assessment Result Date Created if the subtest has only been scored once, but may be different if the score was recalculated with a different result." ;
  rdfs:comment "This flag is to handle cases when a subtest result is originally scored using incorrect parameters and then rescored, such as if the grade level attributed to the student was originally encoded incorrectly and later corrected.  An operational system may also capture the history of if rescored more than once." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid123 ) .

ceds:P000971
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000971"^^xsd:token ;
  rdfs:label "Assessment Result Date Created" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AssessmentResultDateCreated" ;
  dc11:description "The date on which the assessment result was generated." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid125 ) .

ceds:P001008
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001008"^^xsd:token ;
  rdfs:label "Diagnostic Statement Source" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "DiagnosticStatementSource" ;
  dc11:description "Identifies the source of the Diagnostic Statement based on a scored/evaluated portion of an assessment." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001009
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001009"^^xsd:token ;
  rdfs:label "Assessment Result Number of Responses" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentResultNumberOfResponses" ;
  dc11:description "The number of responses that are included with the Student Score Set. Responses are those items that were attempted (partially or fully answered) by the student and not necessarily the number of items in the assessment (which can be determined from the assessment object)." ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid127 ) .

ceds:P001092
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001092"^^xsd:token ;
  rdfs:label "Assessment Result Descriptive Feedback Source" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentResultDescriptiveFeedbackSource" ;
  dc11:description "Identifies the source of the descriptive feedback that was given to a learner based on a scored/evaluated portion of an assessment. May indicate if this is teacher, scorer, or system generated feedback. Values for this attribute would be determined by the assessment program." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid129 ) .

ceds:P001219
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001219"^^xsd:token ;
  rdfs:label "Assessment Result Diagnostic Statement" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentResultDiagnosticStatement" ;
  dc11:description "A statement intended for use by education professionals, using professional terminology, to interpret learner needs based on the scored/evaluated portion of an assessment.  This statement may inform Descriptive Feedback given to the learner." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid131 ) .

ceds:P001545
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001545"^^xsd:token ;
  rdfs:label "Assessment Result Descriptive Feedback Date Time" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "AssessmentResultDescriptiveFeedbackDateTime" ;
  dc11:description "The date and time the descriptive feedback was entered for a scored/evaluated portion of an assessment." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" .

ceds:P001546
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001546"^^xsd:token ;
  rdfs:label "Assessment Result Score Standard Error" ;
  schema:domainIncludes ceds:C200047 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentResultScoreStandardError" ;
  dc11:description "The measure of sampling variability and measurement error for the score, the amount of error to be expected in the score." ;
  rdfs:comment "See http://nces.ed.gov/nationsreportcard/NDEHelp/WebHelp/standard_error.htm" ;
  ceds:textFormat "Numeric" .

ceds:P000408
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000408"^^xsd:token ;
  rdfs:label "Assessment Session Allotted Time" ;
  schema:domainIncludes ceds:C200049 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "AssessmentSessionAllottedTime" ;
  dc11:description "The duration of time allotted for the assessment session." ;
  ceds:textFormat "HH:MM:SS or HH:MM:SS.sss" ;
  ceds:editHistory ( _:genid133 ) .

ceds:P000597
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000597"^^xsd:token ;
  rdfs:label "Assessment Session Location" ;
  schema:domainIncludes ceds:C200049 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSessionLocation" ;
  dc11:description " The description of the place where an assessment is administered." ;
  ceds:maxLength "45" ;
  ceds:textFormat "Alphanumeric - 45 characters maximum" ;
  ceds:editHistory ( _:genid135 ) .

ceds:P000968
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000968"^^xsd:token ;
  rdfs:label "Assessment Session Security Issue" ;
  schema:domainIncludes ceds:C200049 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSessionSecurityIssue" ;
  dc11:description "The description of a security issue, if any, discovered for an administration of an assessment, such as suspected cheating by a student or a teacher changing answers after a student takes the test." ;
  rdfs:comment "For example: Suspected plagiarism ; Computer left test window ; Excessive response time ; Proctor suspected copying ; Student identity not confirmed ; No proctor present ; Student carried wireless mobile device during test ; Student terminated test early and restarted ; Excessive erasures on test form ; Response pattern identical to another student's" ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001019
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001019"^^xsd:token ;
  rdfs:label "Assessment Session Scheduled Start Date Time" ;
  schema:domainIncludes ceds:C200049 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "AssessmentSessionScheduledStartDateTime" ;
  dc11:description "Date and time the assessment is scheduled to begin." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" .

ceds:P001020
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001020"^^xsd:token ;
  rdfs:label "Assessment Session Scheduled End Date Time" ;
  schema:domainIncludes ceds:C200049 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "AssessmentSessionScheduledEndDateTime" ;
  dc11:description "Date and time the assessment is scheduled to end." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" ;
  ceds:editHistory ( _:genid137 ) .

ceds:P000274
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000274"^^xsd:token ;
  rdfs:label "Assessment Subtest Description" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestDescription" ;
  dc11:description "The description of the subtest (e.g., vocabulary, measurement, or geometry)." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000275
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000275"^^xsd:token ;
  rdfs:label "Assessment Subtest Title" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestTitle" ;
  dc11:description "The name or title of the subtest." ;
  ceds:maxLength "60" ;
  ceds:textFormat "300 characters maximum" ;
  ceds:editHistory (
   _:genid139
   _:genid141
   _:genid143
 ) .

ceds:P000367
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000367"^^xsd:token ;
  rdfs:label "Assessment Subtest Identifier" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to an assessment subtest." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid145 ) .

ceds:P000368
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000368"^^xsd:token ;
  rdfs:label "Assessment Subtest Abbreviation" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestAbbreviation" ;
  dc11:description "The shortened name identifying the assessment for use in reference and/or reports." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000388
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000388"^^xsd:token ;
  rdfs:label "Assessment Subtest Version" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestVersion" ;
  dc11:description "The version of the subtest that is included for the assessment." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000395
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000395"^^xsd:token ;
  rdfs:label "Assessment Subtest Minimum Value" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestMinimumValue" ;
  dc11:description "The minimum value possible for the measurement." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid147 ) .

ceds:P000396
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000396"^^xsd:token ;
  rdfs:label "Assessment Subtest Maximum Value" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestMaximumValue" ;
  dc11:description "The maximum value for the measurement." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid149 ) .

ceds:P000397
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000397"^^xsd:token ;
  rdfs:label "Assessment Subtest Optimal Value" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestScaleOptimalValue" ;
  dc11:description "The optimal value for this measurement." ;
  rdfs:comment "The Optimal Value may be the same as the Maximum Value, the Minimum Value, or something in between." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid151 ) .

ceds:P000719
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000719"^^xsd:token ;
  rdfs:label "Assessment Subtest Rules" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AssessmentSubtestRules" ;
  dc11:description "A description of the rules to produce a student test/subtest score from for a grouping of student item scores." ;
  ceds:textFormat "Alphanumeric" .

ceds:P001091
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001091"^^xsd:token ;
  rdfs:label "Assessment Subtest Published Date" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AssessmentSubtestPublishedDate" ;
  dc11:description "The date on which the Subtest was published." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001214
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001214"^^xsd:token ;
  rdfs:label "Assessment Form Subtest Tier" ;
  schema:domainIncludes ceds:C200051 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "AssessmentFormSubtestTier" ;
  dc11:description "In a hierarchy of subtests, this element represents the level of the sub test in the hierarchy.  The top tier and default is zero." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P001010
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001010"^^xsd:token ;
  rdfs:label "Assessment Form Subtest Item Weight Correct" ;
  schema:domainIncludes ceds:C200052 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentFormSubtestItemWeightCorrect" ;
  dc11:description "A weighting factor for how the item score is used to compute a sub-test score when the item is correct or partially correct. Item weight of 1 indicates the full item score is used. A weight of .5 would indicate the item only contributes one half of the item score to the subtest. A weight of 0 indicates the item does not affect the sub test score." ;
  ceds:textFormat "Numeric" .

ceds:P001012
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001012"^^xsd:token ;
  rdfs:label "Assessment Form Subtest Item Weight Incorrect" ;
  schema:domainIncludes ceds:C200052 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentFormSubtestItemWeightIncorrect" ;
  dc11:description "A weighting factor for how the item score is used to compute a sub-test score when the item is attempted and incorrect. Item weight should be a negative value if the item subtracts from the score if missed." ;
  ceds:textFormat "Numeric" .

ceds:P001013
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001013"^^xsd:token ;
  rdfs:label "Assessment Form Subtest Item Weight Not Attempted" ;
  schema:domainIncludes ceds:C200052 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AssessmentFormSubtestItemWeightNotAttempted" ;
  dc11:description "A weighting factor for how the item score is used to compute a sub-test score when the item has not been attempted by the student. Item weight should be a negative value if the item subtracts from the score if not attempted." ;
  ceds:textFormat "Numeric" .

ceds:P001168
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001168"^^xsd:token ;
  rdfs:label "Authentication Identity Provider Name" ;
  schema:domainIncludes ceds:C200054 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AuthenticationIdentityProviderName" ;
  dc11:description "The name of a provider that can authenticate the identity of an person." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001169
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001169"^^xsd:token ;
  rdfs:label "Authentication Identity Provider URI" ;
  schema:domainIncludes ceds:C200054 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AuthenticationIdentityProviderURI" ;
  dc11:description "The Uniform Resource Identifier (URI) of the  Authentication Identity Provider." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" .

ceds:P001170
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001170"^^xsd:token ;
  rdfs:label "Authentication Identity Provider Login Identifier" ;
  schema:domainIncludes ceds:C200054 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AuthenticationIdentityProviderLoginIdentifier" ;
  dc11:description "The login identifier for the person for the specified Authentication Identity Provider." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid153 ) .

ceds:P001171
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001171"^^xsd:token ;
  rdfs:label "Authentication Identity Provider Start Date" ;
  schema:domainIncludes ceds:C200054 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AuthenticationIdentityProviderStartDate" ;
  dc11:description "The date on which the  an associated person may begin to use the specified Authentication Identity Provider to authenticate identity." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001172
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001172"^^xsd:token ;
  rdfs:label "Authentication Identity Provider End Date" ;
  schema:domainIncludes ceds:C200054 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AuthenticationIdentityProviderEndDate" ;
  dc11:description "The date after which the  an associated person is no longer allowed to use the specified Authentication Identity Provider to authenticate identity." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid155 ) .

ceds:P001175
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001175"^^xsd:token ;
  rdfs:label "Authorization Application Role Name" ;
  schema:domainIncludes ceds:C200055 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AuthorizationApplicationRoleName" ;
  dc11:description "The user role for which the person is allowed." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P001176
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001176"^^xsd:token ;
  rdfs:label "Authorization Start Date" ;
  schema:domainIncludes ceds:C200055 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AuthorizationStartDate" ;
  dc11:description "The date on which the  an associated person  is authorized to start using the application with the specified role." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001177
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001177"^^xsd:token ;
  rdfs:label "Authorization End Date" ;
  schema:domainIncludes ceds:C200055 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AuthorizationEndDate" ;
  dc11:description "The date after which the  an associated person is no longer allowed to use the application with the specified role." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid157 ) .

ceds:P001722
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001722"^^xsd:token ;
  rdfs:label "Authorization Decision Explanation" ;
  schema:domainIncludes ceds:C200056 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "AuthorizationDecisionExplanation" ;
  dc11:description "Authorizer's explanation regarding the authorization decision." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid159 ) .

ceds:P001725
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001725"^^xsd:token ;
  rdfs:label "Authorization Date" ;
  schema:domainIncludes ceds:C200056 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "AuthorizationDate" ;
  dc11:description "The date the authorization occurred." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid161 ) .

ceds:P002102
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002102"^^xsd:token ;
  rdfs:label "Board Member Term Start Date" ;
  schema:domainIncludes ceds:C200057 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "BoardMemberTermStartDate" ;
  dc11:description "The date on which the board member's term begins." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid163 ) .

ceds:P002103
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002103"^^xsd:token ;
  rdfs:label "Board Member Term End Date" ;
  schema:domainIncludes ceds:C200057 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "BoardMemberTermEndDate" ;
  dc11:description "The date on which the board member's term ends." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid165 ) .

ceds:P001207
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001207"^^xsd:token ;
  rdfs:label "Facility Space Description" ;
  schema:domainIncludes ceds:C200058 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FacilitySpaceDescription" ;
  dc11:description "A description of the space, as determined by its physical layout and built-in systems and equipment." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001861
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001861"^^xsd:token ;
  rdfs:label "Building Space Utilization Area" ;
  schema:domainIncludes ceds:C200059 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "BuildingSpaceUtilizationArea" ;
  dc11:description "The area in square feet measured between the principal wall that faces at or near floor level, including alcove spaces, and the outer limits of space designed to serve the activity. Structural space is excluded." ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001801
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001801"^^xsd:token ;
  rdfs:label "Building Institutional Equipment Description" ;
  schema:domainIncludes ceds:C200061 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "BuildingInstitutionalEquipmentDescription" ;
  dc11:description "Equipment that is installed for use in support of instructional program such as kilns for art, planetarium equipment for astronomy, fitness equipment for physical education." ;
  ceds:maxLength "80" ;
  ceds:textFormat "Alphanumeric - 80 characters maximum" .

ceds:P001840
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001840"^^xsd:token ;
  rdfs:label "Facility Component Identification Code" ;
  schema:domainIncludes ceds:C200061 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FacilityComponentIdentificationCode" ;
  dc11:description "A unique number or alphanumeric code assigned to a component by a school, school system, state, or other agency or entity." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P001848
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001848"^^xsd:token ;
  rdfs:label "Installation Date" ;
  schema:domainIncludes ceds:C200061 ;
  schema:rangeIncludes xsd:gYear ;
  skos:notation "InstallationDate" ;
  dc11:description "The year in which the system, component, equipment, or fixture was originally installed." ;
  ceds:textFormat "YYYY" .

ceds:P001849
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001849"^^xsd:token ;
  rdfs:label "Life-cycle Cost" ;
  schema:domainIncludes ceds:C200061 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "Life-cycleCost" ;
  dc11:description "The total cost of acquiring, owning, operating, and disposing of a building, facility, or piece of equipment over its useful life." ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001901
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001901"^^xsd:token ;
  rdfs:label "Component or Fixture Useful Life" ;
  schema:domainIncludes ceds:C200061 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "ComponentOrFixtureUsefulLife" ;
  dc11:description "The anticipated time (in years) from the time of installation or service that a properly maintained system, component, equipment, or fixture is expected to operate effectively and efficiently." ;
  ceds:textFormat "Integer" .

ceds:P001899
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001899"^^xsd:token ;
  rdfs:label "Component or Fixture Serviced Date" ;
  schema:domainIncludes ceds:C200062 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "ComponentOrFixtureServicedDate" ;
  dc11:description "The month, day, and year a system, component, equipment, or fixture was serviced for repair or routine maintenance." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P001900
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001900"^^xsd:token ;
  rdfs:label "Component or Fixture Scheduled Serviced Date" ;
  schema:domainIncludes ceds:C200062 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "ComponentOrFixtureScheduledServicedDate" ;
  dc11:description "The month, day, and year a major component, system, equipment, or fixture is scheduled to be serviced for preventive or routine maintenance." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000030
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000030"^^xsd:token ;
  rdfs:label "Available Carnegie Unit Credit" ;
  schema:domainIncludes ceds:C200090, ceds:C200074, ceds:C200186 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "AvailableCarnegieUnitCredit" ;
  dc11:description "Measured in Carnegie units, the amount of credit available to a student who successfully meets the objectives of the course. A course meeting every day for one period of the school day over the span of a school year offers one Carnegie unit. A Carnegie unit is thus a measure of \"seat time\" rather than a measure of attainment of the course objectives." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid167 ) .

ceds:P001549
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001549"^^xsd:token ;
  rdfs:label "Course Department Name" ;
  schema:domainIncludes ceds:C200090, ceds:C200186 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseDepartmentName" ;
  dc11:description "Department with jurisdiction over this course." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000073
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000073"^^xsd:token ;
  rdfs:label "Credits Attempted Cumulative" ;
  schema:domainIncludes ceds:C200091, ceds:C200210, ceds:C200336 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CreditsAttemptedCumulative" ;
  dc11:description "The cumulative number of credits a person attempts to earn by taking courses during their enrollment in their current education institution as well as those credits transferred from an education institution in which the person had been previously enrolled." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory (
   _:genid169
   _:genid171
 ) .

ceds:P000074
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000074"^^xsd:token ;
  rdfs:label "Credits Earned Cumulative" ;
  schema:domainIncludes ceds:C200091, ceds:C200210, ceds:C200336 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CreditsEarnedCumulative" ;
  dc11:description "The cumulative number of credits a person earns by completing courses or examinations during their enrollment in the current education institution as well as those credits transferred from an education institution in which the person had been previously enrolled." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory (
   _:genid173
   _:genid175
   _:genid177
 ) .

ceds:P000364
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000364"^^xsd:token ;
  rdfs:label "Classroom Identifier" ;
  schema:domainIncludes ceds:C200063, ceds:C200252 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ClassroomIdentifier" ;
  dc11:description "A unique number or alphanumeric code assigned to a room by a school, school system, state, or other agency or entity." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory (
   _:genid179
   _:genid181
 ) .

ceds:P000689
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000689"^^xsd:token ;
  rdfs:label "Competency Definition Identifier" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionIdentifier" ;
  dc11:description "The globally unique identifier (GUID) issued by the publisher of the competency framework that uniquely identifies the definition in the hierarchy of competency definitions using a RFC 4122 compliant 32-character hexadecimal string, such as 21EC2020-3AEA-1069-A2DD-08002B30309D." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces.  <BR/><BR/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid183 ) .

ceds:P000690
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000690"^^xsd:token ;
  rdfs:label "Competency Definition Statement" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionStatement" ;
  dc11:description "The text of the statement. The textual content that either describes a specific competency or describes a less granular group of competencies within the taxonomy of the competency framework." ;
  rdfs:comment "Note: This element is designed to support statements from various learning standards frameworks. The Head Start Child Outcomes Framework includes statements for Domains, Elements, and Indicators. Examples from the K-12 Common Core State Standards are the domain: “Geometry\", the cluster: “Understand and apply the Pythagorean Theorem,” and standard:  “Apply the Pythagorean Theorem to determine unknown side lengths in right triangles in real-world and mathematical problems in two and three dimensions.”" ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid185 ) .

ceds:P000691
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000691"^^xsd:token ;
  rdfs:label "Competency Definition Type" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionType" ;
  dc11:description "The class of statement in the structure of statements in the Competency Framework according to a controlled vocabulary, specified as a textual label." ;
  rdfs:comment "This property points to a class, not to instances of that class. For example, where two competencies in a competency framework have been identified respectively  as \\\"Strand: Renaissance\\\" and \\\"Strand: Social history\\\", the competencyCategory for both these competencies is \\\"Strand\\\".\"" ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid187 ) .

ceds:P000692
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000692"^^xsd:token ;
  rdfs:label "Competency Definition Code" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionCode" ;
  dc11:description "A human-referenceable code designated by the publisher to identify the item in the hierarchy of competency definitions." ;
  rdfs:comment "For example: \"M.1.N.3\"  The code is usually not globally unique and usually has embedded meaning such as a number that represents a grade/level and letters that represent content strands." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid189 ) .

ceds:P000872
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000872"^^xsd:token ;
  rdfs:label "Competency Definition Parent Identifier" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionParentIdentifier" ;
  dc11:description "The globally unique identifier (GUID) issued by the publisher of the competency framework that uniquely identifies the parent item in the hierarchy of competency definitions using a RFC 4122 compliant 32-character hexadecimal string, such as 21EC2020-3AEA-1069-A2DD-08002B30309D." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid191 ) .

ceds:P000873
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000873"^^xsd:token ;
  rdfs:label "Competency Definition Parent Code" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionParentCode" ;
  dc11:description "A human-referenceable code designated by the publisher to identify the parent item in the hierarchy of competency definitions." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid193 ) .

ceds:P000874
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000874"^^xsd:token ;
  rdfs:label "Competency Definition URL" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionURL" ;
  dc11:description "A network-resolvable Uniform Resource Locator (URL) pointing to the authoritative reference for the competency definition." ;
  rdfs:comment "An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid195 ) .

ceds:P000883
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000883"^^xsd:token ;
  rdfs:label "Competency Definition License" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionLicense" ;
  dc11:description "The full text or URL reference to a legal document giving official permission to do something with the competency definition statement." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid197 ) .

ceds:P000887
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000887"^^xsd:token ;
  rdfs:label "Competency Definition Concept Keyword" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionConceptKeyword" ;
  dc11:description "The significant topicality of the competency definition using free-text keywords and phrases." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid199 ) .

ceds:P000888
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000888"^^xsd:token ;
  rdfs:label "Competency Definition Concept Term" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionConceptTerm" ;
  dc11:description "The topicality of the competency definition, e.g. \"Pythagorean Theorem,\" \"Trigonometric functions,\" \"Forces and energy,\" \"Scientific method,\" \"Oral history,\" etc." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid201 ) .

ceds:P000910
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000910"^^xsd:token ;
  rdfs:label "Competency Definition Text Complexity System" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionTextComplexitySystem" ;
  dc11:description "The scaling system used to specify the text complexity of a competency item." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid203 ) .

ceds:P001094
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001094"^^xsd:token ;
  rdfs:label "Competency Definition Parent URL" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionParentURL" ;
  dc11:description "A network-resolvable Uniform Resource Locator (URL) pointing to the authoritative reference for the hierarchal parent of the competency definition." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid205 ) .

ceds:P001154
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001154"^^xsd:token ;
  rdfs:label "Competency Definition Text Complexity Minimum Value" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CompetencyDefinitionTextComplexityMinimumValue" ;
  dc11:description "The minimum value in the range of text complexity applicable to a language competency definition using the scaling system defined by Text Complexity System, e.g. Lexile(tm)." ;
  ceds:textFormat "Numeric" ;
  ceds:editHistory ( _:genid207 ) .

ceds:P001155
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001155"^^xsd:token ;
  rdfs:label "Competency Definition Text Complexity Maximum Value" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CompetencyDefinitionTextComplexityMaximumValue" ;
  dc11:description "The maximum value in the range of text complexity applicable to a language competency definition using the scaling system defined by Text Complexity System, e.g. Lexile(tm)." ;
  ceds:textFormat "Numeric" ;
  ceds:editHistory ( _:genid209 ) .

ceds:P001249
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001249"^^xsd:token ;
  rdfs:label "Competency Definition Notes" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionNotes" ;
  dc11:description "Information about the derivation of a Competency Definition Statement." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid211 ) .

ceds:P001250
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001250"^^xsd:token ;
  rdfs:label "Competency Definition Version" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionVersion" ;
  dc11:description "A label assigned by the publisher indicating the version of the competency framework statement." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid213 ) .

ceds:P001409
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001409"^^xsd:token ;
  rdfs:label "Competency Definition Short Name" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionShortName" ;
  dc11:description "The short name or label for the competency definition or its node in a competency framework." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid215 ) .

ceds:P001511
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001511"^^xsd:token ;
  rdfs:label "Competency Definition Valid End Date" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CompetencyDefinitionValidEndDate" ;
  dc11:description "The year, month and day the competency definition was deprecated/replaced by the jurisdiction in which it was intended to apply." ;
  rdfs:comment "When not specified, the entity is assumed to contain the most current version of the specified competency definition. All CEDS Exit and End Dates represent the last day of the date range specified, in this case the last day the competency definition was valid." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid217 ) .

ceds:P001512
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001512"^^xsd:token ;
  rdfs:label "Competency Definition Valid Start Date" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CompetencyDefinitionValidStartDate" ;
  dc11:description "The year, month and day the competency definition was adopted by the jurisdiction in which it was intended to apply." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid219 ) .

ceds:P001524
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001524"^^xsd:token ;
  rdfs:label "Competency Definition Previous Version Identifier" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionPreviousVersionIdentifier" ;
  dc11:description "The unique identifier of the previous version of the Competency Definition if the statement was modified." ;
  rdfs:comment "This element supports version histories at the statement level. If corrections have been made to individual items/statements that are not part of a new Competency Framework, the elements 'Competency Definition Previous Version Identifier' and 'Competency Definition Current Version Indicator' provide a reference to historical versions of the current statement. In such uses the 'Competency Definition Code' could be the same for multiple versions of a statement and 'Competency Definition URL' could resolve to the most current version of the statement.<br/><br/><BR/>CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces.<br/><br/><BR/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid221 ) .

ceds:P001570
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001570"^^xsd:token ;
  rdfs:label "Competency Definition Sequence" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionSequence" ;
  dc11:description "A set of one or more alphanumeric characters and/or symbols denoting the positioning of the statement being described in a sequential listing of statements." ;
  rdfs:comment "Based on ASN's ListID. (add reference URL)" ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid223 ) .

ceds:P001757
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001757"^^xsd:token ;
  rdfs:label "Competency Definition Type URL" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyDefinitionTypeURL" ;
  dc11:description "The class of statement in the structure of statements in the Competency Framework according to a controlled vocabulary, specified as a URI referencing a controlled vocabulary." ;
  rdfs:comment "This property points to a class, not to instances of that class. For example, where two competencies in a competency framework have been identified respectively  as \\\"Strand: Renaissance\\\" and \\\"Strand: Social history\\\", the competency category for both these competencies is \\\"Strand\\\".\"" ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid225 ) .

ceds:P001908
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001908"^^xsd:token ;
  rdfs:label "Competency Definition Typical Age Range Minimum" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "CompetencyDefinitionTypicalAgeRangeMinimum" ;
  dc11:description "The typical minimum age at which a person learns the defined competency." ;
  rdfs:comment "Use this element with \"Competency Definition Typical Age Range Maximum\" instead of \"Competency Item Typical Age Range\"" ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid227 ) .

ceds:P001909
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001909"^^xsd:token ;
  rdfs:label "Competency Definition Typical Age Range Maximum" ;
  schema:domainIncludes ceds:C200065 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "CompetencyDefinitionTypicalAgeRangeMaximum" ;
  dc11:description "The typical maximum age at which a person learns the defined competency." ;
  rdfs:comment "Use this element with \"Competency Definition Typical Age Range Minimum\" instead of \"Competency Item Typical Age Range\"" ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid229 ) .

ceds:P000715
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000715"^^xsd:token ;
  rdfs:label "Competency Definition Prerequisite Identifier" ;
  schema:domainIncludes ceds:C200064 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "CompetencyDefinitionPrerequisiteIdentifier" ;
  dc11:description "The unique identifier of an immediate prerequisite Competency Definition, a competency needed prior to learning this one. (Some items may have no prerequisites while others may have one or more prerequisites. This should only be used to represent the immediate predecessors in a competency-based pathway, i.e. not prerequisites of prerequisites.)" ;
  rdfs:comment """The recommended approach is to use the entity Learning Standard Item Association instead of this data element. Learning Standard Item Association also supports associating other entities, such as Learning Resources, to learning standard items.



CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces.



An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.""" ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid231 ) .

ceds:P000871
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000871"^^xsd:token ;
  rdfs:label "Competency Association Identifier URI" ;
  schema:domainIncludes ceds:C200064 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyAssociationIdentifierURI" ;
  dc11:description "A URI that establishes uniqueness of an association between a competency definition and another competency item or other objects such as learning resources." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory (
   _:genid233
   _:genid235
 ) .

ceds:P001402
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001402"^^xsd:token ;
  rdfs:label "Competency Association Connection Citation" ;
  schema:domainIncludes ceds:C200064 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyAssociationConnectionCitation" ;
  dc11:description "Any citation appropriate to evidence the connection between nodes" ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid237 ) .

ceds:P001403
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001403"^^xsd:token ;
  rdfs:label "Competency Association Destination Node Name" ;
  schema:domainIncludes ceds:C200064 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyAssociationDestinationNodeName" ;
  dc11:description "Name of the destination node when the Competency Association is used as a connector in a learning map." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid239 ) .

ceds:P001404
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001404"^^xsd:token ;
  rdfs:label "Competency Association Destination Node URI" ;
  schema:domainIncludes ceds:C200064 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyAssociationDestinationNodeURI" ;
  dc11:description "URI of the destination node when the Competency Association is used as a connector in a learning map." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid241 ) .

ceds:P001405
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001405"^^xsd:token ;
  rdfs:label "Competency Association Origin Node Name" ;
  schema:domainIncludes ceds:C200064 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyAssociationOriginNodeName" ;
  dc11:description "Name of the origin node when the Competency Association is used as a connector in a learning map." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid243 ) .

ceds:P001406
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001406"^^xsd:token ;
  rdfs:label "Competency Association Origin Node URI" ;
  schema:domainIncludes ceds:C200064 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyAssociationOriginNodeURI" ;
  dc11:description "URI of the origin node when the Competency Association is used as a connector in a learning map." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid245 ) .

ceds:P001407
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001407"^^xsd:token ;
  rdfs:label "Competency Association Weight" ;
  schema:domainIncludes ceds:C200064 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CompetencyAssociationWeight" ;
  dc11:description "Indicates the relative significance this connection has for the destination node in a learning map." ;
  rdfs:comment "This element is used to support learning maps and may be used in two ways 1) use a 1.000 to flag incoming nodes as important prerequisites/predecessors and 0.000 to indicate those with less significance, or 2) to indicate a levels of significance for the connection as a decimal between 0.000 and 1.000." ;
  ceds:minInclusive "0" ;
  ceds:maxInclusive "1" ;
  ceds:textFormat "Numeric - up to 3 digits after decimal place" ;
  ceds:decimalPlaces "3" ;
  ceds:editHistory ( _:genid247 ) .

ceds:P000693
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000693"^^xsd:token ;
  rdfs:label "Competency Framework Identifier URI" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkIdentifierURI" ;
  dc11:description "An unambiguous reference to the competency framework using a network-resolvable URI." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid249 ) .

ceds:P000694
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000694"^^xsd:token ;
  rdfs:label "Competency Framework Title" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkTitle" ;
  dc11:description "The name of the competency framework." ;
  ceds:maxLength "120" ;
  ceds:textFormat "Alphanumeric - 120 characters maximum" ;
  ceds:editHistory ( _:genid251 ) .

ceds:P000695
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000695"^^xsd:token ;
  rdfs:label "Competency Framework Version" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkVersion" ;
  dc11:description "Defines the revision of the competency framework as a version number or date." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid253 ) .

ceds:P000696
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000696"^^xsd:token ;
  rdfs:label "Competency Framework Creator" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkCreator" ;
  dc11:description "The person or organization chiefly responsible for the intellectual content of the competency framework." ;
  rdfs:comment "Implementations may choose to model this element as a repeatable field to support the case of multiple authors.  Others may just use a comma delimited string for multiple authors." ;
  ceds:maxLength "120" ;
  ceds:textFormat "Alphanumeric - 120 characters maximum" ;
  ceds:editHistory ( _:genid255 ) .

ceds:P000697
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000697"^^xsd:token ;
  rdfs:label "Competency Framework Description" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkDescription" ;
  dc11:description "A textual description of the scope and contents of the competency framework." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid257 ) .

ceds:P000699
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000699"^^xsd:token ;
  rdfs:label "Competency Framework Jurisdiction" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkJurisdiction" ;
  dc11:description "A legal, quasi-legal, organizational or institutional domain of the entity mandating the use of the statement--e.g., California." ;
  ceds:maxLength "120" ;
  ceds:textFormat "Alphanumeric - 120 characters maximum" ;
  ceds:editHistory ( _:genid259 ) .

ceds:P000700
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000700"^^xsd:token ;
  rdfs:label "Competency Framework Valid Start Date" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CompetencyFrameworkValidStartDate" ;
  dc11:description "The year, month and day the competency framework was adopted by the jurisdiction in which it was intended to apply." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid261 ) .

ceds:P000701
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000701"^^xsd:token ;
  rdfs:label "Competency Framework Valid End Date" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CompetencyFrameworkValidEndDate" ;
  dc11:description "The year, month and day the competency framework was deprecated/replaced by the jurisdiction in which it was intended to apply." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid263
   _:genid265
 ) .

ceds:P000702
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000702"^^xsd:token ;
  rdfs:label "Competency Framework Subject" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkSubject" ;
  dc11:description "The topic or academic subject of the competency framework." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid267 ) .

ceds:P000882
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000882"^^xsd:token ;
  rdfs:label "Competency Framework License" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkLicense" ;
  dc11:description "A legal document giving official permission to do something with the competency framework." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid269 ) .

ceds:P000884
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000884"^^xsd:token ;
  rdfs:label "Competency Framework Publisher" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkPublisher" ;
  dc11:description "The entity responsible for making the competency framework available." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid271 ) .

ceds:P000885
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000885"^^xsd:token ;
  rdfs:label "Competency Framework Rights" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkRights" ;
  dc11:description "The information about rights held in and over the resource." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid273 ) .

ceds:P000886
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000886"^^xsd:token ;
  rdfs:label "Competency Framework Rights Holder" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkRightsHolder" ;
  dc11:description "The person or organization owning or managing rights over the competency framework." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid275 ) .

ceds:P001569
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001569"^^xsd:token ;
  rdfs:label "Competency Framework Publication Date" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CompetencyFrameworkPublicationDate" ;
  dc11:description "The date on which this content was first published." ;
  rdfs:comment "This may or may not be different from the Learning Standard Document Valid Start Date." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid277 ) .

ceds:P001907
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001907"^^xsd:token ;
  rdfs:label "Competency Framework Source URL" ;
  schema:domainIncludes ceds:C200067 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CompetencyFrameworkSourceURL" ;
  dc11:description "A URL that resolves to the original or authoritative competency framework document." ;
  rdfs:comment "This is the URL of a human-readable artifact. Often this document is published in html and/or pdf and is used by the standard setting entity as part of its approval process." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid279 ) .

ceds:P000878
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000878"^^xsd:token ;
  rdfs:label "Competency Set Completion Criteria Threshold" ;
  schema:domainIncludes ceds:C200068 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "CompetencySetCompletionCriteriaThreshold" ;
  dc11:description "The minimum number of competencies in the set that must be achieved for completion or partial completion of a unit, course, program, degree, certification, or other achievement/award." ;
  rdfs:comment "Used to define the completion criteria when Competency Set Completion Criteria is \"At Least\".  Not used when Competency Set Completion Criteria is \"All\"." ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid281 ) .

ceds:P000058
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000058"^^xsd:token ;
  rdfs:label "Credit Value" ;
  schema:domainIncludes ceds:C200072 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CreditValue" ;
  dc11:description "The amount of credit available to the student who successfully meets the objectives of the course or learning opportunity based on the units defined by Credit Unit Type." ;
  rdfs:comment "For K-12 a course meeting every day for one period of the school day over the span of a school year typically offers one Carnegie unit. In this case a Carnegie unit is  a measure of \"seat time\" rather than a measure of attainment of the course objectives." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" ;
  ceds:editHistory ( _:genid283 ) .

ceds:P000066
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000066"^^xsd:token ;
  rdfs:label "Course Subject Abbreviation" ;
  schema:domainIncludes ceds:C200072 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseSubjectAbbreviation" ;
  dc11:description "The alphabetic abbreviation of the academic department or discipline offering the course. It is one part of the total course identifier number. " ;
  ceds:maxLength "10" ;
  ceds:textFormat "Alphanumeric - 10 characters maximum" ;
  ceds:editHistory ( _:genid285 ) .

ceds:P000250
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000250"^^xsd:token ;
  rdfs:label "School Courses for the Exchange of Data Sequence of Course" ;
  schema:domainIncludes ceds:C200072 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "SCEDSequenceOfCourse" ;
  dc11:description "Where a specific course lies when it is part of a consecutive sequence of courses. This element should be interpreted as \"part 'n' of 'm' parts." ;
  rdfs:comment "For example: if a school offers 4 years of Theater, Theater 3 within this school would be indicated in the sequence elements as 3 4, denoting the 3rd part of a 4-part sequence of courses." ;
  ceds:maxLength "10" ;
  ceds:textFormat "Alphanumeric - 10 characters maximum" ;
  ceds:editHistory (
   _:genid287
   _:genid289
 ) .

ceds:P000499
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000499"^^xsd:token ;
  rdfs:label "Instructional Minutes" ;
  schema:domainIncludes ceds:C200072, ceds:C200245 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "InstructionalMinutes" ;
  dc11:description "The total number of instruction minutes in a given session, as determined by time in class, time on task (e.g., engaged in a class), or as estimated by a qualified course designer." ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory (
   _:genid291
   _:genid293
 ) .

ceds:P000517
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000517"^^xsd:token ;
  rdfs:label "Course Description" ;
  schema:domainIncludes ceds:C200072 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseDescription" ;
  dc11:description "A description of the course content and/or goals. Reference may be made to state or national content standards." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric-1024 characters maximum" ;
  ceds:editHistory (
   _:genid295
   _:genid297
 ) .

ceds:P001302
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001302"^^xsd:token ;
  rdfs:label "Course Certification Description" ;
  schema:domainIncludes ceds:C200072 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CourseCertificationDescription" ;
  dc11:description "A description of the certification or recognition associated with this course (ex. Networking, CAD, etc.)" ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" .

ceds:P001667
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001667"^^xsd:token ;
  rdfs:label "Course Repeatability Maximum Number" ;
  schema:domainIncludes ceds:C200072 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "CourseRepeatabilityMaximumNumber" ;
  dc11:description "The maximum number of times the course may be taken or completed for credit." ;
  ceds:textFormat "Integer" ;
  ceds:editHistory ( _:genid299 ) .

ceds:P002023
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002023"^^xsd:token ;
  rdfs:label "Sequence of Course" ;
  schema:domainIncludes ceds:C200072 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "SequenceOfCourse" ;
  dc11:description "Where a specific course lies when it is part of a consecutive sequence of courses. " ;
  rdfs:comment "For example: if a school offers 4 years of Theater, Theater 3 within this school would be indicated in the sequence elements as 3 4, denoting the 3rd part of a 4-part sequence of courses." ;
  ceds:textFormat "Alphanumeric- 10 characters maximum" ;
  ceds:editHistory ( _:genid301 ) .

ceds:P000101
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000101"^^xsd:token ;
  rdfs:label "Course Section Time Required for Completion" ;
  schema:domainIncludes ceds:C200074 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "CourseSectionTimeRequiredForCompletion" ;
  dc11:description "The actual or estimated number of clock minutes required for course completion. This number is especially important for career and technical education course and may represent (in minutes) the clock hour requirement of the course, the number of minutes (or clock hours) of class time per week, times the number of equivalent weeks the class typically meets." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid303 ) .

ceds:P000231
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000231"^^xsd:token ;
  rdfs:label "Related Competency Definitions" ;
  schema:domainIncludes ceds:C200074 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "RelatedCompetencyDefinitions" ;
  dc11:description "An indication of the competency definition(s) addressed in the Course Section." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" ;
  ceds:editHistory ( _:genid305 ) .

ceds:P001655
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001655"^^xsd:token ;
  rdfs:label "Course Section Maximum Capacity" ;
  schema:domainIncludes ceds:C200074 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "CourseSectionMaximumCapacity" ;
  dc11:description "The maximum number of students the Course Section can maintain." ;
  ceds:textFormat "Integer - greater than or equal to 0" ;
  ceds:editHistory ( _:genid307 ) .

ceds:P000519
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000519"^^xsd:token ;
  rdfs:label "Class Beginning Time" ;
  schema:domainIncludes ceds:C200078 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "ClassBeginningTime" ;
  dc11:description "An indication of the time of day the class begins." ;
  ceds:textFormat "HH:MM:SS" .

ceds:P000520
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000520"^^xsd:token ;
  rdfs:label "Class Ending Time" ;
  schema:domainIncludes ceds:C200078 ;
  schema:rangeIncludes xsd:time ;
  skos:notation "ClassEndingTime" ;
  dc11:description "An indication of the time of day the class ends." ;
  ceds:textFormat "HH:MM:SS" .

ceds:P000521
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000521"^^xsd:token ;
  rdfs:label "Class Meeting Days" ;
  schema:domainIncludes ceds:C200078 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ClassMeetingDays" ;
  dc11:description "The day(s) of the week (e.g., Monday, Wednesday) that the class meets or an indication that a class meets \"out-of-school\" or \"self-paced\"." ;
  ceds:maxLength "60" ;
  ceds:textFormat "Alphanumeric - 60 characters maximum" .

ceds:P000522
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000522"^^xsd:token ;
  rdfs:label "Class Period" ;
  schema:domainIncludes ceds:C200078 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "ClassPeriod" ;
  dc11:description "An indication of the portion of a typical daily session in which students receive instruction in a specified subject (e.g., morning, sixth period, block period, or AB schedules)." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" .

ceds:P000523
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000523"^^xsd:token ;
  rdfs:label "Timetable Day Identifier" ;
  schema:domainIncludes ceds:C200078 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "TimetableDayIdentifier" ;
  dc11:description "The unique identifier for the locally defined rotation cycle date code when the class meets (e.g., in a two day schedule, valid values could be \"A\" and \"B\", or \"1\" and \"2\")." ;
  rdfs:comment "CEDS \"Identifier\" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. <br/><br/>An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122." ;
  ceds:maxLength "40" ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid309 ) .

ceds:P001163
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001163"^^xsd:token ;
  rdfs:label "Credential Award Start Date" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CredentialAwardStartDate" ;
  dc11:description "The date on which the qualification, achievement, personal or organizational quality, or aspect of an identity was conferred." ;
  rdfs:comment "Diploma or Credential Award Date is the same concept but used when only month and year are known or needed." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid311
   _:genid313
 ) .

ceds:P001164
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001164"^^xsd:token ;
  rdfs:label "Credential Award End Date" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CredentialAwardEndDate" ;
  dc11:description "The date, if any, on which the qualification, achievement, personal or organizational quality, or aspect of an identity expires or requires renewal." ;
  rdfs:comment "All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid315
   _:genid317
 ) .

ceds:P001660
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001660"^^xsd:token ;
  rdfs:label "Credential Revoked Date" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CredentialRevokedDate" ;
  dc11:description "The date on which the qualification, achievement, personal or organizational quality, or aspect of an identity was revoked." ;
  rdfs:comment "An empty string means the assertion was not revoked. Some uses (e.g. OpenBadges) may append time info in ISO 8601 format." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory (
   _:genid319
   _:genid321
 ) .

ceds:P001661
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001661"^^xsd:token ;
  rdfs:label "Credential Revoked Reason" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialRevokedReason" ;
  dc11:description "Published reason for revocation of a credential award." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid323 ) .

ceds:P001664
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001664"^^xsd:token ;
  rdfs:label "Credential Completion Date" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CredentialCompletionDate" ;
  dc11:description "The date on which the person's requirements for earning a credential were met or completed." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid325 ) .

ceds:P001669
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001669"^^xsd:token ;
  rdfs:label "Credential Award Evidence URL" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialAwardEvidenceURL" ;
  dc11:description "A URL to a page that describes the evidence that the learner met the criteria for attainment of the credential award." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid327 ) .

ceds:P001734
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001734"^^xsd:token ;
  rdfs:label "Credential Advanced Standing Description" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialAdvancedStandingDescription" ;
  dc11:description "A description of a credential that reduced the time or cost of attaining this credential." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid329 ) .

ceds:P001735
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001735"^^xsd:token ;
  rdfs:label "Credential Advanced Standing URL" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialAdvancedStandingURL" ;
  dc11:description "A URL that resolves to information about a credential that reduced the time or cost of attaining this credential." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory ( _:genid331 ) .

ceds:P001737
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001737"^^xsd:token ;
  rdfs:label "Credential Award Approver Name" ;
  schema:domainIncludes ceds:C200079 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialAwardApproverName" ;
  dc11:description "Pronouncement of a favorable judgment by the agent being referenced." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid333 ) .

ceds:P000901
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000901"^^xsd:token ;
  rdfs:label "Credential Evidence Statement" ;
  schema:domainIncludes ceds:C200081 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialEvidenceStatement" ;
  dc11:description "A statement or reference describing the evidence that the learner met the criteria for attainment of the qualification, achievement, personal or organizational quality, or aspect of an identity." ;
  rdfs:comment "A narrative that may connect multiple pieces of evidence OR an IRI or document describing the work that the recipient did to earn the achievement. This can be a page that links out to other pages if linking directly to the work is infeasible. May be used in an array of multiple values." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory (
   _:genid335
   _:genid337
 ) .

ceds:P000893
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000893"^^xsd:token ;
  rdfs:label "Credential Definition Title" ;
  schema:domainIncludes ceds:C200087 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialDefinitionTitle" ;
  dc11:description "The title assigned to a qualification, achievement, personal or organizational quality, or aspect of an identity." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory (
   _:genid339
   _:genid341
 ) .

ceds:P000894
