ceds:NI001517163424
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Science (grade 3) courses involve observation, measurement, and description
			of simple systems. Course content may include the scientific process; life and
			environmental science; and physical, earth, and space science. Specific content depends
			upon state standards for grade 3.""" ;
  dc11:identifier "NI001517163424"^^xsd:token ;
