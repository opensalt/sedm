ceds:P000032
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000032"^^xsd:token ;
  rdfs:label "Staff Compensation Base Salary" ;
  schema:domainIncludes ceds:C200362 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "StaffCompensationBaseSalary" ;
  dc11:description "The salary or wage a person is paid before deductions (excluding differentials) but including annuities." ;
  rdfs:comment "For the Common Core Data Teacher Compensation Survey this is: 'The negotiated annual salary for teaching duties for the school year. The base salary excludes pay for additional duties, such as supervising or directing afterschool activities, school administration activities, and teaching summer school or adult education classes. Bonuses and other incentives are not included in base salaries.'  Also use CEDS element Salary for Teaching Assignment Only Indicator to indicate if a Base Salary is specific to teaching assignments." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000136
