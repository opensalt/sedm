  schema:domainIncludes ceds:C200087 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialImageURL" ;
  dc11:description "The Uniform Resource Locator (URL) for the unique address of an image representing an award or badge associated with the qualification, achievement, personal or organizational quality, or aspect of an identity." ;
  rdfs:comment "Typical use is for online display of a badge image." ;
  ceds:maxLength "512" ;
  ceds:textFormat "Alphanumeric - 512 characters maximum" ;
  ceds:editHistory (
   _:genid343
   _:genid345
 ) .

ceds:P000895
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000895"^^xsd:token ;
  rdfs:label "Credential Definition Description" ;
  schema:domainIncludes ceds:C200087 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "CredentialDefinitionDescription" ;
  dc11:description "A description of the qualification, achievement, personal or organizational quality, or aspect of an identity." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory (
   _:genid347
   _:genid349
 ) .

