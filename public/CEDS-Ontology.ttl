ceds:NI001517162843
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """French for Young Learners (prior-to-secondary) courses provide instruction
			at multiple grade levels in French and may apply to a range of consecutive grades. These
			courses prepare students to communicate authentically in French by interpreting
			(reading, listening, viewing), exchanging (speaking and listening; reading and writing),
			and presenting (speaking, writing) information on concrete topics. These courses
			introduce the relationships among the products, practices, and perspectives of
			French-speaking cultures.""" ;
  dc11:identifier "NI001517162843"^^xsd:token ;
  rdfs:label "French for Young Learners (prior-to-secondary)" ;
  skos:definition """French for Young Learners (prior-to-secondary) courses provide instruction
			at multiple grade levels in French and may apply to a range of consecutive grades. These
			courses prepare students to communicate authentically in French by interpreting
			(reading, listening, viewing), exchanging (speaking and listening; reading and writing),
			and presenting (speaking, writing) information on concrete topics. These courses
			introduce the relationships among the products, practices, and perspectives of
			French-speaking cultures.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "24100" ;
  skos:prefLabel "French for Young Learners (prior-to-secondary)" .

ceds:NI001517162844
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """French Immersion (prior-to-secondary) courses engage students in
			developmentally appropriate activities to acquire literacy in French and grade-specific
			content using French as the language of instruction. French Immersion courses prepare
			students to communicate authentically in French by interpreting (reading, listening,
			viewing), exchanging (speaking and listening; reading and writing), and presenting
			(speaking, writing) information about standards-based academic content and incorporate
			the relationships among the products, practices, and perspectives of French-speaking
			cultures.""" ;
  dc11:identifier "NI001517162844"^^xsd:token ;
  rdfs:label "French Immersion (prior-to-secondary)" ;
  skos:definition """French Immersion (prior-to-secondary) courses engage students in
			developmentally appropriate activities to acquire literacy in French and grade-specific
			content using French as the language of instruction. French Immersion courses prepare
			students to communicate authentically in French by interpreting (reading, listening,
			viewing), exchanging (speaking and listening; reading and writing), and presenting
			(speaking, writing) information about standards-based academic content and incorporate
			the relationships among the products, practices, and perspectives of French-speaking
