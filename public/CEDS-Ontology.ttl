@prefix ceds: <http://ceds.ed.gov/terms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dc11: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .

ceds:
  a owl:Ontology ;
  owl:versionInfo "13.0.0.0" .

ceds:textFormat
  a owl:AnnotationProperty ;
  rdfs:label "Text Format" ;
  rdfs:comment "A description of the formatting expectations or pattern for a property value." ;
  rdfs:range xsd:string .

ceds:minCount
  a owl:AnnotationProperty ;
  rdfs:label "Minimum Count" ;
  rdfs:comment "The minimum number of values required for a property." ;
  rdfs:range xsd:nonNegativeInteger .

ceds:maxCount
  a owl:AnnotationProperty ;
  rdfs:label "Maximum Count" ;
  rdfs:comment "The maximum number of values allowed for a property." ;
  rdfs:range xsd:nonNegativeInteger .

ceds:minLength
  a owl:AnnotationProperty ;
  rdfs:label "Minimum Length" ;
  rdfs:comment "The minimum string length for a property value." ;
  rdfs:range xsd:nonNegativeInteger .

ceds:maxLength
  a owl:AnnotationProperty ;
  rdfs:label "Maximum Length" ;
  rdfs:comment "The maximum string length for a property value." ;
  rdfs:range xsd:nonNegativeInteger .

ceds:minInclusive
  a owl:AnnotationProperty ;
  rdfs:label "Minimum Inclusive Value" ;
  rdfs:comment "The minimum value (inclusive) for a numeric property." .

ceds:maxInclusive
  a owl:AnnotationProperty ;
  rdfs:label "Maximum Inclusive Value" ;
  rdfs:comment "The maximum value (inclusive) for a numeric property." .

ceds:decimalPlaces
  a owl:AnnotationProperty ;
  rdfs:label "Decimal Places" ;
  rdfs:comment "The number of fractional decimal places to be used for a numeric property." ;
  rdfs:range xsd:nonNegativeInteger .

ceds:editHistory
  a rdf:Property ;
  rdfs:label "Edit History" ;
  rdfs:comment "Records changes made to a class or property, including date, version, and optional link to GitHub ticket." ;
  rdfs:domain rdf:Property, rdfs:Class, owl:Class, owl:NamedIndividual ;
  rdfs:range ceds:editHistoryEntry .

ceds:editHistoryEntry
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  rdfs:comment "An entry documenting a change to a class or property in the ontology." ;
  rdfs:label "Edit History Entry" ;
  skos:notation "EditHistoryEntry" .

ceds:changeDate
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  rdfs:comment "The date when a change was made to a class or property." ;
  rdfs:label "Change Date" ;
  schema:domainIncludes ceds:EditHistoryEntry ;
  schema:rangeIncludes xsd:date ;
  skos:notation "changeDate" .

ceds:changeVersion
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  rdfs:comment "The version of the ontology in which a change was made to a class or property." ;
  rdfs:label "Change Version" ;
  schema:domainIncludes ceds:EditHistoryEntry ;
  schema:rangeIncludes xsd:string ;
  skos:notation "changeVersion" .

ceds:changeDescription
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  rdfs:comment "A description of the change made to a class or property." ;
  rdfs:label "Change Description" ;
  schema:domainIncludes ceds:EditHistoryEntry ;
  schema:rangeIncludes xsd:string ;
  skos:notation "changeDescription" .

ceds:issueLink
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  rdfs:comment "A link to an issue or ticket in a version control system related to the change." ;
  rdfs:label "Issue Link" ;
  schema:domainIncludes ceds:EditHistoryEntry ;
  schema:rangeIncludes xsd:anyURI ;
  skos:notation "issueLink" .

ceds:changedBy
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  rdfs:comment "The person or system that made the change to a class or property." ;
  rdfs:label "Changed By" ;
  schema:domainIncludes ceds:EditHistoryEntry ;
  schema:rangeIncludes xsd:string ;
  skos:notation "changedBy" .

ceds:C000000
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C000000"^^xsd:token ;
  rdfs:comment "The CEDS Base Resource class represents the base resource in the Common Education Data Standards (CEDS) ontology. It serves as the foundational class from which all other CEDS resource classes inherit common properties and attributes. Subclasses of CEDSBaseResource may include specific types of instructional resources, such as students, staff, courses, assessments, etc." ;
  rdfs:label "Base CEDS Resource" ;
  skos:notation "CEDSBaseResource" .

ceds:P001917
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001917"^^xsd:token ;
  rdfs:comment """The start date and, optionally, time that a record is active as used to
			support version control.""" ;
  rdfs:label "Record Start Date Time" ;
  schema:domainIncludes ceds:C000000 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "RecordStartDateTime" ;
  dc11:description "The start date and, optionally, time that a record is active as used to support version control." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" ;
  ceds:editHistory (
   _:genid1
   _:genid3
 ) .

ceds:P001918
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001918"^^xsd:token ;
  rdfs:comment "The end date and, optionally, time that a record is active as used to support version control." ;
  rdfs:label "Record End Date Time" ;
  schema:domainIncludes ceds:C000000 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "RecordEndDateTime" ;
  dc11:description "The end date and, optionally, time that a record is active as used to support version control." ;
  ceds:textFormat "YYYY-MM-DDTHH:MM:SS" ;
  ceds:editHistory (
   _:genid5
   _:genid7
 ) .

ceds:C200411
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200411"^^xsd:token ;
  rdfs:comment "A classification representing the current condition, lifecycle stage, or operational state of a data record, including associated key dates, committing organization, committing individual, and statuses." ;
  rdfs:label "Record Status" ;
  skos:notation "RecordStatus" .

ceds:C200395
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200395"^^xsd:token ;
  rdfs:comment "A log of status changes to data." ;
  rdfs:label "Record Status History" ;
  skos:notation "RecordStatusHistory" .

ceds:P001972
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001972"^^xsd:token ;
  rdfs:comment "A process indicator of the level of stability, quality, and/or preparedness of the record." ;
  rdfs:label "Has Record Status Type" ;
  schema:domainIncludes ceds:C200411, ceds:C200395 ;
  schema:rangeIncludes ceds:C001972 ;
  skos:notation "hasRecordStatusType" ;
  dc11:description "A process indicator of the level of stability, quality, and/or preparedness of the record." ;
  ceds:editHistory ( _:genid9 ) .

ceds:P200998
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P200998"^^xsd:token ;
  rdfs:comment "The date the record was marked with the Record Status Type." ;
  rdfs:label "Record Status Date" ;
  schema:domainIncludes ceds:C200411, ceds:C200395 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "RecordStatusDate" ;
  dc11:description "The date the record was marked with the Record Status Type." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid11 ) .

ceds:P200999
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P200999"^^xsd:token ;
  rdfs:comment "The organization responsible for a specific action or event in the lifecycle of a record. This property links the record to the organization that officially committed an action to the record." ;
  rdfs:label "Committed By Organization" ;
  schema:domainIncludes ceds:C200411 ;
  schema:rangeIncludes ceds:C200239 ;
  skos:notation "CommittedByOrganization" .

ceds:P201000
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P201000"^^xsd:token ;
  rdfs:comment "The person responsible for a specific action or event in the lifecycle of a record. This property links the record to the person that officially committed an action to the record." ;
  rdfs:label "Created By Person" ;
  schema:domainIncludes ceds:C200411 ;
  schema:rangeIncludes ceds:C200275 ;
  skos:notation "CommittedByPerson" .

ceds:C200410
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200410"^^xsd:token ;
  rdfs:comment "Data collections track the details of data submissions as part of an organized, time-bound collection event, typically governed by specific deadlines and requirements, to ensure accurate and timely data reporting in a structured system." ;
  rdfs:label "Data Collection" ;
  skos:notation "DataCollection" .

ceds:P001990
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001990"^^xsd:token ;
  rdfs:comment "A process indicator of the level of stability, quality, and/or preparedness the collection of data." ;
  rdfs:label "Has Data Collection Status" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes ceds:C001990 ;
  skos:notation "HasDataCollectionStatus" ;
  dc11:description "A process indicator of the level of stability, quality, and/or preparedness of the collection of data." ;
  ceds:editHistory ( _:genid13 ) .

ceds:P001970
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001970"^^xsd:token ;
  rdfs:comment "The year for a reported school session for which the data is applicable." ;
  rdfs:label "Data Collection Academic School Year" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes xsd:gYear ;
  skos:notation "DataCollectionAcademicSchoolYear" ;
  dc11:description "The year for a reported school session for which the data is applicable." ;
  ceds:textFormat "YYYY" ;
  ceds:editHistory ( _:genid15 ) .

ceds:P001969
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001969"^^xsd:token ;
  rdfs:comment "The date the data collection closes or ends." ;
  rdfs:label "Data Collection Close Date" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "DataCollectionCloseDate" ;
  dc11:description "The date the data collection closes or ends." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid17 ) .

ceds:P001967
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001967"^^xsd:token ;
  rdfs:comment """The description of what is included in the data within the context of the data
			collection based on the source system and collection period as defined by the Data
			Collection Open Date and Data Collection Close Date.""" ;
  rdfs:label "Data Collection Description" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "DataCollectionDescription" ;
  dc11:description "The description of what is included in the data within the context of the data collection based on the source system and collection period as defined by the Data Collection Open Date and Data Collection Close Date." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid19 ) .

ceds:P001966
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001966"^^xsd:token ;
  rdfs:comment "A human readable name used to identify the data within the collection." ;
  rdfs:label "Data Collection Name" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "DataCollectionName" ;
  dc11:description "A human readable name used to identify the data within the collection." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid21 ) .

ceds:P001968
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001968"^^xsd:token ;
  rdfs:comment "The date the data collection opens or commences." ;
  rdfs:label "Data Collection Open Date" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes xsd:dateTime ;
  skos:notation "DataCollectionOpenDate" ;
  dc11:description "The date the data collection opens or commences." ;
  ceds:textFormat "YYYY-MM-DD" ;
  ceds:editHistory ( _:genid23 ) .

ceds:P001971
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001971"^^xsd:token ;
  rdfs:comment "The year for a reported school session in which the data collection occurs." ;
  rdfs:label "Data Collection School Year" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes xsd:gYear ;
  skos:notation "DataCollectionSchoolYear" ;
  dc11:description "The year for a reported school session in which the data collection occurs." ;
  ceds:textFormat "YYYY" ;
  ceds:editHistory ( _:genid25 ) .

ceds:P001964
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001964"^^xsd:token ;
  rdfs:comment """The identifier specified by the source system that uniquely identifies the
			data collection.""" ;
  rdfs:label "Source System Data Collection Identifier" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "SourceSystemDataCollectionIdentifier" ;
  dc11:description "The identifier specified by the source system that uniquely identifies the data collection." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid27 ) .

ceds:P001965
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001965"^^xsd:token ;
  rdfs:comment "The name of the source system that provided the data within the collection." ;
  rdfs:label "Source System Name" ;
  schema:domainIncludes ceds:C200410 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "SourceSystemName" ;
  dc11:description "The name of the source system that provided the data within the collection." ;
  ceds:textFormat "Alphanumeric" ;
  ceds:editHistory ( _:genid29 ) .

ceds:P201001
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P201001"^^xsd:token ;
  rdfs:label "Has Record Status" ;
  schema:domainIncludes ceds:C000000 ;
  schema:rangeIncludes ceds:C200411 ;
  skos:notation "hasRecordStatus" .

ceds:P201002
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P201002"^^xsd:token ;
  rdfs:comment "Has Record Status History" ;
  schema:domainIncludes ceds:C200411 ;
  schema:rangeIncludes ceds:C200395 ;
  skos:notation "hasRecordStatusHistory" .

ceds:P201003
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P201003"^^xsd:token ;
  rdfs:comment "Has Data Collection" ;
  schema:domainIncludes ceds:C000000 ;
  schema:rangeIncludes ceds:C200410 ;
  skos:notation "hasDataCollection" .

ceds:C200393
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200393"^^xsd:token ;
  rdfs:comment """An authority that reviews an organization's educational program and staff for
			quality, and certifies whether the organization meets a minimal set of standards.""" ;
  rdfs:label "Accrediting Organization" ;
  rdfs:subClassOf ceds:C200239 ;
  skos:notation "AccreditingOrganization" .

ceds:C200001
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200001"^^xsd:token ;
  rdfs:comment """An organized activity, such as a co-curricular or extra-curricular activity
			that is offered at an education institution.""" ;
  rdfs:label "Activity" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Activity" .

ceds:C200002
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200002"^^xsd:token ;
  rdfs:comment """Records of a person's participation in an organized activity, such as a
			co-curricular or extra-curricular activity that is offered at an education institution.""" ;
  rdfs:label "Activity Recognition" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "ActivityRecognition" .

ceds:C200003
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200003"^^xsd:token ;
  rdfs:comment "Information about a Course specific to adult education." ;
  rdfs:label "Adult Education Course" ;
  rdfs:subClassOf ceds:C200072 ;
  skos:notation "AdultEducationCourse" .

ceds:C200004
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200004"^^xsd:token ;
  rdfs:comment """Information about an organization specific to their role as an adult education
			provider.""" ;
  rdfs:label "Adult Education Provider" ;
  rdfs:subClassOf ceds:C200239 ;
  skos:notation "AdultEducationProvider" .

ceds:C200005
  a rdfs:Class ;
  rdfs:subClassOf ceds:C200405, ceds:C000000 ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200005"^^xsd:token ;
  rdfs:comment """Information about a person specific to their role as a staff member in an
			adult education context.""" ;
  rdfs:label "Adult Education Staff" ;
  skos:notation "AdultEducationStaff" .

ceds:C200006
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200006"^^xsd:token ;
  rdfs:comment """Information in a student's academic record specific to adult education program
			participation.""" ;
  rdfs:label "Adult Education Student Academic Record" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AdultEducationStudentAcademicRecord" .

ceds:C200007
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200007"^^xsd:token ;
  rdfs:comment "Information about student employment specific to the adult education context." ;
  rdfs:label "Adult Education Student Employment" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AdultEducationStudentEmployment" .

ceds:C200392
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200392"^^xsd:token ;
  rdfs:comment """An institution that has an ongoing, functional relationship with the education
			institution in order to provide improved educational experiences to an individual and/or
			the school.""" ;
  rdfs:label "Affiliated Institution" ;
  rdfs:subClassOf ceds:C200239 ;
  skos:notation "AffiliatedInstitution" .

ceds:C200008
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200008"^^xsd:token ;
  rdfs:comment """Information defining an assessment item interaction that may be specified
			using the IMS Global Accessible Portable Item Protocol APIP(R) standards.""" ;
  rdfs:label "Apip Interaction" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "ApipInteraction" .

ceds:C200009
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200009"^^xsd:token ;
  rdfs:comment "Information about a software application used for authentication and access." ;
  rdfs:label "Application" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Application" .

ceds:C200010
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200010"^^xsd:token ;
  rdfs:comment """An instrument used to evaluate a person typically having at-least one
			AssessmentForm, AssessmentSection, and AssessmentItem.""" ;
  rdfs:label "Assessment" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Assessment" .

ceds:C200012
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200012"^^xsd:token ;
  rdfs:comment "Information defining a variation in the standard administration of a standardized assessment that may be avaibale to accomodate a special needs such as a physical or cognitive disability." ;
  rdfs:label "Assessment Accommodation" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentAccommodation" .

ceds:C200013
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200013"^^xsd:token ;
  rdfs:comment "Information for an assessment event or administration period." ;
  rdfs:label "Assessment Administration" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentAdministration" .

ceds:C200015
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200015"^^xsd:token ;
  rdfs:comment """Information about content used to compose an Assessment Item, is referenced by
			an item but not part of the item content itself, or is content that is included as part
			of a section within an assessment form. Assets can be static content such as artwork or
			dynamic assets such as calculators or other tools.""" ;
  rdfs:label "Assessment Asset" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentAsset" .

ceds:C200016
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200016"^^xsd:token ;
  rdfs:comment """Developmental domains related to early learning and used for assessing a
			child's kindergarten readiness.""" ;
  rdfs:label "Assessment Early Learning Developmental Domain" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentEarlyLearningDevelopmentalDomain" .

ceds:C200017
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200017"^^xsd:token ;
  rdfs:comment """An instance of an a sessment that can equate scores with another instance of
			that same assessment.""" ;
  rdfs:label "Assessment Form" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentForm" .

ceds:C200019
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200019"^^xsd:token ;
  rdfs:comment "Information linking sections within an assessment form to the form and the order in which the sections are designed to be offered." ;
  rdfs:label "Assessment Form Assessment Form Section" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentFormAssessmentFormSection" .

ceds:C200020
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200020"^^xsd:token ;
  rdfs:comment """Information about a grouping of assessment items intended to be delivered
			together.""" ;
  rdfs:label "Assessment Form Section" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentFormSection" .

ceds:C200022
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200022"^^xsd:token ;
  rdfs:comment "Information linking assessment items to an assessment form section." ;
  rdfs:label "Assessment Form Section Assessment Item" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentFormSectionAssessmentItem" .

ceds:C200023
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200023"^^xsd:token ;
  rdfs:comment """A specific prompt that defines a question or protocol for a measurable
			activity that triggers a response from a person used to determine whether the person has
			mastered a learning objective.""" ;
  rdfs:label "Assessment Item" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentItem" .

ceds:C200024
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200024"^^xsd:token ;
  rdfs:comment "Accessible Portable Item Protocol information for an assessment item that may use the IMS Global APIP(R) standards." ;
  rdfs:label "Assessment Item Apip" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentItemApip" .

ceds:C200025
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200025"^^xsd:token ;
  rdfs:comment """Accessible Portable Item Protocol description for an assessment item that may
			use the IMS Global APIP(R) standards.""" ;
  rdfs:label "Assessment Item Apip Description" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentItemApipDescription" .

ceds:C200026
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200026"^^xsd:token ;
  rdfs:comment "The type and value for a psychometric measure." ;
  rdfs:label "Assessment Item Characteristic" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentItemCharacteristic" .

ceds:C200027
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200027"^^xsd:token ;
  rdfs:comment """Information about one of the possible responses that a person may give in 	response to an assessment item prompt.""" ;
  rdfs:label "Assessment Item Possible Response" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentItemPossibleResponse" .

ceds:C200028
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200028"^^xsd:token ;
  rdfs:comment "AssessmentItemResponse includes information about a learner response and subsequent information about feedback and scoring of the response. Some properties like DescriptiveFeedback are for support of a formative assessment process. Some properties are used within intelligent tutoring systems such as HintCount and ScaffoldingItemFlag." ;
  rdfs:label "Assessment Item Response" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentItemResponse" .

ceds:C200029
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200029"^^xsd:token ;
  rdfs:comment """Information representing the difficulty of an assessment itme and other
			measures of the relationship between any individuals' performances on the test item and
			the test takers' levels of performance on an overall measure of the ability that item
			was designed to measure.""" ;
  rdfs:label "Assessment Item Response Theory" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentItemResponseTheory" .

ceds:C200030
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200030"^^xsd:token ;
  rdfs:comment """Information about an assessment result or score derived using a rubic
			criterion.""" ;
  rdfs:label "Assessment Item Rubric Criterion Result" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentItemRubricCriterionResult" .

ceds:C200032
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200032"^^xsd:token ;
  rdfs:comment """Used as part of an Assessment Personal Needs Profile to define the content
			preferences and representation.""" ;
  rdfs:label "Assessment Need Apip Content" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentNeedApipContent" .

ceds:C200033
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200033"^^xsd:token ;
  rdfs:comment """Used as part of an Assessment Personal Needs Profile to define the control
			attributes.""" ;
  rdfs:label "Assessment Need Apip Control" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentNeedApipControl" .

ceds:C200034
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200034"^^xsd:token ;
  rdfs:comment """Used as part of an Assessment Personal Needs Profile to define the display
			attributes.""" ;
  rdfs:label "Assessment Need Apip Display" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentNeedApipDisplay" .

ceds:C200035
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200035"^^xsd:token ;
  rdfs:comment """Defines as part of an Assessment Personal Needs Profile the attributes for
			Braille display""" ;
  rdfs:label "Assessment Need Braille" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentNeedBraille" .

ceds:C200036
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200036"^^xsd:token ;
  rdfs:comment """Defines as part of an Assessment Personal Needs Profile the attributes for
			screen enhancement.""" ;
  rdfs:label "Assessment Need Screen Enhancement" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentNeedScreenEnhancement" .

ceds:C200037
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200037"^^xsd:token ;
  rdfs:comment "Information about a specific person's participation in an Assessment Session." ;
  rdfs:label "Assessment Participant Session" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentParticipantSession" .

ceds:C200038
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200038"^^xsd:token ;
  rdfs:comment "information about the performance levels that may be assigned to an Assessment Subtest Result and specifications for selecting the performance level based on a score. Four styles are supported: 1) specification of performance level by lower and upper cut score, 2) specification of performance level by lower cut score only, 3) specification of performance level without any mapping to scores, and 4) Specification of performance level by mapping to other scores." ;
  rdfs:label "Assessment Performance Level" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentPerformanceLevel" .

ceds:C200039
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200039"^^xsd:token ;
  rdfs:comment """Information that indicates a person's need related as a language learner that
			may be used to deternine the need for an assessment accomodation.""" ;
  rdfs:label "Assessment Personal Need Language Learner" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentPersonalNeedLanguageLearner" .

ceds:C200040
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200040"^^xsd:token ;
  rdfs:comment """Information that indicates a person's need that calls for use of a screen
			reader accomodation during assessment.""" ;
  rdfs:label "Assessment Personal Need Screen Reader" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentPersonalNeedScreenReader" .

ceds:C200041
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200041"^^xsd:token ;
  rdfs:comment """An entity that includes information about the personal needs and preferences
			for assessment participants, based on the IMS Global (R) Accessible Portable Item
			Protocol (R)""" ;
  rdfs:label "Assessment Personal Needs Profile" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentPersonalNeedsProfile" .

ceds:C200042
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200042"^^xsd:token ;
  rdfs:comment """An entity that includes information about the personal needs and preferences
			related to content presented within an assessment delivery.""" ;
  rdfs:label "Assessment Personal Needs Profile Content" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentPersonalNeedsProfileContent" .

ceds:C200043
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200043"^^xsd:token ;
  rdfs:comment """An entity that includes information about the personal needs and preferences
			related to control of presentation during delivery of assessments.""" ;
  rdfs:label "Assessment Personal Needs Profile Control" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentPersonalNeedsProfileControl" .

ceds:C200044
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200044"^^xsd:token ;
  rdfs:comment """An entity that includes information about the personal needs and preferences
			related to displays of assessment content.""" ;
  rdfs:label "Assessment Personal Needs Profile Display" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentPersonalNeedsProfileDisplay" .

ceds:C200045
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200045"^^xsd:token ;
  rdfs:comment """An entity that includes information about the personal needs and preferences
			related to screen enhancements during delivery of an assessment.""" ;
  rdfs:label "Assessment Personal Needs Profile Screen Enhancement" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentPersonalNeedsProfileScreenEnhancement" .

ceds:C200046
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200046"^^xsd:token ;
  rdfs:comment "Information related to a specific person registered for an Assessment Administration, assigned a specific Assessment Form for participation in one or more Assessment Sessions." ;
  rdfs:label "Assessment Registration" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentRegistration" .

ceds:C200047
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200047"^^xsd:token ;
  rdfs:comment """An entity that includes information about a person's results from an
			assessment which may be for the entire assessment or one aspect of evaluation. The
			scoring method is defined by the related Assessment Subtest. The entity includes the
			score value and information about the score, such as a diagnostic statement.""" ;
  rdfs:label "Assessment Result" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentResult" .

ceds:C200048
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200048"^^xsd:token ;
  rdfs:comment """This join links an assessment result record to a result defined within a
			RubricCriterion.""" ;
  rdfs:label "Assessment Result Rubric Criterion Result" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentResultRubricCriterionResult" .

ceds:C200049
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200049"^^xsd:token ;
  rdfs:comment """Information related to an instance of delivering an assessment during a
			specific period of time.""" ;
  rdfs:label "Assessment Session" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentSession" .

ceds:C200050
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200050"^^xsd:token ;
  rdfs:comment "Roles served related to the administration of an assessment session." ;
  rdfs:label "Assessment Session Staff Role" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentSessionStaffRole" .

ceds:C200051
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200051"^^xsd:token ;
  rdfs:comment """Information for scoring an Assessment Form based on a set of Assessment Item
			responses with explicit rules to produce an Assessment Subtest Result, which may be for
			the entire Assessment Form or one aspect of evaluation based on a subset of Assessment
			Items.""" ;
  rdfs:label "Assessment Subtest" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentSubtest" .

ceds:C200052
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200052"^^xsd:token ;
  rdfs:comment "This join links an assessment subtest to an assessment item." ;
  rdfs:label "Assessment Subtest Assessment Item" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentSubtestAssessmentItem" .

ceds:C200053
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200053"^^xsd:token ;
  rdfs:comment """This join links an assessment subtest to an early learning developmental
			domain record.""" ;
  rdfs:label "Assessment Subtest Early Learning Developmental Domain" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AssessmentSubtestEarlyLearningDevelopmentalDomain" .

ceds:C200054
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200054"^^xsd:token ;
  rdfs:comment "An application or service that can authenticate the identity of a person. The CEDS entity that includes information about an authentication provider, the login identifier used to authenticate a person's identity, and other information related to authentication of a person's identity." ;
  rdfs:label "Authentication" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Authentication" .

ceds:C200055
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200055"^^xsd:token ;
  rdfs:comment "Information about a data system or application which an authenticated person may access." ;
  rdfs:label "Authorization" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Authorization" .

ceds:C200056
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200056"^^xsd:token ;
  rdfs:comment """Information about a document that authorizes a deision or plan such as a
			document authorizing an IEP.""" ;
  rdfs:label "Authorization Document" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "AuthorizationDocument" .

ceds:C200057
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200057"^^xsd:token ;
  rdfs:comment "Information related to persons as board members within an organization." ;
  rdfs:label "Board Membership" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "BoardMembership" .

ceds:C200058
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200058"^^xsd:token ;
  rdfs:comment "Information describing and defining the uses of space within a building." ;
  rdfs:label "Building Space" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "BuildingSpace" .

ceds:C200059
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200059"^^xsd:token ;
  rdfs:comment """Information about the capacity and assigned utilization of an area within a
			building including if the area is unassigned.""" ;
  rdfs:label "Building Space Utilization" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "BuildingSpaceUtilization" .

ceds:C200060
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200060"^^xsd:token ;
  rdfs:comment "Type of building within a school such as a playground, gym, or classroom." ;
  rdfs:label "Building System Category" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "BuildingSystemCategory" .

ceds:C200061
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200061"^^xsd:token ;
  rdfs:comment """Information about a component of a system within a facility including the
			installation date, lifecycle cost, description, and useful life.""" ;
  rdfs:label "Building System Component" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "BuildingSystemComponent" .

ceds:C200062
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200062"^^xsd:token ;
  rdfs:comment "Information that tracks the service record of a building system component." ;
  rdfs:label "Building System Component Service" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "BuildingSystemComponentService" .

ceds:C200069
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200069"^^xsd:token ;
  rdfs:comment """A location where the postsecondary institution provides services (admin,
			residential, education). May be virtual or physical. May be called by other terms (e.g.,
			branch, location site regional campus).""" ;
  rdfs:label "Campus" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Campus" .

ceds:C200090
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200090"^^xsd:token ;
  rdfs:comment "The organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time (e.g., a semester or two-week workshop) to an individual or group of students (e.g., a class)." ;
  rdfs:label "Career And Technical Course" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CareerAndTechnicalCourse" .

ceds:C200091
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200091"^^xsd:token ;
  rdfs:comment "Summary academic record information for a career and technical education student." ;
  rdfs:label "Career And Technical Student Academic Record" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CareerAndTechnicalStudentAcademicRecord" .

ceds:C200021
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200021"^^xsd:token ;
  rdfs:comment "An organization responsible for authorizing charter schools." ;
  rdfs:label "Charter School Authorizing Organization" ;
  rdfs:subClassOf ceds:C200239 ;
  skos:notation "CharterSchoolAuthorizingOrganization" .

ceds:C200379
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200379"^^xsd:token ;
  rdfs:comment """A separate legal entity that 1) contracts with one or more charter schools to
			manage, operate, and oversee the charter schools; or 2) holds a charter, or charters, to
			operate multiple charter schools. (see Charter School Management Organization Type)""" ;
  rdfs:label "Charter School Management Organization" ;
  rdfs:subClassOf ceds:C200239 ;
  skos:notation "CharterSchoolManagementOrganization" .

ceds:C200063
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200063"^^xsd:token ;
  rdfs:comment """A room where educational services are provided by a school, school system,
			state, or other agency or entity.""" ;
  rdfs:label "Classroom" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Classroom" .

ceds:C200065
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200065"^^xsd:token ;
  rdfs:comment """A resource that states a capability or behavior that a person may learn or be
			able to do within a given context with references to potential levels of competence, a
			mastery threshold, and other contextualizing metadata.""" ;
  rdfs:label "Competency Definition" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CompetencyDefinition" .

ceds:C200064
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200064"^^xsd:token ;
  rdfs:comment """The relation of competency definitions to other competency definitions and/or
			competency frameworks to competency frameworks to support competency maps or competency
			sub frameworks or linked controlled vocabulary terms as metadata to further define a
			competency definition. (In CEDS IDS CompetencyDefAssociation also provides a mechanism
			to link any other object in the model to a CompetencyDefinition, e.g. to
			RubricCriterion, LearningResource, Course, or AssessmentItem.)""" ;
  rdfs:label "Competency Definition Association" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CompetencyDefinitionAssociation" .

ceds:C200067
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200067"^^xsd:token ;
  rdfs:comment """A resource that identifies a collection of logically related
			CompetencyDefinitions, CompetencyDefAssociations, and contextualizing metadata.""" ;
  rdfs:label "Competency Framework" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CompetencyFramework" .

ceds:C200068
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200068"^^xsd:token ;
  rdfs:comment "CompetencySet supports defining criteria for award or recognition of a credential or micro-credential based on a person's attainment of one or more CompetencyFrameworkItem(s). The set may have a completion criteria specifying if all or some of the items are required. If only some are required then Completion Criteria Threshold is used to specify how many. Competency Set may also include other Competency Sets so it is possible to make a rule such as \"the person must complete these three required competency items and 2 out of 3 of these items specified in this sub set.\"" ;
  rdfs:label "Competency Set" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CompetencySet" .

ceds:C200071
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200071"^^xsd:token ;
  rdfs:comment """The core knowledge areas addressed by a professional development activity most
			commonly used in the early learning domain.""" ;
  rdfs:label "Core Knowledge Area" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CoreKnowledgeArea" .

ceds:C001209
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C001209"^^xsd:token ;
  rdfs:comment """County code as defined for the identification of counties and equivalent areas
			of the United States, Puerto Rico, and the insular areas as established by the American
			National Standards Institute (ANSI) Inter-National Committee for Information Technology
			Standards (INCITS) in specification BSR INCITS 31-200x or more current updates. See
			https://www.census.gov/library/reference/code-lists/ansi.html#par_statelist.""" ;
  rdfs:label "County A N S I Code" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CountyANSICode" .

ceds:C200072
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200072"^^xsd:token ;
  rdfs:comment """The organization of subject matter and related learning experiences provided
			for the instruction of students on a regular or systematic basis, usually for a
			predetermined period of time.""" ;
  rdfs:label "Course" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "Course" .

ceds:C200073
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200073"^^xsd:token ;
  rdfs:comment """The relationship between course and the financial account that would be used
			to fund the course.""" ;
  rdfs:label "Course Funding Source" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CourseFundingSource" .

ceds:C200074
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200074"^^xsd:token ;
  rdfs:comment """CourseSection represents an instance of a course offered/delivered in a
			specific timeframe and/or place or through specific media or mode of study or to a
			specific section of students. (In the CEDS IDS, CourseSection is a subclass of
			organization that can be linked to persons and roles using Membership. Subclasses
			include K12 Course, PsCourse, CteCoure, AeCourse)""" ;
  rdfs:label "Course Section" ;
  rdfs:subClassOf ceds:C200239 ;
  skos:notation "CourseSection" .

ceds:C200075
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200075"^^xsd:token ;
  rdfs:comment "The method(s) that the instructor of the course uses to report the performance and achievement of all students. It may be a qualitative method such as individualized teacher comments or a quantitative method such as a letter or a numerical grade." ;
  rdfs:label "Course Section Assessment Reporting" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CourseSectionAssessmentReporting" .

ceds:C200076
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200076"^^xsd:token ;
  rdfs:comment "Information about an education level associated with a Course Section." ;
  rdfs:label "Course Section Level" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CourseSectionLevel" .

ceds:C200077
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200077"^^xsd:token ;
  rdfs:comment "The location where a Course Section meets." ;
  rdfs:label "Course Section Location" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CourseSectionLocation" .

ceds:C200078
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200078"^^xsd:token ;
  rdfs:comment "CourseSectionSchedule contains the times and days that a class is scheduled to meet on a weekly basis." ;
  rdfs:label "Course Section Schedule" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CourseSectionSchedule" .

ceds:C200079
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200079"^^xsd:token ;
  rdfs:comment "Information about the award of a credential to a person or organization." ;
  rdfs:label "Credential Award" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CredentialAward" .

ceds:C200080
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200080"^^xsd:token ;
  rdfs:comment """Credential AwardCredit may be used to record a specific course
			instance(CousreSection) that a Person completed to qualify for a CredentialAward using
			MembershipId and/or it could use CredentialCriteriaCourseId to reference the course
			completed.""" ;
  rdfs:label "Credential Award Credit" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CredentialAwardCredit" .

ceds:C200081
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200081"^^xsd:token ;
  rdfs:comment """CredentialAwardEvidence includes a statement or reference describing the
			evidence that the learner met the criteria for attainment of the achievement and may be
			related to an AssessmentResult.""" ;
  rdfs:label "Credential Award Evidence" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CredentialAwardEvidence" .

ceds:C200082
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200082"^^xsd:token ;
  rdfs:comment """The relationship between two credential awards, genrally used to capture
			extentions to an award (e.g., An endorsement for a teaching license).""" ;
  rdfs:label "Credential Award Relationship" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CredentialAwardRelationship" .

ceds:C200087
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200087"^^xsd:token ;
  rdfs:comment """Defines a qualification, achievement, personal or organizational quality, or
			aspect of an identity typically used to indicate suitability.""" ;
  rdfs:label "Credential Definition" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CredentialDefinition" .

ceds:C200083
  a rdfs:Class ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "C200083"^^xsd:token ;
  rdfs:comment """Information linking a person or organization to a credential definition with
			the applicable role such as the author, publisher, or issuer or the credential.""" ;
  rdfs:label "Credential Definition Agent" ;
  rdfs:subClassOf ceds:C000000 ;
  skos:notation "CredentialDefinitionAgent" .

ceds:C200084
