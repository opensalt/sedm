  schema:domainIncludes ceds:C200141 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "BuildingNetAreaOfInstructionalSpace" ;
  dc11:description "The area of space directly used for instruction excluding circulation, administration, student services, and building support." ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P001858
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001858"^^xsd:token ;
  rdfs:label "Building Number of Teaching Stations" ;
  schema:domainIncludes ceds:C200141 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "BuildingNumberOfTeachingStations" ;
