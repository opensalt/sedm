  schema:domainIncludes ceds:C200215 ;
  schema:rangeIncludes ceds:C000513 ;
  skos:notation "hasFullYearExpulsion" ;
  dc11:description "An expulsion with or without services for a period of one full year (i.e., 365 days)." .

