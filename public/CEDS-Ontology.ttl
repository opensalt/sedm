ceds:NI001517164295
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Agricultural Leadership courses help students develop leadership skills with
			a focus on opportunities in the food, fiber, and natural resources industries. Topics
			may include but are not limited to human relationships and effective communication,
			decisionmaking and problem-solving, leadership qualities and styles, and ensuring
			successful completion of group activities.""" ;
  dc11:identifier "NI001517164295"^^xsd:token ;
