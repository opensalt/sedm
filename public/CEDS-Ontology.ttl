  ceds:textFormat "Integer" .

ceds:P001859
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001859"^^xsd:token ;
  rdfs:label "Building Public Use Policy Description" ;
  schema:domainIncludes ceds:C200141 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "BuildingPublicUsePolicyDescription" ;
  dc11:description "A description of the policy that enables the community or other organizations to use all or part of a building for purposes other than general education." ;
  ceds:maxLength "80" ;
  ceds:textFormat "Alphanumeric - 80 characters maximum" .

ceds:P001904
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001904"^^xsd:token ;
  rdfs:label "Facility Enrollment Capacity" ;
  schema:domainIncludes ceds:C200141 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "FacilityEnrollmentCapacity" ;
  dc11:description "The maximum number of age appropriate students who can be enrolled in a facility such that the district's programmatic, operational, and student/teacher work load requirements are met." ;
  rdfs:comment "This element will be phased out in version 12. It is being replaced by Enrollment Capacity." ;
  ceds:textFormat "Integer" ;
  ceds:editHistory ( _:genid457 ) .

ceds:P002012
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002012"^^xsd:token ;
  rdfs:label "Enrollment Capacity" ;
  schema:domainIncludes ceds:C200141, ceds:C200249 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "EnrollmentCapacity" ;
  dc11:description "Maximum number of age-appropriate students who can be enrolled. " ;
  rdfs:comment "Enrollment capacity can be collected at a variety of levels, such as classroom, grade, school, and facility." ;
  ceds:textFormat "Integer" ;
  ceds:editHistory ( _:genid459 ) .

ceds:P001346
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001346"^^xsd:token ;
  rdfs:label "Financial Account Description" ;
  schema:domainIncludes ceds:C200142 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FinancialAccountDescription" ;
  dc11:description "The description for the financial account in an organization's accounting system." ;
  ceds:maxLength "300" ;
  ceds:textFormat "Alphanumeric - 300 characters maximum" ;
  ceds:editHistory ( _:genid461 ) .

ceds:P001348
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001348"^^xsd:token ;
  rdfs:label "Financial Account Name" ;
  schema:domainIncludes ceds:C200142 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FinancialAccountName" ;
  dc11:description "The name given to the financial account in an organization's accounting system." ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" ;
  ceds:editHistory ( _:genid463 ) .

ceds:P001554
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001554"^^xsd:token ;
  rdfs:label "Financial Account Number" ;
  schema:domainIncludes ceds:C200142 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FinancialAccountNumber" ;
  dc11:description "A number given to a financial account within a local source accounting system. The number may be a concatenation of a standard  prefix for the type of account with digits added that have specific meaning within the local system." ;
  ceds:maxLength "30" ;
  ceds:textFormat "Alphanumeric - 30 characters maximum" ;
  ceds:editHistory ( _:genid465 ) .

ceds:P001556
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001556"^^xsd:token ;
  rdfs:label "Financial Expenditure Project Reporting Code" ;
  schema:domainIncludes ceds:C200142 ;
  schema:rangeIncludes xsd:decimal ;
  skos:notation "FinancialExpenditureProjectReportingCode" ;
  dc11:description "The project/reporting code permits organizations to accumulate expenditures to meet a variety of specialized reporting requirements at the local, state, and federal levels. It is a three-digit code with the format 00X. The first two digits identify the particular funding source, authority, or expenditure purpose for which a special record or report is required. The third digit is available to identify particular projects and the fiscal year of the appropriation within that funding source. Each classification is presented by a code range followed by a description." ;
  rdfs:comment "Based on the following code conventions specified in the NCES Handbook <a href=\"http://nces.ed.gov/pubs2015/fin_acct/chapter6_7.asp\">\"Financial Accounting for Local and State School Systems: 2014 Edition\"</a>:<BR/><BR/>010 to 190 Local Projects. Expenditures that require specialized reporting and are funded from local sources. <BR/><BR/>200 to 390 State Projects. Expenditures that require specialized reporting for categorically funded state programs.<BR/><BR/>400 to 990 Federal Projects. Expenditures that require specialized reporting to the federal government directly or through the state.<BR/><BR/>1000 Noncategorical. Expenditures that do not require specialized reporting." ;
  ceds:textFormat "Numeric" ;
  ceds:editHistory ( _:genid467 ) .

ceds:P001645
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P001645"^^xsd:token ;
  rdfs:label "Financial Account Program Name" ;
  schema:domainIncludes ceds:C200143 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "FinancialAccountProgramName" ;
  dc11:description "The name given to the program area in an organization's accounting system." ;
  ceds:maxLength "100" ;
  ceds:textFormat "Alphanumeric - 100 characters maximum" ;
  ceds:editHistory ( _:genid469 ) .

