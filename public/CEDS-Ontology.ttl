ceds:NI001353117371
  a owl:NamedIndividual, ceds:C001353, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """An intangible asset is a capital asset that lacks physical substance, is
			nonfinancial in nature, and has an initial useful life of more than 1 year. Intangible
			assets may be purchased or licensed, acquired through nonexchange transactions, or
			internally generated. Examples include easements, contractual rights, patents,
			trademarks, and computer software.""" ;
