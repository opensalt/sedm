  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000199"^^xsd:token ;
  rdfs:label "Number of Credits Attempted" ;
  schema:domainIncludes ceds:C200213, ceds:C200336, ceds:C200346 ;
