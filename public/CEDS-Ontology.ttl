  schema:rangeIncludes xsd:decimal ;
  skos:notation "FinancialAidAwardAmount" ;
  dc11:description "The amount of financial aid awarded to a person for the term/year." ;
  rdfs:comment "Linked to financial aid award type.   <BR/>Note:  For any given individual this cluster of fields may be repeated multiple times." ;
  ceds:minInclusive "0" ;
  ceds:textFormat "Numeric - up to 2 digits after decimal place" ;
  ceds:decimalPlaces "2" .

ceds:P000903
