ceds:NI001517164263
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Viticulture courses prepare students for further studies in grape-growing,
			viticulture, and wine-making industry. Course topics typically include establishing and
			managing vineyards; harvesting; fermentation and wine making; marketing; and exploring
			career options within the industry. Agricultural applications specific to vineyards and
			wineries are emphasized.""" ;
  dc11:identifier "NI001517164263"^^xsd:token ;
  rdfs:label "Viticulture" ;
