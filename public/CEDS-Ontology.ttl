ceds:NI001517164034
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Repair—Workplace Experience courses provide students with work experience in
			the fields involving repair, supported by classroom attendance and discussion. Goals are
			typically set cooperatively by the student, teacher, and employer (although students are
			not necessarily paid). These courses may include classroom activities as well, involving
			further study of the field or discussion regarding experiences that students encounter
			in the workplace.""" ;
  dc11:identifier "NI001517164034"^^xsd:token ;
