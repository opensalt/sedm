ceds:NI001517164255
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Plant Systems—Workplace Experience courses provide work experience in fields
			related to plant systems (care, propagation, and processing). Goals are typically set
			cooperatively by the student, teacher, and employer (although students are not
			necessarily paid). These courses may include classroom activities as well, involving
			further study of the field or discussion regarding experiences that students encounter
			in the workplace.""" ;
