  rdfs:label "Military Deployment Activity Name" ;
  schema:domainIncludes ceds:C200298 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MilitaryDeploymentActivityName" ;
  dc11:description "The names of any activities performed by the person while deployed in the military." ;
  rdfs:comment "This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements. " ;
  ceds:textFormat "Alphanumeric - 400 characters maximum" ;
  ceds:editHistory ( _:genid973 ) .

ceds:P002049
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P002049"^^xsd:token ;
  rdfs:label "Military Honors" ;
  schema:domainIncludes ceds:C200301 ;
  schema:rangeIncludes xsd:string ;
  skos:notation "MilitaryHonors" ;
  dc11:description "A military honor that the person received during the service period." ;
  rdfs:comment "This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements. " ;
  ceds:textFormat "Alphanumeric - 40 characters maximum" ;
  ceds:editHistory ( _:genid975 ) .

