ceds:NI001517164529
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Transportation, Distribution, and Logistics—Independent Study courses, often
			conducted with instructors as mentors, enable students to explore topics of interest
			related to transportation, distribution, and logistics. Independent Study courses may
			serve as an opportunity for students to expand their expertise in a particular
			application, to explore a topic in greater detail, or to develop more advanced skills.""" ;
  dc11:identifier "NI001517164529"^^xsd:token ;
  rdfs:label "Transportation, Distribution and Logistics—Independent Study" ;
  skos:definition """Transportation, Distribution, and Logistics—Independent Study courses,
			often conducted with instructors as mentors, enable students to explore topics of
			interest related to transportation, distribution, and logistics. Independent Study
			courses may serve as an opportunity for students to expand their expertise in a
			particular application, to explore a topic in greater detail, or to develop more
			advanced skills.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "20997" ;
  skos:prefLabel "Transportation, Distribution and Logistics—Independent Study" .

ceds:NI001517164530
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Transportation, Distribution, and Logistics—Workplace Experience courses
			provide students with work experience in fields related to transportation, distribution,
			and logistics. Goals are typically set cooperatively by the student, teacher, and
			employer (although students are not necessarily paid). These courses may include
			classroom activities as well, involving further study of the field or discussion
			regarding experiences encountered in the workplace.""" ;
  dc11:identifier "NI001517164530"^^xsd:token ;
  rdfs:label "Transportation, Distribution and Logistics—Workplace Experience" ;
