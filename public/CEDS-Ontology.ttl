ceds:P000099
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000099"^^xsd:token ;
  rdfs:label "Has Entry Type" ;
  schema:domainIncludes ceds:C200219 ;
  schema:rangeIncludes ceds:C000099 ;
  skos:notation "hasEntryType" ;
