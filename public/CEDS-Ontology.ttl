ceds:NI001517164257
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Animal Production/Science courses impart information about the care and
			management of companion and farm animals. These courses may cover animal nutrition,
			health, behavior, selection, reproduction, anatomy and physiology, facilities, product
			processing, research, qualitative and quantitative analyses as a basis for
			decisionmaking, and marketing. Students may study a particular species, or they may
			learn how to care for and maintain livestock as a more inclusive study.""" ;
  dc11:identifier "NI001517164257"^^xsd:token ;
  rdfs:label "Animal Production/Science" ;
  skos:definition """Animal Production/Science courses impart information about the care and
