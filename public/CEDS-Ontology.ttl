ceds:NI001517163249
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """History of the English Language courses trace the development of English,
			concentrating on historical and cultural influences and how the language has changed
			over time. Although language roots, structures, and dialects may be examined, the
			emphasis remains on the process of language development rather than on morphology.""" ;
  dc11:identifier "NI001517163249"^^xsd:token ;
  rdfs:label "History of the English Language" ;
  skos:definition """History of the English Language courses trace the development of English,
			concentrating on historical and cultural influences and how the language has changed
			over time. Although language roots, structures, and dialects may be examined, the
			emphasis remains on the process of language development rather than on morphology.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "01202" ;
  skos:prefLabel "History of the English Language" .

ceds:NI001517163250
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """English—Test Preparation courses provide students with activities in
			analytical thinking and with the skills and strategies associated with standardized test
			taking. Topics covered include vocabulary, reading comprehension, and writing
			strategies, as well as time management, scoring procedures, and dealing with
			test-related stress. Course materials may include national and state standardized test
			review materials (such as ACT, SAT, or PSAT test review materials), current assessment
			software programs, and previous standardized examinations.""" ;
  dc11:identifier "NI001517163250"^^xsd:token ;
  rdfs:label "English—Test Preparation" ;
  skos:definition """English—Test Preparation courses provide students with activities in
			analytical thinking and with the skills and strategies associated with standardized test
			taking. Topics covered include vocabulary, reading comprehension, and writing
			strategies, as well as time management, scoring procedures, and dealing with
			test-related stress. Course materials may include national and state standardized test
			review materials (such as ACT, SAT, or PSAT test review materials), current assessment
			software programs, and previous standardized examinations.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "01203" ;
  skos:prefLabel "English—Test Preparation" .

