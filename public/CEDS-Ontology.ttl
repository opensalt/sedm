  schema:domainIncludes ceds:C200199 ;
  schema:rangeIncludes xsd:date ;
  skos:notation "CharterSchoolContractRenewalDate" ;
  dc11:description "The date by which the charter school must renew its contract (or charter) with an approved charter school authorizer in order to continue to operate in the state under the state's charter school legislation." ;
  ceds:textFormat "YYYY-MM-DD" .

ceds:P000481
