ceds:P000653
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000653"^^xsd:token ;
  rdfs:label "Interscholastic Sports - Male Only" ;
  schema:domainIncludes ceds:C200190 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "InterscholasticSportsMaleOnly" ;
  dc11:description "The number of interscholastic sports in which only male students participate.  Sports include distinct sports such as football, basketball, soccer but not intramural sports or cheerleading." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000654
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000654"^^xsd:token ;
  rdfs:label "Interscholastic Sports - Female Only" ;
  schema:domainIncludes ceds:C200190 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "InterscholasticSportsFemaleOnly" ;
  dc11:description "The number of interscholastic sports in which only female students participate.  Sports include distinct sports such as football, basketball, soccer but not intramural sports or cheerleading." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000655
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000655"^^xsd:token ;
  rdfs:label "Interscholastic Teams - Male Only" ;
  schema:domainIncludes ceds:C200190 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "InterscholasticTeamsMaleOnly" ;
  dc11:description "The number of interscholastic teams in which only male students participate.  Teams include each competitive level team in each sport, such as freshman team, junior varsity team, and varsity team but not intramural sports or cheerleading." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000656
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000656"^^xsd:token ;
  rdfs:label "Interscholastic Teams - Female Only" ;
  schema:domainIncludes ceds:C200190 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "InterscholasticTeamsFemaleOnly" ;
  dc11:description "The number of interscholastic teams in which only female students participate.  Teams include each competitive level team in each sport, such as freshman team, junior varsity team, and varsity team but not intramural sports or cheerleading." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000657
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000657"^^xsd:token ;
  rdfs:label "Interscholastic Sport Participants - Male Only" ;
  schema:domainIncludes ceds:C200190 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "InterscholasticSportParticipantsMaleOnly" ;
  dc11:description "The number of male students who participated on an interscholastic team.  A student should be counted once for each team he was on." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

ceds:P000658
  a rdf:Property ;
  dc11:creator "Common Education Data Standards" ;
  dc11:identifier "P000658"^^xsd:token ;
  rdfs:label "Interscholastic Sport Participants - Female Only" ;
  schema:domainIncludes ceds:C200190 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "InterscholasticSportParticipantsFemaleOnly" ;
  dc11:description "The number of female students who participated on an interscholastic team.  A student should be counted once for each team she was on." ;
  ceds:textFormat "Integer - greater than or equal to 0" .

