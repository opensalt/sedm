ceds:NI001517163989
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Payroll Accounting courses introduce students to and expand their knowledge
			of the fundamental accounting principles and procedures related to payroll transactions
			for businesses. These courses typically emphasize computing wages, social security
			taxes, income tax withholding, unemployment taxes, and recording payroll transactions
			while providing students with experience in preparing all the necessary monthly,
			quarterly, and annual reports.""" ;
  dc11:identifier "NI001517163989"^^xsd:token ;
  rdfs:label "Payroll Accounting" ;
  skos:definition """Payroll Accounting courses introduce students to and expand their knowledge
			of the fundamental accounting principles and procedures related to payroll transactions
			for businesses. These courses typically emphasize computing wages, social security
			taxes, income tax withholding, unemployment taxes, and recording payroll transactions
			while providing students with experience in preparing all the necessary monthly,
			quarterly, and annual reports.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "12110" ;
  skos:prefLabel "Payroll Accounting" .

