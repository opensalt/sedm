ceds:NI001673127655
  a owl:NamedIndividual, ceds:C001673, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting revenues from private (non-governmental) entities
			including revenues received from gift or contribution nonexchange transactions
			(including contributed services) except those from affiliated entities. Includes
			bequests, promises to give (pledges), gifts from an affiliated organization or a
			component unit not blended or consolidated, and income from funds held in irrevocable
			trusts or distributable at the direction of the trustees of the trusts. Includes any
			contributed services recognized (recorded) by the institution.""" ;
  dc11:identifier "NI001673127655"^^xsd:token ;
  rdfs:label "Private gifts" ;
  skos:definition """Used for reporting revenues from private (non-governmental) entities
			including revenues received from gift or contribution nonexchange transactions
			(including contributed services) except those from affiliated entities. Includes
			bequests, promises to give (pledges), gifts from an affiliated organization or a
			component unit not blended or consolidated, and income from funds held in irrevocable
			trusts or distributable at the direction of the trustees of the trusts. Includes any
			contributed services recognized (recorded) by the institution.""" ;
  skos:inScheme ceds:C001673 ;
  skos:notation "Privategifts" ;
  skos:prefLabel "Private gifts" .

ceds:NI001673127656
  a owl:NamedIndividual, ceds:C001673, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Used for reporting revenues from private (non-governmental) entities that
			are for specific research projects, other types of programs, or for general
			institutional operations (if not government appropriations). Examples are research
			projects, training programs, and similar activities for which amounts are received or
			expenses are reimbursable under the terms of a grant or contract, including amounts to
			cover both direct and indirect expenses.""" ;
  dc11:identifier "NI001673127656"^^xsd:token ;
  rdfs:label "Private grants and contracts" ;
  skos:definition """Used for reporting revenues from private (non-governmental) entities that
			are for specific research projects, other types of programs, or for general
			institutional operations (if not government appropriations). Examples are research
			projects, training programs, and similar activities for which amounts are received or
			expenses are reimbursable under the terms of a grant or contract, including amounts to
			cover both direct and indirect expenses.""" ;
  skos:inScheme ceds:C001673 ;
  skos:notation "Privategrantscontracts" ;
  skos:prefLabel "Private grants and contracts" .

ceds:NI001673127657
