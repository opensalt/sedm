ceds:NI001517163253
  a owl:NamedIndividual, ceds:C001517, skos:Concept ;
  dc11:creator "Common Education Data Standards" ;
  dc11:description """Informal Mathematics courses emphasize the teaching of mathematics as
			problem solving, communication, and reasoning, and highlight the connections among
			mathematical topics and between mathematics and other disciplines. These courses
			approach the teaching of general mathematics, pre-algebra, and pre-geometry topics by
			applying numbers, and algebraic and geometric concepts and relationships to real world
			problems.""" ;
  dc11:identifier "NI001517163253"^^xsd:token ;
  rdfs:label "Informal Mathematics" ;
  skos:definition """Informal Mathematics courses emphasize the teaching of mathematics as
			problem solving, communication, and reasoning, and highlight the connections among
			mathematical topics and between mathematics and other disciplines. These courses
			approach the teaching of general mathematics, pre-algebra, and pre-geometry topics by
			applying numbers, and algebraic and geometric concepts and relationships to real world
			problems.""" ;
  skos:inScheme ceds:C001517 ;
  skos:notation "02001" ;
  skos:prefLabel "Informal Mathematics" .

