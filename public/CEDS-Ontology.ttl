  schema:domainIncludes ceds:C200210, ceds:C200338 ;
  schema:rangeIncludes xsd:int ;
  skos:notation "HighSchoolStudentClassRank" ;
  dc11:description "The academic rank of a student in relation to his or her high school graduating class (e.g., 1, 2, 3) based on high school GPA." ;
