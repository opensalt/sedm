@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ceds: <http://ceds.ed.gov/terms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix domain: <http://ward.guru/domain/terms#> .

# Domain class definitions
domain:adulteducation a owl:Class ;
  rdfs:label "Adult Education" ;
  rdfs:comment "A Adult Education domain concept in the CEDS ontology" .

domain:assessments a owl:Class ;
  rdfs:label "Assessments" ;
  rdfs:comment "A Assessments domain concept in the CEDS ontology" .

domain:authenticationandauthorization a owl:Class ;
  rdfs:label "Authentication and Authorization" ;
  rdfs:comment "A Authentication and Authorization domain concept in the CEDS ontology" .

domain:careerandtechnical a owl:Class ;
  rdfs:label "Career and Technical" ;
  rdfs:comment "A Career and Technical domain concept in the CEDS ontology" .

domain:competencies a owl:Class ;
  rdfs:label "Competencies" ;
  rdfs:comment "A Competencies domain concept in the CEDS ontology" .

domain:credentials a owl:Class ;
  rdfs:label "Credentials" ;
  rdfs:comment "A Credentials domain concept in the CEDS ontology" .

domain:earlylearning a owl:Class ;
  rdfs:label "Early Learning" ;
  rdfs:comment "A Early Learning domain concept in the CEDS ontology" .

domain:facilities a owl:Class ;
  rdfs:label "Facilities" ;
  rdfs:comment "A Facilities domain concept in the CEDS ontology" .

domain:implementationvariables a owl:Class ;
  rdfs:label "Implementation Variables" ;
  rdfs:comment "A Implementation Variables domain concept in the CEDS ontology" .

domain:k12 a owl:Class ;
  rdfs:label "K12" ;
  rdfs:comment "A K12 domain concept in the CEDS ontology" .

domain:learningresources a owl:Class ;
  rdfs:label "Learning Resources" ;
  rdfs:comment "A Learning Resources domain concept in the CEDS ontology" .

domain:postsecondary a owl:Class ;
  rdfs:label "Postsecondary" ;
  rdfs:comment "A Postsecondary domain concept in the CEDS ontology" .

domain:workforce a owl:Class ;
  rdfs:label "Workforce" ;
  rdfs:comment "A Workforce domain concept in the CEDS ontology" .

domain:unknown a owl:Class ;
  rdfs:label "Unknown" ;
  rdfs:comment "A concept with unknown or unmappable domain in the CEDS ontology" .

