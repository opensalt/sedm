@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ceds: <http://ceds.ed.gov/terms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix greg: <http://ward.guru/greg/terms#> .

# Class definitions for concept types

greg:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A person concept in the CEDS ontology" .

greg:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "An organization concept in the CEDS ontology" .

greg:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "An event concept in the CEDS ontology" .

greg:Resource a owl:Class ;
  rdfs:label "Resource" ;
  rdfs:comment "A resource concept in the CEDS ontology" .

greg:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A role concept in the CEDS ontology" .

greg:Financial a owl:Class ;
  rdfs:label "Financial" ;
  rdfs:comment "A financial concept in the CEDS ontology" .

greg:Unknown a owl:Class ;
  rdfs:label "Unknown" ;
  rdfs:comment "An unknown or unspecified concept in the CEDS ontology" .

# Classifications from CEDS-Classification-Greg.csv
# All entries mapped according to the "Fundamental" column

